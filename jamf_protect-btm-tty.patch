@@ -4,6 +4,9 @@
     - description: Keep the BTM launch item instigator under `jamf_protect.telemetry.instigator.*` when the app is mapped to `process.*`, and include its hashes in `related.hash`.
       type: enhancement
       link: https://github.com/elastic/integrations/pull/22270
+    - description: Keep a BTM launch item instigator TTY on `jamf_protect.telemetry.instigator.tty` when the app is mapped to `process.*`, and preserve `process.interactive` for an instigator-only removal that has a TTY.
+      type: bugfix
+      link: https://github.com/elastic/integrations/pull/22270
 - version: "3.5.1"
   changes:
     - description: Prefer `app` process fields over `instigator` fields in BTM telemetry pipelines so events that contain both objects no longer fail ingest.
