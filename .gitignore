.DS_Store

.idea

# Claude Code state.
# - Any .claude/ directory nested under a package or subdirectory (e.g.
#   packages/*/.claude/) is fully ignored - it's local scratch state.
# - The root .claude/ is ignored EXCEPT for settings.json, which is checked
#   in to register the elastic-integration-skills plugin marketplace for all
#   contributors (see CLAUDE.md).
.claude/
!/.claude/
/.claude/*
!/.claude/settings.json
# - /.claude/skills/ is checked in: repo-local skills that are too
#   integrations-specific to live in the integration-skills plugin.
!/.claude/skills/

/build

dev/packages

elastic-package

# Folder created by the Sonar Scanner
.scannerwork/

# Buildkite Python CI scripts test venv
.buildkite/.venv-ci-python-scripts/
