config_version: 2
interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.rate_limit.limit: 10
resource.rate_limit.burst: 10
resource.retry.max_attempts: 5
resource.retry.wait_min: 1s
resource.retry.wait_max: 60s
resource.url: {{public_api_url}}/v1.0/jsonrpc/quarantine/computers
state:
  api_key: {{api_key}}
  auth_type: {{auth_type}}
  company_id: '{{company_id}}'
  page_size: {{page_size}}
  initial_interval: {{initial_interval}}
  collection_delay: {{collection_delay}}
redact:
  fields:
    - api_key
max_executions: 10000
program: |-
  {
    "phase": state.?cursor.phase.orValue("window"),
    "start": state.?cursor.window.start.orValue(
      (
        state.?cursor.bookmark.optMap(
          bookmark,
          string(timestamp(bookmark) - duration("1s"))
        )
      ).orValue(string(now - duration(state.collection_delay) - duration(state.initial_interval)))
    ),
    "end": state.?cursor.window.end.orValue(string(now - duration(state.collection_delay))),
    "page": int(state.?cursor.page.orValue(1)),
    "resumed": state.?cursor.resumed.orValue(
      state.?cursor.bookmark.hasValue()
    ),
    "states": state.?cursor.states.orValue({}),
    "seen_ids": state.?cursor.seen_ids.orValue([]),
  }.as(run,
    (run.phase == "window" && timestamp(run.end) <= timestamp(run.start)) ?
      state.with({"events": [], "want_more": false})
    :
      state.with(
        request("POST", state.url).with(
          {
            "Header": {
              "Accept": ["application/json"],
              "Content-Type": ["application/json"],
              ?"Authorization": (state.auth_type == "basic") ?
                optional.of(["Basic " + bytes(state.api_key + ":").base64()])
              :
                optional.none(),
              ?"X-API-Key": (state.auth_type == "x_api_key") ?
                optional.of([state.api_key])
              :
                optional.none(),
            },
            "Body": {
              "id": (run.phase == "reconcile") ?
                "quarantine-reconcile"
              : run.resumed ?
                "quarantine-list-resume"
              :
                "quarantine-list-initial",
              "jsonrpc": "2.0",
              "method": "getQuarantineItemsList",
              "params": {
                "page": run.page,
                "perPage": int(state.page_size),
                ?"companyId": (state.company_id != "") ?
                  optional.of(state.company_id)
                :
                  optional.none(),
                "filters": (run.phase == "reconcile") ?
                  {"endDate": run.start}
                :
                  {
                    "startDate": run.start,
                    "endDate": run.end,
                  },
              },
            }.encode_json(),
          }
        ).do_request().as(resp,
          is_error(resp) ?
            {
              "events": {
                "error": {
                  "code": "transport_error",
                  "id": "transport_error",
                  "message": "POST /v1.0/jsonrpc/quarantine/computers: " + try(resp),
                },
              },
              "want_more": false,
            }
          : (resp.StatusCode == 200) ?
            try(resp.Body.decode_json()).as(body,
              (is_error(body) || type(body) != map) ?
                {
                  "events": {
                    "error": {
                      "code": "invalid_json_rpc_response",
                      "id": "invalid_response",
                      "message": "POST /v1.0/jsonrpc/quarantine/computers: response was not a JSON object",
                    },
                  },
                  "want_more": false,
                }
              : (body.?error.orValue(null) != null) ?
                {
                  "events": {
                    "error": {
                      "code": "json_rpc_error",
                      "id": string(body.error.message),
                      "message": "POST /v1.0/jsonrpc/quarantine/computers: " + body.error.encode_json(),
                    },
                  },
                  "want_more": false,
                }
              : (!has(body.result) || type(body.result) != map || type(body.result.?items.orValue(null)) != list) ?
                {
                  "events": {
                    "error": {
                      "code": "invalid_json_rpc_response",
                      "id": "missing_result",
                      "message": "POST /v1.0/jsonrpc/quarantine/computers: response did not contain a valid items list",
                    },
                  },
                  "want_more": false,
                }
              :
                {
                  "more": int(body.result.?page.orValue(run.page)) < int(body.result.?pagesCount.orValue(run.page)),
                  "emitted": body.result.items.filter(item,
                    type(item) == map && string(item.?id.orValue("")) != "" && (
                      (run.phase == "reconcile") ?
                        (
                          (string(item.id) in run.states) ?
                            (int(item.?actionStatus.orValue(0)) != int(run.states[string(item.id)]))
                          :
                            int(item.?actionStatus.orValue(0)) != 0
                        )
                      :
                        !(string(item.id) in run.states) || int(item.?actionStatus.orValue(0)) != int(run.states[string(item.id)])
                    )
                  ),
                  "tracked": body.result.items.filter(item,
                    type(item) == map && string(item.?id.orValue("")) != "" && (
                      run.phase != "reconcile" || string(item.id) in run.states ||
                      int(item.?actionStatus.orValue(0)) != 0
                    )
                  ),
                }.as(page_data,
                  {
                    "next_states": zip(
                      run.states.keys() + page_data.tracked.map(item, string(item.id)),
                      run.states.keys().map(k, int(run.states[k])) + page_data.tracked.map(item, int(item.?actionStatus.orValue(0)))
                    ),
                    "next_seen_ids": run.seen_ids + page_data.tracked.map(item, string(item.id)),
                    "seen_map": (run.phase == "reconcile" && !page_data.more) ?
                      (
                        zip(
                          run.seen_ids + page_data.tracked.map(item, string(item.id)),
                          (run.seen_ids + page_data.tracked.map(item, string(item.id))).map(id, true)
                        )
                      )
                    :
                      {},
                  }.as(merged,
                    {
                      "events": (size(page_data.emitted) != 0) ?
                        dyn(page_data.emitted.map(item, {"message": item.encode_json()}))
                      :
                        dyn([{"retry": true}]),
                      "cursor": page_data.more ?
                        {
                          "phase": run.phase,
                          "window": {"start": run.start, "end": run.end},
                          "page": run.page + 1,
                          "resumed": run.resumed,
                          "states": merged.next_states,
                          "seen_ids": merged.next_seen_ids,
                        }
                      : (run.phase == "window" && run.resumed) ?
                        {
                          "phase": "reconcile",
                          "window": {"start": run.start, "end": run.end},
                          "page": 1,
                          "resumed": true,
                          "states": merged.next_states,
                          "seen_ids": merged.next_seen_ids,
                        }
                      : (run.phase == "reconcile") ?
                        {
                          "bookmark": run.end,
                          "resumed": true,
                          "states": zip(
                            merged.next_states.keys().filter(k, k in merged.seen_map),
                            merged.next_states.keys().map(k, k in merged.seen_map, merged.next_states[k])
                          ),
                        }
                      :
                        {
                          "bookmark": run.end,
                          "resumed": true,
                          "states": merged.next_states,
                        },
                      "want_more": page_data.more || run.phase == "window" && run.resumed,
                    }
                  )
                )
            )
          :
            {
              "events": {
                "error": {
                  "code": string(resp.StatusCode),
                  "id": resp.Status,
                  "message": "POST /v1.0/jsonrpc/quarantine/computers: " + (
                    (size(resp.Body) != 0) ?
                      string(resp.Body)
                    :
                      resp.Status + " (" + string(resp.StatusCode) + ")"
                  ),
                },
              },
              "want_more": false,
            }
        )
      )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{escape_string tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
processors:
  - drop_event.when.equals.retry: true
{{#if processors}}
{{processors}}
{{/if}}
