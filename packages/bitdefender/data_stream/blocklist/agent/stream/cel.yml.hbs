config_version: 2
interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.rate_limit.limit: 10
resource.rate_limit.burst: 10
resource.retry.max_attempts: 5
resource.retry.wait_min: 1s
resource.retry.wait_max: 60s
resource.url: {{public_api_url}}/v1.2/jsonrpc/incidents
state:
  api_key: {{api_key}}
  auth_type: {{auth_type}}
  company_id: '{{company_id}}'
  page_size: {{page_size}}
redact:
  fields:
    - api_key
max_executions: 10000
program: |-
  {
    "page": int(state.?cursor.page.orValue(1)),
    "resumed": state.?cursor.resumed.orValue(false),
  }.as(run,
    state.with(
      request("POST", state.url).with(
        {
          "Header": {
            "Accept": ["application/json"],
            "Content-Type": ["application/json"],
            ?"Authorization": (state.auth_type == "basic") ?
              optional.of(["Basic " + bytes(state.api_key + ":").base64()])
            :
              optional.none(),
            ?"X-API-Key": (state.auth_type == "x_api_key") ?
              optional.of([state.api_key])
            :
              optional.none(),
          },
          "Body": {
            "id": run.resumed ? "blocklist-items-resume" : "blocklist-items",
            "jsonrpc": "2.0",
            "method": "getBlocklistItems",
            "params": {
              "page": run.page,
              "perPage": [[int(state.page_size), 100].min(), 1].max(),
              ?"companyId": (state.company_id != "") ?
                optional.of(state.company_id)
              :
                optional.none(),
            },
          }.encode_json(),
        }
      ).do_request().as(resp,
        is_error(resp) ?
          {
            "events": {
              "error": {
                "code": "transport_error",
                "id": "transport_error",
                "message": "POST /v1.2/jsonrpc/incidents: " + try(resp),
              },
            },
            "want_more": false,
          }
        : (resp.StatusCode == 200) ?
          try(resp.Body.decode_json()).as(body,
            (is_error(body) || type(body) != map) ?
              {
                "events": {
                  "error": {
                    "code": "invalid_json_rpc_response",
                    "id": "invalid_response",
                    "message": "POST /v1.2/jsonrpc/incidents: response was not a JSON object",
                  },
                },
                "want_more": false,
              }
            : (body.?error.orValue(null) != null) ?
              {
                "events": {
                  "error": {
                    "code": string(body.error.code),
                    "id": string(body.error.message),
                    "message": "POST /v1.2/jsonrpc/incidents: " + body.error.encode_json(),
                  },
                },
                "want_more": false,
              }
            : (!has(body.result) || type(body.result) != map) ?
              {
                "events": {
                  "error": {
                    "code": "invalid_json_rpc_response",
                    "id": "missing_result",
                    "message": "POST /v1.2/jsonrpc/incidents: response did not contain an object result",
                  },
                },
                "want_more": false,
              }
            : (
              !has(body.result.items) || type(body.result.items) != list || !has(body.result.pagesCount) ||
              type(body.result.pagesCount) != double || body.result.pagesCount < 0.0 ||
              body.result.pagesCount != double(int(body.result.pagesCount))
            ) ?
              {
                "events": {
                  "error": {
                    "code": "invalid_json_rpc_response",
                    "id": "invalid_pagination",
                    "message": "POST /v1.2/jsonrpc/incidents: result did not contain valid items and pagesCount fields",
                  },
                },
                "want_more": false,
              }
            :
              (int(body.result.?page.orValue(run.page)) < int(body.result.pagesCount)).as(more,
                {
                  "events": (size(body.result.items) != 0) ?
                    dyn(body.result.items.map(item, {"message": item.encode_json()}))
                  :
                    dyn([{"retry": true}]),
                  "cursor": {
                    ?"page": more ?
                      optional.of(run.page + 1)
                    :
                      optional.none(),
                    ?"resumed": more ?
                      optional.of(run.resumed)
                    :
                      optional.of(true),
                  },
                  "want_more": more,
                }
              )
          )
        :
          {
            "events": {
              "error": {
                "code": string(resp.StatusCode),
                "id": resp.Status,
                "message": "POST /v1.2/jsonrpc/incidents: " + (
                  (size(resp.Body) != 0) ?
                    string(resp.Body)
                  :
                    resp.Status + " (" + string(resp.StatusCode) + ")"
                ),
              },
            },
            "want_more": false,
          }
      )
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{escape_string tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
processors:
  - drop_event.when.equals.retry: true
{{#if processors}}
{{processors}}
{{/if}}
