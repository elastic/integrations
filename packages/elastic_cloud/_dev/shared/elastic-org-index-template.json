{
    "index_patterns": [
        "elastic-org*"
    ],
    "priority": 210,
    "composed_of": [
        "logs-elastic_cloud.audit@package",
        "logs-elastic_cloud.audit@custom"
    ],
    "ignore_missing_component_templates": [
        "logs-elastic_cloud.audit@custom"
    ],
    "_meta": {
        "package": {
            "name": "elastic_cloud"
        },
        "managed_by": "elastic_cloud",
        "description": "Apply Elastic Cloud audit mappings and ingest pipeline to classic elastic-org* indices."
    }
}
