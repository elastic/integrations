config_version: 2
interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.ssl.renegotiation: freely
resource.url: {{url}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
state:
  initial_interval: {{initial_interval}}
  limit: {{limit}}
  apikey: {{escape_string apikey}}
 {{#if password}}
  password: {{escape_string password}}
 {{/if}}
  username: {{escape_string username}}
  cookie_ttl: 15m
redact:
  fields:
    - apikey
    - password
    - cookie_jar
{{!--
API References:
  https://docs.beyondtrust.com/bips/docs/api#post-authsignappin
  https://docs.beyondtrust.com/bips/docs/api#post-authsignout
  https://docs.beyondtrust.com/bips/docs/beyondinsight-apis#get-useraudits

State variable definitions:
  cookie_jar: Session state ({cookies, session_time}), persisted across polls but not restarts.
    cookies: Raw Set-Cookie header values from /Auth/SignAppin.
    session_time: Timestamp of session creation (RFC 3339), used for renewal check.
  cursor.newest_event_time: CreateDate of most recent record, only updated from offset=0.
  cursor.current_startdate: Start of current time window, preserved during pagination.
  cursor.current_enddate: End of current time window, preserved during pagination.
  cursor.current_offset: API offset parameter, incremented during pagination, reset on new time window.
  cursor.in_pagination: Boolean indicating if currently paginating through a time window.
--}}
program: |-
  state.with(
    (
      // Reuse existing session if fresh; otherwise sign out the old one (if any) and sign in.
      has(state.?cookie_jar.cookies) && (now - timestamp(state.cookie_jar.session_time)) < duration(state.cookie_ttl) ?
        state.cookie_jar
      :
        (has(state.?cookie_jar.cookies) ?
          request("POST", state.url.trim_suffix("/") + "/Auth/Signout").with(
            {
              "Header": {
                "Authorization": [
                  sprintf("PS-Auth key=%s; runas=%s;", [state.apikey, state.username]) +
                  (has(state.password) ? (sprintf(" pwd=[%s];", [state.password])) : ""),
                ],
                "Content-Type": ["application/json"],
                "Cookie": [state.cookie_jar.cookies.map(c, c.split(";")[0]).join("; ")],
              },
            }
          ).do_request()
        :
          dyn(null)
        ).as(_,
          request("POST", state.url.trim_suffix("/") + "/Auth/SignAppin").with(
            {
              "Header": {
                "Authorization": [
                  sprintf("PS-Auth key=%s; runas=%s;", [state.apikey, state.username]) +
                  // pwd is required only if the user password is required on the application API registration.
                  (has(state.password) ? (sprintf(" pwd=[%s];", [state.password])) : ""),
                ],
                "Content-Type": ["application/json"],
              },
            }
          ).do_request().as(resp,
            (resp.StatusCode == 200) ?
              {"cookies": resp.Header["Set-Cookie"], "session_time": now.format("2006-01-02T15:04:05Z")}
            :
              {
                "error": {
                  "code": string(resp.StatusCode),
                  "id": resp.Status,
                  "message": "Failed to create session: POST " + state.url.trim_suffix("/") + "/Auth/SignAppin: " + (
                    (size(resp.Body) != 0) ?
                      string(resp.Body)
                    :
                      resp.Status + " (" + string(resp.StatusCode) + ")"
                  ),
                },
              }
          )
        )
    ).as(auth,
      has(auth.error) ?
        {
          "events": {"error": {"message": "failed to log in: " + auth.error.message}},
          "want_more": false,
          "cookie_jar": {},
        }
      :
        // Fetch user audits using authenticated session.
        request(
          "GET",
          state.url.trim_suffix("/") + "/UserAudits?" + {
            "limit": [string(state.limit)],
            "startdate": [
              state.?cursor.current_startdate.orValue((now - duration(state.initial_interval)).format("2006-01-02T15:04:05Z")),
            ],
            "enddate": [
              state.?cursor.current_enddate.orValue(now.format("2006-01-02T15:04:05Z")),
            ],
            "offset": [
              string(state.?cursor.current_offset.orValue(0)),
            ],
          }.format_query()
        ).with(
          {
            "Header": {
              // Include credentials on every request; some API registrations validate them on all calls, not just sign-in.
              "Authorization": [
                sprintf("PS-Auth key=%s; runas=%s;", [state.apikey, state.username]) +
                (has(state.password) ? (sprintf(" pwd=[%s];", [state.password])) : ""),
              ],
              "Content-Type": ["application/json"],
              "Cookie": [auth.cookies.map(c, c.split(";")[0]).join("; ")],
            },
          }
        ).do_request().as(resp,
          (resp.StatusCode == 200) ?
            // Success: process JSON response with Data array of user audit objects.
            // Records are sorted by CreateDate in descending order (latest entries first).
            resp.Body.decode_json().as(body,
              (int(state.?cursor.current_offset.orValue(0)) == 0 && size(body.Data) > 0) ?
                // First page with data: update newest_event_time high-water mark.
                (
                  (body.TotalCount > size(body.Data)) ?
                    // More pages in current time window.
                    {
                      "events": body.Data.map(e,
                        {
                          "event": {
                            "original": e.encode_json(),
                          },
                        }
                      ),
                      "want_more": true,
                      "cookie_jar": auth,
                      "cursor": {
                        "newest_event_time": body.Data[0].CreateDate,
                        "current_startdate": state.?cursor.current_startdate.orValue((now - duration(state.initial_interval)).format("2006-01-02T15:04:05Z")),
                        "current_enddate": state.?cursor.current_enddate.orValue(now.format("2006-01-02T15:04:05Z")),
                        "current_offset": int(state.limit),
                        "in_pagination": true,
                      },
                    }
                  :
                    // Last page of first fetch.
                    {
                      "events": body.Data.map(e,
                        {
                          "event": {
                            "original": e.encode_json(),
                          },
                        }
                      ),
                      "want_more": false,
                      "cookie_jar": auth,
                      "cursor": {
                        "newest_event_time": body.Data[0].CreateDate,
                        "current_startdate": body.Data[0].CreateDate,
                        "current_enddate": now.format("2006-01-02T15:04:05Z"),
                        "current_offset": 0,
                        "in_pagination": false,
                      },
                    }
                )
              :
                // Not first page or no data: preserve existing newest_event_time.
                (
                  (body.TotalCount > int(state.?cursor.current_offset.orValue(0)) + size(body.Data)) ?
                    // More pages in current time window.
                    {
                      "events": body.Data.map(e,
                        {
                          "event": {
                            "original": e.encode_json(),
                          },
                        }
                      ),
                      "want_more": true,
                      "cookie_jar": auth,
                      "cursor": {
                        "newest_event_time": state.?cursor.newest_event_time.orValue((now - duration(state.initial_interval)).format("2006-01-02T15:04:05Z")),
                        "current_startdate": state.?cursor.current_startdate.orValue((now - duration(state.initial_interval)).format("2006-01-02T15:04:05Z")),
                        "current_enddate": state.?cursor.current_enddate.orValue(now.format("2006-01-02T15:04:05Z")),
                        "current_offset": int(state.?cursor.current_offset.orValue(0)) + int(state.limit),
                        "in_pagination": true,
                      },
                    }
                  :
                    // Last page.
                    {
                      "events": body.Data.map(e,
                        {
                          "event": {
                            "original": e.encode_json(),
                          },
                        }
                      ),
                      "want_more": false,
                      "cookie_jar": auth,
                      "cursor": {
                        "newest_event_time": state.?cursor.newest_event_time.orValue((now - duration(state.initial_interval)).format("2006-01-02T15:04:05Z")),
                        "current_startdate": has(state.?cursor.newest_event_time) ?
                          state.cursor.newest_event_time
                        :
                          (now - duration(state.initial_interval)).format("2006-01-02T15:04:05Z"),
                        "current_enddate": now.format("2006-01-02T15:04:05Z"),
                        "current_offset": 0,
                        "in_pagination": false,
                      },
                    }
                )
            )
          : (resp.StatusCode == 401) ?
            {
              "events": {
                "error": {
                  "code": string(resp.StatusCode),
                  "id": resp.Status,
                  "message": "GET " + state.url.trim_suffix("/") + "/UserAudits: " + (
                    (size(resp.Body) != 0) ?
                      string(resp.Body)
                    :
                      resp.Status + " (" + string(resp.StatusCode) + ")"
                  ),
                },
              },
              "want_more": false,
              "cookie_jar": {},
            }
          :
            {
              "events": {
                "error": {
                  "code": string(resp.StatusCode),
                  "id": resp.Status,
                  "message": "GET " + state.url.trim_suffix("/") + "/UserAudits: " + (
                    (size(resp.Body) != 0) ?
                      string(resp.Body)
                    :
                      resp.Status + " (" + string(resp.StatusCode) + ")"
                  ),
                },
              },
              "want_more": false,
              "cookie_jar": auth,
            }
        )
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}

{{#if processors}}
processors:
{{processors}}
{{/if}}
