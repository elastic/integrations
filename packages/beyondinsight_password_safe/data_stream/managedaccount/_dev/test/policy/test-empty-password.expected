inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: beyondinsight_password_safe
      name: test-empty-password-beyondinsight_password_safe
      streams:
        - config_version: 2
          data_stream:
            dataset: beyondinsight_password_safe.managedaccount
          interval: 4h
          processors:
            - add_fields:
                fields:
                    foo: bar
          program: |-
            state.with(
              (
                // Reuse existing session if fresh; otherwise sign out the old one (if any) and sign in.
                has(state.?cookie_jar.cookies) && (now - timestamp(state.cookie_jar.session_time)) < duration(state.cookie_ttl) ?
                  state.cookie_jar
                :
                  (has(state.?cookie_jar.cookies) ?
                    request("POST", state.url.trim_suffix("/") + "/Auth/Signout").with(
                      {
                        "Header": {
                          "Authorization": [
                            sprintf("PS-Auth key=%s; runas=%s;", [state.apikey, state.username]) +
                            (has(state.password) ? (sprintf(" pwd=[%s];", [state.password])) : ""),
                          ],
                          "Content-Type": ["application/json"],
                          "Cookie": [state.cookie_jar.cookies.map(c, c.split(";")[0]).join("; ")],
                        },
                      }
                    ).do_request()
                  :
                    dyn(null)
                  ).as(_,
                    request("POST", state.url.trim_suffix("/") + "/Auth/SignAppin").with(
                      {
                        "Header": {
                          "Authorization": [
                            sprintf("PS-Auth key=%s; runas=%s;", [state.apikey, state.username]) +
                            // pwd is required only if the user password is required on the application API registration.
                            (has(state.password) ? (sprintf(" pwd=[%s];", [state.password])) : ""),
                          ],
                          "Content-Type": ["application/json"],
                        },
                      }
                    ).do_request().as(resp,
                      (resp.StatusCode == 200) ?
                        {"cookies": resp.Header["Set-Cookie"], "session_time": now.format("2006-01-02T15:04:05Z")}
                      :
                        {
                          "error": {
                            "code": string(resp.StatusCode),
                            "id": resp.Status,
                            "message": "Failed to create session: POST " + state.url.trim_suffix("/") + "/Auth/SignAppin: " + (
                              (size(resp.Body) != 0) ?
                                string(resp.Body)
                              :
                                resp.Status + " (" + string(resp.StatusCode) + ")"
                            ),
                          },
                        }
                    )
                  )
              ).as(auth,
                has(auth.error) ?
                  {
                    "events": {"error": {"message": "failed to log in: " + auth.error.message}},
                    "want_more": false,
                    "cookie_jar": {},
                  }
                :
                  // Fetch managed accounts using authenticated session.
                  request(
                    "GET",
                    state.url.trim_suffix("/") + "/ManagedAccounts?" + {
                      "limit": [string(state.limit)],
                      "offset": [string(state.?offset.orValue(0))],
                    }.format_query()
                  ).with(
                    {
                      "Header": {
                        // Include credentials on every request; some API registrations validate them on all calls, not just sign-in.
                        "Authorization": [
                          sprintf("PS-Auth key=%s; runas=%s;", [state.apikey, state.username]) +
                          (has(state.password) ? (sprintf(" pwd=[%s];", [state.password])) : ""),
                        ],
                        "Content-Type": ["application/json"],
                        "Cookie": [auth.cookies.map(c, c.split(";")[0]).join("; ")],
                      },
                    }
                  ).do_request().as(resp,
                    (resp.StatusCode == 200) ?
                      resp.Body.decode_json().as(body,
                        (size(body) == int(state.limit)) ?
                          // More pages available.
                          {
                            "events": body.map(e,
                              {
                                "event": {
                                  "original": e.encode_json(),
                                },
                              }
                            ),
                            "want_more": true,
                            "offset": int(state.?offset.orValue(0)) + size(body),
                            "cookie_jar": auth,
                          }
                        :
                          // All data fetched.
                          {
                            "events": body.map(e,
                              {
                                "event": {
                                  "original": e.encode_json(),
                                },
                              }
                            ),
                            "want_more": false,
                            "offset": 0,
                            "cookie_jar": auth,
                          }
                      )
                    : (resp.StatusCode == 401) ?
                      {
                        "events": {
                          "error": {
                            "code": string(resp.StatusCode),
                            "id": resp.Status,
                            "message": "GET " + state.url.trim_suffix("/") + "/ManagedAccounts: " + (
                              (size(resp.Body) != 0) ?
                                string(resp.Body)
                              :
                                resp.Status + " (" + string(resp.StatusCode) + ")"
                            ),
                          },
                        },
                        "want_more": false,
                        "cookie_jar": {},
                      }
                    :
                      {
                        "events": {
                          "error": {
                            "code": string(resp.StatusCode),
                            "id": resp.Status,
                            "message": "GET " + state.url.trim_suffix("/") + "/ManagedAccounts: " + (
                              (size(resp.Body) != 0) ?
                                string(resp.Body)
                              :
                                resp.Status + " (" + string(resp.StatusCode) + ")"
                            ),
                          },
                        },
                        "want_more": false,
                        "cookie_jar": auth,
                      }
                  )
              )
            )
          publisher_pipeline.disable_host: true
          redact:
            fields:
                - apikey
                - password
                - cookie_jar
          resource.ssl.renegotiation: freely
          resource.tracer:
            enabled: true
            filename: ../../logs/cel/http-request-trace-*.ndjson
            maxbackups: 5
          resource.url: https://foo.ps.beyondtrustcloud.com/BeyondTrust/api/public/v3
          state:
            apikey: ${SECRET_0}
            cookie_ttl: 15m
            limit: 1000
            username: domain\user
          tags:
            - forwarded
            - beyondinsight_password_safe.managedaccount
      type: cel
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-beyondinsight_password_safe.managedaccount-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references:
    - {}
