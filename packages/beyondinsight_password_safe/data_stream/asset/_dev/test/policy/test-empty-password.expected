inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: beyondinsight_password_safe
      name: test-empty-password-beyondinsight_password_safe
      streams:
        - config_version: 2
          data_stream:
            dataset: beyondinsight_password_safe.asset
          interval: 4h
          processors:
            - drop_event.when.equals.retry: true
            - add_fields:
                fields:
                    foo: bar
          program: |-
            (
              (has(state.?cursor.asset_reqs) && !has(state.?cursor.workgroup_ids)) ?
                // Migrate cursor from old asset_reqs (array of arrays) to new workgroup_ids (array of objects).
                state.with(
                  {
                    "cursor": state.cursor.with(
                      {
                        "workgroup_ids": state.cursor.asset_reqs.map(item,
                          {"workgroup_id": string(item[0]), "offset": int(item[1])}
                        ),
                      }
                    ).drop("asset_reqs"),
                  }
                )
              :
                state
            ).as(state,
              state.with(
                (
                  // Reuse existing session if fresh; otherwise sign out the old one (if any) and sign in.
                  has(state.?cookie_jar.cookies) && (now - timestamp(state.cookie_jar.session_time)) < duration(state.cookie_ttl) ?
                    state.cookie_jar
                  :
                    (has(state.?cookie_jar.cookies) ?
                      request("POST", state.url.trim_suffix("/") + "/Auth/Signout").with(
                        {
                          "Header": {
                            "Authorization": [
                              sprintf("PS-Auth key=%s; runas=%s;", [state.apikey, state.username]) +
                              (has(state.password) ? (sprintf(" pwd=[%s];", [state.password])) : ""),
                            ],
                            "Content-Type": ["application/json"],
                            "Cookie": [state.cookie_jar.cookies.map(c, c.split(";")[0]).join("; ")],
                          },
                        }
                      ).do_request()
                    :
                      dyn(null)
                    ).as(_,
                      request("POST", state.url.trim_suffix("/") + "/Auth/SignAppin").with(
                        {
                          "Header": {
                            "Authorization": [
                              sprintf("PS-Auth key=%s; runas=%s;", [state.apikey, state.username]) +
                              // pwd is required only if the user password is required on the application API registration.
                              (has(state.password) ? (sprintf(" pwd=[%s];", [state.password])) : ""),
                            ],
                            "Content-Type": ["application/json"],
                          },
                        }
                      ).do_request().as(resp,
                        (resp.StatusCode == 200) ?
                          {"cookies": resp.Header["Set-Cookie"], "session_time": now.format("2006-01-02T15:04:05Z")}
                        :
                          {
                            "error": {
                              "code": string(resp.StatusCode),
                              "id": resp.Status,
                              "message": "Failed to create session: POST " + state.url.trim_suffix("/") + "/Auth/SignAppin: " + (
                                (size(resp.Body) != 0) ?
                                  string(resp.Body)
                                :
                                  resp.Status + " (" + string(resp.StatusCode) + ")"
                              ),
                            },
                          }
                      )
                    )
                ).as(auth,
                  has(auth.error) ?
                    {
                      "events": {"error": {"message": "failed to log in: " + auth.error.message}},
                      "want_more": false,
                      "cookie_jar": {},
                    }
                  :
                    (
                      // Use existing authenticated session to fetch assets from workgroups.
                      (size(state.?cursor.workgroup_ids.orValue([])) > 0) ?
                        // We already have workgroup IDs, process assets from them.
                        {
                          "workgroup_id": state.cursor.workgroup_ids[0].workgroup_id,
                          "offset": state.cursor.workgroup_ids[0].offset,
                          "remaining_workgroups": tail(state.cursor.workgroup_ids),
                        }.as(r,
                          request(
                            "GET",
                            state.url.trim_suffix("/") + "/Workgroups/" + r.workgroup_id + "/Assets?" + {
                              "limit": [string(state.limit)],
                              "offset": [string(r.offset)],
                            }.format_query()
                          ).with(
                            {
                              "Header": {
                                // Include credentials on every request; some API registrations validate them on all calls, not just sign-in.
                                "Authorization": [
                                  sprintf("PS-Auth key=%s; runas=%s;", [state.apikey, state.username]) +
                                  (has(state.password) ? (sprintf(" pwd=[%s];", [state.password])) : ""),
                                ],
                                "Content-Type": ["application/json"],
                                "Cookie": [auth.cookies.map(c, c.split(";")[0]).join("; ")],
                              },
                            }
                          ).do_request().as(resp,
                            (resp.StatusCode == 200) ?
                              // Success: process JSON response with Data array of asset objects.
                              resp.Body.decode_json().as(body,
                                (
                                  (size(body.Data) + int(r.offset) < int(body.TotalCount)) ?
                                    ([{"workgroup_id": r.workgroup_id, "offset": int(r.offset) + size(body.Data)}] + r.remaining_workgroups)
                                  :
                                    r.remaining_workgroups
                                ).as(next_workgroup_ids,
                                  (size(next_workgroup_ids) > 0) ?
                                    // More workgroups to process.
                                    {
                                      "events": body.Data.map(e,
                                        {
                                          "event": {
                                            "original": e.encode_json(),
                                          },
                                        }
                                      ),
                                      "want_more": true,
                                      "cookie_jar": auth,
                                      "cursor": {"workgroup_ids": next_workgroup_ids},
                                    }
                                  :
                                    // All workgroups done; session kept in state for next poll.
                                    {
                                      "events": body.Data.map(e,
                                        {
                                          "event": {
                                            "original": e.encode_json(),
                                          },
                                        }
                                      ),
                                      "want_more": false,
                                      "cookie_jar": auth,
                                      "cursor": {},
                                    }
                                )
                              )
                            : (resp.StatusCode == 401) ?
                              {
                                "events": {
                                  "error": {
                                    "code": string(resp.StatusCode),
                                    "id": resp.Status,
                                    "message": "GET " + state.url.trim_suffix("/") + "/Workgroups/" + r.workgroup_id + "/Assets: " + (
                                      (size(resp.Body) != 0) ?
                                        string(resp.Body)
                                      :
                                        resp.Status + " (" + string(resp.StatusCode) + ")"
                                    ),
                                  },
                                },
                                "want_more": false,
                                "cookie_jar": {},
                              }
                            :
                              {
                                "events": {
                                  "error": {
                                    "code": string(resp.StatusCode),
                                    "id": resp.Status,
                                    "message": "GET " + state.url.trim_suffix("/") + "/Workgroups/" + r.workgroup_id + "/Assets: " + (
                                      (size(resp.Body) != 0) ?
                                        string(resp.Body)
                                      :
                                        resp.Status + " (" + string(resp.StatusCode) + ")"
                                    ),
                                  },
                                },
                                "want_more": false,
                                "cookie_jar": auth,
                              }
                          )
                        )
                      :
                        // Fetch workgroup IDs first.
                        request("GET", state.url.trim_suffix("/") + "/Workgroups").with(
                          {
                            "Header": {
                              // Include credentials on every request; some API registrations validate them on all calls, not just sign-in.
                              "Authorization": [
                                sprintf("PS-Auth key=%s; runas=%s;", [state.apikey, state.username]) +
                                (has(state.password) ? (sprintf(" pwd=[%s];", [state.password])) : ""),
                              ],
                              "Content-Type": ["application/json"],
                              "Cookie": [auth.cookies.map(c, c.split(";")[0]).join("; ")],
                            },
                          }
                        ).do_request().as(resp,
                          (resp.StatusCode == 200) ?
                            // Success: extract workgroup IDs and set up for asset fetching.
                            resp.Body.decode_json().as(workgroups,
                              (size(workgroups) == 0) ?
                                // No workgroups; session kept in state for next poll.
                                {
                                  "events": [],
                                  "want_more": false,
                                  "cookie_jar": auth,
                                }
                              :
                                {
                                  "events": [
                                    // Must produce an event for want_more=true to be honored.
                                    {"retry": true},
                                  ],
                                  "want_more": true,
                                  "cookie_jar": auth,
                                  "cursor": {
                                    "workgroup_ids": workgroups.map(wg, {"workgroup_id": string(wg.ID), "offset": 0}),
                                  },
                                }
                            )
                          : (resp.StatusCode == 401) ?
                            {
                              "events": {
                                "error": {
                                  "code": string(resp.StatusCode),
                                  "id": resp.Status,
                                  "message": "GET " + state.url.trim_suffix("/") + "/Workgroups: " + (
                                    (size(resp.Body) != 0) ?
                                      string(resp.Body)
                                    :
                                      resp.Status + " (" + string(resp.StatusCode) + ")"
                                  ),
                                },
                              },
                              "want_more": false,
                              "cookie_jar": {},
                            }
                          :
                            {
                              "events": {
                                "error": {
                                  "code": string(resp.StatusCode),
                                  "id": resp.Status,
                                  "message": "GET " + state.url.trim_suffix("/") + "/Workgroups: " + (
                                    (size(resp.Body) != 0) ?
                                      string(resp.Body)
                                    :
                                      resp.Status + " (" + string(resp.StatusCode) + ")"
                                  ),
                                },
                              },
                              "want_more": false,
                              "cookie_jar": auth,
                            }
                        )
                    )
                )
              )
            )
          publisher_pipeline.disable_host: true
          redact:
            fields:
                - apikey
                - password
                - cookie_jar
          resource.ssl.renegotiation: freely
          resource.tracer:
            enabled: true
            filename: ../../logs/cel/http-request-trace-*.ndjson
            maxbackups: 5
          resource.url: https://foo.ps.beyondtrustcloud.com/BeyondTrust/api/public/v3
          state:
            apikey: ${SECRET_0}
            cookie_ttl: 15m
            limit: 1000
            username: domain\user
          tags:
            - forwarded
            - beyondinsight_password_safe.asset
      type: cel
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-beyondinsight_password_safe.asset-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references:
    - {}
