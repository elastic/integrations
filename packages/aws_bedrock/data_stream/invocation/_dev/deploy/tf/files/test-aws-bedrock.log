e_missing\": true\n      }\n    },\n    {\n      \"rename\": {\n        \"field\": \"teleport.audit.identity.route_to_database.protocol\",\n        \"target_field\": \"network.protocol\",\n        \"ignore_missing\": true\n      }\n    },\n    {\n      \"rename\": {\n        \"field\": \"teleport.audit.server_hostname\",\n        \"target_field\": \"server.domain\",\n        \"ignore_missing\": true\n      }\n    },\n    {\n      \"rename\": {\n        \"field\": \"teleport.audit.proto\",\n        \"target_field\": \"network.transport\",\n        \"ignore_missing\": true\n      }\n    },\n    {\n      \"rename\": {\n        \"field\": \"teleport.audit.tx\",\n        \"target_field\": \"client.bytes\",\n        \"ignore_missing\": true\n      }\n    },\n    {\n      \"rename\": {\n        \"field\": \"teleport.audit.rx\",\n        \"target_field\": \"server.bytes\",\n        \"ignore_missing\": true\n      }\n    },\n    {\n      \"date\": {\n        \"field\": \"teleport.audit.session_start\",\n        \"target_field\": \"event.start\",\n        \"formats\": [\n          \"ISO8601\"  \n        ],\n        \"ignore_failure\": true\n      }\n    },\n    {\n      \"rename\": {\n        \"field\": \"teleport.audit.server_addr\",\n        \"target_field\": \"server.ip\",\n        \"ignore_missing\": true\n      }\n    },\n    {\n      \"rename\": {\n        \"field\": \"teleport.audit.url\",\n        \"target_field\": \"url.full\",\n        \"ignore_missing\": true\n      }\n    },\n    {\n      \"geoip\": {\n        \"field\": \"client.ip\",\n        \"target_field\": \"client.geo\",\n        \"ignore_missing\": true\n      }\n    },\n    {\n      \"geoip\": {\n        \"ignore_missing\": true,\n        \"database_file\": \"GeoLite2-ASN.mmdb\",\n        \"field\": \"client.ip\",\n        \"target_field\": \"client.as\",\n        \"properties\": [\n          \"asn\",\n          \"organization_name\"\n        ]\n      }\n    },\n    {\n      \"rename\": {\n        \"field