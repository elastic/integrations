output_sink: elasticsearch
output_index: {{escape_string output_index}}
{{#if domains}}
domains:
{{domains}}
{{/if}}
{{#if schedule}}
schedule:
  pattern: {{escape_string schedule}}
{{/if}}
{{#if max_crawl_depth}}
max_crawl_depth: {{max_crawl_depth}}
{{/if}}
{{#if max_unique_url_count}}
max_unique_url_count: {{max_unique_url_count}}
{{/if}}
{{#if max_duration}}
max_duration: {{max_duration}}
{{/if}}
{{#if user_agent}}
user_agent: {{escape_string user_agent}}
{{/if}}
purge_crawl_enabled: {{purge_crawl_enabled}}
binary_content_extraction_enabled: {{binary_content_extraction_enabled}}
{{#if binary_content_extraction_mime_types}}
binary_content_extraction_mime_types:
{{#each binary_content_extraction_mime_types}}
  - {{escape_string this}}
{{/each}}
{{/if}}
{{#if elasticsearch_pipeline}}
elasticsearch.pipeline: {{escape_string elasticsearch_pipeline}}
{{/if}}
{{#if log_level}}
log_level: {{log_level}}
{{/if}}
{{#if advanced_settings}}
{{advanced_settings}}
{{/if}}
