paths:
{{#each paths as |path i|}}
 - {{path}}
{{/each}}
tags:
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#if condition}}
condition: {{ condition }}
{{/if}}
allow_deprecated_use: true
exclude_files: [".gz$"]
processors:
  - decode_json_fields:
      fields: ["message"]
      target: ""
      overwrite_keys: true
      expand_keys: true
      add_error_key: true
