interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
{{#if max_executions}}
max_executions: {{max_executions}}
{{/if}}
resource.url: {{url}}
auth.basic:
  user: {{username}}
  password: {{password}}
state:
  initial_interval: {{initial_interval}}
  page_size: {{page_size}}
  tz_offset: {{tz_offset}}
  columns: >-
    OrionAuditLog.AutoId OrionAuditLog.UserId OrionAuditLog.UserName
    OrionAuditLog.Priority OrionAuditLog.CmdName OrionAuditLog.Message
    OrionAuditLog.Success OrionAuditLog.StartTime OrionAuditLog.EndTime
redact:
  fields:
    - password
program: |
  (
    state.?want_more.orValue(false) ?
      state
    :
      state.with({
        "start_time": state.?cursor.last_start_time.orValue(
          (now - duration(state.initial_interval)).format("2006-01-02T15:04:05")
        )
      })
  ).as(state,
    state.with(
      get(
        state.url.trim_right("/") + "/remote/core.executeQuery?" +
        {
          "target": ["OrionAuditLog"],
          // (top N) keyset page ordered by StartTime ascending.
          "select": ['(select (top ' + string(int(state.page_size)) + ') ' + state.columns + ')'],
          // ge (inclusive) so same-second ties on the boundary are not skipped;
          "where": ['(where (ge OrionAuditLog.StartTime "' + state.start_time + '"))'],
          "order": ["(order (asc OrionAuditLog.StartTime))"]
        }.format_query() + "&:output=json"
      ).as(resp,
        resp.StatusCode == 200 ?
          string(resp.Body).trim_space().trim_prefix("OK:").trim_space().decode_json().as(rows,
            // Advance the cursor using the wall-clock the API itself returned.
            // The API's OrionAuditLog.StartTime comes back with a UTC offset (e.g.
            // "+05:30"), but the API rejects that same offset when it's echoed back
            // in the next page's where clause and instead interprets a bare
            // timestamp as UTC — so the offset has to be subtracted here or every
            // page transition silently skips tz_offset worth of records.
            (size(rows) > 0 ?
              (timestamp(string(rows[size(rows)-1]["OrionAuditLog.StartTime"])) -
                state.tz_offset.split(":").as(tz, duration(tz[0] + "h" + tz[1] + "m"))
              ).format("2006-01-02T15:04:05")
            :
              state.start_time
            ).as(new_start_time, {
              "events": rows.map(e, {"message": e.encode_json()}),
              "start_time": new_start_time,
              "cursor": {"last_start_time": new_start_time},
              "want_more": size(rows) == int(state.page_size)
            })
          )
        :
          {
            "events": {
              "error": {
                "code": string(resp.StatusCode),
                "message": "GET core.executeQuery failed: " + (
                  size(resp.Body) != 0 ? string(resp.Body) : string(resp.StatusCode)
                )
              }
            },
            "want_more": false
          }
      )
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
