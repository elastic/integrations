interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
{{#if max_executions}}
max_executions: {{max_executions}}
{{/if}}
resource.url: {{url}}
auth.basic:
  user: {{username}}
  password: {{password}}
state:
  initial_interval: "{{initial_interval}}"
  page_size: {{page_size}}
  columns: >-
    EPOLeafNode.AutoID EPOLeafNode.NodeName EPOLeafNode.Type
    EPOLeafNode.ParentID EPOLeafNode.AgentGUID EPOLeafNode.LastUpdate
    EPOLeafNode.AgentVersion EPOLeafNode.NodePath
    EPOLeafNode.ServerKeyHash EPOLeafNode.TenantId
    EPOLeafNode.LastCommSecure
    EPOLeafNode.SequenceErrorCount EPOLeafNode.SequenceErrorCountLastUpdate
    EPOLeafNode.TransferSiteListsID EPOLeafNode.ManagedState
    EPOLeafNode.Tags EPOLeafNode.ExcludedTags
redact:
  fields: ~
program: |
  (
    state.?want_more.orValue(false) ?
      state
    :
      state.with({
        // Empty until the first page lands. The seed below is relative and
        // evaluated by ePO, so no client-side instant is needed to start.
        "update_time": state.?cursor.last_update_time.orValue("")
      })
  ).as(state,
    state.with(
      get(
        state.url.trim_right("/") + "/remote/core.executeQuery?" +
        {
          "target": ["EPOLeafNode"],
          // (top N) keyset page ordered by LastUpdate.
          "select": ['(select (top ' + string(state.page_size) + ') ' + state.columns + ')'],
          // Without a cursor, seed from newerThan, whose argument is a duration in
          // milliseconds that ePO resolves against its own clock. A client-side
          // instant cannot seed this column: it stores a bare wall clock, so any
          // boundary built from the agent's clock is wrong by the server's offset,
          // which over-collects east of UTC and silently skips history west of it.
          // Once a row has been seen its own timestamp is an exact boundary, and
          // inclusive ge keeps records sharing it from being skipped.
          "where": [
            state.update_time == "" ?
              '(where (newerThan EPOLeafNode.LastUpdate ' +
                string(int(duration(state.initial_interval)) / 1000000) + '))'
            :
              '(where (ge EPOLeafNode.LastUpdate "' + state.update_time + '"))'
          ],
          "order": ["(order (asc EPOLeafNode.LastUpdate))"],
          ":output": ["json"]
        }.format_query()
      ).as(resp,
        // core.executeQuery is a plain-text protocol that reports query errors
        // with HTTP 200 and an "Error <n> :" body, so the status alone does not
        // establish that the body is JSON. Without the prefix check a non-JSON
        // 200 aborts the whole evaluation inside decode_json(), which returns no
        // events at all and leaves nothing in the index to diagnose.
        (resp.StatusCode == 200 && string(resp.Body).trim_space().has_prefix("OK:")) ?
          string(resp.Body).trim_space().trim_prefix("OK:").decode_json().as(rows,
            // LastUpdate is stored without a zone and merely has the server's offset
            // appended on the way out, so "2026-08-03T12:31:28+05:30" holds the digits
            // the where clause compares against. format() renders in the parsed value's
            // own offset, which hands those digits back unchanged. Do not re-anchor this
            // to UTC: the offset here is decorative, so converting would park the cursor
            // a whole offset behind the last record and re-read it forever.
            (size(rows) > 0 ?
              timestamp(
                string(rows[size(rows) - 1]["EPOLeafNode.LastUpdate"])
              ).format("2006-01-02T15:04:05")
            :
              state.update_time
            ).as(new_update_time, {
              "events": rows.map(e, {"message": e.encode_json()}),
              "update_time": new_update_time,
              "cursor": {"last_update_time": new_update_time},
              // The cursor comparison stops a full page whose rows all share the
              // boundary timestamp from being re-fetched for the rest of the budget.
              "want_more": size(rows) == int(state.page_size) &&
                new_update_time != state.update_time
            })
          )
        :
          {
            "events": {
              "error": {
                "code": string(resp.StatusCode),
                "id": resp.Status,
                "message": "GET " + state.url.trim_right("/") + "/remote/core.executeQuery: " + (
                  size(resp.Body) != 0 ?
                    string(resp.Body)
                  :
                    resp.Status + " (" + string(resp.StatusCode) + ")"
                )
              }
            },
            "want_more": false
          }
      )
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
