interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
{{#if resource_retry_max_attempts}}
resource.retry.max_attempts: {{resource_retry_max_attempts}}
{{/if}}
{{#if resource_retry_wait_min}}
resource.retry.wait_min: {{resource_retry_wait_min}}
{{/if}}
{{#if resource_retry_wait_max}}
resource.retry.wait_max: {{resource_retry_wait_max}}
{{/if}}
resource.rate_limit.limit: 1
resource.rate_limit.burst: 1
resource.url: {{url}}
state:
  token: {{token}}
  role: {{role}}
  warehouse: {{warehouse}}
  batch_size: {{batch_size}}
  initial_interval: {{initial_interval}}
  lag_time: {{lag_time}}
  user_agent: Elastic-Snowflake/{{#if _meta.package.version}}{{_meta.package.version}}{{else}}unknown{{/if}}
  want_more: false
redact:
  fields:
    - token
program: |-
  {
    "query": state.?cursor.query.orValue("created"),
    "http_method": (state.?want_more.orValue(false) && state.?cursor.handle.orValue("") != "") ? "GET" : "POST",
    "request_url": (state.?want_more.orValue(false) && state.?cursor.handle.orValue("") != "") ?
      (
        (int(state.?cursor.next_partition.orValue(0)) > 0) ?
          (
            state.url.trim_right("/") + "/api/v2/statements/" + state.cursor.handle + "?" + {
              "partition": [string(int(state.cursor.next_partition))],
            }.format_query()
          )
        :
          state.url.trim_right("/") + "/api/v2/statements/" + state.cursor.handle
      )
    :
      state.url.trim_right("/") + "/api/v2/statements?" + {
        "async": ["true"],
        "requestId": [uuid()],
      }.format_query(),
  }.as(req,
    state.with(
      request(
        req.http_method,
        req.request_url
      ).with(
        {
          "Header": {
            "Authorization": ["Bearer " + state.token],
            "X-Snowflake-Authorization-Token-Type": ["PROGRAMMATIC_ACCESS_TOKEN"],
            "Accept": ["application/json"],
            "Content-Type": ["application/json"],
            "User-Agent": [state.user_agent],
          },
          ?"Body": (req.http_method == "POST") ?
            optional.of(
              {
                "statement": (req.query == "deleted") ?
                  ("SELECT * FROM SNOWFLAKE.ACCOUNT_USAGE.GRANTS_TO_USERS " + "WHERE DELETED_ON IS NOT NULL AND DELETED_ON " + (state.?cursor.continue.orValue(false) ? ">= ?" : "> ?") + " ORDER BY DELETED_ON ASC, GRANTEE_NAME ASC, ROLE ASC " + "LIMIT " + string(state.batch_size))
                :
                  "SELECT * FROM SNOWFLAKE.ACCOUNT_USAGE.GRANTS_TO_USERS " + "WHERE CREATED_ON " + (state.?cursor.continue.orValue(false) ? ">= ?" : "> ?") + " ORDER BY CREATED_ON ASC, GRANTEE_NAME ASC, ROLE ASC " + "LIMIT " + string(state.batch_size),
                "warehouse": state.warehouse,
                "role": state.role,
                "bindings": {
                  "1": {
                    "type": "TEXT",
                    "value": (req.query == "deleted") ?
                      (
                        (state.?cursor.last_deleted_on.orValue("") != "") ?
                          (
                            state.?cursor.continue.orValue(false) ?
                              state.cursor.last_deleted_on
                            :
                              (state.cursor.last_deleted_on.parse_time("2006-01-02 15:04:05.000 -0700") - duration(state.lag_time)).format("2006-01-02 15:04:05.000 -0700")
                          )
                        :
                          (now - duration(state.initial_interval)).format("2006-01-02 15:04:05.000 -0700")
                      )
                    : (state.?cursor.last_created_on.orValue("") != "") ?
                      (
                        state.?cursor.continue.orValue(false) ?
                          state.cursor.last_created_on
                        :
                          (state.cursor.last_created_on.parse_time("2006-01-02 15:04:05.000 -0700") - duration(state.lag_time)).format("2006-01-02 15:04:05.000 -0700")
                      )
                    :
                      (now - duration(state.initial_interval)).format("2006-01-02 15:04:05.000 -0700"),
                  },
                },
                "parameters": {
                  "TIMESTAMP_LTZ_OUTPUT_FORMAT": "YYYY-MM-DD HH24:MI:SS.FF3 TZHTZM",
                },
              }.encode_json()
            )
          :
            optional.none(),
        }
      ).do_request().as(resp,
        (resp.StatusCode == 202) ?
          try(resp.Body.decode_json()).as(body,
            (is_error(body) || string(body.?statementHandle.orValue("")) == "") ?
              {
                "events": {
                  "error": {
                    "code": string(resp.StatusCode),
                    "id": resp.Status,
                    "message": req.http_method + " " + req.request_url + ": HTTP 202 without statementHandle",
                  },
                },
                "want_more": false,
              }
            :
              {
                "events": [{"retry": true}],
                "cursor": {
                  ?"last_created_on": (state.?cursor.last_created_on.orValue("") != "") ? optional.of(state.cursor.last_created_on) : optional.none(),
                  ?"last_deleted_on": (state.?cursor.last_deleted_on.orValue("") != "") ? optional.of(state.cursor.last_deleted_on) : optional.none(),
                  "query": req.query,
                  "handle": string(body.statementHandle),
                  "next_partition": 0,
                },
                "want_more": true,
              }
          )
        : (resp.StatusCode == 200) ?
          try(resp.Body.decode_json()).as(body,
            is_error(body) ?
              {
                "events": {
                  "error": {
                    "code": string(resp.StatusCode),
                    "id": resp.Status,
                    "message": req.http_method + " " + req.request_url + ": failed to decode JSON",
                  },
                },
                "want_more": false,
              }
            :
              {
                "names": (size(body.?resultSetMetaData.rowType.orValue([])) > 0) ?
                  body.resultSetMetaData.rowType.map(column, column.name)
                :
                  state.?cursor.row_type.orValue([]),
                "rows": body.?data.orValue([]),
                "partition_count": (size(body.?resultSetMetaData.partitionInfo.orValue([])) > 0) ?
                  size(body.resultSetMetaData.partitionInfo)
                :
                  int(state.?cursor.partition_count.orValue(0)),
                "num_rows": int(body.?resultSetMetaData.numRows.orValue(state.?cursor.num_rows.orValue(0))),
                "handle": string(body.?statementHandle.orValue(state.?cursor.handle.orValue(""))),
              }.as(result,
                result.rows.map(row, result.names.zip(row)).map(record,
                  (req.query == "deleted") ?
                    ((record.?DELETED_ON.orValue(null) == null) ? "" : string(record.DELETED_ON))
                  : (record.?CREATED_ON.orValue(null) == null) ? "" : string(record.CREATED_ON)
                ).filter(timestamp, timestamp != "").as(row_timestamps,
                  {
                    "events": (size(result.rows) > 0) ?
                      dyn(result.rows.map(row, {"message": result.names.zip(row).encode_json()}))
                    : (
                      int(state.?cursor.next_partition.orValue(0)) + 1 < result.partition_count ||
                      req.query == "created" || req.query == "deleted" && result.num_rows >= int(state.batch_size)
                    ) ?
                      dyn([{"retry": true}])
                    :
                      dyn([]),
                    "cursor": {
                      "last_created_on": (req.query == "created" && size(row_timestamps) > 0) ?
                        (
                          (state.?cursor.last_created_on.orValue("") != "") ?
                            (row_timestamps + [state.cursor.last_created_on]).max()
                          :
                            row_timestamps.max()
                        )
                      :
                        state.?cursor.last_created_on.orValue(""),
                      "last_deleted_on": (req.query == "deleted" && size(row_timestamps) > 0) ?
                        (
                          (state.?cursor.last_deleted_on.orValue("") != "") ?
                            (row_timestamps + [state.cursor.last_deleted_on]).max()
                          :
                            row_timestamps.max()
                        )
                      :
                        state.?cursor.last_deleted_on.orValue(""),
                      // After a created page, continue created when LIMIT is full; otherwise run deleted.
                      "query": (int(state.?cursor.next_partition.orValue(0)) + 1 < result.partition_count) ?
                        req.query
                      : (req.query == "created" && result.num_rows >= int(state.batch_size)) ?
                        "created"
                      : (req.query == "created") ?
                        "deleted"
                      : (req.query == "deleted" && result.num_rows >= int(state.batch_size)) ?
                        "deleted"
                      :
                        "created",
                      "continue": result.num_rows >= int(state.batch_size),
                    }.with(
                      (int(state.?cursor.next_partition.orValue(0)) + 1 < result.partition_count) ?
                        {
                          "handle": result.handle,
                          "next_partition": int(state.?cursor.next_partition.orValue(0)) + 1,
                          "row_type": result.names,
                          "partition_count": result.partition_count,
                          "num_rows": result.num_rows,
                        }
                      :
                        {}
                    ),
                    // want_more: remaining partitions, another created page, or the deleted statement
                    "want_more": int(state.?cursor.next_partition.orValue(0)) + 1 < result.partition_count ||
                    req.query == "created" || req.query == "deleted" && result.num_rows >= int(state.batch_size),
                  }
                )
              )
          )
        :
          {
            "events": (resp.StatusCode == 429 || resp.StatusCode >= 500) ?
              dyn(
                {
                  "error": {
                    "code": string(resp.StatusCode),
                    "id": resp.Status,
                    "message": req.http_method + " " + req.request_url + ": " + (
                      (size(resp.Body) != 0) ?
                        string(resp.Body)
                      :
                        resp.Status + " (" + string(resp.StatusCode) + ")"
                    ),
                  },
                }
              )
            :
              dyn(
                [
                  {
                    "error": {
                      "code": string(resp.StatusCode),
                      "id": resp.Status,
                      "message": req.http_method + " " + req.request_url + ": " + (
                        (size(resp.Body) != 0) ?
                          string(resp.Body)
                        :
                          resp.Status + " (" + string(resp.StatusCode) + ")"
                      ),
                    },
                  },
                ]
              ),
            "want_more": false,
          }
      )
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
processors:
- drop_event.when.equals.retry: true
{{#if processors}}
{{processors}}
{{/if}}
