interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
{{#if resource_retry_max_attempts}}
resource.retry.max_attempts: {{resource_retry_max_attempts}}
{{/if}}
{{#if resource_retry_wait_min}}
resource.retry.wait_min: {{resource_retry_wait_min}}
{{/if}}
{{#if resource_retry_wait_max}}
resource.retry.wait_max: {{resource_retry_wait_max}}
{{/if}}
resource.rate_limit.limit: 1
resource.rate_limit.burst: 1
resource.url: {{url}}
resource.headers:
  Accept:
    - application/json
  Content-Type:
    - application/json
  User-Agent:
    - elastic-snowflake/1.0
state:
  token: {{token}}
  role: {{role}}
  warehouse: {{warehouse}}
  batch_size: {{batch_size}}
  initial_interval: {{initial_interval}}
  lag_time: {{lag_time}}
  want_more: false
redact:
  fields:
    - token
program: |-
  state.?cursor.query.orValue("created").as(query,
    ((state.?want_more.orValue(false) && string(state.?cursor.handle.orValue("")) != "") ? "GET" : "POST").as(
      http_method,
      (
        (http_method == "GET") ?
          (
            (int(state.?cursor.next_partition.orValue(0)) > 0) ?
              (
                state.url.trim_right("/") + "/api/v2/statements/" + string(state.cursor.handle) + "?" + {
                  "partition": [string(int(state.cursor.next_partition))],
                }.format_query()
              )
            :
              state.url.trim_right("/") + "/api/v2/statements/" + string(state.cursor.handle)
          )
        :
          state.url.trim_right("/") + "/api/v2/statements?" + {
            "async": ["true"],
            "requestId": [uuid()],
          }.format_query()
      ).as(request_url,
        state.with(
          request(
            http_method,
            request_url
          ).with(
            {
              "Header": {
                "Authorization": ["Bearer " + state.token],
                "X-Snowflake-Authorization-Token-Type": ["PROGRAMMATIC_ACCESS_TOKEN"],
                "Accept": ["application/json"],
                "Content-Type": ["application/json"],
              },
              ?"Body": (http_method == "POST") ?
                optional.of(
                  {
                    "statement": (query == "deleted") ?
                      ("SELECT * FROM SNOWFLAKE.ACCOUNT_USAGE.GRANTS_TO_USERS " + "WHERE DELETED_ON IS NOT NULL AND DELETED_ON > ? " + "ORDER BY DELETED_ON ASC, GRANTEE_NAME ASC, ROLE ASC " + "LIMIT " + string(state.batch_size))
                    :
                      "SELECT * FROM SNOWFLAKE.ACCOUNT_USAGE.GRANTS_TO_USERS " + "WHERE CREATED_ON > ? " + "ORDER BY CREATED_ON ASC, GRANTEE_NAME ASC, ROLE ASC " + "LIMIT " + string(state.batch_size),
                    "warehouse": state.warehouse,
                    "role": state.role,
                    "bindings": {
                      "1": {
                        "type": "TEXT",
                        "value": (query == "deleted") ?
                          (
                            (state.?cursor.last_deleted_on.orValue("") != "") ?
                              (state.cursor.last_deleted_on.parse_time("2006-01-02 15:04:05.000 -0700") - duration(state.lag_time)).format("2006-01-02 15:04:05.000 -0700")
                            :
                              (now - duration(state.initial_interval)).format("2006-01-02 15:04:05.000 -0700")
                          )
                        : (state.?cursor.last_created_on.orValue("") != "") ?
                          (state.cursor.last_created_on.parse_time("2006-01-02 15:04:05.000 -0700") - duration(state.lag_time)).format("2006-01-02 15:04:05.000 -0700")
                        :
                          (now - duration(state.initial_interval)).format("2006-01-02 15:04:05.000 -0700"),
                      },
                    },
                    "parameters": {
                      "TIMESTAMP_LTZ_OUTPUT_FORMAT": "YYYY-MM-DD HH24:MI:SS.FF3 TZHTZM",
                    },
                  }.encode_json()
                )
              :
                optional.none(),
            }
          ).do_request().as(resp,
            (resp.StatusCode == 202) ?
              try(resp.Body.decode_json()).as(body,
                (is_error(body) || string(body.?statementHandle.orValue("")) == "") ?
                  {
                    "events": {
                      "error": {
                        "code": string(resp.StatusCode),
                        "id": resp.Status,
                        "message": http_method + " " + request_url + ": HTTP 202 without statementHandle",
                      },
                    },
                    "want_more": false,
                  }
                :
                  {
                    "events": [{"retry": true}],
                    "cursor": {
                      ?"last_created_on": (state.?cursor.last_created_on.orValue("") != "") ? optional.of(string(state.cursor.last_created_on)) : optional.none(),
                      ?"last_deleted_on": (state.?cursor.last_deleted_on.orValue("") != "") ? optional.of(string(state.cursor.last_deleted_on)) : optional.none(),
                      "query": query,
                      "handle": string(body.statementHandle),
                      "next_partition": 0,
                    },
                    "want_more": true,
                  }
              )
            : (resp.StatusCode == 200) ?
              try(resp.Body.decode_json()).as(body,
                is_error(body) ?
                  {
                    "events": {
                      "error": {
                        "code": string(resp.StatusCode),
                        "id": resp.Status,
                        "message": http_method + " " + request_url + ": failed to decode JSON",
                      },
                    },
                    "want_more": false,
                  }
                :
                  {
                    "names": (size(body.?resultSetMetaData.rowType.orValue([])) > 0) ?
                      body.resultSetMetaData.rowType.map(column, column.name)
                    :
                      state.?cursor.row_type.orValue([]),
                    "rows": body.?data.orValue([]),
                    "partition_count": (size(body.?resultSetMetaData.partitionInfo.orValue([])) > 0) ?
                      size(body.resultSetMetaData.partitionInfo)
                    :
                      int(state.?cursor.partition_count.orValue(0)),
                    "num_rows": int(body.?resultSetMetaData.numRows.orValue(state.?cursor.num_rows.orValue(0))),
                    "handle": string(body.?statementHandle.orValue(string(state.?cursor.handle.orValue("")))),
                  }.as(result,
                    result.rows.map(row, result.names.zip(row)).map(record,
                      (query == "deleted") ?
                        ((record.?DELETED_ON.orValue(null) == null) ? "" : string(record.DELETED_ON))
                      : (record.?CREATED_ON.orValue(null) == null) ? "" : string(record.CREATED_ON)
                    ).filter(timestamp, timestamp != "").as(row_timestamps,
                      {
                        "events": (size(result.rows) > 0) ?
                          dyn(result.rows.map(row, {"message": result.names.zip(row).encode_json()}))
                        : (
                          int(state.?cursor.next_partition.orValue(0)) + 1 < result.partition_count ||
                          query == "created" || query == "deleted" && int(result.num_rows) >= int(state.batch_size)
                        ) ?
                          dyn([{"retry": true}])
                        :
                          dyn([]),
                        "cursor": {
                          "last_created_on": (query == "created" && size(row_timestamps) > 0) ?
                            (
                              (state.?cursor.last_created_on.orValue("") != "") ?
                                (row_timestamps + [string(state.cursor.last_created_on)]).max()
                              :
                                row_timestamps.max()
                            )
                          :
                            state.?cursor.last_created_on.orValue(""),
                          "last_deleted_on": (query == "deleted" && size(row_timestamps) > 0) ?
                            (
                              (state.?cursor.last_deleted_on.orValue("") != "") ?
                                (row_timestamps + [string(state.cursor.last_deleted_on)]).max()
                              :
                                row_timestamps.max()
                            )
                          :
                            state.?cursor.last_deleted_on.orValue(""),
                          // After a created page, continue created when LIMIT is full; otherwise run deleted.
                          "query": (int(state.?cursor.next_partition.orValue(0)) + 1 < result.partition_count) ?
                            query
                          : (query == "created" && int(result.num_rows) >= int(state.batch_size)) ?
                            "created"
                          : (query == "created") ?
                            "deleted"
                          : (query == "deleted" && int(result.num_rows) >= int(state.batch_size)) ?
                            "deleted"
                          :
                            "created",
                        }.with(
                          (int(state.?cursor.next_partition.orValue(0)) + 1 < result.partition_count) ?
                            {
                              "handle": result.handle,
                              "next_partition": int(state.?cursor.next_partition.orValue(0)) + 1,
                              "row_type": result.names,
                              "partition_count": result.partition_count,
                              "num_rows": result.num_rows,
                            }
                          :
                            {}
                        ),
                        // want_more: remaining partitions, another created page, or the deleted statement
                        "want_more": int(state.?cursor.next_partition.orValue(0)) + 1 < result.partition_count ||
                        query == "created" || query == "deleted" && int(result.num_rows) >= int(state.batch_size),
                      }
                    )
                  )
              )
            :
              {
                "events": (resp.StatusCode == 429 || resp.StatusCode >= 500) ?
                  dyn(
                    {
                      "error": {
                        "code": string(resp.StatusCode),
                        "id": resp.Status,
                        "message": http_method + " " + request_url + ": " + (
                          (size(resp.Body) != 0) ?
                            string(resp.Body)
                          :
                            resp.Status + " (" + string(resp.StatusCode) + ")"
                        ),
                      },
                    }
                  )
                :
                  dyn(
                    [
                      {
                        "error": {
                          "code": string(resp.StatusCode),
                          "id": resp.Status,
                          "message": http_method + " " + request_url + ": " + (
                            (size(resp.Body) != 0) ?
                              string(resp.Body)
                            :
                              resp.Status + " (" + string(resp.StatusCode) + ")"
                          ),
                        },
                      },
                    ]
                  ),
                "want_more": false,
              }
          )
        )
      )
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
processors:
- drop_event.when.equals.retry: true
{{#if processors}}
{{processors}}
{{/if}}
