interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
{{#if resource_retry_max_attempts}}
resource.retry.max_attempts: {{resource_retry_max_attempts}}
{{/if}}
{{#if resource_retry_wait_min}}
resource.retry.wait_min: {{resource_retry_wait_min}}
{{/if}}
{{#if resource_retry_wait_max}}
resource.retry.wait_max: {{resource_retry_wait_max}}
{{/if}}
resource.url: {{url}}
state:
  token: {{token}}
  role: {{role}}
  warehouse: {{warehouse}}
  batch_size: {{batch_size}}
  initial_interval: {{initial_interval}}
  lag_time: {{lag_time}}
  user_agent: Elastic-Snowflake/{{#if _meta.package.version}}{{_meta.package.version}}{{else}}unknown{{/if}}
  want_more: false
redact:
  fields:
    - token
program: |-
  {
    "http_method": (state.?want_more.orValue(false) && state.?cursor.handle.orValue("") != "") ? "GET" : "POST",
    "request_url": (state.?want_more.orValue(false) && state.?cursor.handle.orValue("") != "") ?
      (
        (int(state.?cursor.next_partition.orValue(0)) > 0) ?
          (
            state.url.trim_right("/") + "/api/v2/statements/" + state.cursor.handle + "?" + {
              "partition": [string(int(state.cursor.next_partition))],
            }.format_query()
          )
        :
          state.url.trim_right("/") + "/api/v2/statements/" + state.cursor.handle
      )
    :
      state.url.trim_right("/") + "/api/v2/statements?" + {
        "requestId": [uuid()],
      }.format_query(),
    "since": (
      (state.?cursor.last_timestamp.orValue("") != "") ?
        (
          state.?cursor.catching_up.orValue(false) ?
            string(state.cursor.last_timestamp)
          :
            (string(state.cursor.last_timestamp).parse_time("2006-01-02 15:04:05.000 Z0700") - duration(state.lag_time)).format("2006-01-02 15:04:05.000 -0700")
        )
      :
        (now - duration(state.initial_interval)).format("2006-01-02 15:04:05.000 -0700")
    ),
    "catching_up": state.?cursor.catching_up.orValue(false) && state.?cursor.after_ts.orValue("") != "",
  }.as(req,
    state.with(
      request(
        req.http_method,
        req.request_url
      ).with(
        {
          "Header": {
            "Authorization": ["Bearer " + state.token],
            "X-Snowflake-Authorization-Token-Type": ["PROGRAMMATIC_ACCESS_TOKEN"],
            "Accept": ["application/json"],
            "Content-Type": ["application/json"],
            "User-Agent": [state.user_agent],
          },
          ?"Body": (req.http_method == "POST") ?
            optional.of(
              (
                req.catching_up ?
                  {
                    "statement": "SELECT * FROM SNOWFLAKE.ACCOUNT_USAGE.DATA_TRANSFER_HISTORY WHERE (START_TIME, COALESCE(SOURCE_CLOUD, ''), COALESCE(SOURCE_REGION, ''), COALESCE(TARGET_CLOUD, ''), COALESCE(TARGET_REGION, ''), COALESCE(TRANSFER_TYPE, '')) > (?, ?, ?, ?, ?, ?) ORDER BY START_TIME ASC, COALESCE(SOURCE_CLOUD, '') ASC, COALESCE(SOURCE_REGION, '') ASC, COALESCE(TARGET_CLOUD, '') ASC, COALESCE(TARGET_REGION, '') ASC, COALESCE(TRANSFER_TYPE, '') ASC LIMIT " + string(state.batch_size),
                    "warehouse": state.warehouse,
                    "role": state.role,
                    "bindings": {
                      "1": {
                        "type": "TEXT",
                        "value": string(state.cursor.after_ts),
                      },
                      "2": {
                        "type": "TEXT",
                        "value": string(state.?cursor.after_source_cloud.orValue("")),
                      },
                      "3": {
                        "type": "TEXT",
                        "value": string(state.?cursor.after_source_region.orValue("")),
                      },
                      "4": {
                        "type": "TEXT",
                        "value": string(state.?cursor.after_target_cloud.orValue("")),
                      },
                      "5": {
                        "type": "TEXT",
                        "value": string(state.?cursor.after_target_region.orValue("")),
                      },
                      "6": {
                        "type": "TEXT",
                        "value": string(state.?cursor.after_transfer_type.orValue("")),
                      },
                    },
                    "parameters": {
                      "TIMESTAMP_LTZ_OUTPUT_FORMAT": "YYYY-MM-DD HH24:MI:SS.FF3 TZHTZM",
                    },
                  }
                :
                  {
                    "statement": "SELECT * FROM SNOWFLAKE.ACCOUNT_USAGE.DATA_TRANSFER_HISTORY WHERE START_TIME > ? ORDER BY START_TIME ASC, COALESCE(SOURCE_CLOUD, '') ASC, COALESCE(SOURCE_REGION, '') ASC, COALESCE(TARGET_CLOUD, '') ASC, COALESCE(TARGET_REGION, '') ASC, COALESCE(TRANSFER_TYPE, '') ASC LIMIT " + string(state.batch_size),
                    "warehouse": state.warehouse,
                    "role": state.role,
                    "bindings": {
                      "1": {
                        "type": "TEXT",
                        "value": req.since,
                      },
                    },
                    "parameters": {
                      "TIMESTAMP_LTZ_OUTPUT_FORMAT": "YYYY-MM-DD HH24:MI:SS.FF3 TZHTZM",
                    },
                  }
              ).encode_json()
            )
          :
            optional.none(),
        }
      ).do_request().as(resp,
        (resp.StatusCode == 202) ?
          resp.Body.decode_json().as(body,
            (is_error(body) || string(body.?statementHandle.orValue("")) == "") ?
              {
                "events": {
                  "error": {
                    "code": string(resp.StatusCode),
                    "id": resp.Status,
                    "message": req.http_method + " " + req.request_url + ": HTTP 202 without statementHandle",
                  },
                },
                "want_more": false,
              }
            :
              {
                "events": [{"retry": true}],
                "cursor": {
                  ?"last_timestamp": (state.?cursor.last_timestamp.orValue("") != "") ? optional.of(state.cursor.last_timestamp) : optional.none(),
                  "handle": string(body.statementHandle),
                  "next_partition": 0,
                },
                "want_more": true,
              }
          )
        : (resp.StatusCode == 200) ?
          resp.Body.decode_json().as(body,
            is_error(body) ?
              {
                "events": {
                  "error": {
                    "code": string(resp.StatusCode),
                    "id": resp.Status,
                    "message": req.http_method + " " + req.request_url + ": failed to decode JSON",
                  },
                },
                "want_more": false,
              }
            :
              {
                "names": (size(body.?resultSetMetaData.rowType.orValue([])) > 0) ?
                  body.resultSetMetaData.rowType.map(column, column.name)
                :
                  state.?cursor.row_type.orValue([]),
                "rows": body.?data.orValue([]),
                "partition_count": (size(body.?resultSetMetaData.partitionInfo.orValue([])) > 0) ?
                  size(body.resultSetMetaData.partitionInfo)
                :
                  int(state.?cursor.partition_count.orValue(0)),
                "handle": string(body.?statementHandle.orValue(state.?cursor.handle.orValue(""))),
                "filled_batch": (size(body.?resultSetMetaData.rowType.orValue([])) > 0) ?
                  int(body.resultSetMetaData.?numRows.orValue(0)) >= int(state.batch_size)
                :
                  state.?cursor.filled_batch.orValue(false),
              }.as(result,
                result.rows.map(row, result.names.zip(row)).as(records,
                  records.map(record, record.?START_TIME.orValue(null) != null,
                    string(record.START_TIME)
                  ).as(row_timestamps,
                  {
                    "events": (size(result.rows) > 0) ?
                      dyn(result.rows.map(row, {"message": result.names.zip(row).encode_json()}))
                    : (int(state.?cursor.next_partition.orValue(0)) + 1 < result.partition_count) ?
                      dyn([{"retry": true}])
                    :
                      dyn([]),
                    "cursor": {
                      "last_timestamp": (size(row_timestamps) > 0) ?
                        (
                          (state.?cursor.last_timestamp.orValue("") != "") ?
                            (row_timestamps.map(timestamp,
                              timestamp.parse_time("2006-01-02 15:04:05.000 Z0700").format("2006-01-02 15:04:05.000 -0700")
                            ) + [state.cursor.last_timestamp]).max()
                          :
                            row_timestamps.map(timestamp,
                              timestamp.parse_time("2006-01-02 15:04:05.000 Z0700").format("2006-01-02 15:04:05.000 -0700")
                            ).max()
                        )
                      :
                        state.?cursor.last_timestamp.orValue(""),
                    }.with(
                      (size(records) > 0 && records[int(size(records)) - 1].?START_TIME.orValue(null) != null) ?
                        records[int(size(records)) - 1].as(last,
                          {
                            "after_ts": string(last.START_TIME).parse_time("2006-01-02 15:04:05.000 Z0700").format("2006-01-02 15:04:05.000 -0700"),
                            "after_source_cloud": (last.?SOURCE_CLOUD.orValue(null) != null) ? string(last.SOURCE_CLOUD) : "",
                            "after_source_region": (last.?SOURCE_REGION.orValue(null) != null) ? string(last.SOURCE_REGION) : "",
                            "after_target_cloud": (last.?TARGET_CLOUD.orValue(null) != null) ? string(last.TARGET_CLOUD) : "",
                            "after_target_region": (last.?TARGET_REGION.orValue(null) != null) ? string(last.TARGET_REGION) : "",
                            "after_transfer_type": (last.?TRANSFER_TYPE.orValue(null) != null) ? string(last.TRANSFER_TYPE) : "",
                          }
                        )
                      :
                        {
                          ?"after_ts": (state.?cursor.after_ts.orValue("") != "") ? optional.of(string(state.cursor.after_ts)) : optional.none(),
                          ?"after_source_cloud": (state.?cursor.after_source_cloud.orValue("") != "") ? optional.of(string(state.cursor.after_source_cloud)) : optional.none(),
                          ?"after_source_region": (state.?cursor.after_source_region.orValue("") != "") ? optional.of(string(state.cursor.after_source_region)) : optional.none(),
                          ?"after_target_cloud": (state.?cursor.after_target_cloud.orValue("") != "") ? optional.of(string(state.cursor.after_target_cloud)) : optional.none(),
                          ?"after_target_region": (state.?cursor.after_target_region.orValue("") != "") ? optional.of(string(state.cursor.after_target_region)) : optional.none(),
                          ?"after_transfer_type": (state.?cursor.after_transfer_type.orValue("") != "") ? optional.of(string(state.cursor.after_transfer_type)) : optional.none(),
                        }
                    ).with(
                      (int(state.?cursor.next_partition.orValue(0)) + 1 < result.partition_count) ?
                        {
                          "handle": result.handle,
                          "next_partition": int(state.?cursor.next_partition.orValue(0)) + 1,
                          "row_type": result.names,
                          "partition_count": result.partition_count,
                          "filled_batch": result.filled_batch,
                        }
                      :
                        {
                          "catching_up": result.filled_batch,
                        }
                    ),
                    "want_more": int(state.?cursor.next_partition.orValue(0)) + 1 < result.partition_count || result.filled_batch,
                  }
                )
                )
              )
          )
        :
          {
            "events": (
              {
                "error": {
                  "code": string(resp.StatusCode),
                  "id": resp.Status,
                  "message": req.http_method + " " + req.request_url + ": " + (
                    (size(resp.Body) != 0) ?
                      string(resp.Body)
                    :
                      resp.Status + " (" + string(resp.StatusCode) + ")"
                  ),
                },
              }.as(err, (resp.StatusCode == 429 || resp.StatusCode >= 500) ?
                dyn(err)
              :
                dyn([err])
              )
            ),
            "want_more": false,
          }
      )
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
processors:
- drop_event.when.equals.retry: true
{{#if processors}}
{{processors}}
{{/if}}
