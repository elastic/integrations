processors:
  transform/parse_nginx_access:
    error_mode: ignore
    log_statements:
      - context: log
        conditions:
          - IsMatch(body, "^\\S+ - .+ \\[.+\\] \".+\" \\d+ \\d+ \".+\" \".+\"")
        statements:
          - set(cache, ExtractGrokPatterns(body, "%{IPORHOST:source.address} - (-|%{DATA:user.name}) \\[%{HTTPDATE:nginx.access.time}\\] \"%{WORD:http.request.method} %{DATA:url.original} HTTP/%{NUMBER:http.version}\" %{NUMBER:http.response.status_code:long} %{NUMBER:http.response.body.size:long} \"(-|%{DATA:http.request.referrer})\" \"(-|%{DATA:user_agent.original})\"", true))
          - set(event_name, "nginx.access")
          - set(time, Time(cache["nginx.access.time"], "%d/%b/%Y:%H:%M:%S %z"))
          - delete_key(cache, "nginx.access.time")
          - set(attributes["http.response.status_code"], cache["http.response.status_code"])
          - set(attributes["http.request.method"], cache["http.request.method"])
          - set(attributes["url.original"], cache["url.original"])
          - set(attributes["url.path"], Split(cache["url.original"], "?")[0]) where cache["url.original"] != nil
          - set(attributes["url.query"], Split(cache["url.original"], "?")[1]) where cache["url.original"] != nil and Len(Split(cache["url.original"], "?")) > 1
          - set(attributes["source.address"], cache["source.address"])
          - set(attributes["client.address"], cache["source.address"])
          - set(attributes["http.response.body.size"], cache["http.response.body.size"])
          - set(attributes["network.protocol.name"], "http")
          - set(attributes["network.protocol.version"], cache["http.version"])
          - set(attributes["user_agent.original"], cache["user_agent.original"])
          - set(attributes["user.name"], cache["user.name"]) where cache["user.name"] != nil and cache["user.name"] != "-"
          - set(attributes["http.request.header.referer"], [cache["http.request.referrer"]]) where cache["http.request.referrer"] != nil and cache["http.request.referrer"] != "-"
          - merge_maps(cache, UserAgent(cache["user_agent.original"]), "upsert") where cache["user_agent.original"] != nil
          - set(attributes["user_agent.name"], cache["user_agent.name"]) where cache["user_agent.name"] != nil
          - set(attributes["user_agent.version"], cache["user_agent.version"]) where cache["user_agent.version"] != nil
          - set(attributes["user_agent.os.name"], cache["os.name"]) where cache["os.name"] != nil
          - set(attributes["user_agent.os.version"], cache["os.version"]) where cache["os.version"] != nil
  resourcedetection/system:
    detectors: ["system"]
    system:
      hostname_sources: ["os"]
service:
  pipelines:
    logs:
      processors:
        - transform/parse_nginx_access
        - resourcedetection/system
