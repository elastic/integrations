metricsets: ["collector"]
hosts:
{{#each hosts}}
  - {{this}}
{{/each}}
metrics_path: {{metrics_path}}
period: {{period}}
use_types: true
rate_counters: false
metrics_filters.include:
{{#each metrics_filters.include}}
  - {{this}}
{{/each}}
{{#if bearer_token_file}}
bearer_token_file: {{bearer_token_file}}
{{/if}}
{{#if ssl}}
ssl:
  {{ssl}}
{{/if}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
