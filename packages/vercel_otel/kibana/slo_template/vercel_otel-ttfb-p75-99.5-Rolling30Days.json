{
    "attributes": {
        "name": "[Vercel OTel] Time to first byte p75 99.5% rolling 30 days",
        "description": "Tracks the 75th-percentile Time to First Byte (TTFB) reported by Speed Insights for production page loads, targeting 99.5% of hourly windows with a p75 TTFB under 800ms (Vercel's 'good' threshold) over a rolling 30-day window. A breach signals cold starts, edge congestion, or regional capacity issues are slowing the server/edge response before rendering can begin \u2014 a leading indicator that also drives downstream Largest Contentful Paint regressions.",
        "indicator": {
            "type": "sli.metric.timeslice",
            "params": {
                "index": "metrics-*",
                "filter": "data_stream.dataset: \"vercel.speedinsights.v1.otel\" and deployment.environment.name: \"production\" and metrics.TTFB: *",
                "metric": {
                    "metrics": [
                        {
                            "name": "A",
                            "aggregation": "percentile",
                            "field": "metrics.TTFB",
                            "percentile": 75
                        }
                    ],
                    "equation": "A",
                    "comparator": "LT",
                    "threshold": 800
                },
                "timestampField": "@timestamp"
            }
        },
        "budgetingMethod": "timeslices",
        "timeWindow": {
            "duration": "30d",
            "type": "rolling"
        },
        "objective": {
            "target": 0.995,
            "timesliceTarget": 0.95,
            "timesliceWindow": "1h"
        },
        "tags": [
            "vercel",
            "otel"
        ],
        "groupBy": [
            "vercel.project.id"
        ],
        "artifacts": {
            "dashboards": [
                {
                    "id": "vercel_otel-speed-insights"
                }
            ]
        }
    },
    "id": "vercel_otel-ttfb-p75-99.5-Rolling30Days",
    "type": "slo_template"
}
