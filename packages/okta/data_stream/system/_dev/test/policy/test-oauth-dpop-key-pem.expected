inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: okta
      name: test-oauth-dpop-key-pem-okta
      streams:
        - auth.oauth2.client.id: client-id
          auth.oauth2.okta.dpop_key_pem: ${SECRET_1}
          auth.oauth2.okta.jwk_json: ${SECRET_0}
          auth.oauth2.provider: okta
          auth.oauth2.scopes:
            - okta.logs.read
          auth.oauth2.token_url: https://trial-xxxxxxx.okta.com/oauth2/v1/token
          config_version: "2"
          cursor:
            published:
                value: '[[.last_event.published]]'
          data_stream:
            dataset: okta.system
          fields:
            _conf:
                remove_flattened_debug: null
          fields_under_root: true
          interval: 60s
          processors:
            - add_fields:
                fields:
                    okta_url: https://trial-xxxxxxx.okta.com/api/v1/logs
                target: ""
          publisher_pipeline.disable_host: true
          request.keep_alive.disable: false
          request.method: GET
          request.rate_limit:
            limit: '[[.last_response.header.Get "X-Rate-Limit-Limit"]]'
            remaining: '[[.last_response.header.Get "X-Rate-Limit-Remaining"]]'
            reset: '[[.last_response.header.Get "X-Rate-Limit-Reset"]]'
          request.tracer:
            enabled: false
            filename: ../../logs/httpjson/http-request-trace-*.ndjson
            maxbackups: 5
          request.transforms:
            - set:
                target: url.params.limit
                value: "1000"
            - set:
                default: '[[formatDate (now (parseDuration "-24h")) "RFC3339"]]'
                target: url.params.since
                value: '[[.cursor.published]]'
          request.url: https://trial-xxxxxxx.okta.com/api/v1/logs
          response.pagination:
            - set:
                do_not_log_failure: true
                fail_on_template_error: true
                target: url.value
                value: '[[ if (ge (len .last_response.body) 1000) ]][[ getRFC5988Link "next" .last_response.header.Link ]][[end]]'
          tags:
            - forwarded
            - okta-system
      type: httpjson
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-okta.system-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references:
    - {}
    - {}
