{{#if condition }}
condition: ${host.platform} == 'linux' and ({{ condition }})
{{ else }}
condition: ${host.platform} == 'linux'
{{/if}}

{{#if paths}}
paths:
{{#each paths as |path i|}}
  - {{path}}
{{/each}}
{{/if}}

{{#if seek}}
seek: {{seek}}
{{/if}}

{{#if since}}
since: {{since}}
{{/if}}

{{#if units}}
units:
{{#each units as |unit i|}}
  - {{unit}}
{{/each}}
{{/if}}

{{#if syslog_identifiers}}
syslog_identifiers:
{{#each syslog_identifiers as |si i|}}
  - {{si}}
{{/each}}
{{/if}}

{{#if transports}}
transports:
{{#each transports as |transport i|}}
  - {{transport}}
{{/each}}
{{/if}}

{{#if facilities}}
facilities:
{{#each facilities as |facility i|}}
  - {{facility}}
{{/each}}
{{/if}}

{{#if merge}}
merge: {{merge}}
{{/if}}

{{#if include_matches}}
include_matches:
{{#each include_matches as |include_match i|}}
  - '{{include_match}}'
{{/each}}
{{/if}}

{{#if chroot}}
chroot: {{chroot}}
{{/if}}

{{#if journalctl_path}}
journalctl_path: {{journalctl_path}}
{{/if}}

tags:
{{#each tags as |tag i|}}
  - {{tag}}
{{/each}}

{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}

processors:
# Align journald input fields to ECS.
- convert:
    tag: journald-to-ecs
    mode: rename
    ignore_missing: true
    fields:
      - from: message_id
        to: event.code
      - from: journald.code.file
        to: log.origin.file.name
      - from: journald.code.line
        to: log.origin.file.line
      - from: journald.code.func
        to: log.origin.function
      - from: syslog.pid
        to: log.syslog.procid
      - from: syslog.identifier
        to: log.syslog.appname
- drop_fields:
    ignore_missing: true
    fields:
      - syslog
      - container.id_truncated
{{#if processors}}
{{processors}}
{{/if}}

{{#if parsers}}
parsers:
{{parsers}}
{{/if}}

data_stream:
  dataset: {{data_stream.dataset}}
