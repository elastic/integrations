paths:
{{#each paths as |path|}}
  - {{path}}
{{/each}}
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
allow_deprecated_use: true
processors:
- add_locale: ~
- add_fields:
    target: _tmp
    fields:
      tz_offset: "{{tz_offset}}"
{{#if internal_networks.length}}
      internal_networks:
{{#each internal_networks as |network|}}
        - {{network}}
{{/each}}
{{/if}}
{{#if processors}}
{{processors}}
{{/if}}
