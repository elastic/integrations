metricsets: ["query"]
period: {{period}}
hosts:
{{#each hosts}}
{{#if ../username}}
  - '{{../username}}{{#if ../password}}:{{../password}}{{/if}}@{{this}}'
{{else}}
  - {{escape_string this}}
{{/if}}
{{/each}}
tags:
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
{{#if ssl}}
{{ssl}}
{{/if}}
{{#if condition}}
condition: {{ condition }}
{{/if}}
driver: "mysql"
sql_queries:
  - query: {{replication_status_query}}
    response_format: "table"