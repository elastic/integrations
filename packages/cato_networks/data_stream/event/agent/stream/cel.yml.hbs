config_version: 2
interval: {{interval}}
{{#if max_executions}}
max_executions: {{max_executions}}
{{/if}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: {{url}}
resource.rate_limit.burst: {{resource_rate_limit_burst}}
resource.rate_limit.limit: {{resource_rate_limit_limit}}
state:
  account_ids:
  {{#each account_ids as |account_id|}}
    - !!str {{account_id}}
  {{/each}}
  api_key: {{api_key}}
  {{!--
    max_page_limit: 3000 — Cato EventsFeed returns at most 3000 records per filtered feed.
    want_more is true when any partition returns a full page, indicating more data may be available.
  --}}
  max_page_limit: 3000
  query: >-
    query EventsFeed(
      $accountIDs: [ID!]
      $internetFirewallMarker: String
      $wanFirewallMarker: String
      $otherMarker: String
    ) {
      internetFirewall: eventsFeed(
        accountIDs: $accountIDs
        marker: $internetFirewallMarker
        filters: [{fieldName: event_sub_type operator: in values: ["Internet Firewall"]}]
      ) {
        fetchedCount
        marker
        accounts {
          errorString
          records {
            fieldsMap
          }
        }
      }
      wanFirewall: eventsFeed(
        accountIDs: $accountIDs
        marker: $wanFirewallMarker
        filters: [{fieldName: event_sub_type operator: in values: ["WAN Firewall"]}]
      ) {
        fetchedCount
        marker
        accounts {
          errorString
          records {
            fieldsMap
          }
        }
      }
      other: eventsFeed(
        accountIDs: $accountIDs
        marker: $otherMarker
        filters: [{fieldName: event_sub_type operator: not_in values: ["Internet Firewall", "WAN Firewall"]}]
      ) {
        fetchedCount
        marker
        accounts {
          errorString
          records {
            fieldsMap
          }
        }
      }
    }
redact:
  fields:
    - api_key
program: |-
  state.with(
    request(
      "POST",
      state.url.trim_right("/") + "/api/v1/graphql2"
    ).with(
      {
        "Header": {
          "Content-Type": ["application/json"],
          "x-api-key": [state.api_key],
        },
        "Body": {
          "query": state.query,
          "variables": {
            "accountIDs": state.account_ids,
            ?"internetFirewallMarker": state.?cursor.internet_firewall.or(state.?cursor.marker),
            ?"wanFirewallMarker": state.?cursor.wan_firewall.or(state.?cursor.marker),
            ?"otherMarker": state.?cursor.other.or(state.?cursor.marker),
          },
        }.encode_json(),
      }
    ).do_request().as(resp,
      (resp.StatusCode == 200) ?
        resp.Body.decode_json().as(body,
          (
            // In case of rate limiting or a wrong API key, StatusCode can be 200 and a feed can be null.
            body.?data.internetFirewall.orValue(null) != null && body.?data.wanFirewall.orValue(null) != null &&
            body.?data.other.orValue(null) != null
          ) ?
            [
              {"feed": body.data.internetFirewall},
              {"feed": body.data.wanFirewall},
              {"feed": body.data.other},
            ].as(feeds,
              {
                "account_errors": feeds.map(partition,
                  partition.feed.?accounts.orValue([]).map(account,
                    account.?errorString.orValue("") != "",
                    account.errorString
                  )
                ).flatten(),
                "events": feeds.map(partition,
                  partition.feed.?accounts.orValue([]).map(account,
                    (account.?records.orValue(null) != null) ?
                      account.records.map(record,
                        {
                          "message": record.fieldsMap.encode_json(),
                        }
                      )
                    :
                      []
                  ).flatten()
                ).flatten(),
              }.as(result,
                (size(result.account_errors) > 0) ?
                  {
                    "events": {
                      "error": {
                        "message": "POST " + state.url.trim_right("/") + "/api/v1/graphql2" + ": " + result.account_errors.join("; "),
                      },
                    },
                    "want_more": false,
                  }
                :
                  {
                    // Persist marker-only initialization responses by publishing an event that is dropped below.
                    "events": (size(result.events) > 0) ? result.events : [{"retry": true}],
                    "cursor": {
                      ?"internet_firewall": body.data.internetFirewall.?marker,
                      ?"wan_firewall": body.data.wanFirewall.?marker,
                      ?"other": body.data.other.?marker,
                    },
                    "want_more": feeds.exists(partition,
                      partition.feed.fetchedCount >= state.max_page_limit
                    ),
                  }
              )
            )
          :
            {
              "events": {
                "error": {
                  "message": "POST " + state.url.trim_right("/") + "/api/v1/graphql2" + ": " + (
                    (has(body.errors) && size(body.errors) > 0) ?
                      body.errors[0].message
                    :
                      "an eventsFeed partition returned null (possible rate limit or invalid API key)"
                  ),
                },
              },
              "want_more": false,
            }
        )
      :
        {
          "events": {
            "error": {
              "code": string(resp.StatusCode),
              "id": string(resp.Status),
              "message": "POST " + state.url.trim_right("/") + "/api/v1/graphql2" + ": " + (
                (size(resp.Body) != 0) ?
                  string(resp.Body)
                :
                  string(resp.Status) + " (" + string(resp.StatusCode) + ")"
              ),
            },
          },
          "want_more": false,
        }
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
processors:
- drop_event.when.equals.retry: true
{{#if processors}}
{{processors}}
{{/if}}
