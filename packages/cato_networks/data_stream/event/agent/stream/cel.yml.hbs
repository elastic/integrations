config_version: 2
interval: {{interval}}
{{#if max_executions}}
max_executions: {{max_executions}}
{{/if}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: {{url}}
resource.rate_limit.burst: {{resource_rate_limit_burst}}
resource.rate_limit.limit: {{resource_rate_limit_limit}}
state:
  account_ids:
  {{#each account_ids as |account_id|}}
    - !!str {{account_id}}
  {{/each}}
  api_key: {{api_key}}
  {{!--
    max_page_limit: 3000 — Cato EventsFeed API returns at most 3000 records per call.
    want_more is true when a full page is returned, indicating more data may be available.
    With filters, Cato scans the event queue until it finds matches or hits a search limit, so a
    page can be short while more events are pending. A short page still ends the cycle. For
    unfiltered requests Cato documents an empty marker when there are no new events (API
    changelog, 2025-04-27). For filtered requests it documents only that the marker is where the
    scan stopped, not how to tell that from the end of the queue, so the marker is not relied on.
  --}}
  max_page_limit: 3000
  query: >-
    query EventsFeed($accountIDs: [ID!] $marker: String $filters: [EventFeedFieldFilterInput!]) {
      eventsFeed(accountIDs: $accountIDs marker: $marker filters: $filters) {
        fetchedCount
        marker
        accounts {
          errorString
          records {
            fieldsMap
          }
        }
      }
    }
{{#if filters}}
state.filters: {{filters}}
{{/if}}
redact:
  fields:
    - api_key
program: |
  state.with(
    request(
      "POST",
      state.url.trim_right("/") + "/api/v1/graphql2"
    ).with(
      {
        "Header": {
          "Content-Type": ["application/json"],
          "x-api-key": [state.api_key],
        },
        "Body": {
          "query": state.query,
          "variables": {
            "accountIDs": state.account_ids,
            ?"marker": state.?cursor.marker,
            // filters is a list, or a single mapping that is wrapped into a list. Fleet parses the
            // YAML, so unquoted numbers and booleans in values are converted to the strings that
            // the API expects. The variable has no default, so state.filters is absent unless it is
            // set. A null, for example a value that only contains comments, sends no filters.
            ?"filters": (state.?filters.orValue(null) == null) ?
              optional.none()
            :
              optional.of(
                ((type(state.filters) == list) ? state.filters : [state.filters]).map(f,
                  f.?values.hasValue() ?
                    f.with({"values": ((type(f.values) == list) ? f.values : [f.values]).map(v, string(v))})
                  :
                    f
                )
              ),
          },
        }.encode_json(),
      }
    ).do_request().as(resp,
      (resp.StatusCode == 200) ?
        resp.Body.decode_json().as(body,
          // in case of rate limit and wrong API key, StatusCode will be 200 and eventsFeed will be null
          (body.?data.eventsFeed.orValue(null) != null) ?
            (body.data.eventsFeed.?accounts.orValue([]).filter(account, account.?errorString.orValue("") != "").map(account, account.errorString)).as(account_errors,
              (size(account_errors) > 0) ?
                {
                  "events": {
                    "error": {
                      "message": "POST " + state.url.trim_right("/") + "/api/v1/graphql2" + ": " + account_errors.join("; "),
                    },
                  },
                  "want_more": false,
                }
              :
                {
                  "events": (body.data.eventsFeed.?accounts.orValue(null) != null) ?
                    body.data.eventsFeed.accounts.map(account, (account.?records.orValue(null) != null) ?
                      account.records.map(record,
                        {
                          "message": record.fieldsMap.encode_json(),
                        }
                      )
                    :
                      []
                    ).flatten()
                  :
                    [],
                  "cursor": {
                    ?"marker": body.?data.eventsFeed.marker,
                  },
                  "want_more": body.data.eventsFeed.fetchedCount >= state.max_page_limit,
                }
            )
          :
            {
              "events": {
                "error": {
                  "message": "POST " + state.url.trim_right("/") + "/api/v1/graphql2" + ": " + (
                    (has(body.errors) && size(body.errors) > 0) ?
                      body.errors[0].message
                    :
                      "eventsFeed returned null (possible rate limit or invalid API key)"
                  ),
                },
              },
              "want_more": false,
            }
        )
      :
        {
          "events": {
            "error": {
              "code": string(resp.StatusCode),
              "id": string(resp.Status),
              "message": "POST " + state.url.trim_right("/") + "/api/v1/graphql2" + ": " + (
                (size(resp.Body) != 0) ?
                  string(resp.Body)
                :
                  string(resp.Status) + " (" + string(resp.StatusCode) + ")"
              ),
            },
          },
          "want_more": false,
        }
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
