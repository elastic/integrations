inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: criminalip
      name: test-tcp-synthetic-criminalip
      streams:
        - data_stream:
            dataset: criminalip.fortigate
          framing: rfc6587
          host: 127.0.0.1:19515
          publisher_pipeline.disable_host: true
          tags:
            - forwarded
            - synthetic
      type: tcp
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-criminalip.fortigate-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references: []
