config_version: 2

interval: {{ interval }}

resource:
  url: {{ url }}

secret_state:
  api_key: {{ api_key }}

state:
  ips:
    - '{{ip}}'
{{#each additional_ips}}
    - '{{this}}'
{{/each}}

program: |
  state.ips.map(ip, string(ip).trim_space()).filter(ip, ip != "").as(ips, {
    "events": ips.zip(ips).keys().map(ip,
      try(
        request("GET", state.url.parse_url().as(endpoint,
          endpoint.with({"RawQuery": endpoint.RawQuery.parse_query().with({
            "ip": [ip]
          }).format_query()}).format_url()
        )).with({
          "Header": {
            "x-api-key": [state.secret.api_key],
            "Accept": ["application/json"]
          }
        }).do_request().as(resp,
          resp.StatusCode == 200 ? {
            "message": resp.Body.decode_json().encode_json(),
            "criminalip.query_ip": ip,
            "http.response.status_code": resp.StatusCode
          } : {
            "event.outcome": "failure",
            "criminalip.query_ip": ip,
            "http.response.status_code": resp.StatusCode,
            "error.message": "Criminal IP request failed with HTTP status " + string(resp.StatusCode)
          }
        ), "request_error"
      ).as(result, has(result.request_error) ? {
        "event.outcome": "failure",
        "criminalip.query_ip": ip,
        "error.message": "Criminal IP request or JSON decoding failed; check endpoint and connectivity."
      } : result)
    ),
    "ips": state.ips,
    "url": state.url,
    "secret": state.secret
  })

{{#if tags.length}}
tags:
{{#each tags as |tag|}}
- {{tag}}
{{/each}}
{{#if preserve_original_event}}
- preserve_original_event
{{/if}}
{{else}}
{{#if preserve_original_event}}
tags:
- preserve_original_event
{{/if}}
{{/if}}

{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
