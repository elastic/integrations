inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: criminalip
      name: test-multiple-criminalip
      streams:
        - data_stream:
            dataset: criminalip.ip_report
          interval: 10m
          program: |-
            state.with(
              state.ips.map(ip, ip.trim_space() != "", ip.trim_space()).as(ips,
                {
                  "events": ips.zip(ips).keys().map(ip,
                    request(
                      "GET",
                      state.url.parse_url().as(endpoint,
                        endpoint.with(
                          {
                            "RawQuery": endpoint.RawQuery.parse_query().with(
                              {
                                "ip": [ip],
                              }
                            ).format_query(),
                          }
                        ).format_url()
                      )
                    ).with(
                      {
                        "Header": {
                          "x-api-key": [state.secret.api_key],
                          "Accept": ["application/json"],
                        },
                      }
                    ).do_request().as(resp,
                      (resp.StatusCode == 200) ?
                        {
                          "message": resp.Body.decode_json().encode_json(),
                          "criminalip.query_ip": ip,
                        }
                      :
                        {
                          "event.outcome": "failure",
                          "criminalip.query_ip": ip,
                          "error": {
                            "code": string(resp.StatusCode),
                            "message": "GET " + state.url.parse_url().Path + ": " + resp.Status + " (" + string(resp.StatusCode) + ")",
                          },
                        }
                    ).as(result, is_error(result) ?
                      {
                        "event.outcome": "failure",
                        "criminalip.query_ip": ip,
                        "error": {"message": "Criminal IP request or JSON decoding failed; check endpoint and connectivity: " + try(result)},
                      }
                    :
                      result
                    )
                  ),
                }
              )
            )
          publisher_pipeline.disable_host: true
          redact:
            fields: null
          resource:
            tracer:
                enabled: true
                filename: ../../logs/cel/http-request-trace-*.ndjson
                maxbackups: 5
            url: https://api.example.invalid/report
          secret_state:
            api_key: ${SECRET_0}
          state:
            ips:
                - 192.0.2.10
                - 198.51.100.20
                - 192.0.2.10
          tags:
            - synthetic
            - forwarded
      type: cel
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-criminalip.ip_report-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references:
    - {}
