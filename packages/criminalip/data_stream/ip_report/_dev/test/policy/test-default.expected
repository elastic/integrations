inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: criminalip
      name: test-default-criminalip
      streams:
        - config_version: 2
          data_stream:
            dataset: criminalip.ip_report
          interval: 5m
          program: |
            state.ips.map(ip, string(ip).trim_space()).filter(ip, ip != "").as(ips, {
              "events": ips.zip(ips).keys().map(ip,
                try(
                  request("GET", state.url + "?" + {"ip": [ip]}.format_query()).with({
                    "Header": {
                      "x-api-key": [state.secret.api_key],
                      "Accept": ["application/json"]
                    }
                  }).do_request().as(resp,
                    resp.StatusCode == 200 ? {
                      "message": resp.Body.decode_json().encode_json(),
                      "criminalip.query_ip": ip,
                      "http.response.status_code": resp.StatusCode
                    } : {
                      "event.outcome": "failure",
                      "criminalip.query_ip": ip,
                      "http.response.status_code": resp.StatusCode,
                      "error.message": "Criminal IP request failed with HTTP status " + string(resp.StatusCode)
                    }
                  ), "request_error"
                ).as(result, has(result.request_error) ? {
                  "event.outcome": "failure",
                  "criminalip.query_ip": ip,
                  "error.message": "Criminal IP request or JSON decoding failed; check endpoint and connectivity."
                } : result)
              ),
              "ips": state.ips,
              "url": state.url,
              "secret": state.secret
            })
          resource:
            url: https://api.criminalip.io/v1/asset/ip/report
          secret_state:
            api_key: ${SECRET_0}
          state:
            ips:
                - 1.1.1.1
          tags:
            - criminalip
            - threat_intelligence
            - preserve_original_event
      type: cel
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-criminalip.ip_report-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references:
    - {}
