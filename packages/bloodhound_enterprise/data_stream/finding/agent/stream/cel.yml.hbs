config_version: 1
interval: {{interval}}
resource:
  url: {{base_url}}
{{#if ssl}}
  ssl: {{ssl}}
{{/if}}
state:
  token_id: {{token_id}}
  token_key: {{token_key}}
  base_url: {{base_url}}
  selected_environment: "{{#if selected_environment}}{{selected_environment}}{{/if}}"
  bhe_zones: "{{#if bhe_zones}}{{bhe_zones}}{{/if}}"
  details_limit: 500
  step: 1
  domains: []
  domain_index: 0
  tag_index: 0
  types: []
  type_index: 0
  skip: 0
  collected_pairs: []
  sync_by_type: []
  type_poll_open_ids: []
  type_poll_id_to_uat: {}
  want_more: true
redact:
  fields:
    - token_key
# Collect findings: discover domains, list types, paginate details.
# HMAC signing is required by the BloodHound API and cannot be done in an ingest pipeline.
# Parent type/domain/zone are attached when splitting detail rows because those values
# come from earlier API steps and are not present on the details document.
program: |-
  int(state.?step.orValue(1)).as(step,
    (
      (has(state.types) && size(state.types) > 0) ?
        (state.types[int(state.?type_index.orValue(0))])
      :
        {
          "type": "",
          "domain_id": "",
          "domain_name": "",
          "tag_id": "",
          "tag_name": "",
        }
    ).as(cur,
      (
        (step == 1) ?
          "/api/v2/available-domains"
        : (step == 2) ?
          (
            "/api/v2/domains/" + state.domains[int(state.domain_index)].id + "/available-types?" + {
              "asset_group_tag_id": [state.domains[int(state.domain_index)].tags[int(state.tag_index)].id],
            }.format_query()
          )
        : (cur.type != "" && cur.?meta_loaded.orValue(false) != true) ?
          ("/api/v2/findings/" + cur.type)
        :
          "/api/v2/domains/" + cur.domain_id + "/details?" + {
            "finding": [cur.type],
            "skip": [string(int(state.?skip.orValue(0)))],
            "limit": [string(int(state.details_limit))],
            "Accepted": ["eq:false"],
            "asset_group_tag_id": [cur.tag_id],
          }.format_query()
      ).as(uri,
        now.format("2006-01-02T15:04:05Z07:00").as(ts,
          state.with(
            request("GET", state.base_url.trim_right("/") + uri).with(
              {
                "Header": {
                  "Authorization": ["bhesignature " + state.token_id],
                  "RequestDate": [ts],
                  "Signature": [base64(hmac(bytes(""), "sha256", hmac(ts.substring(0, 13), "sha256", hmac("GET" + uri, "sha256", bytes(state.token_key)))))],
                  "Content-Type": ["application/json"],
                  "User-Agent": ["Elastic-kibana-v1.0.0"],
                },
              }
            ).do_request().as(resp,
              (int(resp.StatusCode) == 200) ?
                resp.Body.decode_json().as(body,
                  (step == 1) ?
                    (
                      (has(body.data) && size(body.data) > 0) ?
                        body.data.map(d,
                          {
                            "id": string(d.id),
                            "name": string(d.name),
                            "tags": (has(d.exposures) && size(d.exposures) > 0) ?
                              d.exposures.map(e, {"id": string(e.asset_group_tag.id), "name": string(e.asset_group_tag.name)})
                            :
                              [{"id": "1", "name": "default"}],
                          }
                        ).as(all_domains,
                          state.?selected_environment.orValue("").trim_space().as(env_raw,
                            state.?bhe_zones.orValue("").trim_space().as(zones_raw,
                              (env_raw == "" || env_raw == "*" || env_raw.equal_fold("all")).as(env_fetch_all,
                                (zones_raw == "" || zones_raw == "*" || zones_raw.equal_fold("all")).as(zones_fetch_all,
                                  (env_fetch_all ? [] : env_raw.split(",").map(t, t.trim_space().trim('"').trim("'")).filter(t, t != "")).as(env_tokens,
                                    (zones_fetch_all ? [] : zones_raw.split(",").map(t, t.trim_space().trim('"').trim("'")).filter(t, t != "")).as(zone_tokens,
                                      (!env_fetch_all ? env_tokens.filter(tok, !all_domains.exists(d, d.name.equal_fold(tok))) : []).as(invalid_env,
                                        (!zones_fetch_all ? zone_tokens.filter(tok, !all_domains.exists(x, x.tags.exists(tag, tag.name.equal_fold(tok)))) : []).as(invalid_zones,
                                          all_domains.filter(d,
                                            env_fetch_all || env_tokens.exists(tok, d.name.equal_fold(tok))
                                          ).map(d,
                                            d.with(
                                              {
                                                "tags": d.tags.filter(t,
                                                  zones_fetch_all || zone_tokens.exists(tok, t.name.equal_fold(tok))
                                                ),
                                              }
                                            )
                                          ).filter(d, size(d.tags) > 0).as(
                                            domains,
                                            (size(domains) > 0) ?
                                              {
                                                "step": 2,
                                                "domains": domains,
                                                "domain_index": 0,
                                                "tag_index": 0,
                                                "types": [],
                                                "type_index": 0,
                                                "skip": 0,
                                                "collected_pairs": [],
                                                "want_more": true,
                                                "events": (size(invalid_env) > 0 || size(invalid_zones) > 0) ?
                                                  dyn(
                                                    invalid_env.map(tok, {"error": {"message": "selected_environment: domain not found in BloodHound Enterprise: " + tok}}) +
                                                    invalid_zones.map(tok, {"error": {"message": "bhe_zones: zone not found in BloodHound Enterprise: " + tok}})
                                                  )
                                                :
                                                  [{"retry": true}],
                                              }
                                            :
                                              {
                                                "events": (size(invalid_env) > 0 || size(invalid_zones) > 0) ?
                                                  dyn(
                                                    invalid_env.map(tok, {"error": {"message": "selected_environment: domain not found in BloodHound Enterprise: " + tok}}) +
                                                    invalid_zones.map(tok, {"error": {"message": "bhe_zones: zone not found in BloodHound Enterprise: " + tok}}) +
                                                    [{"error": {"message": "GET " + uri + ": no domains after selected_environment/bhe_zones filters"}}]
                                                  )
                                                :
                                                  {
                                                    "error": {
                                                      "message": "GET " + uri + ": no domains after selected_environment/bhe_zones filters",
                                                    },
                                                  },
                                                "want_more": false,
                                              }
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      :
                        {
                          "events": {"error": {"message": "GET " + uri + ": no domains found"}},
                          "want_more": false,
                        }
                    )
                  : (step == 2) ?
                    (has(body.data) ? body.data : ((type(body) == list) ? body : [])).as(raw_types,
                      (
                        state.types + (
                          (type(raw_types) == list) ?
                            raw_types.map(t, (type(t) == string) ? t : string(t.?finding_type.orValue(t.?id.orValue(t))))
                          :
                            []
                        ).map(t,
                          {
                            "type": t,
                            "domain_id": state.domains[int(state.domain_index)].id,
                            "domain_name": state.domains[int(state.domain_index)].name,
                            "tag_id": state.domains[int(state.domain_index)].tags[int(state.tag_index)].id,
                            "tag_name": state.domains[int(state.domain_index)].tags[int(state.tag_index)].name,
                          }
                        )
                      ).as(
                        types,
                        (int(state.tag_index) + 1 < size(state.domains[int(state.domain_index)].tags)) ?
                          {
                            "step": 2,
                            "tag_index": int(state.tag_index) + 1,
                            "types": types,
                            "want_more": true,
                            "events": [{"retry": true}],
                          }
                        : (int(state.domain_index) + 1 < size(state.domains)) ?
                          {
                            "step": 2,
                            "domain_index": int(state.domain_index) + 1,
                            "tag_index": 0,
                            "types": types,
                            "want_more": true,
                            "events": [{"retry": true}],
                          }
                        : (size(types) > 0) ?
                          {
                            "step": 3,
                            "types": types,
                            "type_index": 0,
                            "skip": 0,
                            "want_more": true,
                            "events": [{"retry": true}],
                          }
                        :
                          state.domains.map(d,
                            d.tags.map(t,
                              {
                                "message": {
                                  "Finding": "collection_status",
                                  "finding_type": "collection_status",
                                  "environment": string(d.name),
                                  "zone": string(t.name),
                                  "domain_name": string(d.name),
                                  "category": string(t.name),
                                  "collection_absent_reason": "no_open_finding_types",
                                  "collection_data_source": "BloodHound Enterprise GET /api/v2/domains/{domain_id}/available-types",
                                  "collection_message": "No open finding types returned from BloodHound Enterprise for environment '" + string(d.name) + "' and zone '" + string(t.name) + "' during this poll.",
                                }.encode_json(),
                              }
                            )
                          ).flatten().as(
                            no_type_events,
                            state.?sync_by_type.orValue([]).as(
                              stale_all_types,
                              stale_all_types.map(e,
                                e.?open_ids.orValue([]).map(id,
                                  {
                                    "sync_event": {
                                      "sync_kind": "finding_removed",
                                      "id": id,
                                      "finding_type": string(e.?finding_type.orValue("")),
                                      "domain_name": string(e.?domain_name.orValue("")),
                                      "category": string(e.?category.orValue("")),
                                      "type_key": string(e.type_key),
                                    },
                                  }
                                )
                              ).flatten().as(
                                stale_all_removed,
                                stale_all_types.map(e,
                                  {
                                    "sync_event": {
                                      "sync_kind": "checkpoint",
                                      "type_key": string(e.type_key),
                                      "finding_type": string(e.?finding_type.orValue("")),
                                      "domain_name": string(e.?domain_name.orValue("")),
                                      "category": string(e.?category.orValue("")),
                                      "max_updated_at": string(e.?max_updated_at.orValue("")),
                                      "open_finding_ids": [],
                                      "open_finding_count": 0,
                                      "poll_completed_at": now.format("2006-01-02T15:04:05Z07:00"),
                                    },
                                  }
                                ).as(
                                  stale_all_checkpoints,
                                  {
                                    "step": 1,
                                    "want_more": false,
                                    "types": [],
                                    "collected_pairs": [],
                                    "sync_by_type": [],
                                    "events": (size(no_type_events) + size(stale_all_removed) + size(stale_all_checkpoints) > 0) ?
                                      dyn(no_type_events) + dyn(stale_all_removed) + dyn(stale_all_checkpoints)
                                    :
                                      dyn([{"retry": true}]),
                                  }
                                )
                              )
                            )
                          )
                      )
                    )
                  : (cur.type != "" && cur.?meta_loaded.orValue(false) != true) ?
                    ((type(body) == map && has(body.data) && type(body.data) == map) ? body.data : ((type(body) == map) ? body : {})).as(meta,
                      {
                        "types": state.types.map(t,
                          (t.type == cur.type && t.domain_id == cur.domain_id &&
                          t.tag_id == cur.tag_id) ?
                            t.with(
                              {
                                "meta_loaded": true,
                                "title": string(meta.?title.orValue("")),
                                "short_remediation": string(meta.?short_remediation.orValue("")),
                                "long_remediation": string(meta.?long_remediation.orValue("")),
                                "short_description": string(meta.?short_description.orValue("")),
                                "long_description": string(meta.?long_description.orValue("")),
                                "references": (has(meta.references) && type(meta.references) == list) ? meta.references.map(r, string(r)).join("\n") : string(meta.?references.orValue("")),
                              }
                            )
                          :
                            t
                        ),
                        "want_more": true,
                        "events": [{"retry": true}],
                      }
                    )
                  :
                    ((has(body.data) && type(body.data) == list) ? body.data : []).as(page,
                      (string(cur.domain_name) + "|" + string(cur.tag_name) + "|" + string(cur.type)).as(type_key,
                        (int(state.?skip.orValue(0)) == 0 ?
                          state.with({"type_poll_open_ids": [], "type_poll_id_to_uat": {}})
                        :
                          state
                        ).as(st0,
                          (st0.?sync_by_type.orValue([]).filter(e, e.type_key == type_key).size() > 0 ?
                            st0.?sync_by_type.orValue([]).filter(e, e.type_key == type_key)[0]
                          :
                            {"type_key": type_key, "open_ids": [], "updated_at_by_id": {}, "max_updated_at": ""}
                          ).as(cursor,
                            page.filter(inst,
                              string(inst.id).as(id,
                                string(inst.?updated_at.orValue("")).as(uat,
                                  (!cursor.?open_ids.orValue([]).exists(oid, oid == id)) ||
                                  (uat != "" && uat != string(cursor.?updated_at_by_id.orValue({})[id]))
                                )
                              )
                            ).map(inst,
                              string(inst.id).as(id,
                                ((!cursor.?open_ids.orValue([]).exists(oid, oid == id)) ? "opened" : "updated").as(change_type,
                                  {
                                    "message": inst.with(
                                      {
                                        "finding_type": cur.type,
                                        "domain_name": cur.domain_name,
                                        "category": cur.tag_name,
                                        "change_type": change_type,
                                        "finding_title": cur.?title.orValue(""),
                                        "short_remediation": cur.?short_remediation.orValue(""),
                                        "long_remediation": cur.?long_remediation.orValue(""),
                                        "short_description": cur.?short_description.orValue(""),
                                        "long_description": cur.?long_description.orValue(""),
                                        "finding_references": cur.?references.orValue(""),
                                        "finding_layout": (
                                          has(inst.FromPrincipal) || has(inst.ToPrincipal) ||
                                          has(inst.FromPrincipalName) || has(inst.ToPrincipalName)
                                        ) ?
                                          "relationship"
                                        : (
                                          has(inst.Principal) || has(inst.PrincipalName) || has(inst.Props)
                                        ) ?
                                          "single_principal"
                                        :
                                          "unknown",
                                        "graph_url": (has(inst.GraphURL) && string(inst.GraphURL) != "") ? string(inst.GraphURL) : ((has(inst.graph_url) &&
                                        string(inst.graph_url) != "") ? string(inst.graph_url) : (state.base_url.trim_right("/") + "/ui/graphview?environmentId=" + ((has(inst.DomainSID) &&
                                        string(inst.DomainSID) != "") ? string(inst.DomainSID) : ((has(inst.domain_sid) &&
                                        string(inst.domain_sid) != "") ? string(inst.domain_sid) : cur.domain_id)) + "&findingName=" + cur.type + "&assetGroupTagId=" + cur.tag_id)),
                                      }
                                    ).encode_json(),
                                  }
                                )
                              )
                            ).as(finding_events,
                              page.map(i, string(i.id)).as(page_ids,
                                zip(page_ids, page.map(i, string(i.?updated_at.orValue("")))).as(page_uat_map,
                                  (st0.?type_poll_open_ids.orValue([]) + page_ids).as(all_ids,
                                    st0.?type_poll_id_to_uat.orValue({}).with_update(page_uat_map).as(id_to_uat,
                                      (!(size(page) > 0 && int(st0.?skip.orValue(0)) + size(page) < int(body.?count.orValue(int(st0.?skip.orValue(0)) + size(page))))).as(type_complete,
                                        id_to_uat.keys().as(current_ids,
                                          (size(id_to_uat.values().filter(u, u != "")) > 0 ?
                                            string(max(id_to_uat.values().filter(u, u != "")))
                                          :
                                            string(cursor.?max_updated_at.orValue(""))
                                          ).as(max_uat,
                                            (type_complete ?
                                              cursor.?open_ids.orValue([]).filter(id, !current_ids.exists(c, c == id))
                                            :
                                              []
                                            ).as(removed_ids,
                                              (type_complete ?
                                                removed_ids.map(id,
                                                  {
                                                    "sync_event": {
                                                      "sync_kind": "finding_removed",
                                                      "id": id,
                                                      "finding_type": cur.type,
                                                      "domain_name": cur.domain_name,
                                                      "category": cur.tag_name,
                                                      "type_key": type_key,
                                                    },
                                                  }
                                                ) + [
                                                  {
                                                    "sync_event": {
                                                      "sync_kind": "checkpoint",
                                                      "type_key": type_key,
                                                      "finding_type": cur.type,
                                                      "domain_name": cur.domain_name,
                                                      "category": cur.tag_name,
                                                      "max_updated_at": max_uat,
                                                      "open_finding_ids": current_ids,
                                                      "open_finding_count": size(current_ids),
                                                      "poll_completed_at": now.format("2006-01-02T15:04:05Z07:00"),
                                                    },
                                                  }
                                                ]
                                              :
                                                []
                                              ).as(sync_events,
                                                (type_complete ?
                                                st0.?sync_by_type.orValue([]).filter(e, e.type_key != type_key) + [
                                                  {
                                                    "type_key": type_key,
                                                    "finding_type": cur.type,
                                                    "domain_name": cur.domain_name,
                                                    "category": cur.tag_name,
                                                    "open_ids": current_ids,
                                                    "updated_at_by_id": id_to_uat,
                                                    "max_updated_at": max_uat,
                                                  }
                                                ]
                                                :
                                                  st0.?sync_by_type.orValue([])
                                                ).as(next_sync_by_type,
                                                  (string(cur.domain_name) + "|" + string(cur.tag_name)).as(
                                                    pair_key,
                                                    (
                                                      st0.collected_pairs.exists(p, p == pair_key) ?
                                                        st0.collected_pairs
                                                      :
                                                        st0.collected_pairs + [pair_key]
                                                    ).as(
                                                      next_collected_pairs,
                                                      (!type_complete) ?
                                                        {
                                                          "step": 3,
                                                          "types": st0.types,
                                                          "skip": int(st0.?skip.orValue(0)) + size(page),
                                                          "collected_pairs": next_collected_pairs,
                                                          "sync_by_type": next_sync_by_type,
                                                          "type_poll_open_ids": all_ids,
                                                          "type_poll_id_to_uat": id_to_uat,
                                                          "want_more": true,
                                                          "events": (size(finding_events) > 0) ? dyn(finding_events) : dyn([{"retry": true}]),
                                                        }
                                                      : (int(st0.type_index) + 1 < size(st0.types)) ?
                                                        {
                                                          "step": 3,
                                                          "types": st0.types,
                                                          "type_index": int(st0.type_index) + 1,
                                                          "skip": 0,
                                                          "collected_pairs": next_collected_pairs,
                                                          "sync_by_type": next_sync_by_type,
                                                          "type_poll_open_ids": [],
                                                          "type_poll_id_to_uat": {},
                                                          "want_more": true,
                                                          "events": (size(finding_events) + size(sync_events) > 0) ?
                                                            dyn(finding_events) + dyn(sync_events)
                                                          :
                                                            dyn([{"retry": true}]),
                                                        }
                                                      :
                                                        st0.domains.map(d,
                                                          d.tags.filter(t,
                                                            !next_collected_pairs.exists(p, p == string(d.name) + "|" + string(t.name))
                                                          ).map(t,
                                                            {
                                                              "message": {
                                                                "Finding": "collection_status",
                                                                "finding_type": "collection_status",
                                                                "environment": string(d.name),
                                                                "zone": string(t.name),
                                                                "domain_name": string(d.name),
                                                                "category": string(t.name),
                                                                "collection_absent_reason": "no_open_finding_instances",
                                                                "collection_data_source": "BloodHound Enterprise GET /api/v2/domains/{domain_id}/details",
                                                                "collection_message": "No open finding instances returned from BloodHound Enterprise for environment '" + string(d.name) + "' and zone '" + string(t.name) + "' during this poll.",
                                                              }.encode_json(),
                                                            }
                                                          )
                                                        ).flatten().as(
                                                          empty_pair_events,
                                                          st0.types.map(t,
                                                            string(t.domain_name) + "|" + string(t.tag_name) + "|" + string(t.type)
                                                          ).as(
                                                            active_type_keys,
                                                            next_sync_by_type.filter(e, !active_type_keys.exists(k, k == e.type_key)).as(
                                                              stale_type_entries,
                                                              stale_type_entries.map(e,
                                                                e.?open_ids.orValue([]).map(id,
                                                                  {
                                                                    "sync_event": {
                                                                      "sync_kind": "finding_removed",
                                                                      "id": id,
                                                                      "finding_type": string(e.?finding_type.orValue("")),
                                                                      "domain_name": string(e.?domain_name.orValue("")),
                                                                      "category": string(e.?category.orValue("")),
                                                                      "type_key": string(e.type_key),
                                                                    },
                                                                  }
                                                                )
                                                              ).flatten().as(
                                                                stale_type_removed,
                                                                stale_type_entries.map(e,
                                                                  {
                                                                    "sync_event": {
                                                                      "sync_kind": "checkpoint",
                                                                      "type_key": string(e.type_key),
                                                                      "finding_type": string(e.?finding_type.orValue("")),
                                                                      "domain_name": string(e.?domain_name.orValue("")),
                                                                      "category": string(e.?category.orValue("")),
                                                                      "max_updated_at": string(e.?max_updated_at.orValue("")),
                                                                      "open_finding_ids": [],
                                                                      "open_finding_count": 0,
                                                                      "poll_completed_at": now.format("2006-01-02T15:04:05Z07:00"),
                                                                    },
                                                                  }
                                                                ).as(
                                                                  stale_type_checkpoints,
                                                                  next_sync_by_type.filter(e, active_type_keys.exists(k, k == e.type_key)).as(
                                                                    pruned_sync_by_type,
                                                                    {
                                                                      "step": 1,
                                                                      "want_more": false,
                                                                      "types": [],
                                                                      "type_index": 0,
                                                                      "skip": 0,
                                                                      "domain_index": 0,
                                                                      "tag_index": 0,
                                                                      "collected_pairs": [],
                                                                      "sync_by_type": pruned_sync_by_type,
                                                                      "type_poll_open_ids": [],
                                                                      "type_poll_id_to_uat": {},
                                                                      "events": (size(finding_events) + size(sync_events) + size(empty_pair_events) + size(stale_type_removed) + size(stale_type_checkpoints) > 0) ?
                                                                        dyn(finding_events) + dyn(sync_events) + dyn(empty_pair_events) + dyn(stale_type_removed) + dyn(stale_type_checkpoints)
                                                                      :
                                                                        dyn([{"retry": true}]),
                                                                    }
                                                                  )
                                                                )
                                                              )
                                                            )
                                                          )
                                                        )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                )
              : (int(resp.StatusCode) == 404 && step == 3 && cur.type != "" && cur.?meta_loaded.orValue(false) != true) ?
                {
                  "types": state.types.map(t,
                    (t.type == cur.type && t.domain_id == cur.domain_id && t.tag_id == cur.tag_id) ?
                      t.with(
                        {
                          "meta_loaded": true,
                          "title": "",
                          "short_remediation": "",
                          "long_remediation": "",
                          "short_description": "",
                          "long_description": "",
                          "references": "",
                        }
                      )
                    :
                      t
                  ),
                  "want_more": true,
                  "events": [{"retry": true}],
                }
              : (int(resp.StatusCode) >= 500 || int(resp.StatusCode) == 429) ?
                {
                  "events": {
                    "error": {
                      "code": string(resp.StatusCode),
                      "message": "BloodHound Enterprise request failed. GET " + uri + ": " + resp.Status,
                    },
                  },
                  "want_more": false,
                }
              : (int(resp.StatusCode) == 401 || int(resp.StatusCode) == 403) ?
                {
                  "events": {
                    "error": {
                      "code": string(resp.StatusCode),
                      "message": "BloodHound Enterprise authentication failed. Check the token ID and token key. GET " + uri + ": " + resp.Status,
                    },
                  },
                  "step": 1,
                  "types": [],
                  "type_index": 0,
                  "skip": 0,
                  "want_more": false,
                }
              :
                {
                  "events": {
                    "error": {
                      "code": string(resp.StatusCode),
                      "message": "BloodHound Enterprise request failed. GET " + uri + ": " + ((size(resp.Body) != 0) ? string(resp.Body) : resp.Status),
                    },
                  },
                  "step": 1,
                  "types": [],
                  "type_index": 0,
                  "skip": 0,
                  "want_more": false,
                }
            )
          )
        )
      )
    )
  )
