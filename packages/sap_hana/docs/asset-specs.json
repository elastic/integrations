{
  "source": "Field Prom-gap Auto-ops proof (Nightshift); proposed Fleet assets",
  "exporter": "https://github.com/SUSE/hanadb_exporter",
  "datadog_parity": "https://docs.datadoghq.com/integrations/sap_hana/",
  "dashboard": {
    "id": "sap_hana-overview",
    "title": "[Metrics SAP HANA] Overview",
    "panels": [
      {
        "title": "Connections",
        "metric": "sap_hana.connections.total",
        "prom": "hanadb_connections_total"
      },
      {
        "title": "Host memory used (MB)",
        "metric": "sap_hana.memory.host_memory_used_total",
        "prom": "hanadb_host_memory_used_total"
      },
      {
        "title": "SQL executions",
        "metric": "sap_hana.sql.service_executions",
        "prom": "hanadb_sql_service_executions"
      },
      {
        "title": "HANA alerts",
        "metric": "sap_hana.alerts.current",
        "prom": "hanadb_alerts_current"
      },
      {
        "title": "Host memory over time",
        "type": "xy",
        "metric": "sap_hana.memory.host_memory_used_total"
      },
      {
        "title": "Connections over time",
        "type": "xy",
        "metric": "sap_hana.connections.total"
      }
    ]
  },
  "alerts": [
    {
      "name": "SAP HANA Memory High",
      "type": "elasticsearch_query / ES|QL threshold",
      "condition": "MAX(sap_hana.memory.host_memory_used_total) >= 50000 (HOT) / 20000 (WATCH)",
      "group_by": [
        "sap_hana.labels.sid",
        "sap_hana.labels.host"
      ]
    },
    {
      "name": "SAP HANA Connections High",
      "type": "elasticsearch_query / ES|QL threshold",
      "condition": "MAX(sap_hana.connections.total) above baseline / static threshold",
      "group_by": [
        "sap_hana.labels.sid"
      ]
    },
    {
      "name": "SAP HANA Alerts Current",
      "type": "elasticsearch_query / ES|QL threshold",
      "condition": "MAX(sap_hana.alerts.current) > 0",
      "group_by": [
        "sap_hana.labels.sid",
        "sap_hana.labels.host"
      ]
    }
  ],
  "ml": [
    {
      "job_id": "sap-hana-memory",
      "description": "Anomaly detection on sap_hana.memory.host_memory_used_total by sid/host",
      "function": "mean",
      "bucket_span": "15m"
    }
  ],
  "slos": [
    {
      "name": "SAP HANA availability (alert-free)",
      "indicator": "ratio of periods where sap_hana.alerts.current == 0",
      "objective": 0.99,
      "budgeting_method": "occurrences"
    }
  ],
  "collect_notes": [
    "Category (2) Prom source: proprietary HANA monitoring views \u2192 SUSE hanadb_exporter sidecar \u2192 Agent prometheus/metrics.",
    "Product decision needed long-term: Agent-orchestrated exporter vs OTel receiver contributed to collector-contrib then included in Agent builds."
  ]
}
