  "attributes": {
    "created_at": "2026-08-06T00:00:00.000Z",
    "created_by": "elastic",
    "description": "Inventories NTFS volumes on Windows using the elastic_ntfs_volumes extension table (requires osquerybeat 9.5.0+ with the NTFS extension). Returns volume-level metadata: device path (device), device type (device_type), drive letter (drive_letter), volume label (volume_label), and file system name (file_system_name). Useful for asset inventory and for correlating MFT and USN journal forensic queries with specific volumes.",
    "ecs_mapping": [
      {
        "key": "event.category",
        "value": {
          "value": ["host"]
        }
      },
      {
        "key": "event.type",
        "value": {
          "value": ["info"]
        }
      },
      {
        "key": "event.action",
        "value": {
          "value": "osquery.ntfs_volumes"
        }
      },
      {
        "key": "host.disk.device.name",
        "value": {
          "field": "device"
        }
      },
      {
        "key": "host.disk.device.type",
        "value": {
          "field": "device_type"
        }
      },
      {
        "key": "tags",
        "value": {
          "value": ["osquery", "ntfs_volumes", "filesystem_inventory", "windows"]
        }
      }
    ],
    "id": "ntfs_volumes_windows_elastic",
    "interval": "3600",
    "platform": "windows",
    "query": "SELECT * FROM elastic_ntfs_volumes",
