{
  "attributes": {
    "created_at": "2026-08-06T00:00:00.000Z",
    "created_by": "elastic",
    "description": "Inventories disk partitions on Windows using the elastic_ntfs_partitions extension table (requires osquerybeat 9.5.0+ with the NTFS extension). Returns partition-level metadata: physical device (device), drive letter (drive_letter), partition id/number, partition style (MBR/GPT/RAW), partition type, starting offset and length in bytes, raw and human-readable attributes, and partition name. Useful for asset inventory and for determining available volumes that can be queried with ntfs_mft_windows_elastic.",
    "ecs_mapping": [
      {
        "key": "event.category",
        "value": {
          "value": ["host"]
        }
      },
      {
        "key": "event.type",
        "value": {
          "value": ["info"]
        }
      },
      {
        "key": "event.action",
        "value": {
          "value": "osquery.disk_partitions"
        }
      },
      {
        "key": "file.device",
        "value": {
          "field": "device"
        }
      },
      {
        "key": "device.type",
        "value": {
          "field": "type"
        }
      },
      {
        "key": "tags",
        "value": {
          "value": ["osquery", "disk_partitions", "filesystem_inventory", "windows"]
        }
      }
    ],
    "id": "disk_partitions_windows_elastic",
    "interval": "3600",
    "platform": "windows",
    "query": "SELECT * FROM elastic_ntfs_partitions",
