interval: "{{interval}}"
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: "{{http_client_timeout}}"
{{/if}}
resource.url: "{{url}}"
state:
  api_key: "{{api_key}}"
  page_limit: {{page_limit}}
  cur_offset: 0
redact:
  fields:
    - api_key
program: |
  state.with(
    request("GET", state.url + "?" + {
      "apiKey": [state.api_key],
      "offset": [string(int(state.cur_offset))],
      "limit": [string(int(state.page_limit))],
    }.format_query()).do_request().as(resp,
      (resp.StatusCode != 200) ?
        {
          "events": [
            {
              "error": {
                "code": string(resp.StatusCode),
                "id": string(resp.Status),
                "message": "GET " + state.url + " at offset " + string(int(state.cur_offset)) + ": " + (
                  (size(resp.Body) != 0) ?
                    string(resp.Body)
                  :
                    string(resp.Status) + " (" + string(resp.StatusCode) + ")"
                ),
              },
            },
          ],
          "cur_offset": 0,
          "want_more": false,
        }
      :
        string(resp.Body).split("\n").map(row, row.trim_space()).filter(row, row != "" && !row.startsWith("domain,")).as(rows,
          {
            "events": rows.map(row, {"message": row}),
            "cur_offset": (size(rows) < int(state.page_limit)) ? 0 : int(state.cur_offset) + int(state.page_limit),
            "want_more": size(rows) >= int(state.page_limit),
          }
        )
    )
  )
{{#if ioc_expiration_duration}}
fields_under_root: true
fields:
  _conf:
    ioc_expiration_duration: "{{ioc_expiration_duration}}"
{{/if}}
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
