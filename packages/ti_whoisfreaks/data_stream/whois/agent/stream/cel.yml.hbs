resource.url: {{resource_url}}
resource.timeout: {{resource_timeout}}
interval: {{resource_interval}}
state:
  status_url: {{status_url}}
  api_key: {{api_key}}
  page_limit: {{page_limit}}
  pinned_date: "{{resource_date}}"
  phase: ""
  cur_offset: 0
  gtld_date: ""
  cctld_date: ""
  last_gtld_date: ""
  last_cctld_date: ""
  want_more: false
redact:
  fields:
    - api_key
program: |
  state.phase == "gtld" ?
      request("GET", state.url + "/gtld?" + {
          "apiKey": [state.api_key],
          "whois": ["true"],
          "date": [state.gtld_date],
          "limit": [string(state.page_limit)],
          "offset": [string(state.cur_offset)],
      }.format_query()).do_request().as(resp,
          resp.StatusCode != 200 ?
              {
                  "events": [{"error": {
                      "code": string(resp.StatusCode),
                      "message": "WhoisFreaks gtld page failed at offset " + string(state.cur_offset) +
                          " for date " + state.gtld_date + ": status " + string(resp.StatusCode) + " " + string(resp.Body),
                  }}],
                  "url": state.url,
                  "status_url": state.status_url,
                  "api_key": state.api_key,
                  "page_limit": state.page_limit,
                  "pinned_date": state.pinned_date,
                  "phase": state.cctld_date != "" ? "cctld" : "idle",
                  "cur_offset": 0,
                  "gtld_date": "",
                  "cctld_date": state.cctld_date,
                  "last_gtld_date": state.last_gtld_date,
                  "last_cctld_date": state.last_cctld_date,
                  "want_more": state.cctld_date != "",
              }
          :
              resp.Body.mime("text/csv; header=present").as(rows,
                  size(rows) < state.page_limit ?
                      {
                          "events": rows.map(row, {"whoisfreaks": row, "_tld": "gtld"}),
                          "url": state.url,
                          "status_url": state.status_url,
                          "api_key": state.api_key,
                          "page_limit": state.page_limit,
                          "pinned_date": state.pinned_date,
                          "phase": state.cctld_date != "" ? "cctld" : "idle",
                          "cur_offset": 0,
                          "gtld_date": "",
                          "cctld_date": state.cctld_date,
                          "last_gtld_date": state.gtld_date,
                          "last_cctld_date": state.last_cctld_date,
                          "want_more": state.cctld_date != "",
                      }
                  :
                      {
                          "events": rows.map(row, {"whoisfreaks": row, "_tld": "gtld"}),
                          "url": state.url,
                          "status_url": state.status_url,
                          "api_key": state.api_key,
                          "page_limit": state.page_limit,
                          "pinned_date": state.pinned_date,
                          "phase": "gtld",
                          "cur_offset": state.cur_offset + state.page_limit,
                          "gtld_date": state.gtld_date,
                          "cctld_date": state.cctld_date,
                          "last_gtld_date": state.last_gtld_date,
                          "last_cctld_date": state.last_cctld_date,
                          "want_more": true,
                      }
              )
      )
  : state.phase == "cctld" ?
      request("GET", state.url + "/cctld?" + {
          "apiKey": [state.api_key],
          "whois": ["true"],
          "date": [state.cctld_date],
          "limit": [string(state.page_limit)],
          "offset": [string(state.cur_offset)],
      }.format_query()).do_request().as(resp,
          resp.StatusCode != 200 ?
              {
                  "events": [{"error": {
                      "code": string(resp.StatusCode),
                      "message": "WhoisFreaks cctld page failed at offset " + string(state.cur_offset) +
                          " for date " + state.cctld_date + ": status " + string(resp.StatusCode) + " " + string(resp.Body),
                  }}],
                  "url": state.url,
                  "status_url": state.status_url,
                  "api_key": state.api_key,
                  "page_limit": state.page_limit,
                  "pinned_date": state.pinned_date,
                  "phase": "idle",
                  "cur_offset": 0,
                  "gtld_date": "",
                  "cctld_date": "",
                  "last_gtld_date": state.last_gtld_date,
                  "last_cctld_date": state.last_cctld_date,
                  "want_more": false,
              }
          :
              resp.Body.mime("text/csv; header=present").as(rows,
                  size(rows) < state.page_limit ?
                      {
                          "events": rows.map(row, {"whoisfreaks": row, "_tld": "cctld"}),
                          "url": state.url,
                          "status_url": state.status_url,
                          "api_key": state.api_key,
                          "page_limit": state.page_limit,
                          "pinned_date": state.pinned_date,
                          "phase": "idle",
                          "cur_offset": 0,
                          "gtld_date": "",
                          "cctld_date": "",
                          "last_gtld_date": state.last_gtld_date,
                          "last_cctld_date": state.cctld_date,
                          "want_more": false,
                      }
                  :
                      {
                          "events": rows.map(row, {"whoisfreaks": row, "_tld": "cctld"}),
                          "url": state.url,
                          "status_url": state.status_url,
                          "api_key": state.api_key,
                          "page_limit": state.page_limit,
                          "pinned_date": state.pinned_date,
                          "phase": "cctld",
                          "cur_offset": state.cur_offset + state.page_limit,
                          "gtld_date": state.gtld_date,
                          "cctld_date": state.cctld_date,
                          "last_gtld_date": state.last_gtld_date,
                          "last_cctld_date": state.last_cctld_date,
                          "want_more": true,
                      }
              )
      )
  :
      request("GET", state.status_url).do_request().as(statusResp,
          statusResp.StatusCode != 200 ?
              {
                  "events": [{"error": {
                      "code": string(statusResp.StatusCode),
                      "message": "WhoisFreaks status request failed with status " +
                          string(statusResp.StatusCode) + ": " + string(statusResp.Body),
                  }}],
                  "url": state.url,
                  "status_url": state.status_url,
                  "api_key": state.api_key,
                  "page_limit": state.page_limit,
                  "pinned_date": state.pinned_date,
                  "phase": "idle",
                  "cur_offset": 0,
                  "gtld_date": "",
                  "cctld_date": "",
                  "last_gtld_date": state.last_gtld_date,
                  "last_cctld_date": state.last_cctld_date,
                  "want_more": false,
              }
          :
              statusResp.Body.decode_json().as(status,
                  (has(status.newly) && has(status.newly.gtld) && has(status.newly.gtld.last_update) ? string(status.newly.gtld.last_update) : "").as(gtldLatest,
                  (has(status.newly) && has(status.newly.cctld) && has(status.newly.cctld.last_update) ? string(status.newly.cctld.last_update) : "").as(cctldLatest,
                  (state.pinned_date != "" ? state.pinned_date : gtldLatest).as(gtldT,
                  (state.pinned_date != "" ? state.pinned_date : cctldLatest).as(cctldT,
                  (gtldT != "" && gtldT != state.last_gtld_date).as(gtldNeed,
                  (cctldT != "" && cctldT != state.last_cctld_date).as(cctldNeed,
                      {
                          "events": [],
                          "url": state.url,
                          "status_url": state.status_url,
                          "api_key": state.api_key,
                          "page_limit": state.page_limit,
                          "pinned_date": state.pinned_date,
                          "phase": gtldNeed ? "gtld" : (cctldNeed ? "cctld" : "idle"),
                          "cur_offset": 0,
                          "gtld_date": gtldNeed ? gtldT : "",
                          "cctld_date": cctldNeed ? cctldT : "",
                          "last_gtld_date": state.last_gtld_date,
                          "last_cctld_date": state.last_cctld_date,
                          "want_more": gtldNeed || cctldNeed,
                      }
                  ))))))
              )
      )
