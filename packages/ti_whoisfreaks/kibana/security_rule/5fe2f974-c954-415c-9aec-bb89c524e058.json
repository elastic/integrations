    "attributes": {
        "name": "WhoisFreaks - Ingest Pipeline or API Error",
        "description": "Detects pipeline or upstream API failures from the WhoisFreaks integration (for example invalid API key or download errors). Persistent errors indicate a broken collection pipeline.",
        "author": [
            "WhoisFreaks"
        ],
        "enabled": true,
        "false_positives": [
            "Legitimate bulk domain registrations by portfolio managers or registrars."
        ],
        "from": "now-24h",
        "interval": "1h",
        "language": "kuery",
        "license": "Elastic License v2",
        "max_signals": 100,
        "query": "data_stream.dataset: \"ti_whoisfreaks.whois\" and event.kind: \"pipeline_error\"",
        "references": [
            "https://whoisfreaks.com/"
        ],
        "risk_score": 21,
        "rule_id": "5fe2f974-c954-415c-9aec-bb89c524e058",
