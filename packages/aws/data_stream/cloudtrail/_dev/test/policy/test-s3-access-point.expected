inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            agentVersion: ^9.6.0
            name: aws
      name: test-s3-access-point-aws
      streams:
        - access_key_id: ${SECRET_0}
          access_point_arn: arn:aws:s3:us-east-1:123456789012:accesspoint/cloudtrail-ap
          bucket_list_interval: 1m
          bucket_list_prefix: AWSLogs/123456789012/CloudTrail/
          content_type: application/json
          data_stream:
            dataset: aws.cloudtrail
          default_region: us-east-1
          expand_event_list_from_field: Records
          fields:
            _conf:
                retain: all
          fields_under_root: true
          file_selectors:
            - expand_event_list_from_field: Records
              regex: /CloudTrail/
            - regex: /CloudTrail-Digest/
            - expand_event_list_from_field: Records
              regex: /CloudTrail-Insight/
          number_of_workers: 5
          publisher_pipeline.disable_host: true
          secret_access_key: ${SECRET_1}
          tags:
            - preserve_original_event
            - actor_target_mapping
            - forwarded
            - aws-cloudtrail
      type: aws-s3
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-aws.cloudtrail-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references:
    - {}
    - {}
