inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            agentVersion: ^9.4.0
            name: aws
      name: test-cloudwatch-aws
      streams:
        - access_key_id: ${SECRET_0}
          api_sleep: 200ms
          data_stream:
            dataset: aws.cloudtrail
          default_region: us-east-1
          fields:
            _conf:
                retain: all
          fields_under_root: true
          log_group_arn: arn:aws:logs:us-east-1:123456789012:log-group:CloudTrail-logs:*
          publisher_pipeline.disable_host: true
          scan_frequency: 1m
          secret_access_key: ${SECRET_1}
          start_position: beginning
          tags:
            - preserve_original_event
            - actor_target_mapping
            - forwarded
            - aws-cloudtrail
      type: aws-cloudwatch
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-aws.cloudtrail-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references:
    - {}
    - {}
