inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            agentVersion: ^9.4.0
            name: aws
      name: test-httpjson-assume-role-aws
      streams:
        - auth.aws:
            access_key_id: ${SECRET_0}
            assume_role.duration: 1h
            assume_role.expiry_window: 5m
            default_region: us-east-1
            external_id: ${SECRET_2}
            role_arn: arn:aws:iam::123456789012:role/SecurityHubReader
            secret_access_key: ${SECRET_1}
            service_name: securityhub
          cel.max_executions: 5000
          cel.program: |-
            (
              // Pin the UpdatedAt window start once per collection interval. During
              // pagination (want_more, or a next_page token is present) the window is
              // preserved so it cannot drift between pages and invalidate NextToken -
              // the failure mode of the previous httpjson implementation, which
              // re-evaluated the request transforms (including now()) on every page.
              (state.?want_more.orValue(false) || state.?page.next_token.hasValue()) ?
                state
              :
                state.with(
                  {
                    "start": state.?cursor.last_execution_datetime.orValue(
                      (now - duration(state.initial_interval)).format("2006-01-02T15")
                    ),
                  }
                )
            ).as(state,
              state.with(
                post_request(
                  state.url.trim_right("/"),
                  "application/json",
                  {
                    "MaxResults": 100,
                    "SortCriteria": [{"Field": "UpdatedAt", "SortOrder": "asc"}],
                    "Filters": state.?filters.orValue({}).with(
                      {
                        "UpdatedAt": [{"Start": state.start, "End": "2099-01-01T00"}],
                      }
                    ),
                    ?"NextToken": state.?page.next_token,
                  }.encode_json()
                ).do_request().as(resp, (resp.StatusCode == 200) ?
                  resp.Body.decode_json().as(body,
                    {
                      "events": body.?Findings.orValue([]).map(e, {"message": e.encode_json()}),
                      "page": {?"next_token": body.?NextToken},
                      "want_more": has(body.NextToken),
                      "cursor": {
                        "last_execution_datetime": (
                          (!has(body.NextToken) && size(body.?Findings.orValue([])) > 0) ?
                            body.Findings[size(body.Findings) - 1].UpdatedAt
                          :
                            state.?cursor.last_execution_datetime.orValue(state.start)
                        ),
                      },
                    }
                  )
                :
                  {
                    "events": {
                      "error": {
                        "code": string(resp.StatusCode),
                        "id": resp.Status,
                        "message": "POST " + state.url.trim_right("/") + ": " + (
                          (size(resp.Body) != 0) ?
                            string(resp.Body)
                          :
                            resp.Status + " (" + string(resp.StatusCode) + ")"
                        ),
                      },
                    },
                    "page": {},
                    "want_more": false,
                  }
                )
              )
            )
          cel.state:
            filters:
                SeverityLabel:
                    - Comparison: EQUALS
                      Value: CRITICAL
            initial_interval: 48h
          data_stream:
            dataset: aws.securityhub_findings
          interval: 1h
          publisher_pipeline.disable_host: true
          request.ssl: null
          request.timeout: 2m
          request.tracer:
            enabled: true
            filename: ../../logs/cel/http-request-trace-*.ndjson
            maxbackups: 5
          request.url: https://securityhub.us-east-1.amazonaws.com/findings
          run_as_cel: true
          tags:
            - run_as_cel
            - preserve_original_event
            - preserve_duplicate_custom_fields
            - forwarded
            - aws_securityhub_findings
            - test-policy
      type: httpjson
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-aws.securityhub_findings-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references:
    - {}
    - {}
    - {}
