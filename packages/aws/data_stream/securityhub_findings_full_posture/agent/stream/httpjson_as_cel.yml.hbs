config_version: 2
interval: 24h
run_as_cel: true
request.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
request.timeout: 2m
{{#if proxy_url}}
request.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
request.ssl: {{ssl}}
{{/if}}
request.url: https://securityhub.{{aws_region}}.{{tld}}/findings
auth.aws:
{{#if access_key_id}}
  access_key_id: {{access_key_id}}
{{/if}}
{{#if secret_access_key}}
  secret_access_key: {{secret_access_key}}
{{/if}}
{{#if session_token}}
  session_token: {{session_token}}
{{/if}}
{{#if shared_credential_file}}
  shared_credential_file: {{shared_credential_file}}
{{/if}}
{{#if credential_profile_name}}
  credential_profile_name: {{credential_profile_name}}
{{/if}}
{{#if role_arn}}
  role_arn: {{role_arn}}
{{/if}}
{{#if assume_role_duration}}
  assume_role.duration: {{assume_role_duration}}
{{/if}}
{{#if assume_role_expiry_window}}
  assume_role.expiry_window: {{assume_role_expiry_window}}
{{/if}}
  service_name: securityhub
  default_region: {{aws_region}}
cel.max_executions: {{max_executions}}
cel.state:
{{#if filters}}
  filters: {{filters}}
{{else}}
  filters: {}
{{/if}}
cel.program: |-
  state.with(
    request(
      "POST",
      state.url.trim_right("/"),
      {
        "MaxResults": 100,
        "Filters": state.?filters.orValue({}),
      }.with(
        (state.?next_token.orValue("") != "") ? {"NextToken": state.next_token} : {}
      ).encode_json()
    ).do_request().as(resp, (resp.StatusCode == 200) ?
      resp.Body.decode_json().as(body,
        {
          "events": body.?Findings.orValue([]).map(e, {"message": e.encode_json()}),
          "next_token": body.?NextToken.orValue(""),
          "want_more": body.?NextToken.orValue("") != "",
        }
      )
    :
      {
        "events": {
          "error": {
            "code": string(resp.StatusCode),
            "id": resp.Status,
            "message": "POST " + state.url.trim_right("/") + ": " + (
              (size(resp.Body) != 0) ?
                string(resp.Body)
              :
                resp.Status + " (" + string(resp.StatusCode) + ")"
            ),
          },
        },
        "next_token": "",
        "want_more": false,
      }
    )
  )
tags:
  - run_as_cel
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#if preserve_duplicate_custom_fields}}
  - preserve_duplicate_custom_fields
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
