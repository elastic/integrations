[
  {
    "op": "add",
    "path": "/Resources/ElasticAWSKinesisPolicy",
    "value": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "ElasticAWSKinesis",
        "Roles": [
          {
            "Ref": "ElasticFederatedIdentityRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "KinesisReadAccess",
              "Effect": "Allow",
              "Action": [
                "kinesis:ListStreams",
                "kinesis:DescribeStreamSummary",
                "kinesis:ListShards"
              ],
              "Resource": "*"
            }
          ]
        }
      }
    }
  }
]