[
  {
    "op": "add",
    "path": "/Resources/ElasticAWSBasePolicy",
    "value": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "ElasticAWSBase",
        "Roles": [{ "Ref": "ElasticFederatedIdentityRole" }],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AWSBase",
              "Effect": "Allow",
              "Action": [
                "sts:GetCallerIdentity"
              ],
              "Resource": "*"
            }
          ]
        }
      }
    }
  }
]
