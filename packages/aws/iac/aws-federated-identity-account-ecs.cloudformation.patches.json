[
  {
    "op": "add",
    "path": "/Resources/ElasticAWSECSPolicy",
    "value": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "ElasticAWSECS",
        "Roles": [
          {
            "Ref": "ElasticFederatedIdentityRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ECSReadAccess",
              "Effect": "Allow",
              "Action": [
                "ecs:ListClusters",
                "ecs:DescribeClusters",
                "ecs:ListServices",
                "ecs:DescribeServices"
              ],
              "Resource": "*"
            }
          ]
        }
      }
    }
  }
]