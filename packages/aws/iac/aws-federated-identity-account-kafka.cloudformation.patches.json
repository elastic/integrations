[
  {
    "op": "add",
    "path": "/Resources/ElasticAWSKafkaPolicy",
    "value": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "ElasticAWSKafka",
        "Roles": [
          {
            "Ref": "ElasticFederatedIdentityRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "KafkaReadAccess",
              "Effect": "Allow",
              "Action": [
                "kafka:ListClusters",
                "kafka:DescribeCluster",
                "kafka:ListNodes"
              ],
              "Resource": "*"
            }
          ]
        }
      }
    }
  }
]