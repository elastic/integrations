[
  {
    "op": "add",
    "path": "/Resources/ElasticAWSMetricsInputPolicy",
    "value": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "ElasticAWSMetricsInput",
        "Roles": [{ "Ref": "ElasticFederatedIdentityRole" }],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "MetricsInputBase",
              "Effect": "Allow",
              "Action": [
                "ec2:DescribeRegions",
                "cloudwatch:ListMetrics",
                "cloudwatch:GetMetricData",
                "tag:GetResources"
              ],
              "Resource": "*"
            }
          ]
        }
      }
    }
  }
]
