[
  {
    "op": "add",
    "path": "/Resources/ElasticAWSEMRPolicy",
    "value": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "ElasticAWSEMR",
        "Roles": [
          {
            "Ref": "ElasticFederatedIdentityRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "EMRReadAccess",
              "Effect": "Allow",
              "Action": [
                "elasticmapreduce:ListClusters",
                "elasticmapreduce:DescribeCluster"
              ],
              "Resource": "*"
            }
          ]
        }
      }
    }
  }
]