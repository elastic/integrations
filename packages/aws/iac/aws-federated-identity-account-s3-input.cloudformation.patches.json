[
  {
    "op": "add",
    "path": "/Resources/ElasticAWSS3InputPolicy",
    "value": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "ElasticAWSS3Input",
        "Roles": [{ "Ref": "ElasticFederatedIdentityRole" }],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "S3InputBase",
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:ListBucket",
                "sqs:ReceiveMessage",
                "sqs:DeleteMessage",
                "sqs:ChangeMessageVisibility",
                "sqs:GetQueueAttributes"
              ],
              "Resource": "*"
            }
          ]
        }
      }
    }
  }
]
