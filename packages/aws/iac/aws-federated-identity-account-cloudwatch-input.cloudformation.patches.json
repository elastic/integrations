[
  {
    "op": "add",
    "path": "/Resources/ElasticAWSCloudWatchInputPolicy",
    "value": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "ElasticAWSCloudWatchInput",
        "Roles": [{ "Ref": "ElasticFederatedIdentityRole" }],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "CloudWatchInputBase",
              "Effect": "Allow",
              "Action": [
                "logs:DescribeLogGroups",
                "logs:FilterLogEvents"
              ],
              "Resource": "*"
            }
          ]
        }
      }
    }
  }
]
