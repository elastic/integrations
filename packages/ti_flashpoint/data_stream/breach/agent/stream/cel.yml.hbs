config_version: 2
interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
{{#if resource_rate_limit_limit}}
resource.rate_limit.limit: {{resource_rate_limit_limit}}
{{/if}}
{{#if resource_rate_limit_burst}}
resource.rate_limit.burst: {{resource_rate_limit_burst}}
{{/if}}
{{#if max_executions}}
max_executions: {{max_executions}}
{{/if}}
resource.url: {{url}}
state:
  initial_interval: {{initial_interval}}
  page_size: {{page_size}}
  api_token: {{api_token}}
  integration_version: !!str {{#if _meta.package.version}}{{_meta.package.version}}{{else}}unknown{{/if}}
  integration_platform_version: !!str {{#if _meta.agent.version}}{{_meta.agent.version}}{{else}}unknown{{/if}}
redact:
  fields:
    - api_token
program: |-
  state.?scroll_id.orValue("").as(scroll_id,
    state.?cursor.last_indexed_at.orValue(string(int(now - duration(state.initial_interval)))).as(lower_bound,
      (
        (scroll_id != "") ?
          {
            "url": state.url.trim_right("/") + "/sources/v1/noncommunities/scroll?scroll=2m",
            "body": {"scroll_id": scroll_id},
          }
        :
          {
            "url": state.url.trim_right("/") + "/sources/v1/noncommunities/search",
            "body": {
              "query": "+basetypes:(breach) AND header_.indexed_at:[" + lower_bound + " TO now]",
              "sort": ["header_.indexed_at:asc"],
              "size": int(state.page_size),
              "scroll": "2m",
            },
          }
      ).as(req,
        state.with(
          request("POST", req.url).with(
            {
              "Header": {
                "Accept": ["application/json"],
                "Content-Type": ["application/json"],
                "Authorization": ["Bearer " + state.api_token],
                "X-FP-IntegrationPlatform": ["Elastic"],
                "X-FP-IntegrationVersion": [state.integration_version],
                "X-FP-IntegrationPlatformVersion": [state.integration_platform_version],
              },
              "Body": req.body.encode_json(),
            }
          ).do_request().as(resp,
            (resp.StatusCode == 200) ?
              resp.Body.decode_json().as(body,
                body.?hits.hits.orValue([]).as(hits,
                  {
                    "events": hits.map(e, {"message": e._source.encode_json()}),
                    "scroll_id": (size(hits) > 0) ?
                      body.?_scroll_id.orValue("")
                    :
                      "",
                    "cursor": {
                      "last_indexed_at": (size(hits) > 0) ?
                        string(hits.map(e, int(e._source.header_.indexed_at)).max())
                      :
                        lower_bound,
                    },
                    "want_more": size(hits) > 0,
                  }
                )
              )
            :
              {
                "events": {
                  "error": {
                    "code": string(resp.StatusCode),
                    "id": string(resp.Status),
                    "message": "POST " + req.url + ": " + (
                      (size(resp.Body) != 0) ?
                        string(resp.Body)
                      :
                        string(resp.Status) + " (" + string(resp.StatusCode) + ")"
                    ),
                  },
                },
                "scroll_id": "",
                "want_more": false,
              }
          )
        )
      )
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
