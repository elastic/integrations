inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: jamf_protect
      name: test-aws-s3-jamf_protect
      streams:
        - bucket_arn: arn:aws:s3:::jamf-protect-test
          bucket_list_interval: 5m
          bucket_list_prefix: protect-/alerts/
          data_stream:
            dataset: jamf_protect.alerts
          default_region: us-east-1
          number_of_workers: 5
          publisher_pipeline.disable_host: true
          role_arn: arn:aws:iam::123456789012:role/jamf-protect-reader
          tags:
            - collect_s3_logs
            - forwarded
            - jamf_protect.alerts
      type: aws-s3
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-jamf_protect.alerts-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references: []
