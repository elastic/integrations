host: "{{listen_address}}:{{listen_port}}"
tags:

{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}

{{#each tags as |tag|}}
  - {{tag}}
{{/each}}

{{#if tz_offset}}
fields_under_root: true
fields:
  _conf:
    tz_offset: {{tz_offset}}
{{/if}}
{{#if processors}}
processors:
{{processors}}
{{/if}}

{{#if udp_options}}
{{udp_options}}
{{/if}}
