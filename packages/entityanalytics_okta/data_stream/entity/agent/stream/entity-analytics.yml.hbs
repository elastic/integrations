provider: okta
{{#if use_minimal_state}}
use_minimal_state: true
{{/if}}
tracer.enabled: {{enable_request_tracer}}
tracer.filename: "../../logs/okta/http-request-trace-*.ndjson"
tracer.maxbackups: 5
{{#if id}}
id: {{id}}
{{/if}}
sync_interval: {{sync_interval}}
update_interval: {{update_interval}}
okta_domain: {{okta_domain}}
{{#if client_id}}
oauth2.enabled: true
oauth2.client.id: {{client_id}}
{{#if okta_token_url}}
oauth2.token_url: {{okta_token_url}}
{{else}}
oauth2.token_url: {{okta_domain}}/oauth2/v1/token
{{/if}}
{{#if client_secret}}
oauth2.client.secret: {{client_secret}}
{{/if}}
oauth2.scopes:
{{#each okta_scopes as |scope|}}
  - {{scope}}
{{/each}}
{{#if jwk_json}}
oauth2.jwk_json: {{jwk_json}}
{{/if}}
{{#if jwk_file}}
oauth2.jwk_file: {{jwk_file}}
{{/if}}
{{#if key_pem}}
oauth2.jwk_pem: {{escape_string key_pem}}
{{/if}}
{{else if okta_token}}
okta_token: {{okta_token}}
{{/if}}
dataset: {{dataset}}
enrich_with:
  - groups
{{#if enrich_user_roles}}
  - roles
{{else if enrich_user_perms}}
{{!-- Permissions enrichment implies role enrichment. In the legacy path,
      "perms" already causes roles to be enriched, so explicitly adding
      "roles" here has no functional effect there. The minimal-state path,
      however, only fetches permissions as part of the "roles" enrichment,
      so "roles" must be listed explicitly. --}}
  - roles
{{/if}}
{{#if enrich_user_factors}}
  - factors
{{/if}}
{{#if enrich_user_perms}}
{{!-- The minimal-state provider validates enrich_with strictly and names
      this enrichment "permissions"; the legacy path only understands
      "perms". Collapse to "permissions" once the minimum supported agent
      accepts it on the legacy path too. --}}
{{#if use_minimal_state}}
  - permissions
{{else}}
  - perms
{{/if}}
{{/if}}
{{#if enrich_user_devices}}
  - devices
{{/if}}
{{#if enrich_user_supervises}}
  - supervises
{{/if}}
{{#if proxy_url}}
request.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
request.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
request.timeout: {{http_client_timeout}}
{{/if}}
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#if preserve_duplicate_custom_fields}}
  - preserve_duplicate_custom_fields
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
processors:
{{#if processors}}
{{processors}}
{{/if}}
- add_fields:
    target: ''
    fields:
      okta_domain: {{okta_domain}}
