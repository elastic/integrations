interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: {{url}}
auth.oauth2:
  client.id: {{client_id}}
  client.secret: {{client_secret}}
  token_url: {{login_url}}/{{tenant_id}}/oauth2/v2.0/token
  scopes: {{token_scopes}}
{{#if oauth_endpoint_params}}
  endpoint_params: {{oauth_endpoint_params}}
{{/if}}
state:
  page_size: {{page_size}}
redact:
  fields: ~
program: |
  request("GET",
    (has(state.?cursor.next_link) && state.cursor.next_link != "") ?
      state.cursor.next_link
    :
      state.url.trim_right("/") + "/api/machines/baselineComplianceAssessmentByMachine?" + {
        "pageSize": [string(int(state.page_size))],
      }.format_query()
  ).do_request().as(resp, resp.StatusCode == 200 ?
    resp.Body.decode_json().as(body,
      {
        "events": ("value" in body ? body.value : []).map(e, {"message": e.encode_json()}),
        "cursor": {
          ?"next_link": ("@odata.nextLink" in body) ?
            optional.of(body["@odata.nextLink"])
          :
            optional.none(),
        },
        "want_more": "@odata.nextLink" in body,
      }
    )
  :
    {
      "events": {
        "error": {
          "code": string(resp.StatusCode),
          "id": resp.Status,
          "message": "GET " + state.url.trim_right("/") + "/api/machines/baselineComplianceAssessmentByMachine: " + (
            size(resp.Body) != 0 ?
              string(resp.Body)
            :
              resp.Status + " (" + string(resp.StatusCode) + ")"
          ),
        },
      },
      "want_more": false,
    }
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
