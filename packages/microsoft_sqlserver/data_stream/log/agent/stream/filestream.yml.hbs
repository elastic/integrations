paths:
{{#each paths as |path i|}}
 - {{path}}
{{/each}}
prospector.scanner.exclude_files: ['\.gz$']
# SQL Server can rotate an error log before it reaches the 1 KiB fingerprint threshold.
file_identity.native: ~
prospector.scanner.fingerprint.enabled: false
take_over: true
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag i|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
parsers:
  - multiline:
      pattern: '^\d{4}-\d{2}-\d{2}'
      negate: true
      match: after
{{#if encoding}}
encoding: {{encoding}}
{{/if}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
