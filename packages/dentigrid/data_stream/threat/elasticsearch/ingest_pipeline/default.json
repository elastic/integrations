{
  "description": "Pipeline for normalizing DentiGrid threat deception telemetry into ECS v9.3.0",
  "processors": [
    {
      "set": {
        "tag": "set_ecs_version",
        "field": "ecs.version",
        "value": "9.3.0"
      }
    },
    {
      "set": {
        "tag": "set_event_dataset",
        "field": "event.dataset",
        "value": "dentigrid.threat"
      }
    },
    {
      "set": {
        "tag": "set_event_module",
        "field": "event.module",
        "value": "dentigrid"
      }
    },
    {
      "set": {
        "tag": "set_event_kind",
        "field": "event.kind",
        "value": "alert"
      }
    },
    {
      "set": {
        "tag": "set_event_category",
        "field": "event.category",
        "value": [
          "intrusion_detection",
          "threat",
          "network"
        ]
      }
    },
    {
      "set": {
        "tag": "set_event_type",
        "field": "event.type",
        "value": [
          "denied",
          "indicator"
        ]
      }
    },
    {
      "set": {
        "tag": "set_event_outcome",
        "field": "event.outcome",
        "value": "failure"
      }
    },
    {
      "set": {
        "tag": "set_observer_vendor",
        "field": "observer.vendor",
        "value": "DentiSystems"
      }
    },
    {
      "set": {
        "tag": "set_observer_product",
        "field": "observer.product",
        "value": "DentiGrid"
      }
    },
    {
      "set": {
        "tag": "set_observer_type",
        "field": "observer.type",
        "value": "deception-honeynet"
      }
    },
    {
      "rename": {
        "tag": "rename_message_to_event_original",
        "field": "message",
        "target_field": "event.original",
        "ignore_missing": true,
        "if": "ctx.event?.original == null"
      }
    },
    {
      "remove": {
        "tag": "remove_message",
        "field": "message",
        "ignore_missing": true,
        "if": "ctx.event?.original != null"
      }
    },
    {
      "json": {
        "tag": "json_event_original",
        "field": "event.original",
        "target_field": "json",
        "ignore_missing": true
      }
    },
    {
      "date": {
        "tag": "date_timestamp",
        "field": "json.timestamp",
        "target_field": "@timestamp",
        "formats": [
          "ISO8601",
          "UNIX_MS",
          "UNIX"
        ],
        "ignore_missing": true,
        "ignore_failure": true
      }
    },
    {
      "date": {
        "tag": "date_time",
        "field": "json.time",
        "target_field": "@timestamp",
        "formats": [
          "UNIX",
          "UNIX_MS",
          "ISO8601"
        ],
        "ignore_missing": true,
        "ignore_failure": true,
        "if": "ctx['@timestamp'] == null"
      }
    },
    {
      "date": {
        "tag": "date_root_timestamp",
        "field": "timestamp",
        "target_field": "@timestamp",
        "formats": [
          "ISO8601",
          "UNIX_MS",
          "UNIX"
        ],
        "ignore_missing": true,
        "ignore_failure": true,
        "if": "ctx['@timestamp'] == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_src_ip",
        "field": "json.src_ip",
        "target_field": "source.ip",
        "ignore_missing": true,
        "if": "ctx.source?.ip == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_sourceIP",
        "field": "json.sourceIP",
        "target_field": "source.ip",
        "ignore_missing": true,
        "if": "ctx.source?.ip == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_src",
        "field": "json.src",
        "target_field": "source.ip",
        "ignore_missing": true,
        "if": "ctx.source?.ip == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_ip",
        "field": "json.ip",
        "target_field": "source.ip",
        "ignore_missing": true,
        "if": "ctx.source?.ip == null"
      }
    },
    {
      "rename": {
        "tag": "rename_root_src_ip",
        "field": "src_ip",
        "target_field": "source.ip",
        "ignore_missing": true,
        "if": "ctx.source?.ip == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_src_port",
        "field": "json.src_port",
        "target_field": "source.port",
        "ignore_missing": true,
        "if": "ctx.source?.port == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_spt",
        "field": "json.spt",
        "target_field": "source.port",
        "ignore_missing": true,
        "if": "ctx.source?.port == null"
      }
    },
    {
      "rename": {
        "tag": "rename_root_src_port",
        "field": "src_port",
        "target_field": "source.port",
        "ignore_missing": true,
        "if": "ctx.source?.port == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_src_host",
        "field": "json.src_host",
        "target_field": "source.domain",
        "ignore_missing": true,
        "if": "ctx.source?.domain == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_src_mac",
        "field": "json.src_mac",
        "target_field": "source.mac",
        "ignore_missing": true,
        "if": "ctx.source?.mac == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_dest_ip",
        "field": "json.dest_ip",
        "target_field": "destination.ip",
        "ignore_missing": true,
        "if": "ctx.destination?.ip == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_destinationIP",
        "field": "json.destinationIP",
        "target_field": "destination.ip",
        "ignore_missing": true,
        "if": "ctx.destination?.ip == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_dst",
        "field": "json.dst",
        "target_field": "destination.ip",
        "ignore_missing": true,
        "if": "ctx.destination?.ip == null"
      }
    },
    {
      "rename": {
        "tag": "rename_root_dest_ip",
        "field": "dest_ip",
        "target_field": "destination.ip",
        "ignore_missing": true,
        "if": "ctx.destination?.ip == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_dest_port",
        "field": "json.dest_port",
        "target_field": "destination.port",
        "ignore_missing": true,
        "if": "ctx.destination?.port == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_dpt",
        "field": "json.dpt",
        "target_field": "destination.port",
        "ignore_missing": true,
        "if": "ctx.destination?.port == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_port",
        "field": "json.port",
        "target_field": "destination.port",
        "ignore_missing": true,
        "if": "ctx.destination?.port == null"
      }
    },
    {
      "rename": {
        "tag": "rename_root_dest_port",
        "field": "dest_port",
        "target_field": "destination.port",
        "ignore_missing": true,
        "if": "ctx.destination?.port == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_dest_host",
        "field": "json.dest_host",
        "target_field": "destination.domain",
        "ignore_missing": true,
        "if": "ctx.destination?.domain == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_protocol",
        "field": "json.protocol",
        "target_field": "network.transport",
        "ignore_missing": true,
        "if": "ctx.network?.transport == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_proto",
        "field": "json.proto",
        "target_field": "network.transport",
        "ignore_missing": true,
        "if": "ctx.network?.transport == null"
      }
    },
    {
      "rename": {
        "tag": "rename_root_protocol",
        "field": "protocol",
        "target_field": "network.transport",
        "ignore_missing": true,
        "if": "ctx.network?.transport == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_src_user",
        "field": "json.src_user",
        "target_field": "user.name",
        "ignore_missing": true,
        "if": "ctx.user?.name == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_username",
        "field": "json.username",
        "target_field": "user.name",
        "ignore_missing": true,
        "if": "ctx.user?.name == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_user",
        "field": "json.user",
        "target_field": "user.name",
        "ignore_missing": true,
        "if": "ctx.user?.name == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_signature",
        "field": "json.signature",
        "target_field": "rule.name",
        "ignore_missing": true,
        "if": "ctx.rule?.name == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_signature_id",
        "field": "json.signature_id",
        "target_field": "rule.id",
        "ignore_missing": true,
        "if": "ctx.rule?.id == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_threat_type",
        "field": "json.threat_type",
        "target_field": "threat.indicator.type",
        "ignore_missing": true,
        "if": "ctx.threat?.indicator?.type == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_mitre_tactic_id",
        "field": "json.mitre_tactic_id",
        "target_field": "threat.tactic.id",
        "ignore_missing": true,
        "if": "ctx.threat?.tactic?.id == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_mitre_tactic_name",
        "field": "json.mitre_tactic_name",
        "target_field": "threat.tactic.name",
        "ignore_missing": true,
        "if": "ctx.threat?.tactic?.name == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_mitre_technique_id",
        "field": "json.mitre_technique_id",
        "target_field": "threat.technique.id",
        "ignore_missing": true,
        "if": "ctx.threat?.technique?.id == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_mitre_technique_name",
        "field": "json.mitre_technique_name",
        "target_field": "threat.technique.name",
        "ignore_missing": true,
        "if": "ctx.threat?.technique?.name == null"
      }
    },
    {
      "set": {
        "tag": "set_threat_framework",
        "field": "threat.framework",
        "value": "MITRE ATT&CK",
        "if": "ctx.threat?.tactic?.id != null || ctx.threat?.technique?.id != null"
      }
    },
    {
      "set": {
        "tag": "set_threat_tactic_reference",
        "field": "threat.tactic.reference",
        "value": "https://attack.mitre.org/tactics/{{{threat.tactic.id}}}/",
        "if": "ctx.threat?.tactic?.id != null",
        "ignore_failure": true
      }
    },
    {
      "set": {
        "tag": "set_threat_technique_reference",
        "field": "threat.technique.reference",
        "value": "https://attack.mitre.org/techniques/{{{threat.technique.id}}}/",
        "if": "ctx.threat?.technique?.id != null",
        "ignore_failure": true
      }
    },
    {
      "rename": {
        "tag": "rename_json_severity",
        "field": "json.severity",
        "target_field": "event.severity",
        "ignore_missing": true,
        "if": "ctx.event?.severity == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_action",
        "field": "json.action",
        "target_field": "event.action",
        "ignore_missing": true,
        "if": "ctx.event?.action == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_node_id",
        "field": "json.node_id",
        "target_field": "observer.name",
        "ignore_missing": true,
        "if": "ctx.observer?.name == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_sensor_id",
        "field": "json.sensor_id",
        "target_field": "observer.serial_number",
        "ignore_missing": true,
        "if": "ctx.observer?.serial_number == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_honey_service",
        "field": "json.honey_service",
        "target_field": "dentigrid.deception.honey_service",
        "ignore_missing": true,
        "if": "ctx.dentigrid?.deception?.honey_service == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_share_path",
        "field": "json.share_path",
        "target_field": "dentigrid.deception.share_path",
        "ignore_missing": true,
        "if": "ctx.dentigrid?.deception?.share_path == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_raw_payload",
        "field": "json.raw_payload",
        "target_field": "dentigrid.deception.raw_payload",
        "ignore_missing": true,
        "if": "ctx.dentigrid?.deception?.raw_payload == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_heuristic_classification",
        "field": "json.heuristic_classification",
        "target_field": "dentigrid.deception.heuristic_classification",
        "ignore_missing": true,
        "if": "ctx.dentigrid?.deception?.heuristic_classification == null"
      }
    },
    {
      "rename": {
        "tag": "rename_json_category",
        "field": "json.category",
        "target_field": "dentigrid.category",
        "ignore_missing": true,
        "if": "ctx.dentigrid?.category == null"
      }
    },
    {
      "network_direction": {
        "tag": "network_direction",
        "source_ip": "source.ip",
        "destination_ip": "destination.ip",
        "internal_networks": [
          "private"
        ],
        "ignore_missing": true,
        "if": "ctx.source?.ip != null && ctx.destination?.ip != null"
      }
    },
    {
      "append": {
        "tag": "append_lateral_movement_tripwire",
        "field": "tags",
        "value": "lateral_movement_tripwire",
        "allow_duplicates": false,
        "if": "ctx.network?.direction == 'internal'"
      }
    },
    {
      "geoip": {
        "tag": "geoip_source",
        "field": "source.ip",
        "target_field": "source.geo",
        "ignore_missing": true
      }
    },
    {
      "geoip": {
        "tag": "geoip_source_asn",
        "database_file": "GeoLite2-ASN.mmdb",
        "field": "source.ip",
        "target_field": "source.as",
        "properties": [
          "asn",
          "organization_name"
        ],
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "tag": "rename_source_as_asn",
        "field": "source.as.asn",
        "target_field": "source.as.number",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "tag": "rename_source_as_organization_name",
        "field": "source.as.organization_name",
        "target_field": "source.as.organization.name",
        "ignore_missing": true
      }
    },
    {
      "remove": {
        "tag": "remove_event_original",
        "field": "event.original",
        "if": "ctx.tags == null || !ctx.tags.contains('preserve_original_event')",
        "ignore_missing": true
      }
    },
    {
      "remove": {
        "tag": "remove_json",
        "field": "json",
        "ignore_missing": true
      }
    }
  ],
  "on_failure": [
    {
      "append": {
        "tag": "append_error_message",
        "field": "error.message",
        "value": "Processor '{{{ _ingest.on_failure_processor_type }}}' with tag '{{{ _ingest.on_failure_processor_tag }}}' in pipeline '{{{ _ingest.on_failure_pipeline }}}' failed with message '{{{ _ingest.on_failure_message }}}'"
      }
    },
    {
      "set": {
        "tag": "set_pipeline_error_kind",
        "field": "event.kind",
        "value": "pipeline_error"
      }
    },
    {
      "append": {
        "tag": "append_preserve_original_event",
        "field": "tags",
        "value": "preserve_original_event",
        "allow_duplicates": false
      }
    }
  ]
}