[
  {
    "id": "dentigrid-rule-internal-lateral-movement",
    "name": "DentiGrid Deception: Internal Lateral Movement Intercept",
    "description": "Detects internal hosts interacting with DentiGrid honeynet decoy services (SMB, RDP, SSH, MSRPC). Indicates confirmed lateral movement or internal network compromise with zero false positives.",
    "risk_score": 95,
    "severity": "critical",
    "type": "query",
    "language": "kuery",
    "query": "event.dataset: \"dentigrid.threat\" and network.direction: \"internal\" and event.severity >= 7",
    "index": [
      "logs-dentigrid.threat-*"
    ],
    "interval": "5m",
    "from": "now-6m",
    "threat": [
      {
        "framework": "MITRE ATT&CK",
        "tactic": {
          "id": "TA0008",
          "name": "Lateral Movement",
          "reference": "https://attack.mitre.org/tactics/TA0008/"
        },
        "technique": [
          {
            "id": "T1021.002",
            "name": "SMB/Windows Admin Shares",
            "reference": "https://attack.mitre.org/techniques/T1021/002/"
          },
          {
            "id": "T1021.001",
            "name": "Remote Desktop Protocol",
            "reference": "https://attack.mitre.org/techniques/T1021/001/"
          }
        ]
      }
    ],
    "tags": [
      "DentiGrid",
      "Active Deception",
      "Lateral Movement",
      "Zero False Positive"
    ]
  },
