interval: {{interval}}
resource.url: {{url}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
state:
  token: "{{api_token}}"
redact:
  fields:
    - token
program: |
  state.with(
    get_request(state.url.trim_right("/") + "/api/data/connectors/elastic/pull/").with({
      "Header": {
        "Authorization": ["Token " + state.token],
      },
    }).do_request().as(resp,
      {
        "events": (resp.StatusCode == 200 && size(resp.Body) > 0) ?
          resp.Body.decode_json().map(e, {"event": {"original": e.encode_json()}})
        : resp.StatusCode != 200 ?
          dyn({
            "error": {
              "code": string(resp.StatusCode),
              "id": resp.Status,
              "message": "GET " + state.url.trim_right("/") + "/api/data/connectors/elastic/pull/: " + (
                size(resp.Body) != 0 ?
                  string(resp.Body)
                :
                  resp.Status + " (" + string(resp.StatusCode) + ")"
              )
            }
          })
        :
          [],
        "want_more": true, // This will be ignored if the events field has no elements.
      }
    )
  )
