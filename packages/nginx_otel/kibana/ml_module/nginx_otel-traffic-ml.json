{
  "id": "nginx_otel-traffic-ml",
  "type": "ml-module",
  "migrationVersion": {
    "search": "7.9.3"
  },
  "references": [],
  "attributes": {
    "id": "nginx_otel-traffic-ml",
    "title": "[Nginx OTel] Request rate anomalies",
    "description": "Detect Nginx hosts whose request rate drops or surges against their learned daily and weekly pattern, from the Nginx (OpenTelemetry) access logs.",
    "type": "Web server logs",
    "logo": {
      "icon": "logoNginx"
    },
    "defaultIndexPattern": "logs-nginx.access.otel-*",
    "query": {
      "bool": {
        "filter": [
          {
            "term": {
              "data_stream.dataset": "nginx.access.otel"
            }
          },
          {
            "exists": {
              "field": "host.name"
            }
          }
        ],
        "must_not": {
          "terms": {
            "_tier": [
              "data_frozen",
              "data_cold"
            ]
          }
        }
      }
    },
    "jobs": [
      {
        "id": "nginx_host_request_rate_anomaly",
        "config": {
          "groups": [
            "nginx",
            "otel"
          ],
          "description": "Nginx OTel access logs: unusual request rate per host (drops and surges) against its learned daily and weekly pattern.",
          "analysis_config": {
            "bucket_span": "15m",
            "summary_count_field_name": "doc_count",
            "detectors": [
              {
                "detector_description": "Request rate per host",
                "function": "count",
                "partition_field_name": "host.name"
              }
            ],
            "influencers": [
              "host.name"
            ]
          },
          "analysis_limits": {
            "model_memory_limit": "128mb"
          },
          "data_description": {
            "time_field": "@timestamp",
            "time_format": "epoch_ms"
          },
          "model_plot_config": {
            "enabled": true,
            "annotations_enabled": true
          },
          "custom_settings": {
            "created_by": "ml-module-nginx-otel-traffic-ml",
            "custom_urls": [
              {
                "url_name": "Traffic & Capacity for this host",
                "url_value": "dashboards#/view/nginx_otel-c3d4e5f6-a7b8-9012-cdef-123456789012?_g=(filters:!(),time:(from:'$earliest$',mode:absolute,to:'$latest$'))&_a=(filters:!(),query:(language:kuery,query:'host.name:\"$host.name$\"'))"
              },
              {
                "url_name": "Request Health for this host",
                "url_value": "dashboards#/view/nginx_otel-a1b2c3d4-e5f6-7890-abcd-ef1234567890?_g=(filters:!(),time:(from:'$earliest$',mode:absolute,to:'$latest$'))&_a=(filters:!(),query:(language:kuery,query:'host.name:\"$host.name$\"'))"
              }
            ]
          }
        }
      }
    ],
    "datafeeds": [
      {
        "id": "datafeed-nginx_host_request_rate_anomaly",
        "job_id": "nginx_host_request_rate_anomaly",
        "config": {
          "job_id": "nginx_host_request_rate_anomaly",
          "indices": [
            "INDEX_PATTERN_NAME"
          ],
          "query": {
            "bool": {
              "filter": [
                {
                  "term": {
                    "data_stream.dataset": "nginx.access.otel"
                  }
                }
              ],
              "must_not": [
                {
                  "term": {
                    "url.path": "/nginx_status"
                  }
                }
              ]
            }
          },
          "aggregations": {
            "buckets": {
              "composite": {
                "size": 1000,
                "sources": [
                  {
                    "date": {
                      "date_histogram": {
                        "field": "@timestamp",
                        "fixed_interval": "90s"
                      }
                    }
                  },
                  {
                    "host.name": {
                      "terms": {
                        "field": "host.name"
                      }
                    }
                  }
                ]
              },
              "aggregations": {
                "@timestamp": {
                  "max": {
                    "field": "@timestamp"
                  }
                }
              }
            }
          },
          "indices_options": {
            "allow_no_indices": true
          },
          "frequency": "3m"
        }
      }
    ]
  }
}
