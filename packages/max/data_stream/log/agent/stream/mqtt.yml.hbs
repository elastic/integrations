hosts:
{{#each hosts}}
  - {{this}}
{{/each}}
topics:
{{#each topics}}
  - {{this}}
{{/each}}
{{#if client_id}}
client_id: {{client_id}}
{{/if}}
{{#if qos}}
qos: {{qos}}
{{/if}}
{{#if username}}
username: {{username}}
{{/if}}
{{#if password}}
password: {{password}}
{{/if}}
{{#if ssl}}
ssl: {{ssl}}
{{/if}}
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
