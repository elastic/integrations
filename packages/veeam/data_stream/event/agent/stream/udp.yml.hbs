host: "{{listen_address}}:{{listen_port}}"
{{#if udp_options}}
{{udp_options}}
{{/if}}
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
processors:
{{#if preserve_original_event}}
- copy_fields:
    fields:
      - from: message
        to: event.original
{{/if}}
- syslog:
    field: message
    format: auto
{{#if processors}}
{{processors}}
{{/if}}
