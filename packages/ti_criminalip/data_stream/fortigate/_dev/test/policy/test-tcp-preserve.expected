inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: ti_criminalip
      name: test-tcp-preserve-ti_criminalip
      streams:
        - data_stream:
            dataset: ti_criminalip.fortigate
          framing: rfc6587
          host: 127.0.0.1:19515
          processors:
            - add_tags:
                tags:
                    - test
          publisher_pipeline.disable_host: true
          ssl:
            enabled: true
          tags:
            - forwarded
            - synthetic
            - preserve_original_event
      type: tcp
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-ti_criminalip.fortigate-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references: []
