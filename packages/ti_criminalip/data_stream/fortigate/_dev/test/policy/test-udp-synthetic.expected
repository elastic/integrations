inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: ti_criminalip
      name: test-udp-synthetic-ti_criminalip
      streams:
        - data_stream:
            dataset: ti_criminalip.fortigate
          host: 127.0.0.1:19514
          publisher_pipeline.disable_host: true
          tags:
            - forwarded
            - synthetic
      type: udp
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-ti_criminalip.fortigate-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references: []
