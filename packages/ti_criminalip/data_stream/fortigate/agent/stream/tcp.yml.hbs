host: "{{host}}"
framing: rfc6587
{{#if ssl}}
ssl: {{ssl}}
{{/if}}
tags:
  - forwarded
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
publisher_pipeline.disable_host: true

{{#if tz_offset}}
fields_under_root: true
fields:
  _conf:
    tz_offset: "{{tz_offset}}"
{{/if}}
