[
  {
    "op": "add",
    "path": "/Resources/ElasticCloudConnectorsRole/Properties/Policies/-",
    "value": {
      "PolicyName": "ElasticKSPMEKSAccess",
      "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "KSPMEKSReadAccess",
            "Effect": "Allow",
            "Action": [
              "eks:DescribeCluster",
              "eks:ListClusters",
              "ec2:DescribeInstances",
              "ec2:DescribeSecurityGroups",
              "ec2:DescribeSubnets",
              "iam:GetRole",
              "iam:ListAttachedRolePolicies"
            ],
            "Resource": "*"
          }
        ]
      }
    }
  }
]
