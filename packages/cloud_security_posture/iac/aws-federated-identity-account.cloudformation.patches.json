[
  {
    "op": "add",
    "path": "/Resources/ElasticCloudConnectorsRole/Properties/ManagedPolicyArns/-",
    "value": "arn:aws:iam::aws:policy/SecurityAudit"
  },
  {
    "op": "add",
    "path": "/Resources/ElasticCloudConnectorsRole/Properties/Policies/-",
    "value": {
      "PolicyName": "ElasticCSPMAWSSupplementalAccess",
      "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "CSPMSupplemental",
            "Effect": "Allow",
            "Action": [
              "access-analyzer:ListAnalyzers",
              "organizations:DescribeOrganization",
              "organizations:ListAccounts",
              "organizations:ListDelegatedAdministrators",
              "account:GetAlternateContact"
            ],
            "Resource": "*"
          }
        ]
      }
    }
  }
]
