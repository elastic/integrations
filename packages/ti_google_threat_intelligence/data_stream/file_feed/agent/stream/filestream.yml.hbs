paths:
{{#each paths as |path|}}
  - {{path}}
{{/each}}
prospector.scanner.exclude_files: ['\.gz$', '\.bz2$']
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
processors:
- add_fields:
    target: _conf
    fields:
      drop_below_threshold: {{drop_below_threshold}}
      keep_engine_results: {{keep_engine_results}}
      indicator_min_threat_score: {{indicator_min_threat_score}}
      indicator_min_malicious_detections: {{indicator_min_malicious_detections}}
      indicator_verdicts:
{{#each indicator_verdicts as |verdict|}}
        - {{verdict}}
{{/each}}
{{#if type_tags_include}}
      type_tags_include:
{{#each type_tags_include as |type_tag|}}
        - {{type_tag}}
{{/each}}
{{/if}}
{{#if tags_exclude}}
      tags_exclude:
{{#each tags_exclude as |tag|}}
        - {{tag}}
{{/each}}
{{/if}}
{{#if processors}}
{{processors}}
{{/if}}
