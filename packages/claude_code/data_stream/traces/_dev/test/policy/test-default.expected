connectors:
    forward/componentid-0: {}
exporters:
    elasticsearch/componentid-0:
        endpoints:
            - https://elasticsearch:9200
inputs: []
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - traces-claude_code.otel-ep
                  privileges:
                    - auto_configure
                    - create_doc
                - names:
                    - logs-claude_code.otel-ep
                  privileges:
                    - auto_configure
                    - create_doc
processors:
    transform/componentid-0:
        trace_statements:
            - context: span
              statements:
                - set(attributes["data_stream.type"], "traces")
                - set(attributes["data_stream.dataset"], "claude_code")
                - set(attributes["data_stream.namespace"], "ep")
            - context: spanevent
              statements:
                - set(attributes["data_stream.type"], "logs")
                - set(attributes["data_stream.dataset"], "claude_code")
                - set(attributes["data_stream.namespace"], "ep")
receivers:
    otlp/componentid-0:
        protocols:
            http:
                endpoint: 0.0.0.0:4320
secret_references: []
service:
    pipelines:
        traces/componentid-0:
            exporters:
                - elasticsearch/componentid-0
            receivers:
                - forward/componentid-0
        traces/componentid-1:
            exporters:
                - forward/componentid-0
            processors:
                - transform/componentid-0
            receivers:
                - otlp/componentid-0
