inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: iru
      name: test-default-iru
      streams:
        - data_stream:
            dataset: iru.audit
          interval: 10m
          processors:
            - drop_event:
                when:
                    equals:
                        retry: true
          program: |-
            (
              state.?want_more.orValue(false) ?
                state
              :
                // Clear pagination scratch fields when starting a new collection interval.
                state.drop(
                  [
                    "next_url",
                    "admin_keys",
                    "admin_values",
                    "admin_next_url",
                  ]
                ).with(
                  {
                    "admins_fetched": false,
                  }
                )
            ).as(state,
              !state.?admins_fetched.orValue(false) ?
                request(
                  "GET",
                  has(state.admin_next_url) && state.admin_next_url != "" ?
                    state.admin_next_url
                  :
                    state.url.trim_right("/") + "/api/v1/admins?" + {
                      "limit": [string(int(state.batch_size))],
                    }.format_query()
                ).with(
                  {
                    "Header": {
                      "Authorization": ["Bearer " + state.api_token],
                      "Accept": ["application/json"],
                    },
                  }
                ).do_request().as(resp,
                  resp.StatusCode == 200 ?
                    resp.Body.decode_json().as(body,
                      state.with(
                        {
                          "events": [{"retry": true}],
                          "want_more": true,
                          "admin_keys": state.?admin_keys.orValue([]) + body.?results.optMap(r, r.map(a, a.id)).orValue([]),
                          "admin_values": state.?admin_values.orValue([]) + body.?results.orValue([]),
                          "admin_next_url": has(body.next) && body.next != null ? string(body.next) : "",
                          "admins_fetched": !(has(body.next) && body.next != null),
                        }
                      )
                    )
                  : resp.StatusCode == 403 ?
                    state.with(
                      {
                        "events": [{"retry": true}],
                        "want_more": true,
                        "admins_fetched": true,
                      }
                    )
                  :
                    state.with(
                      {
                        "events": [
                          {
                            "error": {
                              "code": string(resp.StatusCode),
                              "id": resp.Status,
                              "message": "GET " + state.url.trim_right("/") + "/api/v1/admins: " + (
                                size(resp.Body) != 0 ?
                                  string(resp.Body)
                                :
                                  resp.Status + ' (' + string(resp.StatusCode) + ')'
                              ),
                            },
                          },
                        ],
                        "want_more": false,
                      }
                    )
                )
              :
                request(
                  "GET",
                  has(state.next_url) && state.next_url != "" ?
                    state.next_url
                  :
                    state.url.trim_right("/") + "/api/v1/audit/events?" + {
                      "limit": [string(int(state.batch_size))],
                      "sort_by": ["occurred_at"],
                      "start_date": [state.?cursor.occurred_at.orValue(
                        string(now - duration(state.initial_interval))
                      )],
                    }.format_query()
                ).with(
                  {
                    "Header": {
                      "Authorization": ["Bearer " + state.api_token],
                      "Accept": ["application/json"],
                    },
                  }
                ).do_request().as(resp,
                  resp.StatusCode == 200 ?
                    resp.Body.decode_json().as(body,
                      zip(state.?admin_keys.orValue([]), state.?admin_values.orValue([])).as(admin_map,
                        state.with(
                          {
                            "events": has(body.results) ?
                              body.results.map(e,
                                e.actor_type == "user" && e.actor_id != "" &&
                                e.actor_id in admin_map ?
                                  {
                                    "message": e.with(
                                      {
                                        "admin": admin_map[?e.actor_id],
                                      }
                                    ).encode_json(),
                                  }
                                :
                                  {"message": e.encode_json()}
                              )
                            :
                              [],
                            "want_more": has(body.next) && body.next != null,
                            ?"next_url": has(body.next) && body.next != null ?
                              optional.of(string(body.next))
                            :
                              optional.none(),
                            "cursor": {
                              "occurred_at": has(body.results) && size(body.results) > 0 ?
                                body.results.map(e, e.occurred_at).max()
                              :
                                state.?cursor.occurred_at.orValue(
                                  string(now - duration(state.initial_interval))
                                ),
                            },
                            "admin_keys": has(body.next) && body.next != null ? state.?admin_keys.orValue([]) : [],
                            "admin_values": has(body.next) && body.next != null ? state.?admin_values.orValue([]) : [],
                            "admins_fetched": has(body.next) && body.next != null,
                          }
                        )
                      )
                    )
                  :
                    {
                      "events": {
                        "error": {
                          "code": string(resp.StatusCode),
                          "id": resp.Status,
                          "message": "GET " + state.url.trim_right("/") + "/api/v1/audit/events: " + (
                            size(resp.Body) != 0 ?
                              string(resp.Body)
                            :
                              resp.Status + ' (' + string(resp.StatusCode) + ')'
                          ),
                        },
                      },
                      "want_more": false,
                    }
                )
            )
          publisher_pipeline.disable_host: true
          redact:
            fields:
                - api_token
          resource.ssl: null
          resource.tracer:
            enabled: false
            filename: ../../logs/cel/http-request-trace-*.ndjson
            maxbackups: 5
          resource.url: https://example.api.kandji.io
          state:
            admins_fetched: false
            api_token: ${SECRET_0}
            batch_size: 500
            initial_interval: 24h
            want_more: false
          tags:
            - forwarded
            - iru-audit
      type: cel
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-iru.audit-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references:
    - {}
