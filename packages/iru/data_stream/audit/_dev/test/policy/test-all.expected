                  sxSmbIUfc2SGJGCJD4I=
                  -----END CERTIFICATE-----
          resource.timeout: 30s
          resource.tracer:
            enabled: true
            filename: ../../logs/cel/http-request-trace-*.ndjson
            maxbackups: 5
          resource.url: https://example.api.kandji.io
          state:
            api_token: ${SECRET_0}
            batch_size: 500
            initial_interval: 24h
          tags:
            - preserve_original_event
            - forwarded
            - iru-audit
      type: cel
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-iru.audit-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references:
    - {}
