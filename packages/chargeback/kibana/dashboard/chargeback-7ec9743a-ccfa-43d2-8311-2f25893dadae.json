                                            "index": "2bf6c0d816ef0a2d56d03ede549c16c08c35db2cf02d78c12756a98a33f50e4f",
                                            "query": {
                                                "esql": "FROM billing_cluster_cost_lookup\n| WHERE @timestamp IS NOT NULL AND deployment_id IS NOT NULL\n| EVAL ts = @timestamp, ck = composite_key::keyword, b_dep_id = deployment_id, b_dep_name = deployment_name\n| DROP composite_key\n| LOOKUP JOIN cluster_deployment_contribution_lookup ON ck == composite_key\n| EVAL store_gib = TO_DOUBLE(deployment_sum_store_size) / 1073741824.0\n| EVAL u_day = CASE(deployment_sum_store_size IS NOT NULL, ts, null)\n| DROP composite_key, deployment_id, @timestamp\n| LOOKUP JOIN cluster_capacity_utilization_lookup ON ck == composite_key\n| EVAL n_day = CASE(heap_used_pct_p95 IS NOT NULL, ts, null)\n| DROP composite_key, deployment_id, @timestamp\n| LOOKUP JOIN chargeback_conf_lookup ON ts >= conf_start_date AND ts <= conf_end_date\n| EVAL rate = COALESCE(conf_chargeable_unit_rate, 0.85)\n| EVAL platform = CASE(ess.billing.deployment_type == \"deployment\" OR cloud.provider IN (\"aws\", \"gcp\", \"azure\", \"onprem\"), \"ECH\", \"Serverless\")\n| EVAL grp = CASE(deployment_group IS NOT NULL AND deployment_group != \"\", deployment_group, \"(unassigned)\")\n| EVAL reg = CASE(cloud.region IS NOT NULL AND cloud.region != \"\" AND (cloud.region LIKE \"aws-*\" OR cloud.region LIKE \"gcp-*\" OR cloud.region LIKE \"azure-*\" OR cloud.region LIKE \"eu-*\" OR cloud.region LIKE \"us-*\"), cloud.region, null)\n| STATS\n    dep_name = MAX(b_dep_name),\n    `Platform` = MAX(platform),\n    `Region` = COALESCE(MAX(reg), \"\u2014\"),\n    `Chargeback Group` = MAX(grp),\n    billed_days = COUNT_DISTINCT(ts),\n    usage_days = COUNT_DISTINCT(u_day),\n    max_store_gib = MAX(store_gib),\n    util_days = COUNT_DISTINCT(n_day),\n    avg_heap = AVG(heap_used_pct_p95),\n    avg_disk = AVG(disk_used_pct_p95),\n    `Billed ECU` = ROUND(SUM(total_chargeable_units), 2),\n    `Normalized Cost` = ROUND(SUM(total_chargeable_units * rate), 2),\n    latest_ts = MAX(ts)\n  BY b_dep_id\n| EVAL\n    `Deployment` = CONCAT(COALESCE(dep_name, b_dep_id), \" (\", LEFT(b_dep_id, 6), \")\"),\n    `Billing Stream` = CONCAT(\"Active (\", TO_STRING(billed_days), \"d)\"),\n    `Usage Stream (_cat/indices)` = CASE(usage_days > 0, CONCAT(\"Active \u00b7 \", TO_STRING(ROUND(COALESCE(max_store_gib, 0.0), 2)), \" GiB (\", TO_STRING(usage_days), \"d)\"), \"Needs ES API key / CCS\"),\n    `Node Stats Stream (JVM/Disk)` = CASE(`Platform` == \"Serverless\", \"N/A (Serverless)\", util_days > 0, CONCAT(\"Active \u00b7 Heap \", TO_STRING(ROUND(COALESCE(avg_heap, 0.0), 1)), \"% / Disk \", TO_STRING(ROUND(COALESCE(avg_disk, 0.0), 1)), \"%\"), \"100% fallback (Needs ES API key)\"),\n    `Latest Billing Day` = LEFT(TO_STRING(latest_ts), 10)\n| SORT `Normalized Cost` DESC, `Deployment` ASC\n| KEEP `Deployment`, `Platform`, `Region`, `Chargeback Group`, `Billing Stream`, `Usage Stream (_cat/indices)`, `Node Stats Stream (JVM/Disk)`, `Billed ECU`, `Normalized Cost`, `Latest Billing Day`\n| LIMIT 200"
                                            },
                                            "timeField": "@timestamp"
                                        }
                                    }
                                }
                            },
