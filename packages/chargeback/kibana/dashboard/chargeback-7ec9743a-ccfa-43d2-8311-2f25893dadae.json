                            "query": {
                                "esql": "FROM billing_cluster_cost_lookup\n| WHERE @timestamp IS NOT NULL AND deployment_id IS NOT NULL\n| EVAL ts = @timestamp, ck = composite_key::keyword\n| DROP composite_key\n| LOOKUP JOIN cluster_deployment_contribution_lookup ON ck == composite_key\n| EVAL has_usage = CASE(deployment_sum_store_size IS NOT NULL, 1, 0)\n| DROP composite_key, deployment_id, @timestamp\n| EVAL deployment_id = ess.billing.deployment_id\n| LOOKUP JOIN cluster_capacity_utilization_lookup ON ck == composite_key\n| EVAL has_util = CASE(heap_used_pct_p95 IS NOT NULL, 1, 0)\n| DROP composite_key, deployment_id, @timestamp\n| EVAL deployment_id = ess.billing.deployment_id\n| LOOKUP JOIN chargeback_conf_lookup ON ts >= conf_start_date AND ts <= conf_end_date\n| EVAL is_ech = CASE(ess.billing.deployment_type == \"deployment\" OR cloud.provider IN (\"aws\", \"gcp\", \"azure\", \"onprem\"), 1, 0)\n| EVAL ech_id = CASE(is_ech == 1, deployment_id, null), sls_id = CASE(is_ech == 0, deployment_id, null)\n| EVAL usage_dep_id = CASE(has_usage == 1, deployment_id, null), util_ech_id = CASE(is_ech == 1 AND has_util == 1, deployment_id, null)\n| EVAL rate = COALESCE(conf_chargeable_unit_rate, 0.85), unit = COALESCE(conf_chargeable_unit_rate_unit, \"EUR\")\n| STATS\n    total_deps = COUNT_DISTINCT(deployment_id),\n    ech_deps = COUNT_DISTINCT(ech_id),\n    sls_deps = COUNT_DISTINCT(sls_id),\n    usage_deps = COUNT_DISTINCT(usage_dep_id),\n    util_ech_deps = COUNT_DISTINCT(util_ech_id),\n    total_ecu = ROUND(SUM(total_chargeable_units), 2),\n    total_cost = ROUND(SUM(total_chargeable_units * rate), 2),\n    active_unit = MAX(unit),\n    active_rate = MAX(rate),\n    latest_ts = MAX(ts)\n| EVAL\n    `Billing Stream` = CASE(total_deps > 0, CONCAT(\"Active (\", TO_STRING(total_deps), \" billed)\"), \"Awaiting poll\"),\n    `Platform Mix` = CONCAT(TO_STRING(ech_deps), \" ECH \u00b7 \", TO_STRING(sls_deps), \" Serverless\"),\n    `Usage Stream (_cat/indices)` = CONCAT(TO_STRING(usage_deps), \" / \", TO_STRING(total_deps), \" harvested\"),\n    `Node Stats Stream (ECH)` = CONCAT(TO_STRING(util_ech_deps), \" / \", TO_STRING(ech_deps), \" ECH harvested\"),\n    `Billing Currency & Rate` = CONCAT(active_unit, \" (\u00d7\", TO_STRING(active_rate), \")\"),\n    `Billed ECU` = total_ecu,\n    `Normalized Spend` = total_cost,\n    `Latest Billing Day` = LEFT(TO_STRING(latest_ts), 10)\n| KEEP `Billing Stream`, `Platform Mix`, `Usage Stream (_cat/indices)`, `Node Stats Stream (ECH)`, `Billing Currency & Rate`, `Billed ECU`, `Normalized Spend`, `Latest Billing Day`"
