                                            (is_valid_interval ? ((cur_qry_ms >= int(prev_b.m[1])) ? (cur_qry_ms - int(prev_b.m[1])) : (shard_departed ? 0 : cur_qry_ms)) : (is_new_intraday ? cur_qry_ms : 0)).as(raw_qry,
                                            (is_valid_interval ? ((cur_qry_cnt >= int(prev_b.m[2])) ? (cur_qry_cnt - int(prev_b.m[2])) : (shard_departed ? 0 : cur_qry_cnt)) : (is_new_intraday ? cur_qry_cnt : 0)).as(raw_qcnt,
                                            (is_valid_interval ? ((shard_departed && cur_docs < int(prev_b.m[3])) ? 0 : (cur_docs - int(prev_b.m[3]))) : (is_new_intraday ? cur_docs : 0)).as(raw_docs,
                                            (is_valid_interval ? ((shard_departed && cur_dset < int(prev_b.m[4])) ? 0 : (cur_dset - int(prev_b.m[4]))) : (is_new_intraday ? cur_dset : 0)).as(raw_dset,
                                              (is_valid_interval && prev_t < today_start_sec) ?
                                                (double(today_start_sec - prev_t) / double(now_sec - prev_t)).as(prev_ratio,
                                                int(double(raw_idx) * prev_ratio).as(p_idx,
                                                int(double(raw_qry) * prev_ratio).as(p_qry,
                                                int(double(raw_qcnt) * prev_ratio).as(p_qcnt,
                                                int(double(raw_docs) * prev_ratio).as(p_docs,
                                                int(double(raw_dset) * prev_ratio).as(p_dset,
                                                (now_sec > today_start_sec).as(has_cur_day,
                                                  {
                                                    "gap_sec": 0,
                                                    "evts": [
                                                      dyn({
                                                        "period_start": prev_midnight_ts,
                                                        "period_obs_ts": obs_ts + ":prev",
                                                        "doc_type": "index_usage",
                                                        "deployment_name": string(t.name),
                                                        "elasticsearch": {
                                                          "cluster": { "name": tid },
                                                          "index": ({
                                                            "name": idx_name,
                                                            "tier": row_tier,
                                                            "tier_preference": tier_pref,
                                                            "interval": {
                                                              "start": timestamp(prev_t).format(time_layout.RFC3339),
                                                              "end": today_start.format(time_layout.RFC3339),
                                                              "duration_ms": (today_start_sec - prev_t) * 1000,
                                                            },
                                                            "primaries": {
                                                              "docs": {
                                                                "count": max(0, int(prev_b.m[3]) + p_docs),
                                                                "count_delta": p_docs,
                                                              },
                                                              "store": {
                                                                "total_data_set_size_in_bytes": max(0, int(prev_b.m[4]) + p_dset),
                                                                "total_data_set_size_in_bytes_delta": p_dset,
                                                              },
                                                            },
                                                            "total": {
                                                              "store": { "size_in_bytes": cur_tot },
                                                              "indexing": {
                                                                "index_time_in_millis": p_idx,
                                                                "index_time_in_millis_delta": p_idx,
                                                              },
                                                              "search": {
                                                                "query_time_in_millis": p_qry,
                                                                "query_time_in_millis_delta": p_qry,
                                                                "query_total": p_qcnt,
                                                                "query_total_delta": p_qcnt,
                                                              },
                                                            },
                                                          }).with(idx_extra),
                                                        },
                                                      }),
                                                      dyn({
                                                        "period_start": now_ts,
                                                        "period_obs_ts": obs_ts,
                                                        "doc_type": "index_usage",
                                                        "deployment_name": string(t.name),
                                                        "elasticsearch": {
                                                          "cluster": { "name": tid },
                                                          "index": ({
                                                            "name": idx_name,
                                                            "tier": row_tier,
                                                            "tier_preference": tier_pref,
                                                            "primaries": {
                                                              "docs": has_cur_day ? {
                                                                "count": cur_docs,
                                                                "count_delta": raw_docs - p_docs,
                                                              } : { "count": cur_docs },
                                                              "store": has_cur_day ? {
                                                                "total_data_set_size_in_bytes": cur_dset,
                                                                "total_data_set_size_in_bytes_delta": raw_dset - p_dset,
                                                              } : { "total_data_set_size_in_bytes": cur_dset },
                                                            },
                                                            "total": {
                                                              "store": { "size_in_bytes": cur_tot },
                                                              "indexing": has_cur_day ? {
                                                                "index_time_in_millis": raw_idx - p_idx,
                                                                "index_time_in_millis_delta": raw_idx - p_idx,
                                                              } : { "index_time_in_millis": 0 },
                                                              "search": has_cur_day ? {
                                                                "query_time_in_millis": raw_qry - p_qry,
                                                                "query_time_in_millis_delta": raw_qry - p_qry,
                                                                "query_total": raw_qcnt - p_qcnt,
                                                                "query_total_delta": raw_qcnt - p_qcnt,
                                                              } : { "query_time_in_millis": 0, "query_total": 0 },
                                                            },
                                                          }).with(idx_extra).with(has_cur_day ? {
                                                            "interval": {
                                                              "start": today_start.format(time_layout.RFC3339),
                                                              "end": timestamp(now_sec).format(time_layout.RFC3339),
                                                              "duration_ms": (now_sec - today_start_sec) * 1000,
                                                            },
                                                          } : {}),
                                                        },
                                                      }),
                                                    ],
                                                    "base": dyn({
                                                      "k": bkey,
                                                      "c": tid,
                                                      "t": now_sec,
                                                      "sc": cur_sc,
                                                      "m": [cur_idx_ms, cur_qry_ms, cur_qry_cnt, cur_docs, cur_dset],
                                                    }),
                                                  }
                                                )))))))
                                              :
                                                (idx_prev_t < today_start_sec ? today_start_sec : idx_prev_t).as(arr_start_sec,
                                                (is_valid_interval || is_new_intraday || (is_tier_arrival && now_sec > arr_start_sec)).as(emit_delta,
                                                (is_valid_interval ? prev_t : (is_tier_arrival ? arr_start_sec : created_sec)).as(int_start_sec,
                                                  {
                                                    "gap_sec": is_gap ? (now_sec - prev_t) : 0,
                                                    "evts": [
                                                      dyn({
                                                        "period_start": now_ts,
                                                        "period_obs_ts": obs_ts,
                                                        "doc_type": "index_usage",
                                                        "deployment_name": string(t.name),
                                                        "elasticsearch": {
                                                          "cluster": { "name": tid },
                                                          "index": ({
                                                            "name": idx_name,
                                                            "tier": row_tier,
                                                            "tier_preference": tier_pref,
                                                            "primaries": {
                                                              "docs": emit_delta ? {
                                                                "count": cur_docs,
                                                                "count_delta": raw_docs,
                                                              } : {
                                                                "count": cur_docs,
                                                              },
                                                              "store": emit_delta ? {
                                                                "total_data_set_size_in_bytes": cur_dset,
                                                                "total_data_set_size_in_bytes_delta": raw_dset,
                                                              } : {
                                                                "total_data_set_size_in_bytes": cur_dset,
                                                              },
                                                            },
                                                            "total": {
                                                              "store": { "size_in_bytes": cur_tot },
                                                              "indexing": emit_delta ? {
                                                                "index_time_in_millis": raw_idx,
                                                                "index_time_in_millis_delta": raw_idx,
                                                              } : {
                                                                "index_time_in_millis": 0,
                                                              },
                                                              "search": emit_delta ? {
                                                                "query_time_in_millis": raw_qry,
                                                                "query_time_in_millis_delta": raw_qry,
                                                                "query_total": raw_qcnt,
                                                                "query_total_delta": raw_qcnt,
                                                              } : {
                                                                "query_time_in_millis": 0,
                                                                "query_total": 0,
                                                              },
                                                            },
                                                          }).with(idx_extra).with(emit_delta ? {
                                                            "interval": {
                                                              "start": timestamp(int_start_sec).format(time_layout.RFC3339),
                                                              "end": timestamp(now_sec).format(time_layout.RFC3339),
                                                              "duration_ms": max(1, now_sec - int_start_sec) * 1000,
                                                            },
                                                          } : {}),
                                                        },
                                                      }),
                                                    ],
                                                    "base": dyn({
                                                      "k": bkey,
                                                      "c": tid,
                                                      "t": now_sec,
                                                      "sc": cur_sc,
                                                      "m": [cur_idx_ms, cur_qry_ms, cur_qry_cnt, cur_docs, cur_dset],
                                                    }),
                                                  }
                                                )))
                                            )))))))))))))))))))))))))))))))))
                                          ).as(idx_items,
                                            idx_items.filter(x, int(x.gap_sec) > 0).as(gap_items,
                                              {
                                                "ok": true,
                                                "skipped": false,
                                                "id": tid,
                                                "evts": (size(gap_items) > 0 ? [dyn({
                                                  "error": {
                                                    "code": "usage_observation_gap",
                                                    "id": tid,
                                                    "message": "Usage observation gap of " + string(gap_items[0].gap_sec) + "s detected for cluster " + tid + "; reset counter baselines without attributing multi-day gap to a single day.",
                                                  },
                                                })] : []) + idx_items.map(x, x.evts).flatten(),
                                                "baselines": idx_items.map(x, x.base),
                                                "err": dyn({}),
                                              }
                                            )
                                          )
                                      )
                                  )
                                )
                            )))
                          ))
                        ).as(results,
                          results.filter(r, r.ok && !r.skipped).map(r, r.id).as(newly_harvested_ids,
                          results.map(r, r.baselines).flatten().as(new_bases,
                          base_map.keys().filter(k, !(string(base_map[k].c) in newly_harvested_ids) && ("t" in base_map[k]) && base_map[k].t != null && int(base_map[k].t) >= (now_sec - 172800)).as(kept_keys,
                          (
                            (size(kept_keys) > 0 ? zip(kept_keys, kept_keys.map(k, base_map[k])) : dyn({}))
                          ).with(
                            size(new_bases) > 0 ? zip(new_bases.map(b, string(b.k)), new_bases) : {}
                          ).as(merged_baselines,
                          (
                            conf_evts +
                            cloud_disc_errs +
                            (!hub_disc.ok ? [hub_disc.err] : []) +
                            results.filter(r, !r.ok).map(r, r.err) +
                            results.map(r, r.evts).flatten()
                          ).as(out_evts,
                            {
                              "events": size(out_evts) > 0 ? out_evts : [dyn({ "fake": true })],
                              "cursor": {
                                "conf_sig": conf_sig,
                                "idx_baselines": merged_baselines,
                              },
                              "want_more": false,
                            }
                          )))))
                        )
                      )
                    )
                  )
                )
              )))))))))))))))))))))))))))))
            )
          publisher_pipeline.disable_host: true
          redact:
            fields:
                - api_key
                - cloud_api_key
                - hub_es_api_key
                - deployment_keys
                - deployment_api_keys
                - proxy_url
          resource.proxy_url: ${SECRET_3}
          resource.ssl:
            certificate_authorities:
                - /etc/ssl/ca.pem
            verification_mode: full
          resource.timeout: 60s
          resource.tracer.filename: ../../logs/cel/http-request-trace-*.ndjson
          resource.tracer.maxbackups: 5
          resource.url: https://api.example.com/api/v1/deployments/_search?show_metadata=true
          state:
            api_key: ${SECRET_0}
            cloud_api_base: https://api.example.com
            conf_indexing_weight: 15
            conf_query_weight: 25
            conf_storage_weight: 60
            config_owner_id: primary-owner
            deployment_keys: ${SECRET_2}
            hub_es_api_key: ${SECRET_1}
            hub_es_url: https://hub.example.com:9200/
            organization_id: "2222"
            sync_fleet_config: true
          tags:
            - forwarded
            - chargeback
      type: cel
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - metrics-chargeback.usage-ep
                  privileges:
                    - auto_configure
                    - create_doc
