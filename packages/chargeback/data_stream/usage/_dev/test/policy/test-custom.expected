            expired_gap_cids.map(ecid,
            expired_keys.filter(ek, string(base_map[ek].c) == string(ecid)).map(ek, now_sec - int(base_map[ek].t)).as(egaps,
            dyn({
            "error": {
            "code": "usage_observation_gap",
            "id": string(ecid),
            "message": "Usage observation gap of " + string(egaps.max()) + "s detected for cluster " + string(ecid) + "; expired stale counter baselines without attributing multi-day gap to a single day.",
            },
            })
            )
            ).as(expired_gap_errs,
            prev_good_idx.keys().filter(gid,
            results.exists(r, r.id == gid) ?
            results.exists(r, r.id == gid && !r.ok && !r.auth_err && !r.skipped)
            : any_disc_err
            ).as(kept_good_ids,
            results.filter(r, r.ok && int(r.key_idx) >= 0).as(good_results,
            (size(kept_good_ids) > 0 ? zip(kept_good_ids, kept_good_ids.map(gid, prev_good_idx[gid])) : dyn({})).with(
            size(good_results) > 0 ? zip(good_results.map(r, string(r.id)), good_results.map(r, int(r.key_idx))) : {}
            ).as(merged_good_idx,
            (
            (size(kept_keys) > 0 ? zip(kept_keys, kept_keys.map(k, base_map[k])) : dyn({}))
            ).with(
            size(new_bases) > 0 ? zip(new_bases.map(b, string(b.k)), new_bases) : {}
            ).as(merged_baselines,
            results.filter(r, r.ok && r.aux_ran).map(r, string(r.id)).as(aux_ran_ids,
            results.filter(r, r.ok && r.ml_ran).map(r, string(r.id)).as(ml_ran_ids,
            results.filter(r, r.ok).map(r, r.ml_baselines).flatten().as(new_ml_bases,
            new_ml_bases.map(b, string(b.k)).as(new_ml_keys,
            ml_base_map.keys().filter(k,
            !(string(ml_base_map[k].c) in ml_ran_ids) &&
            !(string(dyn(k)) in new_ml_keys) &&
            ("t" in ml_base_map[k]) && ml_base_map[k].t != null &&
            int(ml_base_map[k].t) > 0 &&
            int(ml_base_map[k].t) <= now_sec &&
            (now_sec - int(ml_base_map[k].t)) <= 86400 &&
            int(ml_base_map[k].t) >= (today_start_sec - 86400) &&
            ((string(ml_base_map[k].c) in target_ids) || any_disc_err)
            ).as(kept_ml_keys,
            (
            (size(kept_ml_keys) > 0 ? zip(kept_ml_keys, kept_ml_keys.map(k, ml_base_map[k])) : dyn({}))
            ).with(
            size(new_ml_bases) > 0 ? zip(new_ml_keys, new_ml_bases) : {}
            ).as(merged_ml_baselines,
            aux_sync_map.keys().filter(aid,
            !(string(aid) in aux_ran_ids) &&
            aux_sync_map[aid] != null &&
            int(aux_sync_map[aid]) > 0 &&
            (now_sec - int(aux_sync_map[aid])) <= 86400 &&
            ((string(aid) in target_ids) || any_disc_err)
            ).as(kept_aux_ids,
            (
            (size(kept_aux_ids) > 0 ? zip(kept_aux_ids, kept_aux_ids.map(aid, int(aux_sync_map[aid]))) : dyn({}))
            ).with(
            size(aux_ran_ids) > 0 ? zip(aux_ran_ids, aux_ran_ids.map(aid, now_sec)) : {}
            ).as(merged_aux_sync,
            results.filter(r, r.ok && r.syn_ran && int(r.syn_ts) > 0).as(syn_updated_res,
            syn_updated_res.map(r, string(r.id)).as(syn_upd_ids,
            syn_cursor_map.keys().filter(sid,
            !(string(sid) in syn_upd_ids) &&
            syn_cursor_map[sid] != null &&
            int(syn_cursor_map[sid]) > 0 &&
            (now_sec - int(syn_cursor_map[sid])) <= 86400 &&
            ((string(sid) in target_ids) || any_disc_err)
            ).as(kept_syn_ids,
            (
            (size(kept_syn_ids) > 0 ? zip(kept_syn_ids, kept_syn_ids.map(sid, int(syn_cursor_map[sid]))) : dyn({}))
            ).with(
            size(syn_updated_res) > 0 ? zip(syn_upd_ids, syn_updated_res.map(r, int(r.syn_ts))) : {}
            ).as(merged_syn_cursor,
            (
            conf_evts +
            cloud_disc_errs +
            (!hub_disc.ok ? [hub_disc.err] : []) +
            results.filter(r, !r.ok).map(r, r.err) +
            results.map(r, r.evts).flatten() +
            expired_gap_errs
            ).as(out_evts,
            {
            "events": size(out_evts) > 0 ? out_evts : [dyn({ "fake": true })],
            "cursor": {
            "conf_sig": conf_sig,
            "idx_baselines": merged_baselines,
            "ml_baselines": merged_ml_baselines,
            "aux_sync": merged_aux_sync,
            "syn_cursor": merged_syn_cursor,
            "good_key_idx": merged_good_idx,
            },
            "want_more": false,
            }
            )))))))))))))))))))))))))))))))
            )
            )
            )
            )
            )
            )))))))))))))))))))))))))))))))))))))))
            )
          publisher_pipeline.disable_host: true
          redact:
            fields:
                - api_key
                - cloud_api_key
                - hub_es_api_key
                - deployment_keys
                - deployment_api_keys
                - proxy_url
          resource.proxy_url: ${SECRET_3}
          resource.ssl:
            certificate_authorities:
                - /etc/ssl/ca.pem
            verification_mode: full
          resource.timeout: 60s
          resource.tracer.filename: ../../logs/cel/http-request-trace-*.ndjson
          resource.tracer.maxbackups: 5
          resource.url: https://api.example.com/api/v1/deployments/_search?show_metadata=true
          state:
            api_key: ${SECRET_0}
            cloud_api_base: https://api.example.com
            conf_indexing_weight: 15
            conf_query_weight: 25
            conf_storage_weight: 60
            config_owner_id: primary-owner
            deployment_keys: ${SECRET_2}
            hub_es_api_key: ${SECRET_1}
            hub_es_url: https://hub.example.com:9200/
            organization_id: "2222"
            poll_interval: 10m
            sync_fleet_config: true
          tags:
            - forwarded
            - chargeback
      type: cel
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - metrics-chargeback.usage-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references:
    - {}
    - {}
    - {}
    - {}
