inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: chargeback
      name: test-custom-chargeback
      streams:
        - config_version: 2
          data_stream:
            dataset: chargeback.usage
          interval: 10m
          processors:
            - drop_event.when.equals.fake: true
          program: |-
            state.with(
              now.format(time_layout.DateOnly).as(today_utc,
              state.config_owner_id.trim_space().as(clean_owner_id,
              state.hub_es_url.trim_space().as(trimmed_hub_url,
              (trimmed_hub_url.endsWith("/") ? trimmed_hub_url.substring(0, size(trimmed_hub_url) - 1) : trimmed_hub_url).as(clean_hub_url,
              (int(state.conf_indexing_weight) >= 0 && int(state.conf_query_weight) >= 0 && int(state.conf_storage_weight) >= 0 && (int(state.conf_query_weight) + int(state.conf_storage_weight)) > 0).as(weights_valid,
              (!state.sync_fleet_config ? ("disabled|" + clean_owner_id) : (
                weights_valid ? (clean_owner_id + "|" + string(state.conf_indexing_weight) + "|" + string(state.conf_query_weight) + "|" + string(state.conf_storage_weight) + "|" + today_utc) : state.?cursor.conf_sig.orValue("")
              )).as(conf_sig,
              ((state.sync_fleet_config && !weights_valid) ?
                [dyn({
                  "error": {
                    "code": "invalid_config",
                    "id": "usage_weights",
                    "message": "Invalid blended usage weights (indexing=" + string(state.conf_indexing_weight) + ", query=" + string(state.conf_query_weight) + ", storage=" + string(state.conf_storage_weight) + "): weights must be non-negative and query_weight + storage_weight must be greater than 0",
                  },
                })]
              : ((state.sync_fleet_config && state.?cursor.conf_sig.orValue("") != conf_sig) ?
                [dyn({
                  "doc_type": "config_snapshot",
                  "conf_sync_enabled": true,
                  "conf_owner_id": clean_owner_id,
                  "conf_indexing_weight": int(state.conf_indexing_weight),
                  "conf_query_weight": int(state.conf_query_weight),
                  "conf_storage_weight": int(state.conf_storage_weight),
                })]
              : ((!state.sync_fleet_config && state.?cursor.conf_sig.orValue("") != conf_sig) ?
                [dyn({
                  "doc_type": "config_snapshot",
                  "conf_sync_enabled": false,
                  "conf_owner_id": clean_owner_id,
                })]
              : []))).as(conf_evts,
              int(now).as(now_sec,
              now.format(time_layout.RFC3339).as(obs_ts,
              timestamp(now_sec - (now_sec % 600)).format(time_layout.RFC3339).as(now_ts,
              today_utc.parse_time(time_layout.DateOnly).as(today_start,
              int(today_start).as(today_start_sec,
              (today_start - duration("10m")).format(time_layout.RFC3339).as(prev_midnight_ts,
              state.?cursor.idx_baselines.orValue(dyn({})).as(raw_baselines,
              (type(raw_baselines) == list ?
                (size(raw_baselines) > 0 ?
                  zip(
                    raw_baselines.map(b, ("k" in b && b.k != null) ? string(b.k) : (string(b.c) + "::" + string(b.i))),
                    raw_baselines.map(b, dyn({
                      "k": ("k" in b && b.k != null) ? string(b.k) : (string(b.c) + "::" + string(b.i)),
                      "c": string(b.c),
                      "t": ("t" in b && b.t != null) ? int(b.t) : 0,
                      "sc": ("sc" in b && b.sc != null) ? int(b.sc) : 0,
                      "m": b.m,
                    }))
                  )
                : dyn({}))
              : raw_baselines).as(base_map,
              (state.organization_id != "" && state.api_key != "" && !state.api_key.startsWith("$co.elastic.secret")).as(has_cloud,
              (clean_hub_url != "" && state.hub_es_api_key != "" && !state.hub_es_api_key.startsWith("$co.elastic.secret")).as(has_hub,
              (
                !has(state.deployment_keys) || state.deployment_keys == null ? [] :
                string(dyn(state.deployment_keys)).split(",")
              ).map(k, k.trim_space()).filter(k, k != "" && k != "null" && !k.startsWith("$co.elastic.secret")).as(all_dkeys,
              int(state.?cursor.disc_dep_from.orValue(has_cloud ? 0 : -1)).as(dep_from,
              string(state.?cursor.disc_es_next.orValue(has_cloud ? "START" : "")).as(es_next,
              string(state.?cursor.disc_obs_next.orValue(has_cloud ? "START" : "")).as(obs_next,
              string(state.?cursor.disc_sec_next.orValue(has_cloud ? "START" : "")).as(sec_next,
              string(state.?cursor.disc_vdb_next.orValue(has_cloud ? "START" : "")).as(vdb_next,
              state.?cursor.disc_targets.orValue([]).as(acc_targets,
              ((has_cloud && dep_from >= 0) ?
                (state.cloud_api_base + "/api/v1/deployments/_search?show_metadata=true").as(dep_search_url,
                  try(
                    request(
                      "POST",
                      dep_search_url
                    ).with(
                      {
                        "Header": {
                          "Authorization": ["ApiKey " + state.api_key],
                          "Content-Type": ["application/json"],
                        },
                        "Body": { "size": 500, "from": dep_from }.encode_json(),
                      }
                    ).do_request(),
                    "req_err"
                  ).as(dep_resp,
                    has(dep_resp.req_err) ?
                      {
                        "ok": false,
                        "err": dyn({ "error": { "code": "transport_error", "id": "deployments_search", "message": "POST " + dep_search_url + ": " + string(dep_resp.req_err) } }),
                        "items": [],
                        "next_from": -1,
                      }
                    : (dep_resp.StatusCode == 200) ?
                      try(bytes(dep_resp.Body).decode_json(), "json_err").as(dep_body,
                        has(dep_body.json_err) ?
                          {
                            "ok": false,
                            "err": dyn({ "error": { "code": "decode_error", "id": "deployments_search", "message": "POST " + dep_search_url + ": " + string(dep_body.json_err) } }),
                            "items": [],
                            "next_from": -1,
                          }
                        :
                          ((has(dep_body.deployments) && dep_body.deployments != null) ? dep_body.deployments : []).as(raw_deps,
                            {
                              "ok": true,
                              "err": dyn({}),
                              "items": raw_deps.filter(d,
                                has(d.resources) && d.resources != null && has(d.resources.elasticsearch) && d.resources.elasticsearch != null && size(d.resources.elasticsearch) > 0 &&
                                has(d.resources.elasticsearch[0].info) && has(d.resources.elasticsearch[0].info.metadata) && has(d.resources.elasticsearch[0].info.metadata.service_url) && d.resources.elasticsearch[0].info.metadata.service_url != null
                              ).map(d,
                                d.resources.elasticsearch[0].as(es_r,
                                  string(es_r.info.metadata.service_url).as(raw_surl,
                                    (raw_surl.endsWith("/") ? raw_surl.substring(0, size(raw_surl) - 1) : raw_surl).as(surl,
                                      ((has(es_r.id) && es_r.id != null && string(es_r.id) != "") ? string(es_r.id) : (has(d.id) && d.id != null ? string(d.id) : surl)).as(es_id,
                                        dyn({
                                          "id": es_id,
                                          "alt_id": has(d.id) && d.id != null ? string(d.id) : es_id,
                                          "name": (has(d.name) && d.name != null && string(d.name) != "") ? string(d.name) : es_id,
                                          "es_url": surl,
                                          "is_ech": true,
                                          "is_hub": (has_hub && surl == clean_hub_url),
                                        })
                                      )
                                    )
                                  )
                                )
                              ),
                              "next_from": (has(dep_body.match_count) && dep_body.match_count != null && size(raw_deps) > 0 && (dep_from + size(raw_deps)) < int(dep_body.match_count)) ? (dep_from + size(raw_deps)) : -1,
                            }
                          )
                      )
                    : (dep_resp.StatusCode == 404 ? { "ok": true, "err": dyn({}), "items": [], "next_from": -1 } : {
                        "ok": false,
                        "err": dyn({ "error": { "code": string(dep_resp.StatusCode), "id": string(dep_resp.Status), "message": "POST " + dep_resp.Request.URL + ": " + ((size(dep_resp.Body) != 0) ? string(dep_resp.Body) : string(dep_resp.Status)) } }),
                        "items": [],
                        "next_from": -1,
                      })
                  )
                )
              : { "ok": true, "err": dyn({}), "items": [], "next_from": -1 }).as(dep_page,
              ((has_cloud && es_next != "") ?
                (state.cloud_api_base + "/api/v1/serverless/projects/elasticsearch?" + (es_next == "START" ? { "size": ["100"] } : { "size": ["100"], "next_page": [es_next] }).format_query()).as(es_disc_url,
                  try(
                    get_request(es_disc_url).with({ "Header": { "Authorization": ["ApiKey " + state.api_key] } }).do_request(),
                    "req_err"
                  ).as(r,
                    has(r.req_err) ?
                      {
                        "ok": false,
                        "err": dyn({ "error": { "code": "transport_error", "id": "serverless_elasticsearch", "message": "GET " + es_disc_url + ": " + string(r.req_err) } }),
                        "items": [],
                        "next": "",
                      }
                    : (r.StatusCode == 200) ?
                      try(bytes(r.Body).decode_json(), "json_err").as(b,
                        has(b.json_err) ?
                          {
                            "ok": false,
                            "err": dyn({ "error": { "code": "decode_error", "id": "serverless_elasticsearch", "message": "GET " + es_disc_url + ": " + string(b.json_err) } }),
                            "items": [],
                            "next": "",
                          }
                        :
                          {
                            "ok": true,
                            "err": dyn({}),
                            "items": ((has(b.items) && b.items != null) ? b.items : []).filter(p, has(p.endpoints) && p.endpoints != null && has(p.endpoints.elasticsearch) && p.endpoints.elasticsearch != null).map(p,
                              dyn({
                                "id": string(p.id),
                                "alt_id": string(p.id),
                                "name": (has(p.name) && p.name != null && string(p.name) != "") ? string(p.name) : string(p.id),
                                "es_url": string(p.endpoints.elasticsearch),
                                "is_ech": false,
                                "is_hub": false,
                              })
                            ),
                            "next": (has(b.next_page) && b.next_page != null && string(b.next_page) != "") ? string(b.next_page) : "",
                          }
                      )
                    : (r.StatusCode == 404 ? { "ok": true, "err": dyn({}), "items": [], "next": "" } : {
                        "ok": false,
                        "err": dyn({ "error": { "code": string(r.StatusCode), "id": string(r.Status), "message": "GET " + r.Request.URL + ": " + ((size(r.Body) != 0) ? string(r.Body) : string(r.Status)) } }),
                        "items": [],
                        "next": "",
                      })
                  )
                )
              : { "ok": true, "err": dyn({}), "items": [], "next": "" }).as(es_page,
              ((has_cloud && obs_next != "") ?
                (state.cloud_api_base + "/api/v1/serverless/projects/observability?" + (obs_next == "START" ? { "size": ["100"] } : { "size": ["100"], "next_page": [obs_next] }).format_query()).as(obs_disc_url,
                  try(
                    get_request(obs_disc_url).with({ "Header": { "Authorization": ["ApiKey " + state.api_key] } }).do_request(),
                    "req_err"
                  ).as(r,
                    has(r.req_err) ?
                      {
                        "ok": false,
                        "err": dyn({ "error": { "code": "transport_error", "id": "serverless_observability", "message": "GET " + obs_disc_url + ": " + string(r.req_err) } }),
                        "items": [],
                        "next": "",
                      }
                    : (r.StatusCode == 200) ?
                      try(bytes(r.Body).decode_json(), "json_err").as(b,
                        has(b.json_err) ?
                          {
                            "ok": false,
                            "err": dyn({ "error": { "code": "decode_error", "id": "serverless_observability", "message": "GET " + obs_disc_url + ": " + string(b.json_err) } }),
                            "items": [],
                            "next": "",
                          }
                        :
                          {
                            "ok": true,
                            "err": dyn({}),
                            "items": ((has(b.items) && b.items != null) ? b.items : []).filter(p, has(p.endpoints) && p.endpoints != null && has(p.endpoints.elasticsearch) && p.endpoints.elasticsearch != null).map(p,
                              dyn({
                                "id": string(p.id),
                                "alt_id": string(p.id),
                                "name": (has(p.name) && p.name != null && string(p.name) != "") ? string(p.name) : string(p.id),
                                "es_url": string(p.endpoints.elasticsearch),
                                "is_ech": false,
                                "is_hub": false,
                              })
                            ),
                            "next": (has(b.next_page) && b.next_page != null && string(b.next_page) != "") ? string(b.next_page) : "",
                          }
                      )
                    : (r.StatusCode == 404 ? { "ok": true, "err": dyn({}), "items": [], "next": "" } : {
                        "ok": false,
                        "err": dyn({ "error": { "code": string(r.StatusCode), "id": string(r.Status), "message": "GET " + r.Request.URL + ": " + ((size(r.Body) != 0) ? string(r.Body) : string(r.Status)) } }),
                        "items": [],
                        "next": "",
                      })
                  )
                )
              : { "ok": true, "err": dyn({}), "items": [], "next": "" }).as(obs_page,
              ((has_cloud && sec_next != "") ?
                (state.cloud_api_base + "/api/v1/serverless/projects/security?" + (sec_next == "START" ? { "size": ["100"] } : { "size": ["100"], "next_page": [sec_next] }).format_query()).as(sec_disc_url,
                  try(
                    get_request(sec_disc_url).with({ "Header": { "Authorization": ["ApiKey " + state.api_key] } }).do_request(),
                    "req_err"
                  ).as(r,
                    has(r.req_err) ?
                      {
                        "ok": false,
                        "err": dyn({ "error": { "code": "transport_error", "id": "serverless_security", "message": "GET " + sec_disc_url + ": " + string(r.req_err) } }),
                        "items": [],
                        "next": "",
                      }
                    : (r.StatusCode == 200) ?
                      try(bytes(r.Body).decode_json(), "json_err").as(b,
                        has(b.json_err) ?
                          {
                            "ok": false,
                            "err": dyn({ "error": { "code": "decode_error", "id": "serverless_security", "message": "GET " + sec_disc_url + ": " + string(b.json_err) } }),
                            "items": [],
                            "next": "",
                          }
                        :
                          {
                            "ok": true,
                            "err": dyn({}),
                            "items": ((has(b.items) && b.items != null) ? b.items : []).filter(p, has(p.endpoints) && p.endpoints != null && has(p.endpoints.elasticsearch) && p.endpoints.elasticsearch != null).map(p,
                              dyn({
                                "id": string(p.id),
                                "alt_id": string(p.id),
                                "name": (has(p.name) && p.name != null && string(p.name) != "") ? string(p.name) : string(p.id),
                                "es_url": string(p.endpoints.elasticsearch),
                                "is_ech": false,
                                "is_hub": false,
                              })
                            ),
                            "next": (has(b.next_page) && b.next_page != null && string(b.next_page) != "") ? string(b.next_page) : "",
                          }
                      )
                    : (r.StatusCode == 404 ? { "ok": true, "err": dyn({}), "items": [], "next": "" } : {
                        "ok": false,
                        "err": dyn({ "error": { "code": string(r.StatusCode), "id": string(r.Status), "message": "GET " + r.Request.URL + ": " + ((size(r.Body) != 0) ? string(r.Body) : string(r.Status)) } }),
                        "items": [],
                        "next": "",
                      })
                  )
                )
              : { "ok": true, "err": dyn({}), "items": [], "next": "" }).as(sec_page,
              ((has_cloud && vdb_next != "") ?
                (state.cloud_api_base + "/api/v1/serverless/projects/vectordb?" + (vdb_next == "START" ? { "size": ["100"] } : { "size": ["100"], "next_page": [vdb_next] }).format_query()).as(vdb_disc_url,
                  try(
                    get_request(vdb_disc_url).with({ "Header": { "Authorization": ["ApiKey " + state.api_key] } }).do_request(),
                    "req_err"
                  ).as(r,
                    has(r.req_err) ?
                      {
                        "ok": false,
                        "err": dyn({ "error": { "code": "transport_error", "id": "serverless_vectordb", "message": "GET " + vdb_disc_url + ": " + string(r.req_err) } }),
                        "items": [],
                        "next": "",
                      }
                    : (r.StatusCode == 200) ?
                      try(bytes(r.Body).decode_json(), "json_err").as(b,
                        has(b.json_err) ?
                          {
                            "ok": false,
                            "err": dyn({ "error": { "code": "decode_error", "id": "serverless_vectordb", "message": "GET " + vdb_disc_url + ": " + string(b.json_err) } }),
                            "items": [],
                            "next": "",
                          }
                        :
                          {
                            "ok": true,
                            "err": dyn({}),
                            "items": ((has(b.items) && b.items != null) ? b.items : []).filter(p, has(p.endpoints) && p.endpoints != null && has(p.endpoints.elasticsearch) && p.endpoints.elasticsearch != null).map(p,
                              dyn({
                                "id": string(p.id),
                                "alt_id": string(p.id),
                                "name": (has(p.name) && p.name != null && string(p.name) != "") ? string(p.name) : string(p.id),
                                "es_url": string(p.endpoints.elasticsearch),
                                "is_ech": false,
                                "is_hub": false,
                              })
                            ),
                            "next": (has(b.next_page) && b.next_page != null && string(b.next_page) != "") ? string(b.next_page) : "",
                          }
                      )
                    : (r.StatusCode == 404 ? { "ok": true, "err": dyn({}), "items": [], "next": "" } : {
                        "ok": false,
                        "err": dyn({ "error": { "code": string(r.StatusCode), "id": string(r.Status), "message": "GET " + r.Request.URL + ": " + ((size(r.Body) != 0) ? string(r.Body) : string(r.Status)) } }),
                        "items": [],
                        "next": "",
                      })
                  )
                )
              : { "ok": true, "err": dyn({}), "items": [], "next": "" }).as(vdb_page,
                (
                  (!dep_page.ok ? [dep_page.err] : []) +
                  (!es_page.ok ? [es_page.err] : []) +
                  (!obs_page.ok ? [obs_page.err] : []) +
                  (!sec_page.ok ? [sec_page.err] : []) +
                  (!vdb_page.ok ? [vdb_page.err] : [])
                ).as(cloud_disc_errs,
                  (acc_targets + dep_page.items + es_page.items + obs_page.items + sec_page.items + vdb_page.items).as(cloud_targets,
                    (dep_page.next_from >= 0 || es_page.next != "" || obs_page.next != "" || sec_page.next != "" || vdb_page.next != "") ?
                      {
                        "events": size(conf_evts + cloud_disc_errs) > 0 ? (conf_evts + cloud_disc_errs) : [dyn({ "fake": true })],
                        "cursor": {
                          "conf_sig": conf_sig,
                          "idx_baselines": base_map,
                          "disc_dep_from": dep_page.next_from,
                          "disc_es_next": es_page.next,
                          "disc_obs_next": obs_page.next,
                          "disc_sec_next": sec_page.next,
                          "disc_vdb_next": vdb_page.next,
                          "disc_targets": cloud_targets,
                        },
                        "want_more": true,
                      }
                    : ((!has_hub && size(cloud_targets) == 0) ?
                      {
                        "events": size(conf_evts + cloud_disc_errs) > 0 ? (conf_evts + cloud_disc_errs) : [dyn({ "fake": true })],
                        "cursor": {
                          "conf_sig": conf_sig,
                          "idx_baselines": base_map,
                        },
                        "want_more": false,
                      }
                    :
                      (has_hub ?
                        try(
                          get_request(clean_hub_url + "/").with({ "Header": { "Authorization": ["ApiKey " + state.hub_es_api_key] } }).do_request(),
                          "req_err"
                        ).as(hub_resp,
                          has(hub_resp.req_err) ?
                            {
                              "ok": false,
                              "err": dyn({ "error": { "code": "transport_error", "id": "hub_discovery", "message": "GET " + clean_hub_url + "/: " + string(hub_resp.req_err) } }),
                              "targets": cloud_targets,
                            }
                          : (hub_resp.StatusCode == 200) ?
                            try(bytes(hub_resp.Body).decode_json(), "json_err").as(hub_info,
                              has(hub_info.json_err) ?
                                {
                                  "ok": false,
                                  "err": dyn({ "error": { "code": "decode_error", "id": "hub_discovery", "message": "GET " + clean_hub_url + "/: " + string(hub_info.json_err) } }),
                                  "targets": cloud_targets,
                                }
                              :
                                ((has(hub_info.cluster_name) && hub_info.cluster_name != null && string(hub_info.cluster_name) != "") ? string(hub_info.cluster_name) : "hub").as(hub_cname,
                                  {
                                    "ok": true,
                                    "err": dyn({}),
                                    "targets": cloud_targets.exists(ct, string(ct.id) == hub_cname || string(ct.es_url) == clean_hub_url) ?
                                      cloud_targets.map(ct, (string(ct.id) == hub_cname || string(ct.es_url) == clean_hub_url) ? dyn(ct.with({ "is_hub": true })) : ct)
                                    :
                                      cloud_targets + [dyn({
                                        "id": hub_cname,
                                        "alt_id": hub_cname,
                                        "name": hub_cname,
                                        "es_url": clean_hub_url,
                                        "is_ech": true,
                                        "is_hub": true,
                                      })],
                                  }
                                )
                            )
                          :
                            {
                              "ok": false,
                              "err": dyn({ "error": { "code": string(hub_resp.StatusCode), "id": string(hub_resp.Status), "message": "GET " + hub_resp.Request.URL + ": " + ((size(hub_resp.Body) != 0) ? string(hub_resp.Body) : string(hub_resp.Status)) } }),
                              "targets": cloud_targets,
                            }
                        )
                      : { "ok": true, "err": dyn({}), "targets": cloud_targets }).as(hub_disc,
                        hub_disc.targets.map(t,
                          string(t.id).as(tid,
                          (string(t.es_url).endsWith("/") ? string(t.es_url).substring(0, size(string(t.es_url)) - 1) : string(t.es_url)).as(es_base,
                            all_dkeys.filter(k, k.startsWith(tid + ":") || k.startsWith(string(t.alt_id) + ":") || k.startsWith(string(t.name) + ":")).map(k,
                              k.substring(size(k.split(":")[0]) + 1, size(k))
                            ).filter(k, k != "").as(d_keys,
                              (d_keys + ((bool(t.is_hub) && has_hub && !(state.hub_es_api_key in d_keys)) ? [state.hub_es_api_key] : [])).as(dh_keys,
                              (dh_keys + ((!bool(t.is_ech) && has_cloud && !(state.api_key in dh_keys)) ? [state.api_key] : [])).as(cand_keys,
                              (size(cand_keys) == 0) ?
                                {
                                  "ok": false,
                                  "skipped": true,
                                  "id": tid,
                                  "evts": [],
                                  "baselines": [],
                                  "err": dyn({
                                    "error": {
                                      "code": "missing_credentials",
                                      "id": tid,
                                      "message": "Skipping index usage collection for deployment '" + string(t.name) + "' (" + tid + "): no matching Elasticsearch API key found in deployment_api_keys (<deployment_id_or_name>:<api_key>) or hub_es_url/hub_es_api_key.",
                                    },
                                  }),
                                }
                              :
                                (es_base + (bool(t.is_ech) ?
