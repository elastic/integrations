inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: chargeback
      name: test-custom-chargeback
      streams:
        - config_version: 2
          data_stream:
            dataset: chargeback.usage
          interval: 10m
          processors:
            - drop_event.when.equals.fake: true
            - copy_fields:
                fail_on_error: false
                fields:
                    - from: '@metadata.input_id'
                      to: conf_policy_id
                ignore_missing: true
                when:
                    and:
                        - not:
                            has_fields:
                                - conf_policy_id
                        - not:
                            has_fields:
                                - error.message
          program: |-
            state.with(
            (state.?unsupported_agent_version.orValue("") != "" ?
            string(state.unsupported_agent_version)
            : (
            string(useragent).trim_space().split(" ")[0].split("/").as(ua_parts,
            (size(ua_parts) == 2 && ua_parts[1] != "") ?
            ua_parts[1].as(ua_raw_ver,
            ua_raw_ver.split("-")[0].split("+")[0].as(ua_core_ver,
            (ua_core_ver.matches("^[0-9]+\\.[0-9]+\\.[0-9]+$") && int(ua_core_ver.split(".")[0]) > 0 && (
            int(ua_core_ver.split(".")[0]) < 9 ||
            (int(ua_core_ver.split(".")[0]) == 9 && int(ua_core_ver.split(".")[1]) < 2) ||
            (int(ua_core_ver.split(".")[0]) == 9 && int(ua_core_ver.split(".")[1]) == 2 && int(ua_core_ver.split(".")[2]) == 0 && ua_raw_ver.contains("-") && !ua_raw_ver.startsWith("9.2.0-SNAPSHOT"))
            )) ? ua_raw_ver : ""
            )
            )
            : ""
            )
            )).as(unsupported_ver,
            (unsupported_ver != "") ?
            {
            "events": [dyn({
            "error": {
            "code": "unsupported_agent_version",
            "id": "agent_version_guard",
            "message": "Unsupported Elastic Agent version " + unsupported_ver + ": chargeback requires a Fleet-managed Elastic Agent >= 9.2.0",
            },
            })],
            "cursor": state.?cursor.orValue({}),
            "want_more": false,
            }
            :
            state.api_key.trim_space().as(clean_api_key,
            state.hub_es_api_key.trim_space().as(clean_hub_key,
            now.format(time_layout.DateOnly).as(today_utc,
            state.organization_id.trim_space().as(clean_org_id,
            state.cloud_api_base.trim_space().as(trimmed_cloud_base,
            (trimmed_cloud_base.endsWith("/") ? trimmed_cloud_base.substring(0, size(trimmed_cloud_base) - 1) : trimmed_cloud_base).as(clean_cloud_base,
            state.config_owner_id.trim_space().as(clean_owner_id,
            state.hub_es_url.trim_space().as(trimmed_hub_url,
            (trimmed_hub_url.endsWith("/") ? trimmed_hub_url.substring(0, size(trimmed_hub_url) - 1) : trimmed_hub_url).as(clean_hub_url,
            (int(state.conf_indexing_weight) >= 0 && int(state.conf_query_weight) >= 0 && int(state.conf_storage_weight) >= 0 && (int(state.conf_query_weight) + int(state.conf_storage_weight)) > 0).as(weights_valid,
            (!state.sync_fleet_config ? ("disabled|" + clean_owner_id) : (
            weights_valid ? ("v2|" + clean_owner_id + "|" + string(state.conf_indexing_weight) + "|" + string(state.conf_query_weight) + "|" + string(state.conf_storage_weight) + "|" + today_utc) : state.?cursor.conf_sig.orValue("")
            )).as(conf_sig,
            ((state.sync_fleet_config && !weights_valid) ?
            [dyn({
            "error": {
            "code": "invalid_config",
            "id": "usage_weights",
            "message": "Invalid blended usage weights (indexing=" + string(state.conf_indexing_weight) + ", query=" + string(state.conf_query_weight) + ", storage=" + string(state.conf_storage_weight) + "): weights must be non-negative and query_weight + storage_weight must be greater than 0",
            },
            })]
            : ((state.sync_fleet_config && state.?cursor.conf_sig.orValue("") != conf_sig) ?
            [dyn({
            "doc_type": "config_snapshot",
            "conf_sync_enabled": true,
            "conf_schema_version": 2,
            "conf_owner_id": clean_owner_id,
            "conf_indexing_weight": int(state.conf_indexing_weight),
            "conf_query_weight": int(state.conf_query_weight),
            "conf_storage_weight": int(state.conf_storage_weight),
            })]
            : ((!state.sync_fleet_config && state.?cursor.conf_sig.orValue("") != conf_sig) ?
            [dyn({
            "doc_type": "config_snapshot",
            "conf_sync_enabled": false,
            "conf_schema_version": 2,
            "conf_owner_id": clean_owner_id,
            })]
            : []))).as(conf_evts,
            state.poll_interval.trim_space().as(raw_poll_iv,
            try(int(duration(raw_poll_iv != "" ? raw_poll_iv : "10m").getSeconds()), "iv_err").as(parsed_iv_sec,
            ((type(parsed_iv_sec) == int && parsed_iv_sec > 0 && parsed_iv_sec < 600) ? parsed_iv_sec : 600).as(bucket_sec,
            int(now).as(now_sec,
            now.format(time_layout.RFC3339).as(obs_ts,
            timestamp(now_sec - (now_sec % bucket_sec)).format(time_layout.RFC3339).as(now_ts,
            today_utc.parse_time(time_layout.DateOnly).as(today_start,
            int(today_start).as(today_start_sec,
            (today_start - duration("10m")).format(time_layout.RFC3339).as(prev_midnight_ts,
            state.?cursor.idx_baselines.orValue(dyn({})).as(raw_baselines,
            state.?cursor.ml_baselines.orValue(dyn({})).as(raw_ml_baselines,
            state.?cursor.aux_sync.orValue(dyn({})).as(aux_sync_map,
            state.?cursor.syn_cursor.orValue(dyn({})).as(syn_cursor_map,
            (type(raw_ml_baselines) == map ? raw_ml_baselines : dyn({})).as(ml_base_map,
            (type(raw_baselines) == list ?
            (size(raw_baselines) > 0 ?
            zip(
            raw_baselines.map(b, ("k" in b && b.k != null) ? string(b.k) : (string(b.c) + "::" + string(b.i))),
            raw_baselines.map(b, dyn({
            "k": ("k" in b && b.k != null) ? string(b.k) : (string(b.c) + "::" + string(b.i)),
            "c": string(b.c),
            "t": ("t" in b && b.t != null) ? int(b.t) : 0,
            "sc": ("sc" in b && b.sc != null) ? int(b.sc) : 0,
            "m": b.m,
            }))
            )
            : dyn({}))
            : raw_baselines).as(base_map,
            (clean_org_id != "" && clean_cloud_base != "" && clean_api_key != "" && !clean_api_key.startsWith("$co.elastic.secret")).as(has_cloud,
            (clean_hub_url != "" && clean_hub_key != "" && !clean_hub_key.startsWith("$co.elastic.secret")).as(has_hub,
            (
            !has(state.deployment_keys) || state.deployment_keys == null ? [] :
            string(dyn(state.deployment_keys)).split("\n").map(ln, ln.split("\r")).flatten().map(ln, ln.split(",")).flatten()
            ).map(k, k.trim_space()).filter(k, k != "" && k != "null" && !k.startsWith("$co.elastic.secret")).as(all_dkeys,
            state.?cursor.good_key_idx.orValue(dyn({})).as(prev_good_idx,
            (bool(state.?want_more.orValue(false)) && bool(state.?cursor.disc_err.orValue(false))).as(prev_disc_err,
            int(state.?cursor.disc_dep_from.orValue(has_cloud ? 0 : -1)).as(dep_from,
            string(state.?cursor.disc_es_next.orValue(has_cloud ? "START" : "")).as(es_next,
            string(state.?cursor.disc_obs_next.orValue(has_cloud ? "START" : "")).as(obs_next,
            string(state.?cursor.disc_sec_next.orValue(has_cloud ? "START" : "")).as(sec_next,
            string(state.?cursor.disc_vdb_next.orValue(has_cloud ? "START" : "")).as(vdb_next,
            state.?cursor.disc_targets.orValue([]).as(acc_targets,
            ((has_cloud && dep_from >= 0) ?
            (clean_cloud_base + "/api/v1/deployments/_search?show_metadata=true").as(dep_search_url,
            try(
            request(
            "POST",
            dep_search_url
            ).with(
            {
            "Header": {
            "Authorization": ["ApiKey " + clean_api_key],
            "Content-Type": ["application/json"],
            },
            "Body": { "size": 500, "from": dep_from }.encode_json(),
            }
            ).do_request(),
            "req_err"
            ).as(dep_resp,
            has(dep_resp.req_err) ?
            {
            "ok": false,
            "err": dyn({ "error": { "code": "transport_error", "id": "deployments_search", "message": "POST " + dep_search_url + ": " + string(dep_resp.req_err) } }),
            "items": [],
            "next_from": -1,
            }
            : (dep_resp.StatusCode == 200) ?
            try(bytes(dep_resp.Body).decode_json(), "json_err").as(dep_body,
            (type(dep_body) != map || has(dep_body.json_err)) ?
            {
            "ok": false,
            "err": dyn({ "error": { "code": "decode_error", "id": "deployments_search", "message": "POST " + dep_search_url + ": " + ((type(dep_body) == map && has(dep_body.json_err)) ? string(dep_body.json_err) : ("expected JSON object, got " + (dep_body == null ? "null" : (type(dep_body) == list ? "array" : (type(dep_body) == map ? "object" : "scalar"))))) } }),
            "items": [],
            "next_from": -1,
            }
            :
            ((has(dep_body.deployments) && dep_body.deployments != null) ? dep_body.deployments : []).as(raw_deps,
            {
            "ok": true,
            "err": dyn({}),
            "items": raw_deps.filter(d,
            (!has(d.metadata) || d.metadata == null || !has(d.metadata.organization_id) || d.metadata.organization_id == null || string(d.metadata.organization_id) == "" || string(d.metadata.organization_id) == clean_org_id) &&
            has(d.resources) && d.resources != null && has(d.resources.elasticsearch) && d.resources.elasticsearch != null && size(d.resources.elasticsearch) > 0 && d.resources.elasticsearch[0] != null &&
            has(d.resources.elasticsearch[0].info) && d.resources.elasticsearch[0].info != null && has(d.resources.elasticsearch[0].info.metadata) && d.resources.elasticsearch[0].info.metadata != null && has(d.resources.elasticsearch[0].info.metadata.service_url) && d.resources.elasticsearch[0].info.metadata.service_url != null
            ).map(d,
            d.resources.elasticsearch[0].as(es_r,
            string(es_r.info.metadata.service_url).as(raw_surl,
            (raw_surl.endsWith("/") ? raw_surl.substring(0, size(raw_surl) - 1) : raw_surl).as(surl,
            ((has(es_r.id) && es_r.id != null && string(es_r.id) != "") ? string(es_r.id) : (has(d.id) && d.id != null ? string(d.id) : surl)).as(es_id,
            dyn({
            "id": es_id,
            "alt_id": has(d.id) && d.id != null ? string(d.id) : es_id,
            "name": (has(d.name) && d.name != null && string(d.name) != "") ? string(d.name) : es_id,
            "group": (has(d.metadata) && d.metadata != null && has(d.metadata.tags) && d.metadata.tags != null && type(d.metadata.tags) == list) ?
            (d.metadata.tags.map(tg, type(tg) == map ? ((has(tg.key) && tg.key != null && string(tg.key).to_lower() == "chargeback_group" && has(tg.value) && tg.value != null) ? string(tg.value).trim_space() : "") : (tg != null && string(tg).to_lower().startsWith("chargeback_group:") ? string(tg).substring(17, size(string(tg))).trim_space() : "")).filter(g, g != "")).as(g_vals, size(g_vals) > 0 ? g_vals[0] : "") : "",
            "es_url": surl,
            "is_ech": true,
            "is_hub": (has_hub && surl == clean_hub_url),
            })
            )
            )
            )
            )
            ),
            "next_from": (has(dep_body.match_count) && dep_body.match_count != null && size(raw_deps) > 0 && (dep_from + size(raw_deps)) < int(dep_body.match_count)) ? (dep_from + size(raw_deps)) : -1,
            }
            )
            )
            :
            {
            "ok": false,
            "err": dyn({ "error": { "code": string(dep_resp.StatusCode), "id": string(dep_resp.Status), "message": "POST " + dep_resp.Request.URL + ": " + ((size(dep_resp.Body) != 0) ? string(dep_resp.Body) : string(dep_resp.Status)) } }),
            "items": [],
            "next_from": -1,
            }
            )
            )
            : { "ok": true, "err": dyn({}), "items": [], "next_from": -1 }).as(dep_page,
            ((has_cloud && es_next != "") ?
            (clean_cloud_base + "/api/v1/serverless/projects/elasticsearch?" + (es_next == "START" ? { "size": ["100"] } : { "size": ["100"], "next_page": [es_next] }).format_query()).as(es_disc_url,
            try(
            get_request(es_disc_url).with({ "Header": { "Authorization": ["ApiKey " + clean_api_key] } }).do_request(),
            "req_err"
            ).as(r,
            has(r.req_err) ?
            {
            "ok": false,
            "err": dyn({ "error": { "code": "transport_error", "id": "serverless_elasticsearch", "message": "GET " + es_disc_url + ": " + string(r.req_err) } }),
            "items": [],
            "next": "",
            }
            : (r.StatusCode == 200) ?
            try(bytes(r.Body).decode_json(), "json_err").as(b,
            (type(b) != map || has(b.json_err)) ?
            {
            "ok": false,
            "err": dyn({ "error": { "code": "decode_error", "id": "serverless_elasticsearch", "message": "GET " + es_disc_url + ": " + ((type(b) == map && has(b.json_err)) ? string(b.json_err) : ("expected JSON object, got " + (b == null ? "null" : (type(b) == list ? "array" : (type(b) == map ? "object" : "scalar"))))) } }),
            "items": [],
            "next": "",
            }
            :
            {
            "ok": true,
            "err": dyn({}),
            "items": ((has(b.items) && b.items != null) ? b.items : []).filter(p, (!has(p.organization_id) || p.organization_id == null || string(p.organization_id) == "" || string(p.organization_id) == clean_org_id) && has(p.endpoints) && p.endpoints != null && has(p.endpoints.elasticsearch) && p.endpoints.elasticsearch != null).map(p,
            string(p.endpoints.elasticsearch).as(raw_purl,
            (raw_purl.endsWith("/") ? raw_purl.substring(0, size(raw_purl) - 1) : raw_purl).as(purl,
            dyn({
            "id": string(p.id),
            "alt_id": string(p.id),
            "name": (has(p.name) && p.name != null && string(p.name) != "") ? string(p.name) : string(p.id),
            "group": (
            ((has(p.tags) && p.tags != null && type(p.tags) == list ? p.tags.map(tg, type(tg) == map ? ((has(tg.key) && tg.key != null && has(tg.value) && tg.value != null) ? (string(tg.key) + ":" + string(tg.value)) : "") : (tg != null ? string(tg) : "")) : []) +
            (has(p.metadata) && p.metadata != null && has(p.metadata.tags) && p.metadata.tags != null && type(p.metadata.tags) == list ? p.metadata.tags.map(tg, type(tg) == map ? ((has(tg.key) && tg.key != null && has(tg.value) && tg.value != null) ? (string(tg.key) + ":" + string(tg.value)) : "") : (tg != null ? string(tg) : "")) : []))
            .filter(s, s.to_lower().startsWith("chargeback_group:")).map(s, s.substring(17, size(s)).trim_space()).filter(g, g != "")
            ).as(g_vals, size(g_vals) > 0 ? g_vals[0] : ""),
            "es_url": purl,
            "is_ech": false,
            "is_hub": (has_hub && purl == clean_hub_url),
            })
            )
            )
            ),
            "next": (has(b.next_page) && b.next_page != null && string(b.next_page) != "") ? string(b.next_page) : "",
            }
            )
            : ((r.StatusCode == 204 || r.StatusCode == 404) ? { "ok": true, "err": dyn({}), "items": [], "next": "" } : {
            "ok": false,
            "err": dyn({ "error": { "code": string(r.StatusCode), "id": string(r.Status), "message": "GET " + r.Request.URL + ": " + ((size(r.Body) != 0) ? string(r.Body) : string(r.Status)) } }),
            "items": [],
            "next": "",
            })
            )
            )
            : { "ok": true, "err": dyn({}), "items": [], "next": "" }).as(es_page,
            ((has_cloud && obs_next != "") ?
            (clean_cloud_base + "/api/v1/serverless/projects/observability?" + (obs_next == "START" ? { "size": ["100"] } : { "size": ["100"], "next_page": [obs_next] }).format_query()).as(obs_disc_url,
            try(
            get_request(obs_disc_url).with({ "Header": { "Authorization": ["ApiKey " + clean_api_key] } }).do_request(),
            "req_err"
            ).as(r,
            has(r.req_err) ?
            {
            "ok": false,
            "err": dyn({ "error": { "code": "transport_error", "id": "serverless_observability", "message": "GET " + obs_disc_url + ": " + string(r.req_err) } }),
            "items": [],
            "next": "",
            }
            : (r.StatusCode == 200) ?
            try(bytes(r.Body).decode_json(), "json_err").as(b,
            (type(b) != map || has(b.json_err)) ?
            {
            "ok": false,
            "err": dyn({ "error": { "code": "decode_error", "id": "serverless_observability", "message": "GET " + obs_disc_url + ": " + ((type(b) == map && has(b.json_err)) ? string(b.json_err) : ("expected JSON object, got " + (b == null ? "null" : (type(b) == list ? "array" : (type(b) == map ? "object" : "scalar"))))) } }),
            "items": [],
            "next": "",
            }
            :
            {
            "ok": true,
            "err": dyn({}),
            "items": ((has(b.items) && b.items != null) ? b.items : []).filter(p, (!has(p.organization_id) || p.organization_id == null || string(p.organization_id) == "" || string(p.organization_id) == clean_org_id) && has(p.endpoints) && p.endpoints != null && has(p.endpoints.elasticsearch) && p.endpoints.elasticsearch != null).map(p,
            string(p.endpoints.elasticsearch).as(raw_purl,
            (raw_purl.endsWith("/") ? raw_purl.substring(0, size(raw_purl) - 1) : raw_purl).as(purl,
            dyn({
            "id": string(p.id),
            "alt_id": string(p.id),
            "name": (has(p.name) && p.name != null && string(p.name) != "") ? string(p.name) : string(p.id),
            "group": (
            ((has(p.tags) && p.tags != null && type(p.tags) == list ? p.tags.map(tg, type(tg) == map ? ((has(tg.key) && tg.key != null && has(tg.value) && tg.value != null) ? (string(tg.key) + ":" + string(tg.value)) : "") : (tg != null ? string(tg) : "")) : []) +
            (has(p.metadata) && p.metadata != null && has(p.metadata.tags) && p.metadata.tags != null && type(p.metadata.tags) == list ? p.metadata.tags.map(tg, type(tg) == map ? ((has(tg.key) && tg.key != null && has(tg.value) && tg.value != null) ? (string(tg.key) + ":" + string(tg.value)) : "") : (tg != null ? string(tg) : "")) : []))
            .filter(s, s.to_lower().startsWith("chargeback_group:")).map(s, s.substring(17, size(s)).trim_space()).filter(g, g != "")
            ).as(g_vals, size(g_vals) > 0 ? g_vals[0] : ""),
            "es_url": purl,
            "is_ech": false,
            "is_hub": (has_hub && purl == clean_hub_url),
            })
            )
            )
            ),
            "next": (has(b.next_page) && b.next_page != null && string(b.next_page) != "") ? string(b.next_page) : "",
            }
            )
            : ((r.StatusCode == 204 || r.StatusCode == 404) ? { "ok": true, "err": dyn({}), "items": [], "next": "" } : {
            "ok": false,
            "err": dyn({ "error": { "code": string(r.StatusCode), "id": string(r.Status), "message": "GET " + r.Request.URL + ": " + ((size(r.Body) != 0) ? string(r.Body) : string(r.Status)) } }),
            "items": [],
            "next": "",
            })
            )
            )
            : { "ok": true, "err": dyn({}), "items": [], "next": "" }).as(obs_page,
            ((has_cloud && sec_next != "") ?
            (clean_cloud_base + "/api/v1/serverless/projects/security?" + (sec_next == "START" ? { "size": ["100"] } : { "size": ["100"], "next_page": [sec_next] }).format_query()).as(sec_disc_url,
            try(
            get_request(sec_disc_url).with({ "Header": { "Authorization": ["ApiKey " + clean_api_key] } }).do_request(),
            "req_err"
            ).as(r,
            has(r.req_err) ?
            {
            "ok": false,
            "err": dyn({ "error": { "code": "transport_error", "id": "serverless_security", "message": "GET " + sec_disc_url + ": " + string(r.req_err) } }),
            "items": [],
            "next": "",
            }
            : (r.StatusCode == 200) ?
            try(bytes(r.Body).decode_json(), "json_err").as(b,
            (type(b) != map || has(b.json_err)) ?
            {
            "ok": false,
            "err": dyn({ "error": { "code": "decode_error", "id": "serverless_security", "message": "GET " + sec_disc_url + ": " + ((type(b) == map && has(b.json_err)) ? string(b.json_err) : ("expected JSON object, got " + (b == null ? "null" : (type(b) == list ? "array" : (type(b) == map ? "object" : "scalar"))))) } }),
            "items": [],
            "next": "",
            }
            :
            {
            "ok": true,
            "err": dyn({}),
            "items": ((has(b.items) && b.items != null) ? b.items : []).filter(p, (!has(p.organization_id) || p.organization_id == null || string(p.organization_id) == "" || string(p.organization_id) == clean_org_id) && has(p.endpoints) && p.endpoints != null && has(p.endpoints.elasticsearch) && p.endpoints.elasticsearch != null).map(p,
            string(p.endpoints.elasticsearch).as(raw_purl,
            (raw_purl.endsWith("/") ? raw_purl.substring(0, size(raw_purl) - 1) : raw_purl).as(purl,
            dyn({
            "id": string(p.id),
            "alt_id": string(p.id),
            "name": (has(p.name) && p.name != null && string(p.name) != "") ? string(p.name) : string(p.id),
            "group": (
            ((has(p.tags) && p.tags != null && type(p.tags) == list ? p.tags.map(tg, type(tg) == map ? ((has(tg.key) && tg.key != null && has(tg.value) && tg.value != null) ? (string(tg.key) + ":" + string(tg.value)) : "") : (tg != null ? string(tg) : "")) : []) +
            (has(p.metadata) && p.metadata != null && has(p.metadata.tags) && p.metadata.tags != null && type(p.metadata.tags) == list ? p.metadata.tags.map(tg, type(tg) == map ? ((has(tg.key) && tg.key != null && has(tg.value) && tg.value != null) ? (string(tg.key) + ":" + string(tg.value)) : "") : (tg != null ? string(tg) : "")) : []))
            .filter(s, s.to_lower().startsWith("chargeback_group:")).map(s, s.substring(17, size(s)).trim_space()).filter(g, g != "")
            ).as(g_vals, size(g_vals) > 0 ? g_vals[0] : ""),
            "es_url": purl,
            "is_ech": false,
            "is_hub": (has_hub && purl == clean_hub_url),
            })
            )
