config_version: 2
interval: "10m"
{{#if enable_request_tracer}}
resource.tracer.filename: "../../logs/cel/http-request-trace-*.ndjson"
resource.tracer.maxbackups: 5
{{/if}}
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: "{{cloud_api_base}}/api/v1/deployments/_search?show_metadata=true"
state:
  api_key: !!str {{escape_string cloud_api_key}}
  organization_id: !!str {{escape_string organization_id}}
  cloud_api_base: !!str {{escape_string cloud_api_base}}
  hub_es_url: !!str {{escape_string hub_es_url}}
  hub_es_api_key: !!str {{escape_string hub_es_api_key}}
  deployment_keys: !!str {{escape_string deployment_api_keys}}
  sync_fleet_config: !!bool {{sync_fleet_config}}
  conf_indexing_weight: !!int {{indexing_weight}}
  conf_query_weight: !!int {{query_weight}}
  conf_storage_weight: !!int {{storage_weight}}
redact:
  fields:
    - api_key
    - cloud_api_key
    - hub_es_api_key
    - deployment_keys
    - deployment_api_keys
program: |-
  state.with(
    now.format(time_layout.DateOnly).as(today_utc,
    (int(state.conf_indexing_weight) >= 0 && int(state.conf_query_weight) >= 0 && int(state.conf_storage_weight) >= 0 && (int(state.conf_query_weight) + int(state.conf_storage_weight)) > 0).as(weights_valid,
    (!state.sync_fleet_config ? "disabled" : (
      weights_valid ? (string(state.conf_indexing_weight) + "|" + string(state.conf_query_weight) + "|" + string(state.conf_storage_weight) + "|" + today_utc) : state.?cursor.conf_sig.orValue("")
    )).as(conf_sig,
    ((state.sync_fleet_config && !weights_valid) ?
      [dyn({
        "error": {
          "code": "invalid_config",
          "id": "usage_weights",
          "message": "Invalid blended usage weights (indexing=" + string(state.conf_indexing_weight) + ", query=" + string(state.conf_query_weight) + ", storage=" + string(state.conf_storage_weight) + "): weights must be non-negative and query_weight + storage_weight must be greater than 0",
        },
      })]
    : ((state.sync_fleet_config && state.?cursor.conf_sig.orValue("") != conf_sig) ?
      [dyn({
        "doc_type": "config_snapshot",
        "conf_sync_enabled": true,
        "conf_indexing_weight": int(state.conf_indexing_weight),
        "conf_query_weight": int(state.conf_query_weight),
        "conf_storage_weight": int(state.conf_storage_weight),
      })]
    : ((!state.sync_fleet_config && state.?cursor.conf_sig.orValue("") != "disabled") ?
      [dyn({
        "doc_type": "config_snapshot",
        "conf_sync_enabled": false,
      })]
    : []))).as(conf_evts,
    int(now).as(now_sec,
    now.format(time_layout.RFC3339).as(obs_ts,
    timestamp(now_sec - (now_sec % 600)).format(time_layout.RFC3339).as(now_ts,
    today_utc.parse_time(time_layout.DateOnly).as(today_start,
    int(today_start).as(today_start_sec,
    (today_start - duration("10m")).format(time_layout.RFC3339).as(prev_midnight_ts,
    state.?cursor.idx_baselines.orValue(dyn({})).as(raw_baselines,
    (type(raw_baselines) == list ?
      (size(raw_baselines) > 0 ?
        zip(
          raw_baselines.map(b, ("k" in b && b.k != null) ? string(b.k) : (string(b.c) + "::" + string(b.i))),
          raw_baselines.map(b, dyn({
            "k": ("k" in b && b.k != null) ? string(b.k) : (string(b.c) + "::" + string(b.i)),
            "c": string(b.c),
            "t": ("t" in b && b.t != null) ? int(b.t) : 0,
            "m": b.m,
          }))
        )
      : dyn({}))
    : raw_baselines).as(base_map,
    (state.organization_id != "" && state.api_key != "" && !state.api_key.startsWith("$co.elastic.secret")).as(has_cloud,
    (state.hub_es_url != "" && state.hub_es_api_key != "" && !state.hub_es_api_key.startsWith("$co.elastic.secret")).as(has_hub,
    (state.hub_es_url.endsWith("/") ? state.hub_es_url.substring(0, size(state.hub_es_url) - 1) : state.hub_es_url).as(clean_hub_url,
    (
      !has(state.deployment_keys) || state.deployment_keys == null ? [] :
      string(dyn(state.deployment_keys)).split(",")
    ).map(k, k.trim_space()).filter(k, k != "" && k != "null" && !k.startsWith("$co.elastic.secret")).as(all_dkeys,
    int(state.?cursor.disc_dep_from.orValue(has_cloud ? 0 : -1)).as(dep_from,
    string(state.?cursor.disc_es_next.orValue(has_cloud ? "START" : "")).as(es_next,
    string(state.?cursor.disc_obs_next.orValue(has_cloud ? "START" : "")).as(obs_next,
    string(state.?cursor.disc_sec_next.orValue(has_cloud ? "START" : "")).as(sec_next,
    state.?cursor.disc_targets.orValue([]).as(acc_targets,
    ((has_cloud && dep_from >= 0) ?
      request(
        "POST",
        state.cloud_api_base + "/api/v1/deployments/_search?show_metadata=true"
      ).with(
        {
          "Header": {
            "Authorization": ["ApiKey " + state.api_key],
            "Content-Type": ["application/json"],
          },
          "Body": { "size": 500, "from": dep_from }.encode_json(),
        }
      ).do_request().as(dep_resp,
        (dep_resp.StatusCode == 200) ?
          bytes(dep_resp.Body).decode_json().as(dep_body,
            ((has(dep_body.deployments) && dep_body.deployments != null) ? dep_body.deployments : []).as(raw_deps,
              {
                "ok": true,
                "err": dyn({}),
                "items": raw_deps.filter(d,
                  has(d.resources) && d.resources != null && has(d.resources.elasticsearch) && d.resources.elasticsearch != null && size(d.resources.elasticsearch) > 0 &&
                  has(d.resources.elasticsearch[0].info) && has(d.resources.elasticsearch[0].info.metadata) && has(d.resources.elasticsearch[0].info.metadata.service_url) && d.resources.elasticsearch[0].info.metadata.service_url != null
                ).map(d,
                  d.resources.elasticsearch[0].as(es_r,
                    string(es_r.info.metadata.service_url).as(raw_surl,
                      (raw_surl.endsWith("/") ? raw_surl.substring(0, size(raw_surl) - 1) : raw_surl).as(surl,
                        dyn({
                          "id": string(es_r.id),
                          "alt_id": has(d.id) && d.id != null ? string(d.id) : string(es_r.id),
                          "name": (has(d.name) && d.name != null && string(d.name) != "") ? string(d.name) : string(es_r.id),
                          "es_url": surl,
                          "is_ech": true,
                          "is_hub": (has_hub && surl == clean_hub_url),
                        })
                      )
                    )
                  )
                ),
                "next_from": (has(dep_body.match_count) && dep_body.match_count != null && size(raw_deps) > 0 && (dep_from + size(raw_deps)) < int(dep_body.match_count)) ? (dep_from + size(raw_deps)) : -1,
              }
            )
          )
        : (dep_resp.StatusCode == 404 ? { "ok": true, "err": dyn({}), "items": [], "next_from": -1 } : {
            "ok": false,
            "err": dyn({ "error": { "code": string(dep_resp.StatusCode), "id": string(dep_resp.Status), "message": "POST " + dep_resp.Request.URL + ": " + ((size(dep_resp.Body) != 0) ? string(dep_resp.Body) : string(dep_resp.Status)) } }),
            "items": [],
            "next_from": -1,
          })
      )
    : { "ok": true, "err": dyn({}), "items": [], "next_from": -1 }).as(dep_page,
    ((has_cloud && es_next != "") ?
      get_request(
        state.cloud_api_base + "/api/v1/serverless/projects/elasticsearch?" + (es_next == "START" ? { "size": ["100"] } : { "size": ["100"], "next_page": [es_next] }).format_query()
      ).with({ "Header": { "Authorization": ["ApiKey " + state.api_key] } }).do_request().as(r,
        (r.StatusCode == 200) ?
          bytes(r.Body).decode_json().as(b,
            {
              "ok": true,
              "err": dyn({}),
              "items": ((has(b.items) && b.items != null) ? b.items : []).filter(p, has(p.endpoints) && p.endpoints != null && has(p.endpoints.elasticsearch) && p.endpoints.elasticsearch != null).map(p,
                dyn({
                  "id": string(p.id),
                  "alt_id": string(p.id),
                  "name": (has(p.name) && p.name != null && string(p.name) != "") ? string(p.name) : string(p.id),
                  "es_url": string(p.endpoints.elasticsearch),
                  "is_ech": false,
                  "is_hub": false,
                })
              ),
              "next": (has(b.next_page) && b.next_page != null && string(b.next_page) != "") ? string(b.next_page) : "",
            }
          )
        : (r.StatusCode == 404 ? { "ok": true, "err": dyn({}), "items": [], "next": "" } : {
            "ok": false,
            "err": dyn({ "error": { "code": string(r.StatusCode), "id": string(r.Status), "message": "GET " + r.Request.URL + ": " + ((size(r.Body) != 0) ? string(r.Body) : string(r.Status)) } }),
            "items": [],
            "next": "",
          })
      )
    : { "ok": true, "err": dyn({}), "items": [], "next": "" }).as(es_page,
    ((has_cloud && obs_next != "") ?
      get_request(
        state.cloud_api_base + "/api/v1/serverless/projects/observability?" + (obs_next == "START" ? { "size": ["100"] } : { "size": ["100"], "next_page": [obs_next] }).format_query()
      ).with({ "Header": { "Authorization": ["ApiKey " + state.api_key] } }).do_request().as(r,
        (r.StatusCode == 200) ?
          bytes(r.Body).decode_json().as(b,
            {
              "ok": true,
              "err": dyn({}),
              "items": ((has(b.items) && b.items != null) ? b.items : []).filter(p, has(p.endpoints) && p.endpoints != null && has(p.endpoints.elasticsearch) && p.endpoints.elasticsearch != null).map(p,
                dyn({
                  "id": string(p.id),
                  "alt_id": string(p.id),
                  "name": (has(p.name) && p.name != null && string(p.name) != "") ? string(p.name) : string(p.id),
                  "es_url": string(p.endpoints.elasticsearch),
                  "is_ech": false,
                  "is_hub": false,
                })
              ),
              "next": (has(b.next_page) && b.next_page != null && string(b.next_page) != "") ? string(b.next_page) : "",
            }
          )
        : (r.StatusCode == 404 ? { "ok": true, "err": dyn({}), "items": [], "next": "" } : {
            "ok": false,
            "err": dyn({ "error": { "code": string(r.StatusCode), "id": string(r.Status), "message": "GET " + r.Request.URL + ": " + ((size(r.Body) != 0) ? string(r.Body) : string(r.Status)) } }),
            "items": [],
            "next": "",
          })
      )
    : { "ok": true, "err": dyn({}), "items": [], "next": "" }).as(obs_page,
    ((has_cloud && sec_next != "") ?
      get_request(
        state.cloud_api_base + "/api/v1/serverless/projects/security?" + (sec_next == "START" ? { "size": ["100"] } : { "size": ["100"], "next_page": [sec_next] }).format_query()
      ).with({ "Header": { "Authorization": ["ApiKey " + state.api_key] } }).do_request().as(r,
        (r.StatusCode == 200) ?
          bytes(r.Body).decode_json().as(b,
            {
              "ok": true,
              "err": dyn({}),
              "items": ((has(b.items) && b.items != null) ? b.items : []).filter(p, has(p.endpoints) && p.endpoints != null && has(p.endpoints.elasticsearch) && p.endpoints.elasticsearch != null).map(p,
                dyn({
                  "id": string(p.id),
                  "alt_id": string(p.id),
                  "name": (has(p.name) && p.name != null && string(p.name) != "") ? string(p.name) : string(p.id),
                  "es_url": string(p.endpoints.elasticsearch),
                  "is_ech": false,
                  "is_hub": false,
                })
              ),
              "next": (has(b.next_page) && b.next_page != null && string(b.next_page) != "") ? string(b.next_page) : "",
            }
          )
        : (r.StatusCode == 404 ? { "ok": true, "err": dyn({}), "items": [], "next": "" } : {
            "ok": false,
            "err": dyn({ "error": { "code": string(r.StatusCode), "id": string(r.Status), "message": "GET " + r.Request.URL + ": " + ((size(r.Body) != 0) ? string(r.Body) : string(r.Status)) } }),
            "items": [],
            "next": "",
          })
      )
    : { "ok": true, "err": dyn({}), "items": [], "next": "" }).as(sec_page,
      (
        (!dep_page.ok ? [dep_page.err] : []) +
        (!es_page.ok ? [es_page.err] : []) +
        (!obs_page.ok ? [obs_page.err] : []) +
        (!sec_page.ok ? [sec_page.err] : [])
      ).as(cloud_disc_errs,
        (acc_targets + dep_page.items + es_page.items + obs_page.items + sec_page.items).as(cloud_targets,
          (dep_page.next_from >= 0 || es_page.next != "" || obs_page.next != "" || sec_page.next != "") ?
            {
              "events": size(conf_evts + cloud_disc_errs) > 0 ? (conf_evts + cloud_disc_errs) : [dyn({ "fake": true })],
              "cursor": {
                "conf_sig": conf_sig,
                "idx_baselines": base_map,
                "disc_dep_from": dep_page.next_from,
                "disc_es_next": es_page.next,
                "disc_obs_next": obs_page.next,
                "disc_sec_next": sec_page.next,
                "disc_targets": cloud_targets,
              },
              "want_more": true,
            }
          : ((!has_hub && size(cloud_targets) == 0) ?
            {
              "events": size(conf_evts + cloud_disc_errs) > 0 ? (conf_evts + cloud_disc_errs) : [dyn({ "fake": true })],
              "cursor": {
                "conf_sig": conf_sig,
                "idx_baselines": base_map,
              },
              "want_more": false,
            }
          :
            (has_hub ?
              get_request(clean_hub_url + "/").with({ "Header": { "Authorization": ["ApiKey " + state.hub_es_api_key] } }).do_request().as(hub_resp,
                (hub_resp.StatusCode == 200) ?
                  bytes(hub_resp.Body).decode_json().as(hub_info,
                    ((has(hub_info.cluster_name) && hub_info.cluster_name != null && string(hub_info.cluster_name) != "") ? string(hub_info.cluster_name) : "hub").as(hub_cname,
                      {
                        "ok": true,
                        "err": dyn({}),
                        "targets": cloud_targets.exists(ct, string(ct.id) == hub_cname || string(ct.es_url) == clean_hub_url) ?
                          cloud_targets.map(ct, (string(ct.id) == hub_cname || string(ct.es_url) == clean_hub_url) ? dyn(ct.with({ "is_hub": true })) : ct)
                        :
                          cloud_targets + [dyn({
                            "id": hub_cname,
                            "alt_id": hub_cname,
                            "name": hub_cname,
                            "es_url": clean_hub_url,
                            "is_ech": true,
                            "is_hub": true,
                          })],
                      }
                    )
                  )
                :
                  {
                    "ok": false,
                    "err": dyn({ "error": { "code": string(hub_resp.StatusCode), "id": string(hub_resp.Status), "message": "GET " + hub_resp.Request.URL + ": " + ((size(hub_resp.Body) != 0) ? string(hub_resp.Body) : string(hub_resp.Status)) } }),
                    "targets": cloud_targets,
                  }
              )
            : { "ok": true, "err": dyn({}), "targets": cloud_targets }).as(hub_disc,
              hub_disc.targets.map(t,
                string(t.id).as(tid,
                (string(t.es_url).endsWith("/") ? string(t.es_url).substring(0, size(string(t.es_url)) - 1) : string(t.es_url)).as(es_base,
                  all_dkeys.filter(k, k.startsWith(tid + ":") || k.startsWith(string(t.alt_id) + ":") || k.startsWith(string(t.name) + ":")).map(k,
                    k.substring(size(k.split(":")[0]) + 1, size(k))
                  ).filter(k, k != "").as(d_keys,
                    (d_keys + ((bool(t.is_hub) && has_hub && !(state.hub_es_api_key in d_keys)) ? [state.hub_es_api_key] : [])).as(dh_keys,
                    (dh_keys + ((!bool(t.is_ech) && has_cloud && !(state.api_key in dh_keys)) ? [state.api_key] : [])).as(cand_keys,
                    (size(cand_keys) == 0) ?
                      { "ok": true, "skipped": true, "id": tid, "evts": [], "baselines": [], "err": dyn({}) }
                    :
                      (es_base + (bool(t.is_ech) ?
                        "/*,.ds-*/_stats/docs,store,indexing,search?expand_wildcards=open,hidden&ignore_unavailable=true&allow_no_indices=true&filter_path=indices.*.primaries.docs.count,indices.*.primaries.store.total_data_set_size_in_bytes,indices.*.primaries.store.size_in_bytes,indices.*.total.store.size_in_bytes,indices.*.total.indexing.index_time_in_millis,indices.*.total.search.query_time_in_millis,indices.*.total.search.query_total"
                      :
                        "/_cat/indices/*,.ds-*?format=json&bytes=b&time=ms&expand_wildcards=open,hidden&h=index,docs.count,store.size,dataset.size,indexing.index_time,search.query_time,search.query_total,creation.date"
                      )).as(stats_url,
                        get_request(stats_url).with({ "Header": { "Authorization": ["ApiKey " + cand_keys[0]] } }).do_request().as(r0,
                          (r0.StatusCode == 200) ?
                            { "ok": true, "body": bytes(r0.Body).decode_json(), "key": cand_keys[0], "resp": r0 }
                          : (size(cand_keys) > 1 ?
                            tail(cand_keys).filter(ck, ck != cand_keys[0]).as(rem_keys,
                              (size(rem_keys) == 0) ?
                                { "ok": false, "body": dyn({}), "key": "", "resp": r0 }
                              :
                                rem_keys.map(ck,
                                  get_request(stats_url).with({ "Header": { "Authorization": ["ApiKey " + ck] } }).do_request().as(cr,
                                    { "ok": cr.StatusCode == 200, "key": ck, "resp": cr }
                                  )
                                ).as(rest_resps,
                                  rest_resps.filter(x, x.ok).as(ok_resps,
                                    (size(ok_resps) > 0) ?
                                      { "ok": true, "body": bytes(ok_resps[0].resp.Body).decode_json(), "key": ok_resps[0].key, "resp": ok_resps[0].resp }
                                    :
                                      { "ok": false, "body": dyn({}), "key": "", "resp": rest_resps[size(rest_resps) - 1].resp }
                                  )
                                )
                            )
                          : { "ok": false, "body": dyn({}), "key": "", "resp": r0 })
                        ).as(harvest,
                          (!harvest.ok) ?
                            {
                              "ok": false,
                              "skipped": false,
                              "id": tid,
                              "evts": [],
                              "baselines": [],
                              "err": dyn({
                                "error": {
                                  "code": string(harvest.resp.StatusCode),
                                  "id": string(harvest.resp.Status),
                                  "message": "GET " + harvest.resp.Request.URL + ": " + ((size(harvest.resp.Body) != 0) ? string(harvest.resp.Body) : string(harvest.resp.Status)),
                                },
                              }),
                            }
                          :
                            (bool(t.is_ech) ?
                              (es_base + "/*,.ds-*/_settings/index.routing.allocation.include._tier_preference,index.creation_date?expand_wildcards=open,hidden&ignore_unavailable=true&allow_no_indices=true&flat_settings=true&filter_path=*.settings").as(set_url,
                                get_request(set_url).with({ "Header": { "Authorization": ["ApiKey " + harvest.key] } }).do_request().as(set_resp,
                                  (set_resp.StatusCode != 200) ?
                                    {
                                      "ok": false,
                                      "err": dyn({
                                        "error": {
                                          "code": string(set_resp.StatusCode),
                                          "id": string(set_resp.Status),
                                          "message": "GET " + set_resp.Request.URL + ": " + ((size(set_resp.Body) != 0) ? string(set_resp.Body) : string(set_resp.Status)),
                                        },
                                      }),
                                      "rows": [],
                                    }
                                  :
                                    bytes(set_resp.Body).decode_json().as(settings_map,
                                      (es_base + "/_cluster/state/routing_table,nodes/*,.ds-*?local=true&expand_wildcards=open,hidden&ignore_unavailable=true&allow_no_indices=true&filter_path=nodes.*.roles,routing_table.indices.*.shards.*.state,routing_table.indices.*.shards.*.node").as(cs_url,
                                        get_request(cs_url).with({ "Header": { "Authorization": ["ApiKey " + harvest.key] } }).do_request().as(cs_resp,
                                          (cs_resp.StatusCode == 200 ? bytes(cs_resp.Body).decode_json() : dyn({})).as(cs_body,
                                            ((has(cs_body.nodes) && cs_body.nodes != null) ? cs_body.nodes : dyn({})).as(cs_nodes,
                                            ((has(cs_body.routing_table) && cs_body.routing_table != null && has(cs_body.routing_table.indices) && cs_body.routing_table.indices != null) ? cs_body.routing_table.indices : dyn({})).as(cs_rt,
                                            ((has(harvest.body.indices) && harvest.body.indices != null) ? harvest.body.indices : dyn({})).as(indices_obj,
                                              {
                                                "ok": true,
                                                "err": dyn({}),
                                                "rows": indices_obj.keys().map(raw_idx,
                                                  string(raw_idx).as(rname,
                                                  (rname.contains(":") ? rname.substring(size(rname.split(":")[0]) + 1, size(rname)) : rname).as(iname,
                                                  indices_obj[raw_idx].as(istats,
                                                  ((iname in settings_map && settings_map[iname] != null && has(settings_map[iname].settings) && settings_map[iname].settings != null) ? settings_map[iname].settings : dyn({})).as(iset,
                                                  ((has(istats.primaries) && istats.primaries != null && has(istats.primaries.store) && istats.primaries.store != null) ? (
                                                    (has(istats.primaries.store.total_data_set_size_in_bytes) && istats.primaries.store.total_data_set_size_in_bytes != null) ? int(istats.primaries.store.total_data_set_size_in_bytes) : (
                                                      (has(istats.primaries.store.size_in_bytes) && istats.primaries.store.size_in_bytes != null) ? int(istats.primaries.store.size_in_bytes) : 0
                                                    )
                                                  ) : 0).as(dset_b,
                                                    dyn({
                                                      "raw_idx": rname,
                                                      "idx_name": iname,
                                                      "tier_pref": (("index.routing.allocation.include._tier_preference" in iset) && iset["index.routing.allocation.include._tier_preference"] != null) ? string(iset["index.routing.allocation.include._tier_preference"]) : "",
                                                      "alloc_roles": ((iname in cs_rt && cs_rt[iname] != null && has(cs_rt[iname].shards) && cs_rt[iname].shards != null) ?
                                                        cs_rt[iname].shards.keys().map(sk,
                                                          cs_rt[iname].shards[sk].filter(sr,
                                                            has(sr.state) && (string(sr.state) == "STARTED" || string(sr.state) == "RELOCATING") &&
                                                            has(sr.node) && sr.node != null && string(sr.node) in cs_nodes &&
                                                            cs_nodes[string(sr.node)] != null && has(cs_nodes[string(sr.node)].roles) && cs_nodes[string(sr.node)].roles != null
                                                          ).map(sr, cs_nodes[string(sr.node)].roles.map(rl, string(rl)).join(","))
                                                        ).flatten()
                                                      : []),
