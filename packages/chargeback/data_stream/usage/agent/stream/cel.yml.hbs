                ).as(results,
                  results.filter(r, r.ok && !r.skipped).map(r, r.id).as(newly_harvested_ids,
                  (done_targets + results.filter(r, r.ok).map(r, r.id)).as(new_done_targets,
                  (hub_disc.ok && results.all(r, r.ok)).as(all_ok,
                  (prev_baselines.filter(b, !(string(b.c) in newly_harvested_ids)) + results.map(r, r.baselines).flatten()).as(merged_baselines,
                  (
                    conf_evts +
                    (!hub_disc.ok ? [hub_disc.err] : []) +
                    results.filter(r, !r.ok).map(r, r.err) +
                    results.map(r, r.evts).flatten()
