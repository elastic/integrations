                    {
                      "events": size(out_evts) > 0 ? out_evts : [dyn({ "fake": true })],
                      "cursor": {
                        "last_day": all_ok ? day_ts : prev_last_day,
                        "pending_day": day_ts,
                        "completed_targets": all_ok ? [] : new_done_targets,
                        "conf_sig": conf_sig,
                        "idx_baselines": merged_baselines,
