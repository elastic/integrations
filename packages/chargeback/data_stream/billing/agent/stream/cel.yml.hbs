config_version: 2
interval: "1h"
{{#if enable_request_tracer}}
resource.tracer.filename: "../../logs/cel/http-request-trace-*.ndjson"
resource.tracer.maxbackups: 5
{{/if}}
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl:
  {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: "{{billing_api_base}}"
state:
  api_key: !!str {{escape_string cloud_api_key}}
  organization_id: !!str {{escape_string organization_id}}
  billing_api_base: !!str {{escape_string billing_api_base}}
  cloud_api_base: !!str {{escape_string cloud_api_base}}
  hub_es_url: !!str {{escape_string hub_es_url}}
  lookbehind: !!int {{lookbehind}}
  sync_fleet_config: !!bool {{sync_fleet_config}}
  config_owner_id: !!str {{escape_string config_owner_id}}
  conf_unit_rate: !!str {{escape_string unit_rate}}
  conf_onprem_unit_rate: !!str {{escape_string onprem_unit_rate}}
  conf_currency_unit: !!str {{escape_string currency_unit}}
  conf_effective_from: !!str {{escape_string config_effective_from}}
  collect_ess_credits: !!bool {{collect_ess_credits}}
redact:
  fields:
    - api_key
    - cloud_api_key
    - proxy_url
program: |-
  state.with(
    now.format(time_layout.DateOnly).as(today_utc,
    state.config_owner_id.trim_space().as(clean_owner_id,
    string(state.?cursor.conf_policy_id.orValue("")).as(prev_conf_pol_id,
    (prev_conf_pol_id != "" ? prev_conf_pol_id :
      state.hub_es_url.trim_space().as(thub,
      state.billing_api_base.trim_space().as(tbill,
      state.cloud_api_base.trim_space().as(tcloud,
        "pol|" + state.organization_id.trim_space() + "|" +
        (thub.endsWith("/") ? thub.substring(0, size(thub) - 1) : thub) + "|" +
        (tbill.endsWith("/") ? tbill.substring(0, size(tbill) - 1) : tbill) + "|" +
        (tcloud.endsWith("/") ? tcloud.substring(0, size(tcloud) - 1) : tcloud) + "|" +
        clean_owner_id + "|" + (state.sync_fleet_config ? "sync" : "nosync")
      )))
    ).as(conf_policy_id,
    state.conf_unit_rate.trim_space().as(clean_rate,
    clean_rate.matches("^[0-9]+(\\.[0-9]+)?$").as(rate_valid,
    state.conf_onprem_unit_rate.trim_space().as(clean_onprem_rate,
    (clean_onprem_rate == "" || clean_onprem_rate.matches("^[0-9]+(\\.[0-9]+)?$")).as(onprem_rate_valid,
    state.conf_effective_from.trim_space().as(clean_eff_from,
    (clean_eff_from == "" ? true : (
      !clean_eff_from.matches("^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(T00:00:00(\\.[0]+)?(Z|[+-]00:00))?$") ? false : (
        int(clean_eff_from.substring(0, 4)).as(eff_y,
        int(clean_eff_from.substring(5, 7)).as(eff_m,
        int(clean_eff_from.substring(8, 10)).as(eff_d,
        ((eff_y % 4 == 0 && eff_y % 100 != 0) || (eff_y % 400 == 0)).as(eff_leap,
        ((eff_m == 4 || eff_m == 6 || eff_m == 9 || eff_m == 11) ? 30 : ((eff_m == 2) ? (eff_leap ? 29 : 28) : 31)).as(eff_max_d,
          eff_y >= 1970 && eff_d <= eff_max_d && (
            timestamp(clean_eff_from.substring(0, 10) + "T00:00:00Z") < timestamp("2046-12-31T23:59:59.999Z")
          )
        )))))
      )
    )).as(eff_valid,
    ((clean_eff_from == "" || !eff_valid) ? "" : (clean_eff_from.substring(0, 10) + "T00:00:00Z")).as(norm_eff_from,
    (!state.sync_fleet_config ? ("disabled|" + clean_owner_id) : (
      (rate_valid && onprem_rate_valid && eff_valid) ? (clean_owner_id + "|" + clean_rate + "|" + clean_onprem_rate + "|" + state.conf_currency_unit + "|" + norm_eff_from + "|" + today_utc) : state.?cursor.conf_sig.orValue("")
    )).as(conf_sig,
    ((state.sync_fleet_config && !rate_valid) ?
      [dyn({
        "error": {
          "code": "invalid_config",
          "id": "unit_rate",
          "message": "Invalid unit_rate '" + state.conf_unit_rate + "': expected non-negative decimal using '.' (for example 0.85)",
        },
      })]
    : ((state.sync_fleet_config && !onprem_rate_valid) ?
      [dyn({
        "error": {
          "code": "invalid_config",
          "id": "onprem_unit_rate",
          "message": "Invalid onprem_unit_rate '" + state.conf_onprem_unit_rate + "': expected empty string or non-negative decimal using '.' (for example 0.00085)",
        },
      })]
    : ((state.sync_fleet_config && !eff_valid) ?
      [dyn({
        "error": {
          "code": "invalid_config",
          "id": "config_effective_from",
          "message": "Invalid config_effective_from '" + state.conf_effective_from + "': expected empty string or UTC day-boundary date/timestamp between 1970-01-01 and 2046-12-31 (for example 2026-01-01 or 2026-01-01T00:00:00Z)",
        },
      })]
    : ((state.sync_fleet_config && state.?cursor.conf_sig.orValue("") != conf_sig) ?
      [dyn({
        "doc_type": "config_snapshot",
        "conf_sync_enabled": true,
        "conf_owner_id": clean_owner_id,
        "conf_policy_id": conf_policy_id,
        "conf_chargeable_unit_rate": double(clean_rate),
        "conf_onprem_chargeable_unit_rate": clean_onprem_rate != "" ? double(clean_onprem_rate) : double(clean_rate),
        "conf_chargeable_unit_rate_unit": state.conf_currency_unit,
        "conf_effective_from": norm_eff_from,
      })]
    : ((!state.sync_fleet_config && state.?cursor.conf_sig.orValue("") != conf_sig) ?
      [dyn({
        "doc_type": "config_snapshot",
        "conf_sync_enabled": false,
        "conf_owner_id": clean_owner_id,
        "conf_policy_id": conf_policy_id,
      })]
    : []))))).as(conf_evts,
    (state.organization_id == "" || state.api_key == "" || state.api_key.startsWith("$co.elastic.secret")) ?
      {
        "events": size(conf_evts) > 0 ? conf_evts : [dyn({ "fake": true })],
        "cursor": { "conf_sig": conf_sig, "conf_policy_id": conf_policy_id },
        "want_more": false,
      }
    :
      state.?cursor.last_credit_day.orValue("").as(prev_credit_day,
      int(state.?cursor.disc_dep_from.orValue(0)).as(dep_from,
      string(state.?cursor.disc_es_next.orValue("START")).as(es_next,
      string(state.?cursor.disc_obs_next.orValue("START")).as(obs_next,
      string(state.?cursor.disc_sec_next.orValue("START")).as(sec_next,
      string(state.?cursor.disc_vdb_next.orValue("START")).as(vdb_next,
      ((state.collect_ess_credits && prev_credit_day != today_utc && dep_from == 0 && es_next == "START" && obs_next == "START" && sec_next == "START" && vdb_next == "START") ?
        (state.billing_api_base + "/api/v1/billing/organization/" + state.organization_id + "/line_items").as(cred_url,
          try(
            get_request(cred_url).with({ "Header": { "Authorization": ["ApiKey " + state.api_key] } }).do_request(),
            "req_err"
          ).as(cred_resp,
            has(cred_resp.req_err) ?
              {
                "evts": [dyn({
                  "error": {
                    "code": "transport_error",
                    "id": "credit_line_items",
                    "message": "GET " + cred_url + ": " + string(cred_resp.req_err),
                  },
                })],
                "credit_day": prev_credit_day,
              }
            : (cred_resp.StatusCode == 200) ?
              try(bytes(cred_resp.Body).decode_json(), "json_err").as(cred_items,
                (type(cred_items) == map && has(cred_items.json_err)) ?
                  {
                    "evts": [dyn({
                      "error": {
                        "code": "decode_error",
                        "id": "credit_line_items",
                        "message": "GET " + cred_url + ": " + string(cred_items.json_err),
                      },
                    })],
                    "credit_day": prev_credit_day,
                  }
                :
                  {
                    "evts": (type(cred_items) == list ? cred_items : []).map(item,
                      dyn({
                        "doc_type": "credit_line_item",
                        "ess": {
                          "billing": {
                            "organization_id": state.organization_id,
                            "start": item.start,
                            "end": item.end,
                            "ecu_quantity": (has(item.ecu_quantity) && item.ecu_quantity != null) ? double(item.ecu_quantity) : 0.0,
                            "ecu_balance": (has(item.ecu_balance) && item.ecu_balance != null) ? double(item.ecu_balance) : 0.0,
                            "active": (has(item.active) && item.active != null) ? bool(item.active) : false,
                            "type": (has(item.type) && item.type != null) ? string(item.type) : "",
                          },
                        },
                      })
                    ),
                    "credit_day": today_utc,
                  }
              )
            :
              {
                "evts": [dyn({
                  "error": {
                    "code": string(cred_resp.StatusCode),
                    "id": string(cred_resp.Status),
                    "message": "GET " + cred_resp.Request.URL + ": " + ((size(cred_resp.Body) != 0) ? string(cred_resp.Body) : string(cred_resp.Status)),
                  },
                })],
                "credit_day": prev_credit_day,
              }
          )
        )
      : { "evts": [], "credit_day": prev_credit_day }).as(cred_res,
        (conf_evts + cred_res.evts).as(meta_evts,
        (now - duration("2h")).format(time_layout.DateOnly).parse_time(time_layout.DateOnly).as(ready_day_end,
        min(max(int(state.lookbehind), 0), 3650).as(clamped_lookbehind,
        (ready_day_end - duration(string(clamped_lookbehind * 24) + "h")).as(default_from,
        state.?cursor.last_to.optMap(ts,
          ((type(ts) == string) ? timestamp(ts) : ts).as(parsed_ts,
            (parsed_ts > ready_day_end) ? default_from : parsed_ts
          )
        ).orValue(default_from).format(
          time_layout.DateOnly
        ).parse_time(time_layout.DateOnly).as(raw_from,
          max(raw_from, timestamp("2021-01-01T00:00:00Z")).as(from,
            {
              "from": from,
              "to": from + duration("24h"),
            }
          ).as(req,
            (req.to + duration("2h") > now) ?
              {
                "events": size(meta_evts) > 0 ? meta_evts : [dyn({ "fake": true })],
                "cursor": {
                  "last_to": req.from.format(time_layout.RFC3339),
                  "conf_sig": conf_sig,
                  "conf_policy_id": conf_policy_id,
                  "last_credit_day": cred_res.credit_day,
                },
                "want_more": false,
              }
            :
              state.?cursor.disc_ech.orValue([]).as(acc_ech,
              state.?cursor.disc_sls.orValue([]).as(acc_sls,
              bool(state.?cursor.disc_dep_failed.orValue(false)).as(prev_dep_failed,
              bool(state.?cursor.disc_es_failed.orValue(false)).as(prev_es_failed,
              bool(state.?cursor.disc_obs_failed.orValue(false)).as(prev_obs_failed,
              bool(state.?cursor.disc_sec_failed.orValue(false)).as(prev_sec_failed,
              bool(state.?cursor.disc_vdb_failed.orValue(false)).as(prev_vdb_failed,
              ((dep_from >= 0) ?
                (state.cloud_api_base + "/api/v1/deployments/_search?show_metadata=true").as(dep_search_url,
                  try(
                    request(
                      "POST",
                      dep_search_url
                    ).with(
                      {
                        "Header": {
                          "Authorization": ["ApiKey " + state.api_key],
                          "Content-Type": ["application/json"],
                        },
                        "Body": { "size": 500, "from": dep_from }.encode_json(),
                      }
                    ).do_request(),
                    "req_err"
                  ).as(dep_resp,
                    has(dep_resp.req_err) ?
                      {
                        "ok": false,
                        "retryable": true,
                        "err": dyn({ "error": { "code": "transport_error", "id": "deployments_search", "message": "POST " + dep_search_url + ": " + string(dep_resp.req_err) } }),
                        "items": [],
                        "next_from": -1,
                      }
                    : (dep_resp.StatusCode == 200) ?
                      try(bytes(dep_resp.Body).decode_json(), "json_err").as(dep_body,
                        has(dep_body.json_err) ?
                          {
                            "ok": false,
                            "retryable": true,
                            "err": dyn({ "error": { "code": "decode_error", "id": "deployments_search", "message": "POST " + dep_search_url + ": " + string(dep_body.json_err) } }),
                            "items": [],
                            "next_from": -1,
                          }
                        :
                          ((has(dep_body.deployments) && dep_body.deployments != null) ? dep_body.deployments : []).as(raw_deps,
                            {
                              "ok": true,
                              "retryable": false,
                              "err": dyn({}),
                              "items": raw_deps.filter(d,
                                has(d.id) && d.id != null && string(d.id) != ""
                              ).map(d,
                                (has(d.resources) && d.resources != null && has(d.resources.elasticsearch) && d.resources.elasticsearch != null && size(d.resources.elasticsearch) > 0).as(has_es_res,
                                  ((has_es_res && has(d.resources.elasticsearch[0].id) && d.resources.elasticsearch[0].id != null && string(d.resources.elasticsearch[0].id) != "") ? string(d.resources.elasticsearch[0].id) : string(d.id)).as(primary_id,
                                    dyn({
                                      "id": primary_id,
                                      "dep_id": string(d.id),
                                      "name": (has(d.name) && d.name != null && string(d.name) != "") ? string(d.name) : primary_id,
                                      "region": (has_es_res && has(d.resources.elasticsearch[0].region) && d.resources.elasticsearch[0].region != null) ? string(d.resources.elasticsearch[0].region) : "",
                                      "tags": (has(d.metadata) && d.metadata != null && has(d.metadata.tags) && d.metadata.tags != null) ?
                                        d.metadata.tags.filter(t, has(t.key) && t.key != null && has(t.value) && t.value != null).map(t, string(t.key) + ":" + string(t.value)) : [],
                                    })
                                  )
                                )
                              ),
                              "next_from": (has(dep_body.match_count) && dep_body.match_count != null && size(raw_deps) > 0 && (dep_from + size(raw_deps)) < int(dep_body.match_count)) ? (dep_from + size(raw_deps)) : -1,
                            }
                          )
                      )
                    : (dep_resp.StatusCode == 404 ? { "ok": true, "retryable": false, "err": dyn({}), "items": [], "next_from": -1 } : {
                        "ok": false,
                        "retryable": (dep_resp.StatusCode != 401 && dep_resp.StatusCode != 403) || dep_from > 0,
                        "err": dyn({ "error": { "code": string(dep_resp.StatusCode), "id": string(dep_resp.Status), "message": "POST " + dep_resp.Request.URL + ": " + ((size(dep_resp.Body) != 0) ? string(dep_resp.Body) : string(dep_resp.Status)) } }),
                        "items": [],
                        "next_from": -1,
                      })
                  )
                )
              : { "ok": true, "retryable": false, "err": dyn({}), "items": [], "next_from": -1 }).as(dep_page,
              ((es_next != "") ?
                (state.cloud_api_base + "/api/v1/serverless/projects/elasticsearch?" + (es_next == "START" ? { "size": ["100"] } : { "size": ["100"], "next_page": [es_next] }).format_query()).as(es_disc_url,
                  try(
                    get_request(es_disc_url).with({ "Header": { "Authorization": ["ApiKey " + state.api_key] } }).do_request(),
                    "req_err"
                  ).as(r,
                    has(r.req_err) ?
                      {
                        "ok": false,
                        "retryable": true,
                        "err": dyn({ "error": { "code": "transport_error", "id": "serverless_elasticsearch", "message": "GET " + es_disc_url + ": " + string(r.req_err) } }),
                        "items": [],
                        "next": "",
                      }
                    : (r.StatusCode == 200) ?
                      try(bytes(r.Body).decode_json(), "json_err").as(b,
                        has(b.json_err) ?
                          {
                            "ok": false,
                            "retryable": true,
                            "err": dyn({ "error": { "code": "decode_error", "id": "serverless_elasticsearch", "message": "GET " + es_disc_url + ": " + string(b.json_err) } }),
                            "items": [],
                            "next": "",
                          }
                        :
                          {
                            "ok": true,
                            "retryable": false,
                            "err": dyn({}),
                            "items": (has(b.items) && b.items != null) ? b.items.map(p, dyn({
                              "id": string(p.id),
                              "name": (has(p.name) && p.name != null) ? string(p.name) : "",
                              "region_id": (has(p.region_id) && p.region_id != null) ? string(p.region_id) : "",
                              "project_type": "elasticsearch",
                            })) : [],
                            "next": (has(b.next_page) && b.next_page != null && string(b.next_page) != "") ? string(b.next_page) : "",
                          }
                      )
                    : (r.StatusCode == 404 ? { "ok": true, "retryable": false, "err": dyn({}), "items": [], "next": "" } : {
                        "ok": false,
                        "retryable": (r.StatusCode != 401 && r.StatusCode != 403) || es_next != "START",
                        "err": dyn({ "error": { "code": string(r.StatusCode), "id": string(r.Status), "message": "GET " + r.Request.URL + ": " + ((size(r.Body) != 0) ? string(r.Body) : string(r.Status)) } }),
                        "items": [],
                        "next": "",
                      })
                  )
                )
              : { "ok": true, "retryable": false, "err": dyn({}), "items": [], "next": "" }).as(es_page,
              ((obs_next != "") ?
                (state.cloud_api_base + "/api/v1/serverless/projects/observability?" + (obs_next == "START" ? { "size": ["100"] } : { "size": ["100"], "next_page": [obs_next] }).format_query()).as(obs_disc_url,
                  try(
                    get_request(obs_disc_url).with({ "Header": { "Authorization": ["ApiKey " + state.api_key] } }).do_request(),
                    "req_err"
                  ).as(r,
                    has(r.req_err) ?
                      {
                        "ok": false,
                        "retryable": true,
                        "err": dyn({ "error": { "code": "transport_error", "id": "serverless_observability", "message": "GET " + obs_disc_url + ": " + string(r.req_err) } }),
                        "items": [],
                        "next": "",
                      }
                    : (r.StatusCode == 200) ?
                      try(bytes(r.Body).decode_json(), "json_err").as(b,
                        has(b.json_err) ?
                          {
                            "ok": false,
                            "retryable": true,
                            "err": dyn({ "error": { "code": "decode_error", "id": "serverless_observability", "message": "GET " + obs_disc_url + ": " + string(b.json_err) } }),
                            "items": [],
                            "next": "",
                          }
                        :
                          {
                            "ok": true,
                            "retryable": false,
                            "err": dyn({}),
                            "items": (has(b.items) && b.items != null) ? b.items.map(p, dyn({
                              "id": string(p.id),
                              "name": (has(p.name) && p.name != null) ? string(p.name) : "",
                              "region_id": (has(p.region_id) && p.region_id != null) ? string(p.region_id) : "",
                              "project_type": "observability",
                            })) : [],
                            "next": (has(b.next_page) && b.next_page != null && string(b.next_page) != "") ? string(b.next_page) : "",
                          }
                      )
                    : (r.StatusCode == 404 ? { "ok": true, "retryable": false, "err": dyn({}), "items": [], "next": "" } : {
                        "ok": false,
                        "retryable": (r.StatusCode != 401 && r.StatusCode != 403) || obs_next != "START",
                        "err": dyn({ "error": { "code": string(r.StatusCode), "id": string(r.Status), "message": "GET " + r.Request.URL + ": " + ((size(r.Body) != 0) ? string(r.Body) : string(r.Status)) } }),
                        "items": [],
                        "next": "",
                      })
                  )
                )
              : { "ok": true, "retryable": false, "err": dyn({}), "items": [], "next": "" }).as(obs_page,
              ((sec_next != "") ?
                (state.cloud_api_base + "/api/v1/serverless/projects/security?" + (sec_next == "START" ? { "size": ["100"] } : { "size": ["100"], "next_page": [sec_next] }).format_query()).as(sec_disc_url,
                  try(
                    get_request(sec_disc_url).with({ "Header": { "Authorization": ["ApiKey " + state.api_key] } }).do_request(),
                    "req_err"
                  ).as(r,
                    has(r.req_err) ?
                      {
                        "ok": false,
                        "retryable": true,
                        "err": dyn({ "error": { "code": "transport_error", "id": "serverless_security", "message": "GET " + sec_disc_url + ": " + string(r.req_err) } }),
                        "items": [],
                        "next": "",
                      }
                    : (r.StatusCode == 200) ?
                      try(bytes(r.Body).decode_json(), "json_err").as(b,
                        has(b.json_err) ?
                          {
                            "ok": false,
                            "retryable": true,
                            "err": dyn({ "error": { "code": "decode_error", "id": "serverless_security", "message": "GET " + sec_disc_url + ": " + string(b.json_err) } }),
                            "items": [],
                            "next": "",
                          }
                        :
                          {
                            "ok": true,
                            "retryable": false,
                            "err": dyn({}),
                            "items": (has(b.items) && b.items != null) ? b.items.map(p, dyn({
                              "id": string(p.id),
                              "name": (has(p.name) && p.name != null) ? string(p.name) : "",
                              "region_id": (has(p.region_id) && p.region_id != null) ? string(p.region_id) : "",
                              "project_type": "security",
                            })) : [],
                            "next": (has(b.next_page) && b.next_page != null && string(b.next_page) != "") ? string(b.next_page) : "",
                          }
                      )
                    : (r.StatusCode == 404 ? { "ok": true, "retryable": false, "err": dyn({}), "items": [], "next": "" } : {
                        "ok": false,
                        "retryable": (r.StatusCode != 401 && r.StatusCode != 403) || sec_next != "START",
                        "err": dyn({ "error": { "code": string(r.StatusCode), "id": string(r.Status), "message": "GET " + r.Request.URL + ": " + ((size(r.Body) != 0) ? string(r.Body) : string(r.Status)) } }),
                        "items": [],
                        "next": "",
                      })
                  )
                )
              : { "ok": true, "retryable": false, "err": dyn({}), "items": [], "next": "" }).as(sec_page,
              ((vdb_next != "") ?
                (state.cloud_api_base + "/api/v1/serverless/projects/vectordb?" + (vdb_next == "START" ? { "size": ["100"] } : { "size": ["100"], "next_page": [vdb_next] }).format_query()).as(vdb_disc_url,
                  try(
                    get_request(vdb_disc_url).with({ "Header": { "Authorization": ["ApiKey " + state.api_key] } }).do_request(),
                    "req_err"
                  ).as(r,
                    has(r.req_err) ?
                      {
                        "ok": false,
                        "retryable": true,
                        "err": dyn({ "error": { "code": "transport_error", "id": "serverless_vectordb", "message": "GET " + vdb_disc_url + ": " + string(r.req_err) } }),
                        "items": [],
                        "next": "",
                      }
                    : (r.StatusCode == 200) ?
                      try(bytes(r.Body).decode_json(), "json_err").as(b,
                        has(b.json_err) ?
                          {
