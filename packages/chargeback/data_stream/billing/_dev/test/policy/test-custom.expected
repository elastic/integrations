            "next_from": has_more_days ? req.to.format(time_layout.RFC3339) : replay_start_str,
            "recent_day_keys": updated_recent_keys,
            "group_first_seen": merged_gfs,
            "group_obs_seeded": next_gfs_seeded,
            "conf_sig": conf_sig,
            "last_credit_day": cred_res.credit_day,
