            )))))))))
            )
            )
            )
            )
            )
            )
            )
            )
            )
            )
            )
            )
            :
            {
            "events": meta_evts + disc_errs + [dyn({ "error": { "code": string(resp.StatusCode), "id": string(resp.Status), "message": "GET " + resp.Request.URL + ": " + ((size(resp.Body) != 0) ? string(resp.Body) : string(resp.Status)) } })],
            "cursor": {
