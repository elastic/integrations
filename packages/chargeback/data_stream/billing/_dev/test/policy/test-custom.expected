            "last_to": max(high_water, req.to).format(time_layout.RFC3339),
            "replay_target_to": (high_water >= latest_ready_to || !has_more_days) ? latest_ready_to_str : replay_target_to,
            "replay_completed_to": (high_water >= latest_ready_to && !has_more_days) ? latest_ready_to_str : replay_completed_to,
