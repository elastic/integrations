inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: chargeback
      name: test-custom-chargeback
      streams:
        - config_version: 2
          data_stream:
            dataset: chargeback.node_stats
          interval: 15m
          processors:
            - drop_event.when.equals.fake: true
            - copy_fields:
                fail_on_error: false
                fields:
                    - from: '@metadata.input_id'
                      to: conf_policy_id
                ignore_missing: true
                when:
                    and:
                        - not:
                            has_fields:
                                - conf_policy_id
                        - not:
                            has_fields:
                                - error.message
          program: |-
            state.with(
              (state.?unsupported_agent_version.orValue("") != "") ?
              {
                "events": [dyn({
                  "error": {
                    "code": "unsupported_agent_version",
                    "id": "agent_version_guard",
                    "message": "Unsupported Elastic Agent version " + string(state.unsupported_agent_version) + ": chargeback requires a Fleet-managed Elastic Agent >= 9.2.0",
                  },
                })],
                "cursor": state.?cursor.orValue({}),
                "want_more": false,
              }
              :
              state.api_key.trim_space().as(clean_api_key,
              state.hub_es_api_key.trim_space().as(clean_hub_key,
              now.format(time_layout.DateOnly).as(today_utc,
              state.organization_id.trim_space().as(clean_org_id,
              state.cloud_api_base.trim_space().as(trimmed_cloud_base,
              (trimmed_cloud_base.endsWith("/") ? trimmed_cloud_base.substring(0, size(trimmed_cloud_base) - 1) : trimmed_cloud_base).as(clean_cloud_base,
              state.config_owner_id.trim_space().as(clean_owner_id,
              state.hub_es_url.trim_space().as(trimmed_hub_url,
              (trimmed_hub_url.endsWith("/") ? trimmed_hub_url.substring(0, size(trimmed_hub_url) - 1) : trimmed_hub_url).as(clean_hub_url,
              state.conf_utilization_floor.trim_space().as(clean_floor,
              clean_floor.matches("^(0(\\.[0-9]+)?|1(\\.0+)?)$").as(floor_valid,
              (int(state.conf_utilization_memory_weight) >= 0 && int(state.conf_utilization_storage_weight) >= 0 && (int(state.conf_utilization_memory_weight) + int(state.conf_utilization_storage_weight)) > 0).as(weights_valid,
              (!state.sync_fleet_config ? ("disabled|" + clean_owner_id) : (
                (floor_valid && weights_valid) ? (clean_owner_id + "|" + string(state.conf_utilization_memory_weight) + "|" + string(state.conf_utilization_storage_weight) + "|" + clean_floor + "|" + today_utc) : state.?cursor.conf_sig.orValue("")
              )).as(conf_sig,
              ((state.sync_fleet_config && !floor_valid) ?
                [dyn({
                  "error": {
                    "code": "invalid_config",
                    "id": "utilization_floor",
                    "message": "Invalid utilization_floor '" + state.conf_utilization_floor + "': expected decimal between 0.0 and 1.0 using '.' (for example 0.10)",
                  },
                })]
              : ((state.sync_fleet_config && !weights_valid) ?
                [dyn({
                  "error": {
                    "code": "invalid_config",
                    "id": "utilization_weights",
                    "message": "Invalid utilization weights (memory=" + string(state.conf_utilization_memory_weight) + ", storage=" + string(state.conf_utilization_storage_weight) + "): weights must be non-negative and their sum must be greater than 0",
                  },
                })]
              : ((state.sync_fleet_config && state.?cursor.conf_sig.orValue("") != conf_sig) ?
                [dyn({
                  "doc_type": "config_snapshot",
                  "conf_sync_enabled": true,
                  "conf_schema_version": 2,
                  "conf_owner_id": clean_owner_id,
                  "conf_utilization_memory_weight": int(state.conf_utilization_memory_weight),
                  "conf_utilization_storage_weight": int(state.conf_utilization_storage_weight),
                  "conf_utilization_floor": double(clean_floor),
                })]
              : ((!state.sync_fleet_config && state.?cursor.conf_sig.orValue("") != conf_sig) ?
                [dyn({
                  "doc_type": "config_snapshot",
                  "conf_sync_enabled": false,
                  "conf_owner_id": clean_owner_id,
                }.with(state.?cursor.conf_sig.orValue("") != "" ? { "conf_schema_version": 2 } : {}))]
              : [])))).as(conf_evts,
              (clean_org_id != "" && clean_cloud_base != "" && clean_api_key != "" && !clean_api_key.startsWith("$co.elastic.secret")).as(has_cloud,
              (clean_hub_url != "" && clean_hub_key != "" && !clean_hub_key.startsWith("$co.elastic.secret")).as(has_hub,
              (
                !has(state.deployment_keys) || state.deployment_keys == null ? [] :
                string(dyn(state.deployment_keys)).split("\n").map(ln, ln.split("\r")).flatten().map(ln, ln.split(",")).flatten()
              ).map(k, k.trim_space()).filter(k, k != "" && k != "null" && !k.startsWith("$co.elastic.secret")).as(all_dkeys,
              state.?cursor.good_key_idx.orValue(dyn({})).as(prev_good_idx,
              int(state.?cursor.disc_dep_from.orValue(has_cloud ? 0 : -1)).as(dep_from,
              state.?cursor.disc_targets.orValue([]).as(acc_targets,
              ((has_cloud && dep_from >= 0) ?
                (clean_cloud_base + "/api/v1/deployments/_search?show_metadata=true").as(dep_search_url,
                  try(
                    request(
                      "POST",
                      dep_search_url
                    ).with(
                      {
                        "Header": {
                          "Authorization": ["ApiKey " + clean_api_key],
                          "Content-Type": ["application/json"],
                        },
                        "Body": { "size": 500, "from": dep_from }.encode_json(),
                      }
                    ).do_request(),
                    "req_err"
                  ).as(dep_resp,
                    has(dep_resp.req_err) ?
                      {
                        "ok": false,
                        "err": dyn({ "error": { "code": "transport_error", "id": "deployments_search", "message": "POST " + dep_search_url + ": " + string(dep_resp.req_err) } }),
                        "items": [],
                        "next_from": -1,
                      }
                    : (dep_resp.StatusCode == 200) ?
                      try(bytes(dep_resp.Body).decode_json(), "json_err").as(dep_body,
                        (type(dep_body) != map || has(dep_body.json_err)) ?
                          {
                            "ok": false,
                            "err": dyn({ "error": { "code": "decode_error", "id": "deployments_search", "message": "POST " + dep_search_url + ": " + ((type(dep_body) == map && has(dep_body.json_err)) ? string(dep_body.json_err) : ("expected JSON object, got " + (dep_body == null ? "null" : (type(dep_body) == list ? "array" : (type(dep_body) == map ? "object" : "scalar"))))) } }),
                            "items": [],
                            "next_from": -1,
                          }
                        :
                          ((has(dep_body.deployments) && dep_body.deployments != null) ? dep_body.deployments : []).as(raw_deps,
                            {
                              "ok": true,
                              "err": dyn({}),
                              "items": raw_deps.filter(d,
                                (!has(d.metadata) || d.metadata == null || !has(d.metadata.organization_id) || d.metadata.organization_id == null || string(d.metadata.organization_id) == "" || string(d.metadata.organization_id) == clean_org_id) &&
                                has(d.resources) && d.resources != null && has(d.resources.elasticsearch) && d.resources.elasticsearch != null && size(d.resources.elasticsearch) > 0 && d.resources.elasticsearch[0] != null &&
                                has(d.resources.elasticsearch[0].info) && d.resources.elasticsearch[0].info != null && has(d.resources.elasticsearch[0].info.metadata) && d.resources.elasticsearch[0].info.metadata != null && has(d.resources.elasticsearch[0].info.metadata.service_url) && d.resources.elasticsearch[0].info.metadata.service_url != null
                              ).map(d,
                                d.resources.elasticsearch[0].as(es_r,
                                  string(es_r.info.metadata.service_url).as(raw_surl,
                                    (raw_surl.endsWith("/") ? raw_surl.substring(0, size(raw_surl) - 1) : raw_surl).as(surl,
                                      ((has(es_r.id) && es_r.id != null && string(es_r.id) != "") ? string(es_r.id) : (has(d.id) && d.id != null ? string(d.id) : surl)).as(es_id,
                                        dyn({
                                          "id": es_id,
                                          "alt_id": has(d.id) && d.id != null ? string(d.id) : es_id,
                                          "name": (has(d.name) && d.name != null && string(d.name) != "") ? string(d.name) : es_id,
                                          "es_url": surl,
                                          "is_hub": (has_hub && surl == clean_hub_url),
                                        })
                                      )
                                    )
                                  )
                                )
                              ),
                              "next_from": (has(dep_body.match_count) && dep_body.match_count != null && size(raw_deps) > 0 && (dep_from + size(raw_deps)) < int(dep_body.match_count)) ? (dep_from + size(raw_deps)) : -1,
                            }
                          )
                      )
                    :
                      {
                        "ok": false,
                        "err": dyn({ "error": { "code": string(dep_resp.StatusCode), "id": string(dep_resp.Status), "message": "POST " + dep_resp.Request.URL + ": " + ((size(dep_resp.Body) != 0) ? string(dep_resp.Body) : string(dep_resp.Status)) } }),
                        "items": [],
                        "next_from": -1,
                      }
                  )
                )
              : { "ok": true, "err": dyn({}), "items": [], "next_from": -1 }).as(dep_page,
                (!dep_page.ok ? [dep_page.err] : []).as(cloud_disc_errs,
                  (acc_targets + dep_page.items).as(cloud_targets,
                    (dep_page.ok && dep_page.next_from >= 0) ?
                      {
                        "events": size(conf_evts) > 0 ? conf_evts : [dyn({ "fake": true })],
                        "cursor": {
                          "conf_sig": conf_sig,
                          "good_key_idx": prev_good_idx,
                          "disc_dep_from": dep_page.next_from,
                          "disc_targets": cloud_targets,
                        },
                        "want_more": true,
                      }
                    : ((!has_hub && size(cloud_targets) == 0) ?
                      {
                        "events": size(conf_evts + cloud_disc_errs) > 0 ? (conf_evts + cloud_disc_errs) : [dyn({ "fake": true })],
                        "cursor": { "conf_sig": conf_sig, "good_key_idx": prev_good_idx },
                        "want_more": false,
                      }
                    :
                      (has_hub ?
                        try(
                          get_request(clean_hub_url + "/").with({ "Header": { "Authorization": ["ApiKey " + clean_hub_key] } }).do_request(),
                          "req_err"
                        ).as(hub_resp,
                          has(hub_resp.req_err) ?
                            {
                              "ok": false,
                              "err": dyn({ "error": { "code": "transport_error", "id": "hub_discovery", "message": "GET " + clean_hub_url + "/: " + string(hub_resp.req_err) } }),
                              "targets": cloud_targets,
                            }
                          : (hub_resp.StatusCode == 200) ?
                            try(bytes(hub_resp.Body).decode_json(), "json_err").as(hub_info,
                              (type(hub_info) != map || has(hub_info.json_err)) ?
                                {
                                  "ok": false,
                                  "err": dyn({ "error": { "code": "decode_error", "id": "hub_discovery", "message": "GET " + clean_hub_url + "/: " + ((type(hub_info) == map && has(hub_info.json_err)) ? string(hub_info.json_err) : ("expected JSON object, got " + (hub_info == null ? "null" : (type(hub_info) == list ? "array" : (type(hub_info) == map ? "object" : "scalar"))))) } }),
                                  "targets": cloud_targets,
                                }
                              :
                                ((has(hub_info.cluster_name) && hub_info.cluster_name != null && string(hub_info.cluster_name) != "") ? string(hub_info.cluster_name) : "hub").as(hub_cname,
                                  {
                                    "ok": true,
                                    "err": dyn({}),
                                    "targets": cloud_targets.exists(ct, string(ct.id) == hub_cname || string(ct.es_url) == clean_hub_url) ?
                                      cloud_targets.map(ct, (string(ct.id) == hub_cname || string(ct.es_url) == clean_hub_url) ? dyn(ct.with({ "is_hub": true, "es_url": clean_hub_url })) : ct)
                                    :
                                      cloud_targets + [dyn({
                                        "id": hub_cname,
                                        "alt_id": hub_cname,
                                        "name": hub_cname,
                                        "es_url": clean_hub_url,
                                        "is_hub": true,
                                      })],
                                  }
                                )
                            )
                          :
                            {
                              "ok": false,
                              "err": dyn({ "error": { "code": string(hub_resp.StatusCode), "id": string(hub_resp.Status), "message": "GET " + hub_resp.Request.URL + ": " + ((size(hub_resp.Body) != 0) ? string(hub_resp.Body) : string(hub_resp.Status)) } }),
                              "targets": cloud_targets,
                            }
                        )
                      : { "ok": true, "err": dyn({}), "targets": cloud_targets }).as(hub_disc,
                        hub_disc.targets.map(t,
                          string(t.id).as(tid,
                          (string(t.es_url).endsWith("/") ? string(t.es_url).substring(0, size(string(t.es_url)) - 1) : string(t.es_url)).as(es_base,
                            all_dkeys.filter(k, k.startsWith(tid + ":") || k.startsWith(string(t.alt_id) + ":") || k.startsWith(string(t.name) + ":")).map(k,
                              k.startsWith(tid + ":") ? k.substring(size(tid) + 1, size(k)) : (
                                k.startsWith(string(t.alt_id) + ":") ? k.substring(size(string(t.alt_id)) + 1, size(k)) :
                                k.substring(size(string(t.name)) + 1, size(k))
                              )
                            ).filter(k, k != "").as(d_keys,
                              (d_keys + ((bool(t.is_hub) && has_hub && !(clean_hub_key in d_keys)) ? [clean_hub_key] : [])).as(raw_keys,
                              [0, 1, 2, 3, 4, 5, 6, 7].filter(i, i < size(raw_keys) && !([0, 1, 2, 3, 4, 5, 6, 7].exists(j, j < i && raw_keys[j] == raw_keys[i]))).map(i, raw_keys[i]).as(cand_keys,
                              (size(cand_keys) == 0) ?
                                {
                                  "id": tid,
                                  "ok": false,
                                  "auth_err": false,
                                  "skipped": true,
                                  "key_idx": -1,
                                  "evts": [dyn({
                                    "error": {
                                      "code": "missing_credentials",
                                      "id": tid,
                                      "message": "Skipping node stats collection for deployment '" + string(t.name) + "' (" + tid + "): no matching Elasticsearch API key found in deployment_api_keys (<deployment_id_or_name>:<api_key>) or hub_es_url/hub_es_api_key.",
                                    },
                                  })],
                                }
                              :
                                ((tid in prev_good_idx && int(prev_good_idx[tid]) >= 0 && int(prev_good_idx[tid]) < size(cand_keys)) ? int(prev_good_idx[tid]) : 0).as(cached_pos,
                                ([cached_pos] + [0, 1, 2, 3, 4, 5, 6, 7].filter(i, i < size(cand_keys) && i != cached_pos)).map(i, { "k": cand_keys[i], "i": i }).as(ord_keys,
                                (es_base + "/_nodes/data:true,data_hot:true,data_warm:true,data_cold:true,data_frozen:true,data_content:true/stats/jvm,fs?filter_path=_nodes,nodes.*.name,nodes.*.roles,nodes.*.timestamp,nodes.*.jvm.mem.heap_used_percent,nodes.*.fs.total").as(stats_url,
                                  try(get_request(stats_url).with({ "Header": { "Authorization": ["ApiKey " + ord_keys[0].k] } }).do_request(), "req_err").as(r0,
                                    (!has(r0.req_err) && (r0.StatusCode == 401 || r0.StatusCode == 403) && size(ord_keys) > 1) ?
                                      try(get_request(stats_url).with({ "Header": { "Authorization": ["ApiKey " + ord_keys[1].k] } }).do_request(), "req_err").as(r1,
                                        (!has(r1.req_err) && (r1.StatusCode == 401 || r1.StatusCode == 403) && size(ord_keys) > 2) ?
                                          try(get_request(stats_url).with({ "Header": { "Authorization": ["ApiKey " + ord_keys[2].k] } }).do_request(), "req_err").as(r2,
                                            (!has(r2.req_err) && (r2.StatusCode == 401 || r2.StatusCode == 403) && size(ord_keys) > 3) ?
                                              try(get_request(stats_url).with({ "Header": { "Authorization": ["ApiKey " + ord_keys[3].k] } }).do_request(), "req_err").as(r3,
                                                (!has(r3.req_err) && (r3.StatusCode == 401 || r3.StatusCode == 403) && size(ord_keys) > 4) ?
                                                  try(get_request(stats_url).with({ "Header": { "Authorization": ["ApiKey " + ord_keys[4].k] } }).do_request(), "req_err").as(r4,
                                                    (!has(r4.req_err) && (r4.StatusCode == 401 || r4.StatusCode == 403) && size(ord_keys) > 5) ?
                                                      try(get_request(stats_url).with({ "Header": { "Authorization": ["ApiKey " + ord_keys[5].k] } }).do_request(), "req_err").as(r5,
                                                        (!has(r5.req_err) && (r5.StatusCode == 401 || r5.StatusCode == 403) && size(ord_keys) > 6) ?
                                                          try(get_request(stats_url).with({ "Header": { "Authorization": ["ApiKey " + ord_keys[6].k] } }).do_request(), "req_err").as(r6,
                                                            (!has(r6.req_err) && (r6.StatusCode == 401 || r6.StatusCode == 403) && size(ord_keys) > 7) ?
                                                              try(get_request(stats_url).with({ "Header": { "Authorization": ["ApiKey " + ord_keys[7].k] } }).do_request(), "req_err").as(r7,
                                                                { "resp": r7, "i": ord_keys[7].i }
                                                              )
                                                            : { "resp": r6, "i": ord_keys[6].i }
                                                          )
                                                        : { "resp": r5, "i": ord_keys[5].i }
                                                      )
                                                    : { "resp": r4, "i": ord_keys[4].i }
                                                  )
                                                : { "resp": r3, "i": ord_keys[3].i }
                                              )
                                            : { "resp": r2, "i": ord_keys[2].i }
                                          )
                                        : { "resp": r1, "i": ord_keys[1].i }
                                      )
                                    : { "resp": r0, "i": ord_keys[0].i }
                                  ).as(att,
                                    att.resp.as(hr,
                                      has(hr.req_err) ?
                                        {
                                          "ok": false,
                                          "auth_err": false,
                                          "key_idx": -1,
                                          "obs_ts": "",
                                          "body": dyn({}),
                                          "err": dyn({ "error": { "code": "transport_error", "id": tid, "message": "GET " + stats_url + ": " + string(hr.req_err) } }),
                                        }
                                      : (hr.StatusCode == 200) ?
                                        now.format(time_layout.RFC3339).as(h_obs_ts,
                                          try(bytes(hr.Body).decode_json(), "json_err").as(hb,
                                            (type(hb) != map || has(hb.json_err)) ?
                                              {
                                                "ok": false,
                                                "auth_err": false,
                                                "key_idx": -1,
                                                "obs_ts": "",
                                                "body": dyn({}),
                                                "err": dyn({ "error": { "code": "decode_error", "id": tid, "message": "GET " + stats_url + ": " + ((type(hb) == map && has(hb.json_err)) ? string(hb.json_err) : ("expected JSON object, got " + (hb == null ? "null" : (type(hb) == list ? "array" : (type(hb) == map ? "object" : "scalar"))))) } }),
                                              }
                                            : { "ok": true, "auth_err": false, "key_idx": int(att.i), "obs_ts": h_obs_ts, "body": hb, "err": dyn({}) }
                                          )
                                        )
                                      :
                                        {
                                          "ok": false,
                                          "auth_err": (hr.StatusCode == 401 || hr.StatusCode == 403),
                                          "key_idx": -1,
                                          "obs_ts": "",
                                          "body": dyn({}),
                                          "err": dyn({ "error": { "code": string(hr.StatusCode), "id": string(hr.Status), "message": "GET " + hr.Request.URL + ": " + ((size(hr.Body) != 0) ? string(hr.Body) : string(hr.Status)) } }),
                                        }
                                    )
                                  ).as(harvest,
                                    (!harvest.ok) ?
                                      { "id": tid, "ok": false, "auth_err": harvest.auth_err, "skipped": false, "key_idx": -1, "evts": [harvest.err] }
                                    : (!has(harvest.body.nodes) || harvest.body.nodes == null) ?
                                      { "id": tid, "ok": true, "auth_err": false, "skipped": false, "key_idx": int(harvest.key_idx), "evts": [] }
                                    :
                                      {
                                        "id": tid,
                                        "ok": true,
                                        "auth_err": false,
                                        "skipped": false,
                                        "key_idx": int(harvest.key_idx),
                                        "evts": ((has(harvest.body._nodes) && harvest.body._nodes != null && has(harvest.body._nodes.failed) && harvest.body._nodes.failed != null && int(harvest.body._nodes.failed) > 0) ? int(harvest.body._nodes.failed) : 0).as(failed_node_cnt,
                                      ((has(harvest.body.nodes) && harvest.body.nodes != null) ? harvest.body.nodes : dyn({})).as(nodes_obj,
                                      nodes_obj.keys().filter(knid,
                                        nodes_obj[knid].as(knd,
                                          ((has(knd.roles) && knd.roles != null) ? knd.roles.map(r, string(r)) : ["data"]).exists(rl,
                                            rl == "data" || rl == "data_hot" || rl == "data_warm" || rl == "data_cold" || rl == "data_frozen" || rl == "data_content"
                                          )
                                        )
                                      ).as(data_node_ids,
                                        (size(data_node_ids) + failed_node_cnt).as(data_node_cnt,
                                          data_node_ids.map(nid,
                                            string(dyn(nid)).as(node_id,
                                            nodes_obj[nid].as(nd,
                                              (has(nd.jvm) && nd.jvm != null && has(nd.jvm.mem) && nd.jvm.mem != null && has(nd.jvm.mem.heap_used_percent) && nd.jvm.mem.heap_used_percent != null && double(nd.jvm.mem.heap_used_percent) >= 0.0 && double(nd.jvm.mem.heap_used_percent) <= 100.0).as(has_heap,
                                              (has(nd.fs) && nd.fs != null && has(nd.fs.total) && nd.fs.total != null && has(nd.fs.total.total_in_bytes) && nd.fs.total.total_in_bytes != null && int(nd.fs.total.total_in_bytes) > 0 && has(nd.fs.total.available_in_bytes) && nd.fs.total.available_in_bytes != null && int(nd.fs.total.available_in_bytes) >= 0 && int(nd.fs.total.available_in_bytes) <= int(nd.fs.total.total_in_bytes)).as(has_fs,
                                                dyn({
                                                  "doc_type": "node_sample",
                                                  "sample_ts": (has(nd.timestamp) && nd.timestamp != null && int(nd.timestamp) > 0) ? string(int(nd.timestamp)) : harvest.obs_ts,
                                                  "deployment_name": string(t.name),
                                                  "cluster_data_node_count": data_node_cnt,
                                                  "elasticsearch": {
                                                    "cluster": { "name": tid },
                                                    "node": {
                                                      "id": node_id,
                                                      "name": (has(nd.name) && nd.name != null) ? string(nd.name) : node_id,
                                                      "roles": (has(nd.roles) && nd.roles != null) ? nd.roles.map(r, string(r)) : ["data"],
                                                      "stats": (has_heap ? dyn({
                                                        "jvm": {
                                                          "mem": {
                                                            "heap": {
                                                              "used": {
                                                                "pct": double(nd.jvm.mem.heap_used_percent),
                                                              },
                                                            },
                                                          },
                                                        },
                                                      }) : dyn({})).with(has_fs ? dyn({
                                                        "fs": {
                                                          "total": {
                                                            "total_in_bytes": int(nd.fs.total.total_in_bytes),
                                                            "available_in_bytes": int(nd.fs.total.available_in_bytes),
                                                          },
                                                        },
                                                      }) : dyn({})),
                                                    },
                                                  },
                                                })
                                              ))
                                            ))
                                          )
                                        )
                                      ))),
                                      }
                                  )
                                )))
                              )
                            )))
                          )
                        ).as(results,
                          results.map(r, r.evts).flatten().as(node_evts,
                          prev_good_idx.keys().filter(gid,
                            results.exists(r, r.id == gid) ?
                              results.exists(r, r.id == gid && !r.ok && !r.auth_err && !r.skipped)
                            : (!dep_page.ok || !hub_disc.ok)
                          ).as(kept_good_ids,
                          results.filter(r, r.ok && int(r.key_idx) >= 0).as(good_results,
                          (size(kept_good_ids) > 0 ? zip(kept_good_ids, kept_good_ids.map(gid, prev_good_idx[gid])) : dyn({})).with(
                            size(good_results) > 0 ? zip(good_results.map(r, string(r.id)), good_results.map(r, int(r.key_idx))) : {}
                          ).as(merged_good_idx,
                          (conf_evts + cloud_disc_errs + (!hub_disc.ok ? [hub_disc.err] : []) + node_evts).as(evts,
                            {
                              "events": size(evts) > 0 ? evts : [dyn({ "fake": true })],
                              "cursor": {
                                "conf_sig": conf_sig,
                                "good_key_idx": merged_good_idx,
                              },
                              "want_more": false,
                            }
                          )))))
                        )
                      )
                    )
                  )
                )
              )))))))))))))))))))))
            )
          publisher_pipeline.disable_host: true
          redact:
            fields:
                - api_key
                - cloud_api_key
                - hub_es_api_key
                - deployment_keys
                - deployment_api_keys
                - proxy_url
          resource.proxy_url: ${SECRET_3}
          resource.ssl:
            certificate_authorities:
                - /etc/ssl/ca.pem
            verification_mode: full
          resource.timeout: 60s
          resource.tracer.filename: ../../logs/cel/http-request-trace-*.ndjson
          resource.tracer.maxbackups: 5
          resource.url: https://api.example.com/api/v1/deployments/_search?show_metadata=true
          state:
            api_key: ${SECRET_0}
            cloud_api_base: https://api.example.com
            conf_utilization_floor: "0.15"
            conf_utilization_memory_weight: 80
            conf_utilization_storage_weight: 20
            config_owner_id: primary-owner
            deployment_keys: ${SECRET_2}
            hub_es_api_key: ${SECRET_1}
            hub_es_url: https://hub.example.com:9200/
            organization_id: "2222"
            sync_fleet_config: true
          tags:
            - forwarded
            - chargeback
      type: cel
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - metrics-chargeback.node_stats-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references:
    - {}
    - {}
