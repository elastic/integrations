config_version: 2
interval: "15m"
{{#if enable_request_tracer}}
resource.tracer.filename: "../../logs/cel/http-request-trace-*.ndjson"
resource.tracer.maxbackups: 5
{{/if}}
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: "{{cloud_api_base}}/api/v1/deployments/_search?show_metadata=true"
state:
  api_key: !!str {{escape_string cloud_api_key}}
  organization_id: !!str {{escape_string organization_id}}
  cloud_api_base: !!str {{escape_string cloud_api_base}}
  hub_es_url: !!str {{escape_string hub_es_url}}
  hub_es_api_key: !!str {{escape_string hub_es_api_key}}
  deployment_keys: !!str {{escape_string deployment_api_keys}}
  sync_fleet_config: !!bool {{sync_fleet_config}}
  conf_utilization_memory_weight: !!int {{utilization_memory_weight}}
  conf_utilization_storage_weight: !!int {{utilization_storage_weight}}
  conf_utilization_floor: !!str {{escape_string utilization_floor}}
redact:
  fields:
    - api_key
    - cloud_api_key
    - hub_es_api_key
    - deployment_keys
    - deployment_api_keys
program: |-
  state.with(
    now.format(time_layout.DateOnly).as(today_utc,
    state.conf_utilization_floor.trim_space().as(clean_floor,
    clean_floor.matches("^(0(\\.[0-9]+)?|1(\\.0+)?)$").as(floor_valid,
    (int(state.conf_utilization_memory_weight) >= 0 && int(state.conf_utilization_storage_weight) >= 0 && (int(state.conf_utilization_memory_weight) + int(state.conf_utilization_storage_weight)) > 0).as(weights_valid,
    (!state.sync_fleet_config ? "disabled" : (
      (floor_valid && weights_valid) ? (string(state.conf_utilization_memory_weight) + "|" + string(state.conf_utilization_storage_weight) + "|" + clean_floor + "|" + today_utc) : state.?cursor.conf_sig.orValue("")
    )).as(conf_sig,
    ((state.sync_fleet_config && !floor_valid) ?
      [dyn({
        "error": {
          "code": "invalid_config",
          "id": "utilization_floor",
          "message": "Invalid utilization_floor '" + state.conf_utilization_floor + "': expected decimal between 0.0 and 1.0 using '.' (for example 0.10)",
        },
      })]
    : ((state.sync_fleet_config && !weights_valid) ?
      [dyn({
        "error": {
          "code": "invalid_config",
          "id": "utilization_weights",
          "message": "Invalid utilization weights (memory=" + string(state.conf_utilization_memory_weight) + ", storage=" + string(state.conf_utilization_storage_weight) + "): weights must be non-negative and their sum must be greater than 0",
        },
      })]
    : ((state.sync_fleet_config && state.?cursor.conf_sig.orValue("") != conf_sig) ?
      [dyn({
        "doc_type": "config_snapshot",
        "conf_sync_enabled": true,
        "conf_utilization_memory_weight": int(state.conf_utilization_memory_weight),
        "conf_utilization_storage_weight": int(state.conf_utilization_storage_weight),
        "conf_utilization_floor": double(clean_floor),
      })]
    : ((!state.sync_fleet_config && state.?cursor.conf_sig.orValue("") != "disabled") ?
      [dyn({
        "doc_type": "config_snapshot",
        "conf_sync_enabled": false,
      })]
    : [])))).as(conf_evts,
    now.format(time_layout.RFC3339).as(sample_ts,
    (state.organization_id != "" && state.api_key != "" && !state.api_key.startsWith("$co.elastic.secret")).as(has_cloud,
    (state.hub_es_url != "" && state.hub_es_api_key != "" && !state.hub_es_api_key.startsWith("$co.elastic.secret")).as(has_hub,
    (state.hub_es_url.endsWith("/") ? state.hub_es_url.substring(0, size(state.hub_es_url) - 1) : state.hub_es_url).as(clean_hub_url,
    (
      !has(state.deployment_keys) || state.deployment_keys == null ? [] :
      string(dyn(state.deployment_keys)).split(",")
    ).map(k, k.trim_space()).filter(k, k != "" && k != "null" && !k.startsWith("$co.elastic.secret")).as(all_dkeys,
    int(state.?cursor.disc_dep_from.orValue(has_cloud ? 0 : -1)).as(dep_from,
    state.?cursor.disc_targets.orValue([]).as(acc_targets,
    ((has_cloud && dep_from >= 0) ?
      request(
        "POST",
        state.cloud_api_base + "/api/v1/deployments/_search?show_metadata=true"
      ).with(
        {
          "Header": {
            "Authorization": ["ApiKey " + state.api_key],
            "Content-Type": ["application/json"],
          },
          "Body": { "size": 500, "from": dep_from }.encode_json(),
        }
      ).do_request().as(dep_resp,
        (dep_resp.StatusCode == 200) ?
          bytes(dep_resp.Body).decode_json().as(dep_body,
            ((has(dep_body.deployments) && dep_body.deployments != null) ? dep_body.deployments : []).as(raw_deps,
              {
                "ok": true,
                "err": dyn({}),
                "items": raw_deps.filter(d,
                  has(d.resources) && d.resources != null && has(d.resources.elasticsearch) && d.resources.elasticsearch != null && size(d.resources.elasticsearch) > 0 &&
                  has(d.resources.elasticsearch[0].info) && has(d.resources.elasticsearch[0].info.metadata) && has(d.resources.elasticsearch[0].info.metadata.service_url) && d.resources.elasticsearch[0].info.metadata.service_url != null
                ).map(d,
                  d.resources.elasticsearch[0].as(es_r,
                    string(es_r.info.metadata.service_url).as(raw_surl,
                      (raw_surl.endsWith("/") ? raw_surl.substring(0, size(raw_surl) - 1) : raw_surl).as(surl,
                        dyn({
                          "id": string(es_r.id),
                          "alt_id": has(d.id) && d.id != null ? string(d.id) : string(es_r.id),
                          "name": (has(d.name) && d.name != null && string(d.name) != "") ? string(d.name) : string(es_r.id),
                          "es_url": surl,
                          "is_hub": (has_hub && surl == clean_hub_url),
                        })
                      )
                    )
                  )
                ),
                "next_from": (has(dep_body.match_count) && dep_body.match_count != null && size(raw_deps) > 0 && (dep_from + size(raw_deps)) < int(dep_body.match_count)) ? (dep_from + size(raw_deps)) : -1,
              }
            )
          )
        :
          {
            "ok": false,
            "err": dyn({ "error": { "code": string(dep_resp.StatusCode), "id": string(dep_resp.Status), "message": "POST " + dep_resp.Request.URL + ": " + ((size(dep_resp.Body) != 0) ? string(dep_resp.Body) : string(dep_resp.Status)) } }),
            "items": [],
            "next_from": -1,
          }
      )
    : { "ok": true, "err": dyn({}), "items": [], "next_from": -1 }).as(dep_page,
      (!dep_page.ok ? [dep_page.err] : []).as(cloud_disc_errs,
        (acc_targets + dep_page.items).as(cloud_targets,
          (dep_page.ok && dep_page.next_from >= 0) ?
            {
              "events": size(conf_evts) > 0 ? conf_evts : [dyn({ "fake": true })],
              "cursor": {
                "conf_sig": conf_sig,
                "disc_dep_from": dep_page.next_from,
                "disc_targets": cloud_targets,
              },
              "want_more": true,
            }
          : ((!has_hub && size(cloud_targets) == 0) ?
            {
              "events": size(conf_evts + cloud_disc_errs) > 0 ? (conf_evts + cloud_disc_errs) : [dyn({ "fake": true })],
              "cursor": { "conf_sig": conf_sig },
              "want_more": false,
            }
          :
            (has_hub ?
              get_request(clean_hub_url + "/").with({ "Header": { "Authorization": ["ApiKey " + state.hub_es_api_key] } }).do_request().as(hub_resp,
                (hub_resp.StatusCode == 200) ?
                  bytes(hub_resp.Body).decode_json().as(hub_info,
                    ((has(hub_info.cluster_name) && hub_info.cluster_name != null && string(hub_info.cluster_name) != "") ? string(hub_info.cluster_name) : "hub").as(hub_cname,
                      {
                        "ok": true,
                        "err": dyn({}),
                        "targets": cloud_targets.exists(ct, string(ct.id) == hub_cname || string(ct.es_url) == clean_hub_url) ?
                          cloud_targets.map(ct, (string(ct.id) == hub_cname || string(ct.es_url) == clean_hub_url) ? dyn(ct.with({ "is_hub": true })) : ct)
                        :
                          cloud_targets + [dyn({
                            "id": hub_cname,
                            "alt_id": hub_cname,
                            "name": hub_cname,
                            "es_url": clean_hub_url,
                            "is_hub": true,
                          })],
                      }
                    )
                  )
                :
                  {
                    "ok": false,
                    "err": dyn({ "error": { "code": string(hub_resp.StatusCode), "id": string(hub_resp.Status), "message": "GET " + hub_resp.Request.URL + ": " + ((size(hub_resp.Body) != 0) ? string(hub_resp.Body) : string(hub_resp.Status)) } }),
                    "targets": cloud_targets,
                  }
              )
            : { "ok": true, "err": dyn({}), "targets": cloud_targets }).as(hub_disc,
              hub_disc.targets.map(t,
                string(t.id).as(tid,
                (string(t.es_url).endsWith("/") ? string(t.es_url).substring(0, size(string(t.es_url)) - 1) : string(t.es_url)).as(es_base,
                  (
                    all_dkeys.filter(k, k.startsWith(tid + ":") || k.startsWith(string(t.alt_id) + ":") || k.startsWith(string(t.name) + ":")).map(k,
                      k.substring(size(k.split(":")[0]) + 1, size(k))
                    ) +
                    (bool(t.is_hub) && has_hub ? [state.hub_es_api_key] : [])
                  ).as(cand_keys,
                    (size(cand_keys) == 0) ? [] :
                      (es_base + "/_nodes/_all/stats/jvm,fs?filter_path=nodes.*.name,nodes.*.roles,nodes.*.jvm.mem.heap_used_percent,nodes.*.fs.total").as(stats_url,
                        get_request(stats_url).with({ "Header": { "Authorization": ["ApiKey " + cand_keys[0]] } }).do_request().as(r0,
                          (r0.StatusCode == 200) ?
                            { "ok": true, "body": bytes(r0.Body).decode_json(), "resp": r0 }
                          : (size(cand_keys) > 1 ?
                            get_request(stats_url).with({ "Header": { "Authorization": ["ApiKey " + cand_keys[1]] } }).do_request().as(r1,
                              (r1.StatusCode == 200) ?
                                { "ok": true, "body": bytes(r1.Body).decode_json(), "resp": r1 }
                              : (size(cand_keys) > 2 ?
                                get_request(stats_url).with({ "Header": { "Authorization": ["ApiKey " + cand_keys[2]] } }).do_request().as(r2,
                                  (r2.StatusCode == 200) ?
                                    { "ok": true, "body": bytes(r2.Body).decode_json(), "resp": r2 }
                                  : { "ok": false, "body": dyn({}), "resp": r2 }
                                )
                              : { "ok": false, "body": dyn({}), "resp": r1 })
                            )
                          : { "ok": false, "body": dyn({}), "resp": r0 })
                        ).as(harvest,
                          (!harvest.ok) ?
                            [dyn({
                              "error": {
                                "code": string(harvest.resp.StatusCode),
                                "id": string(harvest.resp.Status),
                                "message": "GET " + harvest.resp.Request.URL + ": " + ((size(harvest.resp.Body) != 0) ? string(harvest.resp.Body) : string(harvest.resp.Status)),
                              },
                            })]
                          : (!has(harvest.body.nodes) || harvest.body.nodes == null) ? [] :
                            ((has(harvest.body.nodes) && harvest.body.nodes != null) ? harvest.body.nodes : dyn({})).as(nodes_obj,
                              nodes_obj.keys().map(nid,
                                string(nid).as(node_id,
                                nodes_obj[nid].as(nd,
                                  dyn({
                                    "doc_type": "node_sample",
                                    "deployment_name": string(t.name),
                                    "elasticsearch": {
                                      "cluster": { "name": tid },
                                      "node": {
                                        "id": node_id,
                                        "name": (has(nd.name) && nd.name != null) ? string(nd.name) : node_id,
                                        "roles": (has(nd.roles) && nd.roles != null) ? nd.roles.map(r, string(r)) : ["data"],
                                        "stats": {
                                          "jvm": {
                                            "mem": {
                                              "heap": {
                                                "used": {
                                                  "pct": (has(nd.jvm) && nd.jvm != null && has(nd.jvm.mem) && nd.jvm.mem != null && has(nd.jvm.mem.heap_used_percent) && nd.jvm.mem.heap_used_percent != null) ? double(nd.jvm.mem.heap_used_percent) : 0.0,
                                                },
                                              },
                                            },
                                          },
                                          "fs": {
                                            "total": {
                                              "total_in_bytes": (has(nd.fs) && nd.fs != null && has(nd.fs.total) && nd.fs.total != null && has(nd.fs.total.total_in_bytes) && nd.fs.total.total_in_bytes != null) ? int(nd.fs.total.total_in_bytes) : 0,
                                              "available_in_bytes": (has(nd.fs) && nd.fs != null && has(nd.fs.total) && nd.fs.total != null && has(nd.fs.total.available_in_bytes) && nd.fs.total.available_in_bytes != null) ? int(nd.fs.total.available_in_bytes) : 0,
                                            },
                                          },
                                        },
                                      },
                                    },
                                  })
                                ))
                              )
                            )
                        )
                      )
                  )
                ))
              ).flatten().as(node_evts,
                (conf_evts + cloud_disc_errs + (!hub_disc.ok ? [hub_disc.err] : []) + node_evts).as(evts,
                  {
                    "events": size(evts) > 0 ? evts : [dyn({ "fake": true })],
                    "cursor": { "conf_sig": conf_sig },
                    "want_more": false,
                  }
                )
              )
            )
          )
        )
      )
    ))))))))))))))
  )

processors:
- drop_event.when.equals.fake: true
{{#if processors}}
{{processors}}
{{/if}}
