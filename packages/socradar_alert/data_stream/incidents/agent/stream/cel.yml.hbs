config_version: 2
interval: {{interval}}
{{#if enable_request_tracer}}
resource.tracer.filename: "../../logs/cel/http-request-trace-*.ndjson"
resource.tracer.maxbackups: 5
{{/if}}
resource.url: {{api_url}}/api/company/{{company_id}}/incidents/v4
state:
  api_key: {{api_key}}
  limit: {{limit}}
  initial_lookback: {{initial_lookback}}
redact:
  fields:
    - api_key
program: |
  state.?cursor.last_requested_at.orValue("").as(last_cursor,
  state.?current_page.orValue(1).as(page,
  state.?query_timestamp.orValue("").as(saved_query_timestamp,
  state.?start_date.orValue("").as(saved_start_date,
    (saved_query_timestamp != ""
      ? saved_query_timestamp
      : now.format("2006-01-02 15:04:05")
    ).as(query_time,
    (saved_start_date != ""
      ? saved_start_date
      : (last_cursor != ""
          ? last_cursor
          : (now - duration(state.initial_lookback)).format("2006-01-02 15:04:05"))
    ).as(start_date,
      state.with(
        request("GET", state.url + "?" + {
          "limit": [string(state.limit)],
          "include_total_records": ["true"],
          "show_page_in_response": ["true"],
          "page": [string(page)],
          "include_alarm_details": ["true"],
          "include_company_id": ["true"],
          "start_date": [start_date],
        }.format_query()).with({
          "Header": {
            "Api-Key": [state.api_key],
          }
        }).do_request().as(resp,
          resp.StatusCode == 200 ?
            resp.Body.decode_json().as(body,
                page < int(body.?data.?total_pages.orValue(1)) ?
                  {
                    "events": body.?data.alarms.orValue([]).map(a, {"message": a.encode_json()}),
                    "want_more": true,
                    "current_page": page + 1,
                    "query_timestamp": query_time,
                    "start_date": start_date,
                    "cursor": {"last_requested_at": last_cursor},
                  }
                :
                  {
                    "events": body.?data.alarms.orValue([]).map(a, {"message": a.encode_json()}),
                    "want_more": false,
                    "current_page": 1,
                    "query_timestamp": "",
                    "start_date": "",
                    "cursor": {
                      "last_requested_at": query_time,
                    },
                  }
            )
          :
            {
              "events": {
                "error": {
                  "code": string(resp.StatusCode),
                  "id": string(resp.Status),
                  "message": "GET:" + (
                    size(resp.Body) != 0 ?
                      string(resp.Body)
                    :
                      string(resp.Status) + " (" + string(resp.StatusCode) + ")"
                  ),
                },
              },
              "want_more": false,
              "current_page": 1,
              "query_timestamp": "",
              "start_date": "",
              "cursor": state.?cursor.orValue({}),
            }
        )
      )
    )
    )
    )
  )))
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
