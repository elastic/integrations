config_version: 2
interval: {{#if interval}}{{interval}}{{else}}1h{{/if}}
{{#if enable_request_tracer}}
resource.tracer.filename: "../../logs/cel/http-request-trace-*.ndjson"
resource.tracer.maxbackups: 5
{{/if}}
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl:
  {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: "{{cloud_api_base}}/api/v1/serverless/projects/elasticsearch"
state:
  api_key: !!str {{escape_string cloud_api_key}}
  organization_id: !!str {{escape_string organization_id}}
  cloud_api_base: !!str {{escape_string cloud_api_base}}
  billing_api_base: !!str {{escape_string billing_api_base}}
  hub_es_api_key: !!str {{escape_string hub_es_api_key}}
  conf_unit_rate: !!str {{escape_string unit_rate}}
  conf_currency_unit: !!str {{escape_string currency_unit}}
  conf_currency_symbol: !!str {{escape_string currency_symbol}}
  project_keys: !!str {{escape_string project_api_keys}}
{{#if _meta.agent.version}}
{{#semverSatisfies _meta.agent.version "<9.2.0"}}
  unsupported_agent_version: !!str "{{_meta.agent.version}}"
{{/semverSatisfies}}
{{/if}}
redact:
  fields:
    - api_key
    - cloud_api_key
    - hub_es_api_key
    - project_keys
    - project_api_keys
    - proxy_url
program: |-
  state.with(
  (state.?unsupported_agent_version.orValue("") != "") ?
