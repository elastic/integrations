processors:
- drop_event.when.equals.fake: true
- copy_fields:
    when:
      and:
        - not:
            has_fields:
              - conf_policy_id
        - not:
            has_fields:
              - error.message
    fields:
      - from: "@metadata.input_id"
        to: "conf_policy_id"
    ignore_missing: true
    fail_on_error: false
