config_version: 2
interval: "1h"
resource.url: "{{cloud_api_base}}/api/v1/serverless/projects/elasticsearch"
state:
  api_key: !!str {{cloud_api_key}}
  organization_id: !!str {{organization_id}}
  cloud_api_base: !!str {{cloud_api_base}}
  billing_api_base: !!str {{billing_api_base}}
  hub_es_api_key: !!str {{hub_es_api_key}}
  conf_unit_rate: !!str {{unit_rate}}
  conf_currency_unit: !!str {{currency_unit}}
  conf_currency_symbol: !!str {{currency_symbol}}
  project_keys:
{{#if project_api_keys}}
{{#each project_api_keys}}
    - !!str {{this}}
{{/each}}
{{else}}
    []
{{/if}}
redact:
  fields:
    - api_key
    - cloud_api_key
    - hub_es_api_key
    - project_keys
    - project_api_keys
program: |-
  state.with(
    (now - duration("2h")).format(time_layout.DateOnly).parse_time(time_layout.DateOnly).as(day_end,
      (day_end - duration("24h")).as(day_start,
        day_start.format(time_layout.RFC3339).as(day_ts,
          (
            !has(state.project_keys) || state.project_keys == null ? [] :
            (type(dyn(state.project_keys)) == type([]) ?
              dyn(state.project_keys).map(k, string(k)) :
              dyn(state.project_keys).map(k, string(dyn(state.project_keys)[k]))
            )
          ).filter(k, k != "" && k != "null" && !k.startsWith("$co.elastic.secret")).as(all_pkeys,
          (now.format(time_layout.RFC3339)).as(cursor_key,
          false ?
            {
              "events": [],
              "cursor": { "last_day": cursor_key },
              "want_more": false,
            }
          :
            get_request(
              state.cloud_api_base + "/api/v1/serverless/projects/elasticsearch"
            ).with(
              { "Header": { "Authorization": ["ApiKey " + state.api_key] } }
            ).do_request().as(es_resp,
              ((es_resp.StatusCode == 200) ? bytes(es_resp.Body).decode_json() : { "items": [] }).as(es_body,
                get_request(
                  state.cloud_api_base + "/api/v1/serverless/projects/observability"
                ).with(
                  { "Header": { "Authorization": ["ApiKey " + state.api_key] } }
                ).do_request().as(obs_resp,
                  ((obs_resp.StatusCode == 200) ? bytes(obs_resp.Body).decode_json() : { "items": [] }).as(obs_body,
                    get_request(
                      state.cloud_api_base + "/api/v1/serverless/projects/security"
                    ).with(
                      { "Header": { "Authorization": ["ApiKey " + state.api_key] } }
                    ).do_request().as(sec_resp,
                      ((sec_resp.StatusCode == 200) ? bytes(sec_resp.Body).decode_json() : { "items": [] }).as(sec_body,
                        get_request(
                          state.cloud_api_base + "/api/v1/serverless/projects/search"
                        ).with(
                          { "Header": { "Authorization": ["ApiKey " + state.api_key] } }
                        ).do_request().as(srch_resp,
                          ((srch_resp.StatusCode == 200) ? bytes(srch_resp.Body).decode_json() : { "items": [] }).as(srch_body,
                            ((has(es_body.items) && es_body.items != null ? es_body.items.map(p, dyn(p.with({ "project_type": "elasticsearch" }))) : []) +
                             (has(obs_body.items) && obs_body.items != null ? obs_body.items.map(p, dyn(p.with({ "project_type": "observability" }))) : []) +
                             (has(sec_body.items) && sec_body.items != null ? sec_body.items.map(p, dyn(p.with({ "project_type": "security" }))) : []) +
                             (has(srch_body.items) && srch_body.items != null ? srch_body.items.map(p, dyn(p.with({ "project_type": "search" }))) : [])
                            ).as(projects,
                          size(projects) > 0 ?
                          {
                            "events": projects.map(p,
                              all_pkeys.filter(k,
                                k.startsWith(p.id + ":") || (has(p.name) && p.name != null && p.name != "" && k.startsWith(p.name + ":"))
                              ).as(pkeys,
                                all_pkeys.map(k,
                                  k.startsWith(p.id + ":") ? k.substring(size(p.id) + 1, size(k)) : (
                                    (has(p.name) && p.name != null && p.name != "" && k.startsWith(p.name + ":")) ? k.substring(size(p.name) + 1, size(k)) : k
                                  )
                                ).as( stripped_keys,
                                  (size(pkeys) > 0 ? (
                                    pkeys[0].startsWith(p.id + ":") ? pkeys[0].substring(size(p.id) + 1, size(pkeys[0])) : pkeys[0].substring(size(p.name) + 1, size(pkeys[0]))
                                  ) : (
                                    state.hub_es_api_key != "" ? state.hub_es_api_key : state.api_key
                                  )).as(primary_key,
                                    (dyn(p.endpoints).elasticsearch + "/_cat/indices?h=index,dataset.size,indexing.index_time,search.query_time&format=json&bytes=b&time=ms&expand_wildcards=open,hidden").as(cat_url,
                                      get_request(cat_url).with({ "Header": { "Authorization": ["ApiKey " + primary_key] } }).do_request().as(resp0,
                                        (resp0.StatusCode == 200) ?
                                          { "resp": resp0, "key": primary_key, "ktype": size(pkeys) > 0 ? "remote_key" : "hub_key" }
                                        : (size(stripped_keys) > 0 ?
                                          get_request(cat_url).with({ "Header": { "Authorization": ["ApiKey " + stripped_keys[0]] } }).do_request().as(resp1,
                                            (resp1.StatusCode == 200) ?
                                              { "resp": resp1, "key": stripped_keys[0], "ktype": "remote_key" }
                                            : (size(stripped_keys) > 1 ?
                                              get_request(cat_url).with({ "Header": { "Authorization": ["ApiKey " + stripped_keys[1]] } }).do_request().as(resp2,
                                                (resp2.StatusCode == 200) ?
                                                  { "resp": resp2, "key": stripped_keys[1], "ktype": "remote_key" }
                                                : (size(stripped_keys) > 2 ?
                                                  get_request(cat_url).with({ "Header": { "Authorization": ["ApiKey " + stripped_keys[2]] } }).do_request().as(resp3,
                                                    (resp3.StatusCode == 200) ?
                                                      { "resp": resp3, "key": stripped_keys[2], "ktype": "remote_key" }
                                                    : (size(stripped_keys) > 3 ?
                                                      get_request(cat_url).with({ "Header": { "Authorization": ["ApiKey " + stripped_keys[3]] } }).do_request().as(resp4,
                                                        (resp4.StatusCode == 200) ?
                                                          { "resp": resp4, "key": stripped_keys[3], "ktype": "remote_key" }
                                                        : { "resp": resp0, "key": primary_key, "ktype": "missing_key" }
                                                      )
                                                    : { "resp": resp0, "key": primary_key, "ktype": "missing_key" })
                                                  )
                                                : { "resp": resp0, "key": primary_key, "ktype": "missing_key" })
                                              )
                                            : { "resp": resp0, "key": primary_key, "ktype": "missing_key" })
                                          )
                                        : { "resp": resp0, "key": primary_key, "ktype": "missing_key" })
                                      ).as(cat_attempt,
                                        cat_attempt.resp.as(cat_resp,
                                          cat_attempt.key.as(target_key,
                                            cat_attempt.ktype.as(resolved_ktype,
                                              (cat_resp.StatusCode == 200) ?
                                                bytes(cat_resp.Body).decode_json().as(rows,
                                                  get_request(
                                                    dyn(p.endpoints).elasticsearch + "/_ml/trained_models/_stats"
                                                  ).with(
                                                    { "Header": { "Authorization": ["ApiKey " + target_key] } }
                                                  ).do_request().as(ml_resp,
                                                    (ml_resp.StatusCode == 200) ? bytes(ml_resp.Body).decode_json() : { "trained_model_stats": [] }
                                                  ).as(ml_body,
                                                    get_request(
                                                      dyn(p.endpoints).elasticsearch + "/synthetics-*/_search?" + {
                                                        "ignore_unavailable": ["true"],
                                                        "size": ["0"],
                                                        "source_content_type": ["application/json"],
                                                        "source": [
                                                          {
                                                            "size": 0,
                                                            "query": {
                                                              "bool": {
                                                                "filter": [{ "exists": { "field": "monitor.id" } }],
                                                                "must_not": [{ "terms": { "event.dataset": ["browser.network", "browser.screenshot"] } }]
                                                              }
                                                            },
                                                            "aggs": {
                                                              "monitors": {
                                                                "terms": { "field": "monitor.id", "size": 500 },
                                                                "aggs": {
                                                                  "monitor_name": { "terms": { "field": "monitor.name", "size": 1 } },
                                                                  "monitor_type": { "terms": { "field": "monitor.type", "size": 1 } },
                                                                  "monitor_namespace": { "terms": { "field": "data_stream.namespace", "size": 1 } },
                                                                  "up_checks": { "filter": { "term": { "monitor.status": "up" } } },
                                                                  "down_checks": { "filter": { "term": { "monitor.status": "down" } } },
                                                                  "locations": { "cardinality": { "field": "observer.geo.name" } },
                                                                  "avg_duration_us": { "avg": { "field": "monitor.duration.us" } }
                                                                }
                                                              }
                                                            }
                                                          }.encode_json()
                                                        ]
                                                      }.format_query()
                                                    ).with(
                                                      { "Header": { "Authorization": ["ApiKey " + target_key] } }
                                                    ).do_request().as(syn_resp,
                                                      (syn_resp.StatusCode == 200) ? bytes(syn_resp.Body).decode_json() : { "aggregations": { "monitors": { "buckets": [] } } }
                                                    ).as(syn_body,
                                                      rows.filter(row,
                                                        !row.index.startsWith(".") || row.index.startsWith(".ds-")
                                                      ).map(row,
                                                        {
                                                          "@timestamp": day_ts,
                                                          "period_start": day_ts,
                                                          "doc_type": "datastream",
                                                          "project_id": p.id,
                                                          "project_name": (has(p.name) && p.name != null && p.name != "") ? p.name : p.id,
                                                          "project_type": p.project_type,
                                                          "datastream": row.index,
                                                          "datastream_sum_indexing_time": ("indexing.index_time" in row && row["indexing.index_time"] != null && row["indexing.index_time"] != "") ? int(row["indexing.index_time"]) : 0,
                                                          "datastream_sum_query_time": ("search.query_time" in row && row["search.query_time"] != null && row["search.query_time"] != "") ? int(row["search.query_time"]) : 0,
                                                          "datastream_sum_data_set_store_size": ("dataset.size" in row && row["dataset.size"] != null && row["dataset.size"] != "") ? int(row["dataset.size"]) : 0,
                                                          "conf_chargeable_unit_rate": double(state.conf_unit_rate),
                                                          "conf_chargeable_unit_rate_unit": state.conf_currency_unit,
                                                          "conf_currency_symbol": state.conf_currency_symbol,
                                                        }
                                                      ) +
                                                      (has(ml_body.trained_model_stats) && ml_body.trained_model_stats != null ?
                                                        ml_body.trained_model_stats.map(m,
                                                          {
                                                            "@timestamp": day_ts,
                                                            "period_start": day_ts,
                                                            "doc_type": "ai_model",
                                                            "project_id": p.id,
                                                            "project_name": (has(p.name) && p.name != null && p.name != "") ? p.name : p.id,
                                                            "project_type": p.project_type,
                                                            "model_id": m.model_id,
                                                            "task_type": has(m.pipeline_count) && int(m.pipeline_count) > 0 ? "ingest_inference" : "query_inference",
                                                            "inference_count": has(m.inference_stats) && has(m.inference_stats.inference_count) ? int(m.inference_stats.inference_count) : 0,
                                                            "average_inference_time_ms": has(m.deployment_stats) && has(m.deployment_stats.nodes) && size(m.deployment_stats.nodes) > 0 && has(m.deployment_stats.nodes[0].average_inference_time_ms) ? double(m.deployment_stats.nodes[0].average_inference_time_ms) : 0.0,
                                                            "total_inference_time_ms": int((has(m.inference_stats) && has(m.inference_stats.inference_count) ? double(m.inference_stats.inference_count) : 0.0) * (has(m.deployment_stats) && has(m.deployment_stats.nodes) && size(m.deployment_stats.nodes) > 0 && has(m.deployment_stats.nodes[0].average_inference_time_ms) ? double(m.deployment_stats.nodes[0].average_inference_time_ms) : 0.0)),
                                                            "conf_chargeable_unit_rate": double(state.conf_unit_rate),
                                                            "conf_chargeable_unit_rate_unit": state.conf_currency_unit,
                                                            "conf_currency_symbol": state.conf_currency_symbol,
                                                          }
                                                        ) : []
                                                      ) +
                                                      (has(syn_body.aggregations) && syn_body.aggregations != null && has(syn_body.aggregations.monitors) && has(syn_body.aggregations.monitors.buckets) && syn_body.aggregations.monitors.buckets != null ?
                                                        syn_body.aggregations.monitors.buckets.map(b,
                                                          {
                                                            "@timestamp": day_ts,
                                                            "period_start": day_ts,
                                                            "doc_type": "synthetics_monitor",
                                                            "project_id": p.id,
                                                            "project_name": (has(p.name) && p.name != null && p.name != "") ? p.name : p.id,
                                                            "project_type": p.project_type,
                                                            "monitor_id": string(b.key),
                                                            "monitor_name": (has(b.monitor_name) && has(b.monitor_name.buckets) && size(b.monitor_name.buckets) > 0 && has(b.monitor_name.buckets[0].key)) ? string(b.monitor_name.buckets[0].key) : string(b.key),
                                                            "monitor_type": (has(b.monitor_type) && has(b.monitor_type.buckets) && size(b.monitor_type.buckets) > 0 && has(b.monitor_type.buckets[0].key)) ? string(b.monitor_type.buckets[0].key) : "http",
                                                            "monitor_namespace": (has(b.monitor_namespace) && has(b.monitor_namespace.buckets) && size(b.monitor_namespace.buckets) > 0 && has(b.monitor_namespace.buckets[0].key)) ? string(b.monitor_namespace.buckets[0].key) : "default",
                                                            "check_count": has(b.doc_count) ? int(b.doc_count) : 0,
                                                            "up_count": (has(b.up_checks) && has(b.up_checks.doc_count)) ? int(b.up_checks.doc_count) : 0,
                                                            "down_count": (has(b.down_checks) && has(b.down_checks.doc_count)) ? int(b.down_checks.doc_count) : 0,
                                                            "locations_count": (has(b.locations) && has(b.locations.value) && b.locations.value != null) ? int(b.locations.value) : 1,
                                                            "average_duration_ms": (has(b.avg_duration_us) && has(b.avg_duration_us.value) && b.avg_duration_us.value != null) ? (double(b.avg_duration_us.value) / 1000.0) : 0.0,
                                                            "conf_chargeable_unit_rate": double(state.conf_unit_rate),
                                                            "conf_chargeable_unit_rate_unit": state.conf_currency_unit,
                                                            "conf_currency_symbol": state.conf_currency_symbol,
                                                          }
                                                        ) : []
                                                      ) +
                                                      [
                                                        {
                                                          "@timestamp": day_ts,
                                                          "period_start": day_ts,
                                                          "doc_type": "project_status",
                                                          "project_id": p.id,
                                                          "project_name": (has(p.name) && p.name != null && p.name != "") ? p.name : p.id,
                                                          "project_type": p.project_type,
                                                          "optimized_for": has(p.optimized_for) ? p.optimized_for : "general_purpose",
                                                          "es_url": dyn(p.endpoints).elasticsearch,
                                                          "last_status": "ok",
                                                          "api_key_type": resolved_ktype,
                                                          "synthetics_status": "ok",
                                                          "index_count": size(rows),
                                                          "datastream_count": size(rows.filter(r, !r.index.startsWith(".") || r.index.startsWith(".ds-"))),
                                                          "ai_model_count": (has(ml_body.trained_model_stats) && ml_body.trained_model_stats != null) ? size(ml_body.trained_model_stats) : 0,
                                                          "synthetics_monitor_count": (has(syn_body.aggregations) && syn_body.aggregations != null && has(syn_body.aggregations.monitors) && has(syn_body.aggregations.monitors.buckets) && syn_body.aggregations.monitors.buckets != null) ? size(syn_body.aggregations.monitors.buckets) : 0,
                                                          "updated_at": now.format(time_layout.RFC3339),
                                                          "conf_chargeable_unit_rate": double(state.conf_unit_rate),
                                                          "conf_chargeable_unit_rate_unit": state.conf_currency_unit,
                                                          "conf_currency_symbol": state.conf_currency_symbol,
                                                        }
                                                      ]
                                                    )
                                                  )
                                                )
                                              :
                                                [
                                                  {
                                                    "@timestamp": day_ts,
                                                    "period_start": day_ts,
                                                    "doc_type": "project_status",
                                                    "project_id": p.id,
                                                    "project_name": (has(p.name) && p.name != null && p.name != "") ? p.name : p.id,
                                                    "project_type": p.project_type,
                                                    "optimized_for": has(p.optimized_for) ? p.optimized_for : "general_purpose",
                                                    "es_url": dyn(p.endpoints).elasticsearch,
                                                    "last_status": "empty_or_unauthorized",
                                                    "api_key_type": "missing_key",
                                                    "synthetics_status": "unauthorized",
                                                    "index_count": 0,
                                                    "datastream_count": 0,
                                                    "ai_model_count": 0,
                                                    "synthetics_monitor_count": 0,
                                                    "updated_at": now.format(time_layout.RFC3339),
                                                    "conf_chargeable_unit_rate": double(state.conf_unit_rate),
                                                    "conf_chargeable_unit_rate_unit": state.conf_currency_unit,
                                                    "conf_currency_symbol": state.conf_currency_symbol,
                                                  }
                                                ]
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            ).flatten(),
                            "cursor": { "last_day": cursor_key },
                            "want_more": false,
                          }
                          :
                          { "events": [], "want_more": false }
                        )
                      )
                    )
                  )
                )
              )
            )
          )
          )
          )
          )
        )
      )
    )
  )
