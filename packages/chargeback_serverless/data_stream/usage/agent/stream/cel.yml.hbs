config_version: 2
interval: "1h"
resource.url: "{{cloud_api_base}}/api/v1/serverless/projects/elasticsearch"
state:
  api_key: !!str {{cloud_api_key}}
  organization_id: !!str {{organization_id}}
  cloud_api_base: !!str {{cloud_api_base}}
  billing_api_base: !!str {{billing_api_base}}
  hub_es_api_key: !!str {{hub_es_api_key}}
  conf_unit_rate: !!str {{escape_string unit_rate}}
  conf_currency_unit: !!str {{escape_string currency_unit}}
  conf_currency_symbol: !!str {{escape_string currency_symbol}}
  project_keys: !!str {{project_api_keys}}
redact:
  fields:
    - api_key
    - cloud_api_key
    - hub_es_api_key
    - project_keys
    - project_api_keys
program: |-
  state.with(
    (now - duration("2h")).format(time_layout.DateOnly).parse_time(time_layout.DateOnly).as(latest_day_end,
      (latest_day_end - duration("24h")).as(latest_day_start,
        ((state.?cursor.pending_day.orValue("") != "" && state.?cursor.pending_day.orValue("") != state.?cursor.last_day.orValue("") && timestamp(state.?cursor.pending_day.orValue("")) <= latest_day_start) ?
          timestamp(state.?cursor.pending_day.orValue(""))
        :
          ((state.?cursor.last_day.orValue("") != "" && (timestamp(state.?cursor.last_day.orValue("")) + duration("24h")) <= latest_day_start) ?
            (timestamp(state.?cursor.last_day.orValue("")) + duration("24h"))
          :
            latest_day_start
          )
        ).as(day_start,
          (day_start + duration("24h")).as(day_end,
            day_start.format(time_layout.RFC3339).as(day_ts,
            (day_start == latest_day_start || (state.?cursor.pending_day.orValue("") == day_ts && state.?cursor.pending_day.orValue("") != state.?cursor.last_day.orValue("") && (latest_day_start - day_start) <= duration("24h"))).as(is_live_day,
          (
            !has(state.project_keys) || state.project_keys == null ? [] :
            (type(dyn(state.project_keys)) == type("") ?
              string(dyn(state.project_keys)).split(",") :
              (type(dyn(state.project_keys)) == type([]) ?
                dyn(state.project_keys).map(k, string(k)) :
                []
              )
            )
          ).map(k, k.trim()).filter(k, k != "" && k != "null" && !k.startsWith("$co.elastic.secret")).as(all_pkeys,
          state.?cursor.ml_baselines.orValue([]).as(prev_ml_baselines,
          (state.?cursor.pending_day.orValue("") == day_ts ? state.?cursor.completed_projects.orValue([]) : []).as(prev_completed_pids,
          (state.?cursor.last_day.orValue("") == day_ts) ?
            {
              "events": [],
              "cursor": { "last_day": day_ts, "pending_day": day_ts, "completed_projects": prev_completed_pids, "ml_baselines": prev_ml_baselines },
              "want_more": false,
            }
          :
            get_request(
              state.cloud_api_base + "/api/v1/serverless/projects/elasticsearch"
            ).with(
              { "Header": { "Authorization": ["ApiKey " + state.api_key] } }
            ).do_request().as(es_resp,
              get_request(
                state.cloud_api_base + "/api/v1/serverless/projects/observability"
              ).with(
                { "Header": { "Authorization": ["ApiKey " + state.api_key] } }
              ).do_request().as(obs_resp,
                get_request(
                  state.cloud_api_base + "/api/v1/serverless/projects/security"
                ).with(
                  { "Header": { "Authorization": ["ApiKey " + state.api_key] } }
                ).do_request().as(sec_resp,
                  get_request(
                    state.cloud_api_base + "/api/v1/serverless/projects/search"
                  ).with(
                    { "Header": { "Authorization": ["ApiKey " + state.api_key] } }
                  ).do_request().as(srch_resp,
                    get_request(
                      state.billing_api_base + "/api/v2/billing/organizations/" + state.organization_id + "/costs/instances?" + {
                        "from": [day_start.format(time_layout.RFC3339)],
                        "to": [day_end.format(time_layout.RFC3339)],
                        "include_names": ["true"],
                      }.format_query()
                    ).with(
                      { "Header": { "Authorization": ["ApiKey " + state.api_key] } }
                    ).do_request().as(bill_resp,
                      (es_resp.StatusCode == 200 && obs_resp.StatusCode == 200 && sec_resp.StatusCode == 200 && (srch_resp.StatusCode == 200 || srch_resp.StatusCode == 404)).as(discovery_ok,
                        (bill_resp.StatusCode == 200 && discovery_ok) ?
                          bytes(es_resp.Body).decode_json().as(es_body,
                            bytes(obs_resp.Body).decode_json().as(obs_body,
                              bytes(sec_resp.Body).decode_json().as(sec_body,
                                ((srch_resp.StatusCode == 200) ? bytes(srch_resp.Body).decode_json() : { "items": [] }).as(srch_body,
                                  bytes(bill_resp.Body).decode_json().as(bill_body,
                                    ((has(es_body.items) && es_body.items != null ? es_body.items.map(p, dyn(p.with({ "project_type": "elasticsearch" }))) : []) +
                                     (has(obs_body.items) && obs_body.items != null ? obs_body.items.map(p, dyn(p.with({ "project_type": "observability" }))) : []) +
                                     (has(sec_body.items) && sec_body.items != null ? sec_body.items.map(p, dyn(p.with({ "project_type": "security" }))) : []) +
                                     (has(srch_body.items) && srch_body.items != null ? srch_body.items.map(p, dyn(p.with({ "project_type": "search" }))) : [])
                                    ).as(projects,
                                      (
                                        projects.filter(p, !prev_completed_pids.exists(cid, cid == string(p.id))).map(p,
                                          all_pkeys.filter(k,
                                            k.startsWith(p.id + ":") || (has(p.name) && p.name != null && p.name != "" && k.startsWith(p.name + ":"))
                                          ).as(pkeys,
                                            (
                                              pkeys.map(k,
                                                k.startsWith(p.id + ":") ?
                                                  { "key": k.substring(size(p.id) + 1, size(k)), "ktype": "remote_key" } :
                                                  { "key": k.substring(size(p.name) + 1, size(k)), "ktype": "remote_key" }
                                              ) +
                                              (state.hub_es_api_key != "" ?
                                                [{ "key": state.hub_es_api_key, "ktype": "hub_key" }, { "key": state.api_key, "ktype": "cloud_key" }] :
                                                [{ "key": state.api_key, "ktype": "cloud_key" }]
                                              ) +
                                              all_pkeys.filter(k, !k.contains(":")).map(k, { "key": k, "ktype": "remote_key" })
                                            ).as(candidate_keys,
                                              candidate_keys[0].as(primary_cand,
                                                string(dyn(p.endpoints).elasticsearch).as(_raw_es_url,
                                                  (_raw_es_url.endsWith("/") ? _raw_es_url.substring(0, size(_raw_es_url) - 1) : _raw_es_url).as(es_base_url,
                                                    (es_base_url + "/_cat/indices?h=index,dataset.size,indexing.index_time,search.query_time&format=json&bytes=b&time=ms&expand_wildcards=open,hidden").as(cat_url,
                                                      get_request(cat_url).with({ "Header": { "Authorization": ["ApiKey " + primary_cand.key] } }).do_request().as(resp0,
                                                        (resp0.StatusCode == 200) ?
                                                          { "resp": resp0, "key": primary_cand.key, "ktype": primary_cand.ktype }
                                                        : (size(candidate_keys) > 1 ?
                                                          get_request(cat_url).with({ "Header": { "Authorization": ["ApiKey " + candidate_keys[1].key] } }).do_request().as(resp1,
                                                            (resp1.StatusCode == 200) ?
                                                              { "resp": resp1, "key": candidate_keys[1].key, "ktype": candidate_keys[1].ktype }
                                                            : (size(candidate_keys) > 2 ?
                                                              get_request(cat_url).with({ "Header": { "Authorization": ["ApiKey " + candidate_keys[2].key] } }).do_request().as(resp2,
                                                                (resp2.StatusCode == 200) ?
                                                                  { "resp": resp2, "key": candidate_keys[2].key, "ktype": candidate_keys[2].ktype }
                                                                : (size(candidate_keys) > 3 ?
                                                                  get_request(cat_url).with({ "Header": { "Authorization": ["ApiKey " + candidate_keys[3].key] } }).do_request().as(resp3,
                                                                    (resp3.StatusCode == 200) ?
                                                                      { "resp": resp3, "key": candidate_keys[3].key, "ktype": candidate_keys[3].ktype }
                                                                    : (size(candidate_keys) > 4 ?
                                                                      get_request(cat_url).with({ "Header": { "Authorization": ["ApiKey " + candidate_keys[4].key] } }).do_request().as(resp4,
                                                                        (resp4.StatusCode == 200) ?
                                                                          { "resp": resp4, "key": candidate_keys[4].key, "ktype": candidate_keys[4].ktype }
                                                                        : { "resp": resp0, "key": primary_cand.key, "ktype": (resp0.StatusCode == 429 || resp0.StatusCode >= 500 || resp1.StatusCode == 429 || resp1.StatusCode >= 500 || resp2.StatusCode == 429 || resp2.StatusCode >= 500 || resp3.StatusCode == 429 || resp3.StatusCode >= 500 || resp4.StatusCode == 429 || resp4.StatusCode >= 500) ? "transient_error" : "missing_key" }
                                                                      )
                                                                    : { "resp": resp0, "key": primary_cand.key, "ktype": (resp0.StatusCode == 429 || resp0.StatusCode >= 500 || resp1.StatusCode == 429 || resp1.StatusCode >= 500 || resp2.StatusCode == 429 || resp2.StatusCode >= 500 || resp3.StatusCode == 429 || resp3.StatusCode >= 500) ? "transient_error" : "missing_key" })
                                                                  )
                                                                : { "resp": resp0, "key": primary_cand.key, "ktype": (resp0.StatusCode == 429 || resp0.StatusCode >= 500 || resp1.StatusCode == 429 || resp1.StatusCode >= 500 || resp2.StatusCode == 429 || resp2.StatusCode >= 500) ? "transient_error" : "missing_key" })
                                                              )
                                                            : { "resp": resp0, "key": primary_cand.key, "ktype": (resp0.StatusCode == 429 || resp0.StatusCode >= 500 || resp1.StatusCode == 429 || resp1.StatusCode >= 500) ? "transient_error" : "missing_key" })
                                                          )
                                                        : { "resp": resp0, "key": primary_cand.key, "ktype": (resp0.StatusCode == 429 || resp0.StatusCode >= 500) ? "transient_error" : "missing_key" })
                                                      ).as(cat_attempt,
                                                        cat_attempt.resp.as(cat_resp,
                                                          cat_attempt.key.as(target_key,
                                                            cat_attempt.ktype.as(resolved_ktype,
                                                              (cat_resp.StatusCode == 200) ?
                                                                bytes(cat_resp.Body).decode_json().as(rows,
                                                                  get_request(
                                                                    es_base_url + "/_ml/trained_models/_stats?size=10000"
                                                                  ).with(
                                                                    { "Header": { "Authorization": ["ApiKey " + target_key] } }
                                                                  ).do_request().as(ml_resp,
                                                                    ((ml_resp.StatusCode == 200) ? bytes(ml_resp.Body).decode_json() : { "trained_model_stats": [] }).as(ml_body,
                                                                      get_request(
                                                                        es_base_url + "/_inference"
                                                                      ).with(
                                                                        { "Header": { "Authorization": ["ApiKey " + target_key] } }
                                                                      ).do_request().as(inf_resp,
                                                                        ((inf_resp.StatusCode == 200) ? bytes(inf_resp.Body).decode_json() : { "endpoints": [] }).as(inf_body,
                                                                          get_request(
                                                                            es_base_url + "/.ds-synthetics-*-*,synthetics-*/_search?" + {
                                                                              "ignore_unavailable": ["true"],
                                                                              "expand_wildcards": ["open,hidden"],
                                                                              "size": ["0"],
                                                                              "source_content_type": ["application/json"],
                                                                              "source": [
                                                                                {
                                                                                  "size": 0,
                                                                                  "query": {
                                                                                    "bool": {
                                                                                      "filter": [
                                                                                        { "exists": { "field": "monitor.id" } },
                                                                                        { "exists": { "field": "monitor.status" } },
                                                                                        { "range": { "@timestamp": { "gte": day_start.format(time_layout.RFC3339), "lt": day_end.format(time_layout.RFC3339) } } }
                                                                                      ],
                                                                                      "must_not": [
                                                                                        { "terms": { "event.dataset": ["browser.network", "browser.screenshot", "browser.step"] } },
                                                                                        { "exists": { "field": "synthetics.step" } }
                                                                                      ]
                                                                                    }
                                                                                  },
                                                                                  "aggs": {
                                                                                    "by_type": {
                                                                                      "terms": { "field": "monitor.type", "size": 10, "missing": "http" },
                                                                                      "aggs": {
                                                                                        "monitors": {
                                                                                          "terms": { "field": "monitor.id", "size": 10000 },
                                                                                          "aggs": {
                                                                                            "monitor_name": { "terms": { "field": "monitor.name", "size": 1 } },
                                                                                            "monitor_namespace": { "terms": { "field": "data_stream.namespace", "size": 1 } },
                                                                                            "up_checks": { "filter": { "term": { "monitor.status": "up" } } },
                                                                                            "down_checks": { "filter": { "term": { "monitor.status": "down" } } },
                                                                                            "locations": { "cardinality": { "field": "observer.geo.name" } },
                                                                                            "avg_duration_us": { "avg": { "field": "monitor.duration.us" } }
                                                                                          }
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                  }
                                                                                }.encode_json()
                                                                              ]
                                                                            }.format_query()
                                                                          ).with(
                                                                            { "Header": { "Authorization": ["ApiKey " + target_key] } }
                                                                          ).do_request().as(syn_resp,
                                                                            ((syn_resp.StatusCode == 200) ? bytes(syn_resp.Body).decode_json() : { "aggregations": { "by_type": { "buckets": [] } } }).as(syn_body,
                                                                              ((has(syn_body.aggregations) && syn_body.aggregations != null && has(syn_body.aggregations.by_type) && has(syn_body.aggregations.by_type.buckets) && syn_body.aggregations.by_type.buckets != null) ?
                                                                                syn_body.aggregations.by_type.buckets.map(tb,
                                                                                  ((has(tb.key) && tb.key != null && string(tb.key) != "") ? string(tb.key) : "http").as(mtype,
                                                                                    ((has(tb.monitors) && has(tb.monitors.buckets) && tb.monitors.buckets != null) ?
                                                                                      tb.monitors.buckets.map(b,
                                                                                        {
                                                                                          "@timestamp": day_ts,
                                                                                          "period_start": day_ts,
                                                                                          "doc_type": "synthetics_monitor",
                                                                                          "project_id": p.id,
                                                                                          "project_name": (has(p.name) && p.name != null && p.name != "") ? p.name : p.id,
                                                                                          "project_type": p.project_type,
                                                                                          "monitor_id": string(b.key),
                                                                                          "monitor_name": (has(b.monitor_name) && has(b.monitor_name.buckets) && size(b.monitor_name.buckets) > 0 && has(b.monitor_name.buckets[0].key)) ? string(b.monitor_name.buckets[0].key) : string(b.key),
                                                                                          "monitor_type": mtype,
                                                                                          "monitor_namespace": (has(b.monitor_namespace) && has(b.monitor_namespace.buckets) && size(b.monitor_namespace.buckets) > 0 && has(b.monitor_namespace.buckets[0].key)) ? string(b.monitor_namespace.buckets[0].key) : "default",
                                                                                          "check_count": has(b.doc_count) ? int(b.doc_count) : 0,
                                                                                          "up_count": (has(b.up_checks) && has(b.up_checks.doc_count)) ? int(b.up_checks.doc_count) : 0,
                                                                                          "down_count": (has(b.down_checks) && has(b.down_checks.doc_count)) ? int(b.down_checks.doc_count) : 0,
                                                                                          "locations_count": (has(b.locations) && has(b.locations.value) && b.locations.value != null) ? int(b.locations.value) : 1,
                                                                                          "average_duration_ms": (has(b.avg_duration_us) && has(b.avg_duration_us.value) && b.avg_duration_us.value != null) ? (double(b.avg_duration_us.value) / 1000.0) : 0.0,
                                                                                          "conf_chargeable_unit_rate": double(state.conf_unit_rate),
                                                                                          "conf_chargeable_unit_rate_unit": state.conf_currency_unit,
                                                                                          "conf_currency_symbol": state.conf_currency_symbol,
                                                                                        }
                                                                                      )
                                                                                    : []) +
                                                                                    ((has(tb.monitors) && has(tb.monitors.sum_other_doc_count) && tb.monitors.sum_other_doc_count != null && int(tb.monitors.sum_other_doc_count) > 0) ?
                                                                                      [
                                                                                        {
                                                                                          "@timestamp": day_ts,
                                                                                          "period_start": day_ts,
                                                                                          "doc_type": "synthetics_monitor",
                                                                                          "project_id": p.id,
                                                                                          "project_name": (has(p.name) && p.name != null && p.name != "") ? p.name : p.id,
                                                                                          "project_type": p.project_type,
                                                                                          "monitor_id": "other-monitors-overflow-" + mtype,
                                                                                          "monitor_name": "Other Monitors (Aggregation Overflow - " + mtype + ")",
                                                                                          "monitor_type": mtype,
                                                                                          "monitor_namespace": "default",
                                                                                          "check_count": int(tb.monitors.sum_other_doc_count),
                                                                                          "up_count": 0,
                                                                                          "down_count": 0,
                                                                                          "locations_count": 1,
                                                                                          "average_duration_ms": 0.0,
                                                                                          "conf_chargeable_unit_rate": double(state.conf_unit_rate),
                                                                                          "conf_chargeable_unit_rate_unit": state.conf_currency_unit,
                                                                                          "conf_currency_symbol": state.conf_currency_symbol,
                                                                                        }
                                                                                      ]
                                                                                    : [])
                                                                                  )
                                                                                ).flatten()
                                                                              : []).as(harvested_syn_evts,
                                                                                ((has(bill_body.instances) && bill_body.instances != null) ?
                                                                                  bill_body.instances.filter(inst, has(inst.id) && inst.id != null && string(inst.id) == string(p.id))
                                                                                : []).as(proj_bill_insts,
                                                                                  proj_bill_insts.map(inst,
                                                                                    (has(inst.product_line_items) && inst.product_line_items != null) ?
                                                                                      inst.product_line_items.filter(li,
                                                                                        has(li.sku) && li.sku != null &&
                                                                                        string(li.sku).lowerAscii().contains("synthetic") &&
                                                                                        string(li.sku).lowerAscii().contains("ping") &&
                                                                                        (!has(li.total_ecu) || li.total_ecu == null || double(li.total_ecu) > 0.0 || (has(li.quantity) && li.quantity != null && has(li.quantity.value) && li.quantity.value != null && double(li.quantity.value) > 0.0))
                                                                                      ).map(li, (has(li.quantity) && li.quantity != null && has(li.quantity.value) && li.quantity.value != null) ? double(li.quantity.value) : 0.0)
                                                                                    : []
                                                                                  ).flatten().as(ping_qtys,
                                                                                    proj_bill_insts.map(inst,
                                                                                      (has(inst.product_line_items) && inst.product_line_items != null) ?
                                                                                        inst.product_line_items.filter(li,
                                                                                          has(li.sku) && li.sku != null &&
                                                                                          string(li.sku).lowerAscii().contains("synthetic") &&
                                                                                          !string(li.sku).lowerAscii().contains("ping") &&
                                                                                          (!has(li.total_ecu) || li.total_ecu == null || double(li.total_ecu) > 0.0 || (has(li.quantity) && li.quantity != null && has(li.quantity.value) && li.quantity.value != null && double(li.quantity.value) > 0.0))
                                                                                        ).map(li, (has(li.quantity) && li.quantity != null && has(li.quantity.value) && li.quantity.value != null) ? double(li.quantity.value) : 0.0)
                                                                                      : []
                                                                                    ).flatten().as(browser_qtys,
                                                                                      (size(ping_qtys) > 0).as(has_ping_sku,
                                                                                        (size(browser_qtys) > 0).as(has_browser_sku,
                                                                                          (size(ping_qtys) == 0 ? 0.0 : ping_qtys.sum()).as(ping_billed_qty,
                                                                                            (size(browser_qtys) == 0 ? 0.0 : browser_qtys.sum()).as(browser_billed_qty,
                                                                                              (
                                                                                                harvested_syn_evts +
                                                                                                ((has_ping_sku && !harvested_syn_evts.exists(m, m.monitor_type != "browser")) ?
                                                                                                  [
                                                                                                    {
                                                                                                      "@timestamp": day_ts,
                                                                                                      "period_start": day_ts,
                                                                                                      "doc_type": "synthetics_monitor",
                                                                                                      "project_id": p.id,
                                                                                                      "project_name": (has(p.name) && p.name != null && p.name != "") ? p.name : p.id,
                                                                                                      "project_type": p.project_type,
                                                                                                      "monitor_id": "billing-derived-lightweight",
                                                                                                      "monitor_name": "Lightweight Monitors (Billing SKU)",
                                                                                                      "monitor_type": "http",
                                                                                                      "monitor_namespace": "default",
                                                                                                      "check_count": ping_billed_qty > 0.0 ? int(ping_billed_qty) : 1,
                                                                                                      "up_count": 0,
                                                                                                      "down_count": 0,
                                                                                                      "locations_count": 1,
                                                                                                      "average_duration_ms": 0.0,
                                                                                                      "conf_chargeable_unit_rate": double(state.conf_unit_rate),
                                                                                                      "conf_chargeable_unit_rate_unit": state.conf_currency_unit,
                                                                                                      "conf_currency_symbol": state.conf_currency_symbol,
                                                                                                    }
                                                                                                  ]
                                                                                                : []) +
                                                                                                ((has_browser_sku && !harvested_syn_evts.exists(m, m.monitor_type == "browser")) ?
                                                                                                  [
                                                                                                    {
                                                                                                      "@timestamp": day_ts,
                                                                                                      "period_start": day_ts,
                                                                                                      "doc_type": "synthetics_monitor",
                                                                                                      "project_id": p.id,
                                                                                                      "project_name": (has(p.name) && p.name != null && p.name != "") ? p.name : p.id,
                                                                                                      "project_type": p.project_type,
                                                                                                      "monitor_id": "billing-derived-browser",
                                                                                                      "monitor_name": "Browser Monitors (Billing SKU)",
                                                                                                      "monitor_type": "browser",
                                                                                                      "monitor_namespace": "default",
                                                                                                      "check_count": browser_billed_qty > 0.0 ? int(browser_billed_qty) : 1,
                                                                                                      "up_count": 0,
                                                                                                      "down_count": 0,
                                                                                                      "locations_count": 1,
                                                                                                      "average_duration_ms": 0.0,
                                                                                                      "conf_chargeable_unit_rate": double(state.conf_unit_rate),
                                                                                                      "conf_chargeable_unit_rate_unit": state.conf_currency_unit,
                                                                                                      "conf_currency_symbol": state.conf_currency_symbol,
                                                                                                    }
                                                                                                  ]
                                                                                                : [])
                                                                                              ).as(all_syn_evts,
                                                                                                ((is_live_day && has(ml_body.trained_model_stats) && ml_body.trained_model_stats != null) ?
                                                                                                  ml_body.trained_model_stats.filter(m,
                                                                                                    has(m.model_id) && m.model_id != null && string(m.model_id) != "" && (
                                                                                                      (has(m.deployment_stats) && m.deployment_stats != null && (
                                                                                                        (has(m.deployment_stats.deployment_id) && m.deployment_stats.deployment_id != null && string(m.deployment_stats.deployment_id) != "") ||
                                                                                                        (has(m.deployment_stats.nodes) && m.deployment_stats.nodes != null && size(m.deployment_stats.nodes) > 0) ||
                                                                                                        (has(m.deployment_stats.state) && m.deployment_stats.state != null && string(m.deployment_stats.state) != "")
                                                                                                      )) ||
                                                                                                      (has(m.pipeline_count) && m.pipeline_count != null && int(m.pipeline_count) > 0) ||
                                                                                                      (has(m.inference_stats) && m.inference_stats != null && has(m.inference_stats.inference_count) && m.inference_stats.inference_count != null && int(m.inference_stats.inference_count) > 0)
                                                                                                    )
                                                                                                  ) : []).as(active_ml_stats,
