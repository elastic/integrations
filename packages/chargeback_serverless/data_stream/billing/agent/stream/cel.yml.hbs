config_version: 2
interval: "1h"
resource.url: "{{billing_api_base}}/api/v2/billing/organizations/{{organization_id}}/costs/instances"
state:
  api_key: !!str {{cloud_api_key}}
  organization_id: !!str {{organization_id}}
  billing_api_base: !!str {{billing_api_base}}
  cloud_api_base: !!str {{cloud_api_base}}
  lookbehind: !!int {{lookbehind}}
  conf_unit_rate: !!str {{escape_string unit_rate}}
  conf_currency_unit: !!str {{escape_string currency_unit}}
  conf_currency_symbol: !!str {{escape_string currency_symbol}}
redact:
  fields:
    - api_key
    - cloud_api_key
program: |-
  state.with(
    state.?cursor.last_to.optMap(ts, (type(ts) == string) ? timestamp(ts) : ts).orValue(
      now - duration(string(int(state.lookbehind) * 24) + "h")
    ).format(
      time_layout.DateOnly
    ).parse_time(time_layout.DateOnly).as(from,
      max(from, timestamp("2023-01-01T00:00:00Z"))
    ).as(from,
      {
        "from": from,
        "to": from + duration("24h"),
      }
    ).as(req, (req.to + duration("2h") > now) ?
      {
        "events": [],
        "cursor": { "last_to": req.from.format(time_layout.RFC3339) },
        "want_more": false,
      }
    :
      get_request(
        state.billing_api_base + "/api/v2/billing/organizations/" + state.organization_id + "/costs/instances?" + {
          "from": [req.from.format(time_layout.RFC3339)],
          "to": [req.to.format(time_layout.RFC3339)],
          "include_names": ["true"],
        }.format_query()
      ).with(
        { "Header": { "Authorization": ["ApiKey " + state.api_key] } }
      ).do_request().as(resp, (resp.StatusCode == 200) ?
        bytes(resp.Body).decode_json().as(body,
          get_request(
            state.billing_api_base + "/api/v2/billing/organizations/" + state.organization_id + "/costs/items?" + {
              "from": [req.from.format(time_layout.RFC3339)],
              "to": [req.to.format(time_layout.RFC3339)],
            }.format_query()
          ).with(
            { "Header": { "Authorization": ["ApiKey " + state.api_key] } }
          ).do_request().as(items_resp, (items_resp.StatusCode == 200) ?
            bytes(items_resp.Body).decode_json().as(items_body,
            get_request(
              state.cloud_api_base + "/api/v1/serverless/projects/elasticsearch"
            ).with(
              { "Header": { "Authorization": ["ApiKey " + state.api_key] } }
            ).do_request().as(es_resp,
              ((es_resp.StatusCode == 200) ? bytes(es_resp.Body).decode_json() : { "items": [] }).as(es_body,
                get_request(
                  state.cloud_api_base + "/api/v1/serverless/projects/observability"
                ).with(
                  { "Header": { "Authorization": ["ApiKey " + state.api_key] } }
                ).do_request().as(obs_resp,
                  ((obs_resp.StatusCode == 200) ? bytes(obs_resp.Body).decode_json() : { "items": [] }).as(obs_body,
                    get_request(
                      state.cloud_api_base + "/api/v1/serverless/projects/security"
                    ).with(
                      { "Header": { "Authorization": ["ApiKey " + state.api_key] } }
                    ).do_request().as(sec_resp,
                      ((sec_resp.StatusCode == 200) ? bytes(sec_resp.Body).decode_json() : { "items": [] }).as(sec_body,
                        get_request(
                          state.cloud_api_base + "/api/v1/serverless/projects/search"
                        ).with(
                          { "Header": { "Authorization": ["ApiKey " + state.api_key] } }
                        ).do_request().as(srch_resp,
                          ((srch_resp.StatusCode == 200) ? bytes(srch_resp.Body).decode_json() : { "items": [] }).as(srch_body,
                            ((has(es_body.items) && es_body.items != null ? es_body.items.map(p, dyn(p.with({ "project_type": "elasticsearch" }))) : []) +
                             (has(obs_body.items) && obs_body.items != null ? obs_body.items.map(p, dyn(p.with({ "project_type": "observability" }))) : []) +
                             (has(sec_body.items) && sec_body.items != null ? sec_body.items.map(p, dyn(p.with({ "project_type": "security" }))) : []) +
                             (has(srch_body.items) && srch_body.items != null ? srch_body.items.map(p, dyn(p.with({ "project_type": "search" }))) : [])
                            ).as(projects,
                              ((has(body.instances) && body.instances != null) ?
                                body.instances.filter(instance,
                                  size(projects.filter(p, has(instance.id) && instance.id != null && p.id == instance.id)) > 0 ||
                                  ((!has(instance.type) || instance.type == null || string(instance.type) != "deployment") &&
                                  has(instance.product_line_items) && instance.product_line_items != null &&
                                  !instance.product_line_items.exists(li,
                                    has(li.sku) && li.sku != null && (
                                      li.sku.contains("cloud-enterprise") || li.sku.contains("cloud-platinum") || li.sku.contains("cloud-standard") || li.sku.contains("cloud-gold") ||
                                      li.sku.contains(".es.data") || li.sku.contains(".es.ml") || li.sku.contains(".es.master") || li.sku.contains(".es.coordinating") ||
                                      li.sku.contains(".kibana.") || li.sku.contains(".apm.") || li.sku.contains(".enterprise_search.") || li.sku.contains(".integrations_server.")
                                    )
                                  ) &&
                                  size(instance.product_line_items.filter(li,
                                    has(li.sku) && li.sku != null && (
                                      li.sku.contains("-vcu") || li.sku.contains(".ecu") || li.sku.contains(".observability.") || li.sku.contains(".security.") ||
                                      li.sku.startsWith("serverless.search.") || li.sku.startsWith("serverless.") || li.sku.startsWith("observability.") ||
                                      li.sku.startsWith("security.") || li.sku.startsWith("search.") || li.sku.contains("synthetic") ||
                                      li.sku.contains(".retained") || li.sku == "global.inference-chat-input" || li.sku.contains("inference") ||
                                      li.sku.contains("agent-builder") || li.sku.contains(".eis") || li.sku.contains("workflow") || li.sku.contains("cross-project")
                                    )
                                  )) > 0)
                                )
                              : []).as(sls_instances,
                                sls_instances.map(instance,
                                  projects.filter(p, has(instance.id) && instance.id != null && p.id == instance.id).as(matched_projs,
                                    ((size(matched_projs) > 0 && has(matched_projs[0].project_type) && matched_projs[0].project_type != null && matched_projs[0].project_type != "") ? matched_projs[0].project_type : (
                                      ((has(instance.type) && instance.type != null) ? string(instance.type).to_lower() : "").as(raw_inst_type,
                                        (raw_inst_type == "observability" || raw_inst_type == "oblt" || raw_inst_type.contains("observability") || raw_inst_type.contains("oblt")) ? "observability" : (
                                          (raw_inst_type == "security" || raw_inst_type == "sec" || raw_inst_type.contains("security")) ? "security" : (
                                            (raw_inst_type == "elasticsearch" || raw_inst_type == "es" || raw_inst_type.contains("elasticsearch")) ? "elasticsearch" : (
                                              (raw_inst_type == "search" || raw_inst_type == "enterprise_search" || raw_inst_type.contains("search")) ? "search" : (
                                                (has(instance.product_line_items) && instance.product_line_items != null && instance.product_line_items.exists(li, has(li.sku) && li.sku != null && string(li.sku).to_lower().as(s, s.startsWith("observability.") || s.startsWith("oblt.") || s.startsWith("serverless.observability.") || s.startsWith("serverless.oblt.") || s.contains("synthetic")))) ? "observability" : (
                                                  (has(instance.product_line_items) && instance.product_line_items != null && instance.product_line_items.exists(li, has(li.sku) && li.sku != null && string(li.sku).to_lower().as(s, s.startsWith("security.") || s.startsWith("sec.") || s.startsWith("serverless.security.") || s.startsWith("serverless.sec.")))) ? "security" : (
                                                    (has(instance.product_line_items) && instance.product_line_items != null && instance.product_line_items.exists(li, has(li.sku) && li.sku != null && string(li.sku).to_lower().as(s, s.startsWith("elasticsearch.") || s.startsWith("es.") || s.startsWith("serverless.elasticsearch.") || s.startsWith("serverless.es.")))) ? "elasticsearch" : (
                                                      (has(instance.product_line_items) && instance.product_line_items != null && instance.product_line_items.exists(li, has(li.sku) && li.sku != null && string(li.sku).to_lower().as(s, s.startsWith("search.") || s.startsWith("serverless.search.")))) ? "search" : "elasticsearch"
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )).as(resolved_type,
                                      ((has(instance.id) && instance.id != null && string(instance.id) != "") ? string(instance.id) : ("unassociated_" + resolved_type)).as(inst_id,
                                        ((size(matched_projs) > 0 && has(matched_projs[0].name) && matched_projs[0].name != null && matched_projs[0].name != "" && matched_projs[0].name != inst_id) ? matched_projs[0].name : ((has(instance.name) && instance.name != null && instance.name != "") ? instance.name : ((has(instance.id) && instance.id != null && string(instance.id) != "") ? inst_id : ("Unassociated (" + resolved_type + ")")))).as(resolved_name,
                                          (has(instance.product_line_items) && instance.product_line_items != null) ?
                                            instance.product_line_items.filter(line_item,
                                              has(line_item.sku) && line_item.sku != null && string(line_item.sku) != "" && (
                                                size(matched_projs) > 0 ||
                                                (has(instance.id) && instance.id != null && string(instance.id) != "" && (!has(instance.type) || instance.type == null || string(instance.type) != "deployment")) ||
                                                line_item.sku.contains("-vcu") || line_item.sku.contains(".ecu") || line_item.sku.contains(".observability.") || line_item.sku.contains(".security.") ||
                                                line_item.sku.startsWith("serverless.search.") || line_item.sku.startsWith("serverless.") || line_item.sku.startsWith("observability.") ||
                                                line_item.sku.startsWith("security.") || line_item.sku.startsWith("search.") || line_item.sku.contains("synthetic") ||
                                                line_item.sku.contains(".retained") || line_item.sku == "global.inference-chat-input" || line_item.sku.contains("inference") ||
                                                line_item.sku.contains("agent-builder") || line_item.sku.contains(".eis") || line_item.sku.contains("workflow") || line_item.sku.contains("cross-project")
                                              )
                                            ).as(sls_line_items,
                                              size(sls_line_items) > 0 ?
                                                sls_line_items.map(line_item,
                                                  {
                                                    "@timestamp": req.from.format(time_layout.RFC3339),
                                                    "period_start": req.from.format(time_layout.RFC3339),
                                                    "project_id": inst_id,
                                                    "project_name": resolved_name,
                                                    "project_type": resolved_type,
                                                    "sku": line_item.sku,
                                                    "total_ecu": double(line_item.total_ecu),
                                                    "quantity_value": (has(line_item.quantity) && line_item.quantity != null && has(line_item.quantity.value) && line_item.quantity.value != null) ? double(line_item.quantity.value) : 0.0,
                                                    "conf_chargeable_unit_rate": double(state.conf_unit_rate),
                                                    "conf_chargeable_unit_rate_unit": state.conf_currency_unit,
                                                    "conf_currency_symbol": state.conf_currency_symbol,
                                                  }
                                                )
                                              :
                                                [
                                                  {
                                                    "@timestamp": req.from.format(time_layout.RFC3339),
                                                    "period_start": req.from.format(time_layout.RFC3339),
                                                    "project_id": inst_id,
                                                    "project_name": resolved_name,
                                                    "project_type": resolved_type,
                                                    "sku": "none",
                                                    "total_ecu": 0.0,
                                                    "quantity_value": 0.0,
                                                    "conf_chargeable_unit_rate": double(state.conf_unit_rate),
                                                    "conf_chargeable_unit_rate_unit": state.conf_currency_unit,
                                                    "conf_currency_symbol": state.conf_currency_symbol,
                                                  }
                                                ]
                                            )
                                          :
                                            [
                                              {
                                                "@timestamp": req.from.format(time_layout.RFC3339),
                                                "period_start": req.from.format(time_layout.RFC3339),
                                                "project_id": inst_id,
                                                "project_name": resolved_name,
                                                "project_type": resolved_type,
                                                "sku": "none",
                                                "total_ecu": 0.0,
                                                "quantity_value": 0.0,
                                                "conf_chargeable_unit_rate": double(state.conf_unit_rate),
                                                "conf_chargeable_unit_rate_unit": state.conf_currency_unit,
                                                "conf_currency_symbol": state.conf_currency_symbol,
                                              }
                                            ]
                                        )
                                      )
                                    )
                                  )
                                ).flatten().as(instance_evts,
                                  (
                                    instance_evts +
                                    ((has(items_body.products) && items_body.products != null) ?
                                      items_body.products.filter(prod,
                                        !has(prod.type) || prod.type == null || string(prod.type) != "deployment"
                                      ).map(prod,
                                        ((has(prod.type) && prod.type != null) ? string(prod.type).to_lower() : "").as(raw_prod_type,
                                          ((raw_prod_type == "observability" || raw_prod_type == "oblt" || raw_prod_type.contains("observability") || raw_prod_type.contains("oblt")) ? "observability" : ((raw_prod_type == "security" || raw_prod_type == "sec" || raw_prod_type.contains("security")) ? "security" : ((raw_prod_type == "elasticsearch" || raw_prod_type == "es" || raw_prod_type.contains("elasticsearch")) ? "elasticsearch" : ((raw_prod_type == "search" || raw_prod_type == "enterprise_search" || raw_prod_type.contains("search")) ? "search" : "")))).as(prod_type,
                                            (has(prod.product_line_items) && prod.product_line_items != null) ?
                                              prod.product_line_items.filter(li,
                                                has(li.sku) && li.sku != null && (
                                                  li.sku.contains("-vcu") || li.sku.contains(".ecu") || li.sku.contains(".observability.") || li.sku.contains(".security.") ||
                                                  li.sku.startsWith("serverless.search.") || li.sku.startsWith("serverless.") || li.sku.startsWith("observability.") ||
                                                  li.sku.startsWith("security.") || li.sku.startsWith("search.") || li.sku.contains("synthetic") ||
                                                  li.sku.contains(".retained") || ((li.sku == "global.inference-chat-input" || li.sku.contains("inference") || li.sku.contains("agent-builder") || li.sku.contains(".eis") || li.sku.contains("workflow") || li.sku.contains("cross-project")) && has(prod.type) && prod.type != null && string(prod.type) != "" && string(prod.type) != "deployment")
                                                )
                                              ).map(li,
                                                string(li.sku).to_lower().as(ls,
                                                  ((prod_type != "") ? prod_type : ((ls.startsWith("observability.") || ls.startsWith("oblt.") || ls.startsWith("serverless.observability.") || ls.startsWith("serverless.oblt.") || ls.contains("synthetic")) ? "observability" : ((ls.startsWith("security.") || ls.startsWith("sec.") || ls.startsWith("serverless.security.") || ls.startsWith("serverless.sec.")) ? "security" : ((ls.startsWith("elasticsearch.") || ls.startsWith("es.") || ls.startsWith("serverless.elasticsearch.") || ls.startsWith("serverless.es.")) ? "elasticsearch" : ((ls.startsWith("search.") || ls.startsWith("serverless.search.")) ? "search" : "elasticsearch"))))).as(eff_prod_type,
                                                    {
                                                      "sku": string(li.sku),
                                                      "prod_type": prod_type,
                                                      "eff_prod_type": eff_prod_type,
                                                      "item_ecu": (has(li.total_ecu) && li.total_ecu != null) ? double(li.total_ecu) : 0.0,
                                                      "item_qty": (has(li.quantity) && li.quantity != null && has(li.quantity.value) && li.quantity.value != null) ? double(li.quantity.value) : 0.0,
                                                    }
                                                  )
                                                )
                                              )
                                            : []
                                          )
                                        )
                                      ).flatten().as(raw_item_entries,
                                        zip(
                                          raw_item_entries.map(ie, ie.eff_prod_type + "\n" + ie.sku),
                                          raw_item_entries
                                        ).keys().map(ik,
                                          raw_item_entries.filter(ie, (ie.eff_prod_type + "\n" + ie.sku) == ik).as(igrp,
                                            igrp[0].eff_prod_type.as(eff_prod_type,
                                              igrp[0].sku.as(isku,
                                                (igrp.exists(ie, ie.prod_type == "") ? instance_evts.filter(e, e.sku == isku) : instance_evts.filter(e, e.sku == isku && e.project_type == eff_prod_type)).as(matched_evts,
                                                  matched_evts.map(e, e.total_ecu).as(matched_ecus,
                                                    (size(matched_ecus) == 0 ? 0.0 : matched_ecus.sum()).as(day_sku_ecu,
                                                      matched_evts.map(e, e.quantity_value).as(matched_qtys,
                                                        (size(matched_qtys) == 0 ? 0.0 : matched_qtys.sum()).as(day_sku_qty,
                                                          igrp.map(ie, ie.item_ecu).sum().as(item_ecu,
                                                            igrp.map(ie, ie.item_qty).sum().as(item_qty,
                                                              (item_ecu - day_sku_ecu).as(diff_ecu,
                                                                (max(0.0, item_qty - day_sku_qty)).as(diff_qty,
                                                                  (diff_ecu > 0.0001 || (day_sku_ecu == 0.0 && item_qty > 0.0)) ?
                                                                    [
                                                                      {
                                                                        "@timestamp": req.from.format(time_layout.RFC3339),
                                                                        "period_start": req.from.format(time_layout.RFC3339),
                                                                        "project_id": "deleted_or_unassociated_" + eff_prod_type,
                                                                        "project_name": "Deleted / Unassociated (" + eff_prod_type + ")",
                                                                        "project_type": eff_prod_type,
                                                                        "sku": isku,
                                                                        "total_ecu": max(0.0, diff_ecu),
                                                                        "quantity_value": diff_qty,
                                                                        "conf_chargeable_unit_rate": double(state.conf_unit_rate),
                                                                        "conf_chargeable_unit_rate_unit": state.conf_currency_unit,
                                                                        "conf_currency_symbol": state.conf_currency_symbol,
                                                                      }
                                                                    ]
                                                                  : []
                                                                )
                                                              )
                                                            )
                                                          )
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        ).flatten()
                                      )
                                    : []) +
                                    projects.filter(p,
                                      size(sls_instances.filter(inst, has(inst.id) && inst.id == p.id)) == 0
                                    ).map(p,
                                      {
                                        "@timestamp": req.from.format(time_layout.RFC3339),
                                        "period_start": req.from.format(time_layout.RFC3339),
                                        "project_id": p.id,
                                        "project_name": (has(p.name) && p.name != null && p.name != "") ? p.name : p.id,
                                        "project_type": (has(p.project_type) && p.project_type != null && p.project_type != "") ? p.project_type : "elasticsearch",
                                        "sku": "none",
                                        "total_ecu": 0.0,
                                        "quantity_value": 0.0,
                                        "conf_chargeable_unit_rate": double(state.conf_unit_rate),
                                        "conf_chargeable_unit_rate_unit": state.conf_currency_unit,
                                        "conf_currency_symbol": state.conf_currency_symbol,
                                      }
                                    )
                                  ).as(raw_evts,
                                    zip(
                                      raw_evts.map(d, string(d.project_id) + "\n" + string(d.sku)),
                                      raw_evts
                                    ).keys().map(k,
                                      raw_evts.filter(x, (string(x.project_id) + "\n" + string(x.sku)) == k).as(grp,
                                        grp.filter(x, x.project_name != x.project_id).as(named_grp,
                                          (size(named_grp) > 0 ? named_grp[0] : grp[0]).with({
                                            "total_ecu": grp.map(x, x.total_ecu).sum(),
                                            "quantity_value": grp.map(x, x.quantity_value).sum(),
                                          })
                                        )
                                      )
                                    ).as(evts,
                                      {
                                        "events": size(evts) > 0 ? evts : [ { "fake": true } ],
                                        "cursor": { "last_to": req.to.format(time_layout.RFC3339) },
                                        "want_more": req.to + duration("26h") <= now,
                                      }
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            )
          :
            {
              "events": { "error": { "code": string(items_resp.StatusCode), "id": string(items_resp.Status), "message": "GET " + items_resp.Request.URL + ": " + ( (size(items_resp.Body) != 0) ? string(items_resp.Body) : string(items_resp.Status) + " (" + string(items_resp.StatusCode) + ")" ) } },
              "want_more": false,
            }
          )
        )
      :
        {
          "events": { "error": { "code": string(resp.StatusCode), "id": string(resp.Status), "message": "GET " + resp.Request.URL + ": " + ( (size(resp.Body) != 0) ? string(resp.Body) : string(resp.Status) + " (" + string(resp.StatusCode) + ")" ) } },
          "want_more": false,
        }
      )
    )
  )

processors:
- drop_event.when.equals.fake: true
