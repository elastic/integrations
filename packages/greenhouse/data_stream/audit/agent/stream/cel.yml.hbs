interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: {{url}}
state:
  initial_interval: {{initial_interval}}
  token_url: {{token_url}}
  harvest_url: {{harvest_url}}
  client_id: {{client_id}}
  client_secret: {{client_secret}}
  enrich_rejections: {{enrich_rejections}}
{{#if user_id}}
  user_id: "{{user_id}}"
{{/if}}
  batch_size: {{batch_size}}
{{#if performer_ids}}
  performer_ids: "{{performer_ids}}"
{{/if}}
{{#if event_types}}
  event_types: "{{event_types}}"
{{/if}}
  want_more: false
redact:
  fields:
    - client_secret
    - auth_token
{{!--
Greenhouse Audit Log API (Harvest V3 OAuth)

Endpoints:
  POST https://auth.greenhouse.io/token
    - HTTP Basic auth with client_id:client_secret
    - Body: grant_type=client_credentials[&sub=<user_id>]
    - Response: {access_token, expires_at (ISO-8601), token_type}
    - Note: expires_at is non-standard (RFC 6749 uses expires_in),
      so auth.oauth2 cannot manage token refresh — it is done here.

  GET https://auditlog.us.greenhouse.io/events
    - Query: paging=true, after_time, performer_ids, event_types
    - Headers: Authorization (Bearer), Size (page size 100-500),
      Pit-Id + Search-After (for page 2+)
    - Response: {paging: {pit_id, next_search_after}, results: [...]}
    - next_search_after is null on the last page.

Rejection enrichment (optional, enrich_rejections):

  When enabled, rejection events are enriched with data from the Harvest
  API in a collect → fetch → apply pattern:

  1. Collect: identify "Candidate or Prospect rejected" action events and
     correlate each to its sibling "RejectionDetails" audit event via
     request.id. Extract the application_id from unambiguous (1:1) matches.
     The API does not document result ordering, so the sibling may land on
     a neighbouring page. To avoid page-local misses or false 1:1 matches,
     the {request.id, application_id} pairs of every RejectionDetails seen
     are carried in the cursor for two pages (rd_prev, rd_prev2), and each
     rejection action is resolved only after the following page has been
     seen: actions on a page are held in the cursor (pending_actions) for
     exactly one evaluation when more pages follow, or when no sibling was
     found on the final page of a window (it may arrive in the next poll).
     All other events are emitted immediately.

  2. Fetch (batched): a single call to rejection_details retrieves all
     matched application_ids at once; notes are batch-fetched similarly.
     Rejection reasons require individual /{id} calls (the list endpoint
     is broken) but are de-duplicated so each unique reason is fetched
     only once.

  3. Apply: each rejection event is enriched from pre-built lookup maps.
     Events with 0 or >1 RejectionDetails matches get an error instead.

  Endpoints used:
    GET /v3/rejection_details?application_ids=<comma-separated>
    GET /v3/rejection_reasons/{id}
    GET /v3/notes?ids=<comma-separated>

  Required scopes on the OAuth credential:
    harvest:rejection_details:list
    harvest:rejection_reasons:show
    harvest:notes:list

State:
  auth_token — shallow-replaced object holding token and expires.
    Cleared to {} on 401 so the fields are absent, not sentinel-valued.

Cursor:
  window_start_time — frozen after_time used for every request in the
    current window. Advances only when a full window completes.
  max_event_time — newest event_time seen anywhere in the current window.
    Cleared when the window completes; preserved when an expired PIT
    forces a retry of the same window.
  pit_id, search_after — pagination state; cleared between poll intervals.
  rd_prev, rd_prev2 — compact RejectionDetails pairs from the previous two
    pages, used to correlate rejection actions across page boundaries.
  pending_actions — rejection action events held for one evaluation until
    the following page has been seen. Preserved across PIT-expiry retries
    (duplicates are collapsed by the ingest pipeline fingerprint).
--}}
program: |-
  // 1. Resolve auth token (sequential state pipeline — avoids nesting the event fetch inside the auth block).
  (
    (
      state.?auth_token.token.hasValue() &&
      state.?auth_token.expires.optMap(expires, timestamp(expires) >= now + duration("30s")).orValue(false)
    ) ?
      state
    :
      request("POST", state.token_url).with(
        {
          "Header": {
            "Content-Type": ["application/x-www-form-urlencoded"],
            "Authorization": ["Basic " + base64(state.client_id + ":" + state.client_secret)],
          },
          "Body": bytes(
            {
              "grant_type": ["client_credentials"],
              ?"sub": state.?user_id.optFlatMap(v,
                (v != "") ? optional.of([v]) : optional.none()
              ),
            }.format_query()
          ),
        }
      ).do_request().as(resp,
        (resp.StatusCode == 200) ?
          state.with(
            resp.Body.decode_json().as(tok,
              {
                "auth_token": {
                  "token": tok.access_token,
                  "expires": tok.expires_at,
                },
              }
            )
          )
        :
          state.with(
            {
              "events": {
                "error": {
                  "code": string(resp.StatusCode),
                  "id": string(resp.Status),
                  "message": "POST " + state.token_url + ": " + (
                    (size(resp.Body) != 0) ?
                      string(resp.Body)
                    :
                      string(resp.Status) + " (" + string(resp.StatusCode) + ")"
                  ),
                },
              },
              "want_more": false,
            }
          )
      )
  ).as(state,
    // Exit early if auth failed.
    has(state.events) ? state :
    // 2. Determine the start of the current collection window.
    state.?cursor.window_start_time.orValue(
      (now - duration(state.initial_interval)).format(time_layout.RFC3339)
    ).as(window_start_time,
      state.with(
        request(
          "GET",
          state.url.trim_right("/") + "/events?" + {
            "paging": ["true"],
            "after_time": [window_start_time],
            ?"performer_ids": state.?performer_ids.optFlatMap(v,
              (v != "") ? optional.of([v]) : optional.none()
            ),
            ?"event_types": state.?event_types.optFlatMap(v,
              (v != "") ? optional.of([v]) : optional.none()
            ),
          }.format_query()
        ).with(
          {
            "Header": {
              "Authorization": ["Bearer " + state.auth_token.token],
              "Size": [string(int(state.batch_size))],
              ?"Pit-Id": state.?cursor.pit_id.optFlatMap(v,
                (v != "") ? optional.of([v]) : optional.none()
              ),
              ?"Search-After": state.?cursor.search_after.optFlatMap(v,
                (v != "") ? optional.of([v]) : optional.none()
              ),
            },
          }
        ).do_request().as(resp,
          (resp.StatusCode == 200) ?
            resp.Body.decode_json().as(body,
              // 3. Collect: page metadata, the RejectionDetails seen on this page, and the
              //    rejection action events that need correlating.
              {
                "results": body.?results.orValue([]),
                "has_more": body.?paging.next_search_after.orValue(null) != null,
                "harvest_hdr": {"Header": {"Authorization": ["Bearer " + state.auth_token.token]}},
                "next_max": state.?cursor.max_event_time.orValue("").as(prev_max,
                  (size(body.?results.orValue([])) > 0 && (prev_max == "" || timestamp(body.?results.orValue([])[0].event_time) > timestamp(prev_max))) ?
                    body.?results.orValue([])[0].event_time
                  :
                    prev_max
                ),
                // Compact {request.id, application_id} pairs for the RejectionDetails on this page.
                "rd_now": !state.enrich_rejections ? [] :
                  body.?results.orValue([]).filter(rd_e,
                    rd_e.?event.target_type.orValue("") == "RejectionDetails" &&
                    rd_e.?event.type.orValue("") == "data_change_create" &&
                    has(rd_e.?event.meta.application_id) &&
                    rd_e.?request.id.orValue("") != ""
                  ).map(rd_e, {"r": rd_e.request.id, "a": string(int(rd_e.event.meta.application_id))}),
                // Rejection action events on this page (empty when enrichment is disabled).
                "acts_now": body.?results.orValue([]).filter(e,
                  state.enrich_rejections && e.?event.type.orValue("") == "action" &&
                  e.?event.target_type.orValue("") == "Candidate or Prospect rejected"
                ),
                // Everything else is emitted unchanged. If enrichment was switched off while
                // actions were held, release them unchanged too.
                "passthrough": body.?results.orValue([]).filter(e,
                  !(
                    state.enrich_rejections && e.?event.type.orValue("") == "action" &&
                    e.?event.target_type.orValue("") == "Candidate or Prospect rejected"
                  )
                ) + (state.enrich_rejections ? [] : state.?cursor.pending_actions.orValue([])),
                // Rejection actions held from the previous evaluation; all of their neighbouring
                // pages have now been seen, so they are resolved in this evaluation.
                "held": state.enrich_rejections ? state.?cursor.pending_actions.orValue([]) : [],
              }.as(pg,
                // 4. Correlate against the RejectionDetails from the previous two pages and this one.
                //    Actions on this page are held for one more evaluation when more pages follow,
                //    or when no sibling was found on the final page of a window (it may arrive in the
                //    next poll). An action is never held for more than one evaluation.
                (state.?cursor.rd_prev2.orValue([]) + state.?cursor.rd_prev.orValue([]) + pg.rd_now).as(rd_all,
                  (pg.held + pg.acts_now).transformList(i, e,
                    // Unique application IDs sharing this action's request.id. Dedup protects the
                    // count when a PIT-expiry retry re-reads a page already carried in rd_prev.
                    rd_all.filter(rd,
                      e.?request.id.orValue("") != "" && rd.r == e.?request.id.orValue("")
                    ).map(rd, rd.a).as(ids, ids.zip(ids).keys()).as(m,
                      {
                        "e": e,
                        "n": m.size(),
                        "app_id": (m.size() == 1) ? m[0] : "",
                        "ambiguous_ids": (m.size() > 1) ? m : [],
                        "hold": i >= pg.held.size() && (pg.has_more || m.size() == 0),
                      }
                    )
                  ).as(corr,
                    {
                      "resolve": corr.filter(c, !c.hold),
                      "hold": corr.filter(c, c.hold).map(c, c.e),
                    }.as(cx,
                      // 5. Fetch: batch-retrieve rejection_details for all unambiguous matches.
                      (cx.resolve.filter(c, c.n == 1).size() > 0 ?
                        request(
                          "GET",
                          state.harvest_url.trim_right("/") + "/v3/rejection_details?application_ids=" +
                          cx.resolve.map(c, c.n == 1, c.app_id).as(ids, ids.zip(ids).keys().join(","))
                        ).with(pg.harvest_hdr).do_request().as(rd_resp,
                          {"status": rd_resp.StatusCode, "data": (rd_resp.StatusCode == 200) ? rd_resp.Body.decode_json() : []}
                        )
                      :
                        {"status": 200, "data": []}
                      ).as(rd_fetch,
                        // Build lookup maps keyed by application_id, rejection reason id, and note id.
                        {
                          "rd_map": rd_fetch.data.transformMapEntry(_, rd,
                            {string(int(rd.application_id)): rd}
                          ),
                          "reason_map": rd_fetch.data.map(rd, rd.?rejection_reason_id.orValue(null) != null, string(int(rd.rejection_reason_id))).as(rr_ids,
                            // Deduplicate: zip with self produces {id: id} map; keys() extracts the unique ids.
                            rr_ids.zip(rr_ids).keys()
                          ).as(unique_rr_ids,
                            unique_rr_ids.size() > 0 ?
                              unique_rr_ids.map(id,
                                request(
                                  "GET",
                                  state.harvest_url.trim_right("/") + "/v3/rejection_reasons/" + id
                                ).with(pg.harvest_hdr).do_request().as(rr_resp,
                                  (rr_resp.StatusCode == 200) ?
                                    {"id": id, "val": rr_resp.Body.decode_json()}
                                  :
                                    {"id": id, "error": "rejection_reason fetch failed: HTTP " + string(rr_resp.StatusCode)}
                                )
                              ).transformMapEntry(_, r, {r.id: has(r.val) ? r.val : {"_error": r.error}})
                            :
                              {}
                          ),
                          "note_map": rd_fetch.data.map(rd, rd.?rejection_note_id.orValue(null) != null, string(int(rd.rejection_note_id))).as(note_ids,
                            note_ids.size() > 0 ?
                              request(
                                "GET",
                                state.harvest_url.trim_right("/") + "/v3/notes?ids=" + note_ids.zip(note_ids).keys().join(",")
                              ).with(pg.harvest_hdr).do_request().as(n_resp,
                                n_resp.StatusCode == 200 ?
                                  n_resp.Body.decode_json().transformMapEntry(_, note, {string(int(note.id)): note.?body.orValue("")})
                                : {"_error": "notes fetch failed: HTTP " + string(n_resp.StatusCode)}
                              )
                            : {}
                          ),
                        }.as(lookups,
                          // 6. Apply: emit passthrough events unchanged and resolved rejections enriched.
                          {
                            "auth_token": state.auth_token,
                            "events": pg.passthrough.map(e, {"message": e.encode_json()}) + cx.resolve.map(c,
                              {
                                "message": c.e.as(e,
                                  (c.n == 0) ?
                                    e.with(
                                      {
                                        "event": e.event.with(
                                          {
                                            "rejection": {
                                              "error": "no RejectionDetails audit event found sharing request.id " + e.?request.id.orValue(""),
                                            },
                                          }
                                        ),
                                      }
                                    )
                                  : (c.n > 1) ?
                                    e.with(
                                      {
                                        "event": e.event.with(
                                          {
                                            "rejection": {
                                              "error": "ambiguous: " + string(c.n) + " RejectionDetails events share request.id " + e.?request.id.orValue("") + " (likely a bulk rejection)",
                                              "ambiguous_application_ids": c.ambiguous_ids,
                                            },
                                          }
                                        ),
                                      }
                                    )
                                  :
                                    c.app_id.as(app_id,
                                      (rd_fetch.status != 200) ?
                                        e.with(
                                          {
                                            "event": e.event.with(
                                              {
                                                "rejection": {
                                                  "application_id": app_id,
                                                  "error": "rejection_details fetch failed: " + string(rd_fetch.status),
                                                },
                                              }
                                            ),
                                          }
                                        )
                                      : !(app_id in lookups.rd_map) ?
                                        // API returned 200 but no record for this application — flag as a diagnosable failure.
                                        e.with(
                                          {
                                            "event": e.event.with(
                                              {
                                                "rejection": {
                                                  "application_id": app_id,
                                                  "error": "rejection_details returned 200 but contained no record for application_id " + app_id,
                                                },
                                              }
                                            ),
                                          }
                                        )
                                      :
                                        lookups.rd_map[app_id].as(rd,
                                          {
                                            "reason": rd.?rejection_reason_id.orValue(null).as(rr_id,
                                              (rr_id != null) ? lookups.reason_map[?string(int(rr_id))].orValue(null) : null
                                            ),
                                            "notes_text": rd.?rejection_note_id.orValue(null).as(rn_id,
                                              (rn_id != null) ? lookups.note_map[?string(int(rn_id))].orValue("") : ""
                                            ),
                                            // Non-empty when the batch notes fetch returned non-200.
                                            "note_error": lookups.note_map[?"_error"].orValue(""),
                                          }.as(enrich,
                                            e.with(
                                              {
                                                "event": e.event.with(
                                                  {
                                                    "rejection": {
                                                      "application_id": app_id,
                                                      ?"candidate_id": (rd.?candidate_id.orValue(null) == null) ?
                                                        optional.none()
                                                      :
                                                        optional.of(string(int(rd.candidate_id))),
                                                      ?"reason": (enrich.reason == null) ?
                                                        // No rejection_reason_id on the record; try the legacy notes fallback.
                                                        // Parenthesised: CEL only allows a nested ternary in the true branch when wrapped.
                                                        (
                                                          enrich.notes_text.startsWith("Reason: ") ?
                                                            optional.of(
                                                              {
                                                                "name": enrich.notes_text.split("\n")[0].trim_prefix("Reason: "),
                                                                "type": "",
                                                              }
                                                            )
                                                          : optional.none()
                                                        )
                                                      : ("_error" in enrich.reason) ?
                                                        // Reason lookup failed; surface the error so it's diagnosable.
                                                        optional.of({"error": enrich.reason["_error"]})
                                                      :
                                                        optional.of(
                                                          {
                                                            "id": string(int(enrich.reason.id)),
                                                            "name": enrich.reason.name,
                                                            "type": enrich.reason.?type.?name.orValue(""),
                                                          }
                                                        ),
                                                      ?"notes": (enrich.notes_text == "") ? optional.none() : optional.of(enrich.notes_text),
                                                      ?"notes_error": (enrich.note_error == "") ? optional.none() : optional.of(enrich.note_error),
                                                      ?"rejected_at": rd.?rejected_at,
                                                    },
                                                  }
                                                ),
                                              }
                                            )
                                          )
                                        )
                                    )
                                ).encode_json(),
                              }
                            ),
                            "cursor": {
                              "window_start_time": (pg.has_more || pg.next_max == "") ?
                                window_start_time
                              :
                                pg.next_max,
                              "max_event_time": pg.has_more ? pg.next_max : "",
                              "pit_id": pg.has_more ? string(body.paging.pit_id) : "",
                              "search_after": pg.has_more ? string(body.paging.next_search_after) : "",
                              "rd_prev": pg.rd_now,
                              "rd_prev2": state.?cursor.rd_prev.orValue([]),
                              "pending_actions": cx.hold,
                            },
                            "want_more": pg.has_more,
                          }
                        )
                      )
                    )
                  )
                )
              )
            )
          : (resp.StatusCode == 401) ?
            {
              "auth_token": {},
              "events": [],
              "want_more": false,
            }
          : (resp.StatusCode == 429) ?
            {
              "events": [],
              "want_more": false,
            }
          : string(resp.Body).contains("Pit_Id") ?
            {
              "auth_token": state.auth_token,
              "events": [{"retry": true}],
              "cursor": {
                "window_start_time": window_start_time,
                "max_event_time": state.?cursor.max_event_time.orValue(""),
                "pit_id": "",
                "search_after": "",
                "rd_prev": state.?cursor.rd_prev.orValue([]),
                "rd_prev2": state.?cursor.rd_prev2.orValue([]),
                "pending_actions": state.?cursor.pending_actions.orValue([]),
              },
              "want_more": false,
            }
          :
            {
              "events": {
                "error": {
                  "code": string(resp.StatusCode),
                  "id": string(resp.Status),
                  "message": "GET /events: " + ((size(resp.Body) != 0) ? string(resp.Body) : string(resp.Status)),
                },
              },
              "want_more": false,
            }
        )
      )
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
processors:
- drop_event:
    when:
      equals:
        retry: true
{{#if processors}}
{{processors}}
{{/if}}
