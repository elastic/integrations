config_version: 2
interval: {{interval}}
request.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/httpjson/http-request-trace-*.ndjson"
  maxbackups: 5
auth.oauth2.client.id: {{client_id}}
auth.oauth2.client.secret: {{client_secret}}
auth.oauth2.token_url: {{login_url}}/{{tenant_id}}/{{token_endpoint}}
auth.oauth2.scopes: {{request_url}}/.default
{{#if oauth_endpoint_params}}
auth.oauth2.endpoint_params: {{oauth_endpoint_params}}
{{/if}}
request.url: {{request_url}}/v1.0/security/incidents
{{#if http_client_timeout}}
request.timeout: {{http_client_timeout}}
{{/if}}
{{#if proxy_url}}
request.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
request.ssl: {{ssl}}
{{/if}}
request.transforms:
  - set:
      target: url.params.$top
      value: {{batch_size}}
  - set:
      target: url.params.$skip
      value: 0
  - set:
      target: url.params.$filter
      value: 'lastUpdateDateTime ge [[.cursor.last_update_time]]'
      default: 'lastUpdateDateTime ge [[formatDate (now (parseDuration "-{{initial_interval}}"))]]'
  - set:
      target: url.params.$orderby
      value: 'lastUpdateDateTime asc'
{{#if include_alerts}}
  - set:
      target: url.params.$expand
      value: 'alerts'
{{/if}}
response.pagination:
  # The Graph security API caps $skip at 500 and $top at 1000, and incidents do
  # not return @odata.nextLink, so we cannot page with a growing $skip offset.
  # Instead, keep $skip at 0 and advance the $filter time boundary: on a full page
  # (len == batch_size) move to 'lastUpdateDateTime gt <max lastUpdateDateTime in
  # page>' (the last element, since $orderby is ascending). A non-full page renders
  # an empty value, which stops pagination.
  # https://github.com/microsoftgraph/microsoft-graph-docs-contrib/blob/main/api-reference/beta/resources/security-error-codes.md#constraints
  - set:
      target: url.params.$filter
      value: '[[if (eq (len .last_response.body.value) {{batch_size}})]]lastUpdateDateTime gt [[(index .last_response.body.value (add (toInt (len .last_response.body.value)) -1)).lastUpdateDateTime]][[end]]'
      fail_on_template_error: true
      do_not_log_failure: true
  - set:
      target: url.params.$skip
      value: '0'
      fail_on_template_error: true
      do_not_log_failure: true
response.split:
  target: body.value
  ignore_empty_value: true
{{#if include_alerts}}
  split:
    target: body.alerts
    keep_parent: true
{{/if}}
cursor:
  last_update_time:
    value: >-
      [[- if index .last_event "lastUpdateDateTime" -]]
        [[- .last_event.lastUpdateDateTime -]]
      [[- end -]]
    fail_on_template_error: true
    do_not_log_failure: true
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#if preserve_duplicate_custom_fields}}
  - preserve_duplicate_custom_fields
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
