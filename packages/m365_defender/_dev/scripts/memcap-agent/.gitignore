# Harness scratch - never commit. `work/` alone can hold a multi-hundred-MB corpus, and
# `logs/` holds the console output of every run. Re-run the harness to regenerate them.
# Measurements worth keeping are promoted to results/, which IS committed.
logs/
work/

# Belt and braces: nothing here should ever read a tenant response, but if someone drops
# one in to compare against, keep it out of the repo.
samples/

__pycache__/
