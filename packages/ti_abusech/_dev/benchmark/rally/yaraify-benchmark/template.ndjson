{{- $timestamp := generate "timestamp" -}}
{{- $expireDur := generate "expire_dur" -}}
{{- $hostname := generate "host.name" -}}
{{- $agentId := generate "agent.id" -}}
{{- $duration_start := generate "duration_start" -}}
{{- $firstSeen := ($timestamp | date_modify (print $duration_start)).Format "2006-01-02T15:04:05Z" -}}
{{- $dateWritten := ($timestamp | date_modify "-240h").Format "2006-01-02" -}}
{{- $author := generate "author" -}}
{{- $description := generate "description" -}}
{{- $malpedia := generate "malpedia_family" -}}
{{- $ruleName := generate "rule_name" -}}
{{- $twitter := generate "yarahub_author_twitter" -}}
{{- $license := generate "yarahub_license" -}}
{{- $refLink := generate "yarahub_reference_link" -}}
{{- $refMd5 := generate "yarahub_reference_md5" -}}
{{- $matchTlp := generate "yarahub_rule_matching_tlp" -}}
{{- $shareTlp := generate "yarahub_rule_sharing_tlp" -}}
{{- $uuid := generate "yarahub_uuid" -}}
{
  "@timestamp": "{{ $timestamp.Format "2006-01-02T15:04:05.999999Z07:00" }}",
  "_conf": {
    "ioc_expiration_duration": "{{ $expireDur }}d"
  },
  "agent": {
    "id": "{{$agentId}}",
    "name": "{{$hostname}}",
    "type": "filebeat",
    "version": "8.18.0",
    "ephemeral_id": "{{$agentId}}"
  },
  "data_stream": {
    "namespace": "ep",
    "type": "logs",
    "dataset": "ti_abusech.yaraify"
  },
  "elastic_agent": {
    "id": "60a22c30-4c80-4e95-b5b1-87ff540d8afd",
    "snapshot": false,
    "version": "8.18.0"
  },
  "message": "{\"author\": \"{{ $author }}\",\"date_written\": \"{{ $dateWritten }}\",\"description\": \"detects {{ $description }}\",\"first_seen\": \"{{ $firstSeen }}\",\"malpedia_family\": \"win.{{ $malpedia }}\",\"rule_name\": \"win_{{ $ruleName }}\",\"yarahub_author_twitter\": \"@{{ $twitter }}\",\"yarahub_license\": \"{{ $license }}\",\"yarahub_reference_link\": \"https://example.com/research/{{ $refLink }}\",\"yarahub_reference_md5\": \"{{ $refMd5 }}\",\"yarahub_rule_matching_tlp\": \"{{ $matchTlp }}\",\"yarahub_rule_sharing_tlp\": \"{{ $shareTlp }}\",\"yarahub_uuid\": \"{{ $uuid }}\"}",
  "event": {
    "dataset": "ti_abusech.yaraify"
  },
  "input": {
    "type": "cel"
  },
  "tags": [
    "preserve_original_event",
    "forwarded",
    "abusech-yaraify"
  ]
}
