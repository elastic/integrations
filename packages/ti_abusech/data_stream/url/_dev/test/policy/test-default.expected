inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: ti_abusech
      name: test-default-ti_abusech
      streams:
        - config_version: 2
          data_stream:
            dataset: ti_abusech.url
          fields:
            _conf:
                ioc_expiration_duration: 90d
          fields_under_root: true
          interval: 10m
          program: |
            state.?commercial_url.orValue(state.url).trim_right("/").as(base_url,
              (
                has(state.?cursor.after) ?
                  state.cursor.since
                :
                  state.?cursor.first_seen.orValue(
                    state.?cursor.since.orValue(
                      (now - duration(state.initial_interval)).format(time_layout.RFC3339)
                    )
                  )
              ).as(since,
                state.with(
                  state.?api_type.orValue("community") == "commercial" ?
                    (
                      !has(state.username) || !has(state.password) ?
                        {
                          "events": {
                            "error": {
                              "code": "400",
                              "id": "configuration_error",
                              "message": "api_type is 'commercial' but username/password are not configured",
                            },
                          },
                          "want_more": false,
                        }
                      :
                        (
                          has(state.?token.access_token) && has(state.?token.expires) && now() < timestamp(int(state.token.expires) - 60) ?
                            state.token
                          :
                            request(
                              "POST",
                              base_url + "/v1/login",
                              {
                                "username": state.username,
                                "password": state.password,
                                "realm": "abusech",
                              }.encode_json()
                            ).with(
                              {
                                "Header": {
                                  "Content-Type": ["application/json"],
                                },
                              }
                            ).do_request().as(auth_resp, auth_resp.StatusCode == 200 ?
                              auth_resp.Body.decode_json().as(auth_body,
                                {
                                  "access_token": auth_body.token,
                                  "expires": auth_body.expires,
                                }
                              )
                            :
                              {
                                "events": {
                                  "error": {
                                    "code": string(auth_resp.StatusCode),
                                    "id": auth_resp.Status,
                                    "message": "POST " + base_url + "/v1/login: " + (
                                      size(auth_resp.Body) != 0 ?
                                        string(auth_resp.Body)
                                      :
                                        auth_resp.Status + " (" + string(auth_resp.StatusCode) + ")"
                                    ),
                                  },
                                },
                                "want_more": false,
                              }
                            )
                        ).as(token, !has(token.access_token) ?
                          token
                        :
                          request(
                            "GET",
                            base_url + "/urlhaus/v1/urls?" + {
                              "since": [since],
                              "page_size": [string(state.page_size)],
                              ?"after": state.?cursor.after.optMap(v, [v]),
                            }.format_query()
                          ).with(
                            {
                              "Header": {
                                "Authorization": ["Bearer " + token.access_token],
                              },
                            }
                          ).do_request().as(resp, resp.StatusCode == 200 ?
                            resp.Body.decode_json().as(body,
                              {
                                "events": body.items.map(ind,
                                  {
                                    "message": ind.encode_json(),
                                  }
                                ),
                                "want_more": has(body.?meta.next_cursor),
                                "cursor": {
                                  "since": since,
                                  ?"after": has(body.?meta.next_cursor) ? optional.of(body.meta.next_cursor) : optional.none(),
                                  ?"first_seen": (
                                    body.items.size() > 0 ?
                                      optional.of(
                                        (
                                          has(state.?cursor.first_seen) ?
                                            max(timestamp(state.cursor.first_seen), body.items.map(ind, timestamp(ind.first_seen)).max())
                                          :
                                            body.items.map(ind, timestamp(ind.first_seen)).max()
                                        ).format(time_layout.RFC3339)
                                      )
                                    :
                                      state.?cursor.first_seen
                                  ),
                                },
                                "token": {
                                  "access_token": token.access_token,
                                  "expires": token.expires,
                                },
                              }
                            )
                          :
                            {
                              "events": {
                                "error": {
                                  "code": string(resp.StatusCode),
                                  "id": resp.Status,
                                  "message": "GET " + base_url + "/urlhaus/v1/urls: " + (
                                    size(resp.Body) != 0 ?
                                      string(resp.Body)
                                    :
                                      resp.Status + " (" + string(resp.StatusCode) + ")"
                                  ),
                                },
                              },
                              "want_more": false,
                            }
                          )
                        )
                    )
                  : state.url.contains("/downloads/json") ?
                    {
                      "events": {
                        "error": {
                          "code": "400",
                          "id": "configuration_error",
                          "message": "the URL is set to the deprecated full export endpoint (/downloads/json) which is no longer supported. Update the URL setting to https://urlhaus-api.abuse.ch/v1/urls/recent/",
                        },
                      },
                      "want_more": false,
                    }
                  : duration(state.interval_value) > duration("72h") ?
                    {
                      "events": {
                        "error": {
                          "code": "400",
                          "id": "configuration_error",
                          "message": "the polling interval (" + state.interval_value + ") exceeds the 3-day window of the URLhaus recent API. Reduce the interval to 72h or less to avoid missing data.",
                        },
                      },
                      "want_more": false,
                    }
                  : !has(state.auth_key) ?
                    {
                      "events": {
                        "error": {
                          "code": "400",
                          "id": "configuration_error",
                          "message": "api_type is 'community' but auth_key is not configured",
                        },
                      },
                      "want_more": false,
                    }
                  :
                    request("GET", state.url).with(
                      {
                        "Header": {
                          "Content-Type": ["application/json"],
                          "Auth-Key": [state.auth_key],
                        },
                      }
                    ).as(req,
                      req.do_request().as(resp, resp.StatusCode == 200 ?
                        resp.Body.decode_json().as(body,
                          {
                            "events": has(body.urls) ?
                              body.urls.map(u, {"message": u.encode_json()})
                            :
                              [],
                          }
                        )
                      :
                        {
                          "events": {
                            "error": {
                              "code": string(resp.StatusCode),
                              "id": resp.Status,
                              "message": "GET " + state.url.trim_right("/") + ":" + (
                                size(resp.Body) != 0 ?
                                  string(resp.Body)
                                :
                                  resp.Status + " (" + string(resp.StatusCode) + ")"
                              ),
                            },
                          },
                          "want_more": false,
                        }
                      )
                    )
                )
              )
            )
          publisher_pipeline.disable_host: true
          redact:
            fields:
                - auth_key
                - password
                - token.access_token
          resource.timeout: 30s
          resource.tracer:
            enabled: false
            filename: ../../logs/cel/http-request-trace-*.ndjson
            maxbackups: 5
          resource.url: https://urlhaus-api.abuse.ch/v1/urls/recent/
          state:
            api_type: community
            auth_key: ${SECRET_0}
            commercial_url: https://api.spamhaus.com
            initial_interval: 24h
            interval_value: 10m
            page_size: 100
          tags:
            - forwarded
            - abusech-url
      type: cel
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-ti_abusech.url-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references:
    - {}
