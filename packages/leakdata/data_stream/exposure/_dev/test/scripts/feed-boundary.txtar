# Fail-closed privacy paths are script tests because the pipeline runner
# rejects any expected error.message as an unexpected pipeline error.
use_stack -profile ${CONFIG_PROFILES}/${PROFILE}
install_pipelines -profile ${CONFIG_PROFILES}/${PROFILE} ${DATA_STREAM_ROOT}
simulate -profile ${CONFIG_PROFILES}/${PROFILE} ${DATA_STREAM_ROOT} default reject-extra.json
cp stdout actual-reject-extra.json
exec jq -e --slurpfile expected expected-reject-extra.json -f assertion.jq actual-reject-extra.json
stdout true
simulate -profile ${CONFIG_PROFILES}/${PROFILE} ${DATA_STREAM_ROOT} default malformed.json
cp stdout actual-malformed.json
exec jq -e --slurpfile expected expected-malformed.json -f assertion.jq actual-malformed.json
stdout true
uninstall_pipelines -profile ${CONFIG_PROFILES}/${PROFILE} ${DATA_STREAM_ROOT}

-- assertion.jq --
. == $expected[0]
-- reject-extra.json --
{
  "@timestamp": "2026-08-14T10:05:00.000Z",
  "tags": [
    "preserve_original_event"
  ],
  "message": "{\"@timestamp\":\"2026-08-14T10:00:00.000Z\",\"ecs\":{\"version\":\"9.4.0\"},\"event\":{\"id\":\"leakdata-elastic-synthetic-example\",\"kind\":\"alert\",\"category\":[\"threat\"],\"type\":[\"indicator\"],\"action\":\"verified-exposure-detected\",\"module\":\"leakdata\",\"dataset\":\"leakdata.exposure\",\"severity\":90,\"risk_score\":90,\"risk_score_norm\":90,\"created\":\"2026-08-14T10:00:00.000Z\"},\"message\":\"LeakData detected 2 new verified exposure sources at or above the configured threshold. This event contains no monitored identity, source name, credential, exposed value, or raw record.\",\"observer\":{\"vendor\":\"LeakData\",\"product\":\"Exposure Monitoring\",\"type\":\"saas\"},\"rule\":{\"id\":\"leakdata-verified-exposure-v1\",\"name\":\"Verified identity exposure\",\"category\":\"Data Exposure\",\"ruleset\":\"LeakData verified exposure policy\",\"version\":\"1\"},\"tags\":[\"leakdata\",\"verified-exposure\",\"privacy-minimized\"],\"leakdata\":{\"exposure\":{\"finding_count\":2,\"minimum_severity\":\"high\",\"maximum_severity\":\"critical\",\"evidence_scope\":\"verified_source_and_verified_email_ownership\",\"contains_personal_data\":false}},\"email\":\"synthetic-rejected@example.invalid\"}"
}
-- expected-reject-extra.json --
{
  "@timestamp": "2026-08-14T10:05:00.000Z",
  "tags": [
    "preserve_original_event"
  ],
  "event": {
    "kind": "pipeline_error",
    "module": "leakdata",
    "dataset": "leakdata.exposure"
  },
  "error": {
    "message": "LeakData feed event could not be parsed or was outside the allowlist."
  }
}
-- malformed.json --
{
  "@timestamp": "2026-08-14T10:05:00.000Z",
  "tags": [
    "preserve_original_event"
  ],
  "message": "{invalid JSON with Bearer synthetic-not-a-credential"
}
-- expected-malformed.json --
{
  "@timestamp": "2026-08-14T10:05:00.000Z",
  "tags": [
    "preserve_original_event"
  ],
  "event": {
    "kind": "pipeline_error",
    "module": "leakdata",
    "dataset": "leakdata.exposure"
  },
  "error": {
    "message": "LeakData feed event could not be parsed or was outside the allowlist."
  }
}
