inputs:
    - data_stream:
        namespace: ep
      meta:
        package:
            name: microsoft_intune
      name: test-all-microsoft_intune
      streams:
        - authority_host: https://login.microsoftonline.us
          connection_string: ${SECRET_0}
          consumer_group: $Default
          data_stream:
            dataset: microsoft_intune.managed_device
          eventhub: example
          processor_start_position: latest
          processor_version: v1
          processors:
            - add_fields:
                fields:
                    id: "574734885120952459"
                    name: myproject
                target: project
            - add_tags:
                tags:
                    - web
                    - production
                target: environment
          publisher_pipeline.disable_host: true
          resource_manager_endpoint: https://example.com
          storage_account: default
          storage_account_connection_string: ${SECRET_2}
          storage_account_container: container
          storage_account_key: ${SECRET_1}
          tags:
            - preserve_original_event
            - preserve_duplicate_custom_fields
            - forwarded
            - microsoft_intune-managed_device
            - test-policy
          transport: amqp
      type: azure-eventhub
      use_output: default
output_permissions:
    default:
        _elastic_agent_checks:
            cluster:
                - monitor
        _elastic_agent_monitoring:
            indices: []
        uuid-for-permissions-on-related-indices:
            indices:
                - names:
                    - logs-microsoft_intune.managed_device-ep
                  privileges:
                    - auto_configure
                    - create_doc
secret_references:
    - {}
    - {}
    - {}
