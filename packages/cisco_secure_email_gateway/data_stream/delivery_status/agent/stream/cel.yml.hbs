interval: {{interval}}
{{#if enable_request_tracer}}
resource.tracer.filename: "../../logs/cel/http-request-trace-*.ndjson"
resource.tracer.maxbackups: 5
{{/if}}
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: "http://localhost"
redact.fields:
  - password
state:
  username: {{{username}}}
  password: {{{password}}}
  hosts:
{{#each hosts}}
    - {{this}}
{{/each}}
program: |-
  {
    "events": state.hosts.map(host,
      !host.contains("://") ?
        [
          {
            "error": {
              "code": "400",
              "id": "invalid_url",
              "message": "Host URL must include a scheme (http:// or https://): " + host,
            },
            "host.name": host,
          },
        ]
      :
        host.split("://").as(parts,
          parts[1].split("/")[0].split("@").as(userhost,
            userhost[size(userhost) - 1].as(hostport,
              (hostport.startsWith("[") ? hostport.split("]")[0] + "]" : hostport.split(":")[0]).as(name,
                [
                  try(
                    request("GET", parts[0] + "://" + hostport + "/esa/api/v2.0/health/delivery_status").with(
                      {
                        "Header": {
                          "Accept": ["application/json"],
                          "cache-control": ["no-cache"],
                          "Authorization": ["Basic " + bytes(state.username + ":" + state.password).base64()],
                        },
                      }
                    ).do_request()
                  ),
                ].map(resp,
                  (type(resp) == type("")) ?
                    [
                      {
                        "error": {
                          "code": "transport_error",
                          "id": "transport_error",
                          "message": resp,
                        },
                        "host.name": name,
                      },
                    ]
                  : (resp.StatusCode == 200) ?
                    try(decode_json(resp.Body)).as(body,
                      (type(body) == type("") || !has(body.data) || !has(body.data.resultSet)) ?
                        [
                          {
                            "error": {
                              "code": "decode_error",
                              "id": "decode_error",
                              "message": "GET " + parts[0] + "://" + hostport + "/esa/api/v2.0/health/delivery_status: unexpected response body",
                            },
                            "host.name": name,
                          },
                        ]
                      :
                        body.data.resultSet.map(domain,
                          {
                            "message": domain.encode_json(),
                            "host.name": name,
                          }
                        )
                    )
                  :
                    [
                      {
                        "error": {
                          "code": string(resp.StatusCode),
                          "id": string(resp.Status),
                          "message": "GET " + parts[0] + "://" + hostport + "/esa/api/v2.0/health/delivery_status: " + ((size(resp.Body) != 0) ? string(resp.Body) : string(resp.Status)),
                        },
                        "host.name": name,
                      },
                    ]
                )[0]
              )
            )
          )
        )
    ).flatten(),
    "hosts": state.hosts,
    "username": state.username,
    "password": state.password,
    "want_more": false,
  }
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
