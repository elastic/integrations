metricsets: ["node"]
hosts:
{{#each hosts}}
  - {{this}}
{{/each}}
period: {{period}}
{{#if timeout}}
timeout: {{timeout}}
{{/if}}
nodes:
{{nodes}}
security_policy: {{security_policy}}
security_mode: {{security_mode}}
{{#if username}}
username: {{username}}
{{/if}}
{{#if password}}
password: {{password}}
{{/if}}
{{#if client_certificate}}
client_certificate: {{client_certificate}}
{{/if}}
{{#if client_key}}
client_key: {{client_key}}
{{/if}}
{{#if application_uri}}
application_uri: {{application_uri}}
{{/if}}
{{#if tags}}
tags:
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{/if}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
{{#if condition}}
condition: {{condition}}
{{/if}}
