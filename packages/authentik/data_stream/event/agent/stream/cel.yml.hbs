config_version: 2
interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: {{url}}
state:
  page_size: {{page_size}}
  api_token: {{api_token}}
  page: 1
  initial_interval: {{initial_interval}}
  want_more: false
{{#if custom_filter}}
  custom_filter: {{escape_string custom_filter}}
{{/if}}
redact:
  fields:
    - api_token
program: |
  // Pages backwards from newest to oldest, stopping when it reaches events
  // it knows it has already seen (before the cursor). The cursor keeps
  // its previous value until the last page of a pagination sequence, so a
  // restart part way through repeats the sequence rather than skipping
  // events.
  state.with(
    (
      state.want_more ?
        state
      :
        state.with({
          "cutoff": state.?cursor.last_timestamp.orValue(
            (now - duration(state.initial_interval)).format(time_layout.RFC3339Nano)
          ),
          "cutoff_ids": state.?cursor.last_ids.orValue([]),
          "newest_timestamp": state.?cursor.last_timestamp.orValue(
            (now - duration(state.initial_interval)).format(time_layout.RFC3339Nano)
          ),
          "newest_ids": state.?cursor.last_ids.orValue([]),
        })
    ).as(state,
      request(
        "GET",
        state.url.trim_right("/") + "/api/v3/events/events/?" + {
          "page_size": [string(state.page_size)],
          "page": [string(state.page)],
          "ordering": ["-created"],
          ?"search": state.?custom_filter.optMap(v, [v]),
        }.format_query()
      ).with({
        "Header": {
          "Authorization": ["Bearer " + state.api_token],
        }
      }).do_request().as(resp, resp.StatusCode == 200 ?
        resp.Body.decode_json().as(body,
          body.?results.orValue([]).as(results,
            results.filter(e, has(e.created) && (
              timestamp(e.created) > timestamp(state.cutoff) ||
              (timestamp(e.created) == timestamp(state.cutoff) && !(e.pk in state.cutoff_ids))
            )).as(new_events,
              (
                new_events.map(e, timestamp(e.created)) +
                [timestamp(state.newest_timestamp)]
              ).max().as(newest,
                ((newest == timestamp(state.newest_timestamp)) ? state.newest_ids : []).as(seen_ids,
                  {
                    "timestamp": newest.format(time_layout.RFC3339Nano),
                    "ids": seen_ids + new_events.map(e,
                      timestamp(e.created) == newest && !(e.pk in seen_ids),
                      e.pk
                    ),
                  }
                )
              ).as(page_newest,
                (
                  body.?pagination.next.orValue(0) != 0 &&
                  !results.exists(e, has(e.created) && timestamp(e.created) < timestamp(state.cutoff))
                ).as(want_more,
                  {
                    "events": (size(new_events) == 0) ?
                      [{"message": "retry"}]
                    :
                      new_events.map(e, {
                        "message": e.encode_json(),
                      }),
                    "page": want_more ? body.pagination.next : 1,
                    "want_more": want_more,
                    "cutoff": state.cutoff,
                    "cutoff_ids": state.cutoff_ids,
                    "newest_timestamp": page_newest.timestamp,
                    "newest_ids": page_newest.ids,
                    "cursor": want_more ?
                      {"last_timestamp": state.cutoff, "last_ids": state.cutoff_ids}
                    :
                      {"last_timestamp": page_newest.timestamp, "last_ids": page_newest.ids},
                  }
                )
              )
            )
          )
        )
      :
        {
          "events": {
            "error": {
              "code": string(resp.StatusCode),
              "id": string(resp.Status),
              "message": "GET " + state.url.trim_right("/") + "/api/v3/events/events/: " + (
                size(resp.Body) != 0 ?
                  string(resp.Body)
                :
                  string(resp.Status) + ' (' + string(resp.StatusCode) + ')'
              ),
            },
          },
          "page": 1,
          "want_more": false,
        }
      )
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#if preserve_duplicate_custom_fields}}
  - preserve_duplicate_custom_fields
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
processors:
- drop_event.when.equals.message: retry
{{#if processors}}
{{processors}}
{{/if}}
