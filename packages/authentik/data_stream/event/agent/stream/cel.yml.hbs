config_version: 2
interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: {{url}}
state:
  page_size: {{page_size}}
  api_token: {{api_token}}
  page: 1
  initial_interval: {{initial_interval}}
  want_more: false
{{#if custom_filter}}
  custom_filter: {{escape_string custom_filter}}
{{/if}}
redact:
  fields:
    - api_token
program: |
  state.with(
    (
      state.want_more ?
        state
      :
        state.with({
          "cutoff": state.?cursor.last_timestamp.orValue(
            (now - duration(state.initial_interval)).format(time_layout.RFC3339)
          ),
          "newest_timestamp": state.?cursor.last_timestamp.orValue(
            (now - duration(state.initial_interval)).format(time_layout.RFC3339)
          ),
        })
    ).as(state,
      request(
        "GET",
        state.url.trim_right("/") + "/api/v3/events/events/?" + {
          "page_size": [string(state.page_size)],
          "page": [string(state.page)],
          "ordering": ["-created"],
          ?"search": (has(state.custom_filter) && state.custom_filter != "") ? optional.of([state.custom_filter]) : optional.none(),
        }.format_query()
      ).with({
        "Header": {
          "Authorization": ["Bearer " + state.api_token],
        }
      }).do_request().as(resp, resp.StatusCode == 200 ?
        bytes(resp.Body).decode_json().as(body,
          body.?results.orValue([]).as(results,
            results.filter(e, has(e.created) && timestamp(e.created) > timestamp(state.cutoff)).as(new_events,
              (
                (size(new_events) > 0) ?
                  (
                    new_events.map(e, timestamp(e.created)) +
                    [timestamp(state.newest_timestamp)]
                  ).max().format(time_layout.RFC3339)
                :
                  state.newest_timestamp
              ).as(page_newest,
                (
                  body.?pagination.next.orValue(0) != 0 &&
                  size(results) > 0 &&
                  size(new_events) == size(results)
                ).as(want_more,
                  {
                    "events": new_events.map(e, {
                      "message": e.encode_json(),
                    }),
                    "page": want_more ? body.pagination.next : 1,
                    "want_more": want_more,
                    "cutoff": state.cutoff,
                    "newest_timestamp": page_newest,
                    "cursor": {
                      "last_timestamp": want_more ?
                        state.?cursor.last_timestamp.orValue(state.cutoff)
                      :
                        page_newest,
                    },
                  }
                )
              )
            )
          )
        )
      :
        {
          "events": {
            "error": {
              "code": string(resp.StatusCode),
              "id": string(resp.Status),
              "message": "GET:" + (
                size(resp.Body) != 0 ?
                  string(resp.Body)
                :
                  string(resp.Status) + ' (' + string(resp.StatusCode) + ')'
              ),
            },
          },
          "page": 1,
          "want_more": false,
        }
      )
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#if preserve_duplicate_custom_fields}}
  - preserve_duplicate_custom_fields
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
