interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: {{url}}
state:
  api_token: {{api_token}}
  page_size: {{page_size}}
  initial_interval: {{initial_interval}}
  collection_delay: {{collection_delay}}
redact:
  fields:
    - api_token
program: |-
  // Collect each time window in two phases: Suricata alerts, then Stamus
  // declarations. The cursor retains the phase, page, and window so retries
  // resume without replaying or skipping successful pages.
  state.?cursor.from_date.orValue(
    string(int(now - duration(state.collection_delay) - duration(state.initial_interval)) * 1000)
  ).as(fromDate,
    {
      "phase": state.?cursor.phase.orValue("alert"),
      "page": int(state.?cursor.page.orValue(1)),
      "from_date": fromDate,
      "to_date": state.?cursor.to_date.orValue(
        string(max(int(fromDate), int(now - duration(state.collection_delay)) * 1000))
      ),
    }.as(cur,
      state.with(
        request(
          "GET",
          state.url.trim_right("/") + "/rest/rules/es/events_tail/?" + {
            "qfilter": ["event_type:" + cur.phase],
            "from_date": [cur.from_date],
            "to_date": [cur.to_date],
            "page_size": [string(int(state.page_size))],
            "page": [string(cur.page)],
            "page_number": [string(cur.page)],
          }.format_query()
        ).with(
          {
            "Header": {
              "Authorization": ["Token " + state.api_token],
              "Content-Type": ["application/json"],
            },
          }
        ).do_request().as(resp,
          is_error(resp) ?
            {
              "events": {
                "error": {
                  "code": "transport_error",
                  "id": "transport_error",
                  "message": "GET /rest/rules/es/events_tail/: transport-level failure (timeout, connection reset, DNS failure, TLS handshake failure, etc.) before an HTTP response was received: " + try(resp, "error").error,
                },
              },
              "want_more": false,
            }
          : (resp.StatusCode == 200) ?
            // Preserve large numeric identifiers exactly until the ingest
            // pipeline converts them to keyword fields.
            resp.Body.decode_json_string_numbers().as(body,
              body.?results.orValue([]).map(e, {"message": e.encode_json()}).as(mapped,
                (
                  // Primary signal: DRF-style `next` field, non-null means more pages.
                  // Fallback (if the real envelope omits `next` entirely): a full page
                  // suggests more data may follow; a short/empty page means stop.
                  size(mapped) != 0 && (
                    body.?next.hasValue() ?
                      (body.next != null)
                    :
                      size(mapped) >= int(state.page_size)
                  )
                ) ?
                  // More pages remain for the current phase in this window.
                  {
                    "events": (size(mapped) > 0) ? dyn(mapped) : dyn([{"retry": true}]),
                    "cursor": cur.with({"page": cur.page + 1}),
                    "want_more": true,
                  }
                : (cur.phase == "alert") ?
                  // alert phase exhausted for this window -- move to stamus phase
                  // immediately (same window), page reset to 1.
                  {
                    "events": (size(mapped) > 0) ? dyn(mapped) : dyn([{"retry": true}]),
                    "cursor": {"phase": "stamus", "from_date": cur.from_date, "to_date": cur.to_date, "page": 1},
                    "want_more": true,
                  }
                :
                  // stamus phase exhausted -- both phases done for this window. Advance
                  // the window (next from_date is this window's to_date) and wait for
                  // the next poll interval before starting the next window.
                  {
                    "events": (size(mapped) > 0) ? dyn(mapped) : dyn([{"retry": true}]),
                    "cursor": {"phase": "alert", "from_date": cur.to_date},
                    "want_more": false,
                  }
              )
            )
          :
            {
              "code": string(resp.StatusCode),
              "id": resp.Status,
              "message": "GET /rest/rules/es/events_tail/: " + (
                (size(resp.Body) != 0) ?
                  string(resp.Body)
                :
                  resp.Status + " (" + string(resp.StatusCode) + ")"
              ),
            }.as(err,
              (
                // Skip an unavailable licensed declaration phase. All failures
                // that do not advance the cursor use Agent-logged retry errors.
                [400, 401, 403, 404, 422].exists(c, c == int(resp.StatusCode)) &&
                cur.phase == "stamus"
              ) ?
                {
                  "events": [{"error": err}],
                  "cursor": {"phase": "alert", "from_date": cur.to_date},
                  "want_more": false,
                }
              :
                {"events": {"error": err}, "want_more": false}
            )
        )
      )
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{escape_string tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
processors:
- drop_event.when.equals.retry: true
{{#if processors}}
{{processors}}
{{/if}}
