interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: {{url}}
state:
  api_token: {{api_token}}
  page_size: {{page_size}}
  initial_interval: {{initial_interval}}
  collection_delay: {{collection_delay}}
redact:
  fields:
    - api_token
program: |-
  // Stamus Networks alerts: GET /rest/rules/es/events_tail/?qfilter=event_type:<phase>
  //
  // [CONFIRMED -- live CNCS instance, open-source Clear NDR Community/SELKS edition]
  // Despite vendor docs describing `events_tail` as scoped to non-alert protocol
  // events, GET .../events_tail/?qfilter=event_type:alert DOES return full raw
  // Suricata alert documents (alert.*, flow.*, http.*, etc.), not just aggregates.
  // This endpoint choice is correct; no further action needed here. On this
  // particular (open-source/Community-tier) instance, qfilter=event_type:stamus
  // returned zero results -- consistent with DoC/DoPV correlation (the `stamus`
  // event_type) being a higher license tier, not a bug in this program's two-phase
  // design. See README Troubleshooting for the Tier 3 licensing note.
  //
  // Two-phase worklist per time window: fetch all pages of event_type:alert, then
  // all pages of event_type:stamus, for the same [from_date, to_date) window, then
  // advance the window and repeat. want_more == true is used both to drive
  // within-type pagination and to move from the "alert" phase to the "stamus"
  // phase without waiting for the next poll interval.
  //
  // [CONFIRMED -- live CNCS instance] Pagination response envelope is exactly DRF
  // PageNumberPagination: {count, next, previous, results}. `page_number` (not the
  // `page=` value that appears, vestigially, in the `next` URL's querystring) is
  // the real server-side cursor parameter -- confirmed experimentally that
  // changing `page_number` changes the returned documents. This program already
  // sends `page_number` (see below), so no fix was needed. Continuation is driven
  // primarily by `next` (non-null), with fallback heuristics (empty/short page)
  // retained as a defensive fallback in case a different CNCS version/edition ever
  // omits `next`.
  // [Copilot review, PR #22143] `to_date` is always this evaluation's `now`
  // (minus the safety margin below), and a window's upper bound is never
  // revisited once the cursor has moved past it -- only `from_date` carries
  // forward (as the prior window's `to_date`) when a window completes. That
  // means any alert whose own timestamp falls inside a window, but which does
  // not become searchable via events_tail until after that window's `to_date`
  // was already queried, is permanently skipped: no later poll will ever
  // re-query that earlier, already-advanced-past window to pick it up. The
  // `collection_delay` margin subtracted from `now` below exists so that, by
  // the time a window's `to_date` is actually queried, every alert timestamped
  // at or before it has had `collection_delay` worth of time to become
  // searchable -- shifting the whole polling clock back rather than trying to
  // detect/backfill misses after the fact.
  {
    // [Copilot review, PR #22143] Both bounds of the very first window (no
    // cursor yet) are anchored to the same collection_delay-shifted instant,
    // not to bare `now`: anchoring only `to_date` to it while `from_date`
    // stays anchored to bare `now - initial_interval` would make the window
    // [now - initial_interval, now - collection_delay) -- narrower than
    // initial_interval by collection_delay, and INVERTED (from_date >
    // to_date) whenever initial_interval < collection_delay, which the
    // target API would likely reject outright.
    "phase": state.?cursor.phase.orValue("alert"),
    "page": int(state.?cursor.page.orValue(1)),
    "from_date": state.?cursor.from_date.orValue(
      string(int(now - duration(state.collection_delay) - duration(state.initial_interval)) * 1000)
    ),
    "to_date": state.?cursor.to_date.orValue(
      string(int(now - duration(state.collection_delay)) * 1000)
    ),
  }.as(cur,
    state.with(
      // [Copilot review, PR #22143] do_request() itself can return a CEL error
      // (not an HTTP response) for a transport-level failure -- a timeout or
      // connection failure that exhausts the HTTP client's own retries, a DNS
      // failure, a TLS handshake failure -- i.e. anything that happens before a
      // response is ever received. Accessing `resp.StatusCode` on such an error
      // value would not hit any of the branches below; it would make the whole
      // `state.with(...)` expression itself an error, bypassing every
      // cursor-preserving branch this program relies on for retryable failures.
      // is_error() applied directly to the (non-strict) `.as(resp, ...)`
      // binding detects this before `resp.StatusCode` is ever accessed --
      // deliberately NOT wrapped in try() first: try() immediately stringifies
      // any error it's given, so is_error() on a try()'d value is always
      // false (confirmed empirically with mito). Handled the same way as any
      // other retryable condition: preserve "cursor": cur unmodified so the
      // next evaluation retries the exact same phase/page/window.
      request(
        "GET",
        state.url.trim_right("/") + "/rest/rules/es/events_tail/?" + {
          "qfilter": ["event_type:" + cur.phase],
          "from_date": [cur.from_date],
          "to_date": [cur.to_date],
          "page_size": [string(int(state.page_size))],
          "page_number": [string(cur.page)],
        }.format_query()
      ).with(
        {
          "Header": {
            "Authorization": ["Token " + state.api_token],
            "Content-Type": ["application/json"],
          },
        }
      ).do_request().as(resp,
        is_error(resp) ?
          {
            "code": "transport_error",
            "id": "transport_error",
            "message": "GET /rest/rules/es/events_tail/: transport-level failure (timeout, connection reset, DNS failure, TLS handshake failure, etc.) before an HTTP response was received: " + try(resp, "error").error,
          }.as(err,
            {"events": [{"error": err}], "cursor": cur, "want_more": false}
          )
        :
        (resp.StatusCode == 200) ?
          // flow_id is a large integer (>= 2^53 in production) that would lose
          // trailing-digit precision through CEL's float64 JSON layer if parsed
          // with plain decode_json(). decode_json_string_numbers() decodes every
          // JSON number in the response (not just flow_id) using its exact
          // original textual form instead of float64; this is harmless for every
          // other numeric field below because they are never inspected or
          // compared in this program -- they only pass through
          // `e.encode_json()`, which re-serializes preserved numbers back to
          // bare (unquoted) JSON numbers via their exact original digits, so the
          // wire shape of the emitted "message" is unchanged for every field
          // except flow_id gains exact precision. A prior version of this
          // program instead rewrote flow_id to a quoted JSON string in the raw
          // body before decode_json() (via a `regexp:`/re_replace_all
          // pre-processing step) -- that mechanism was removed because it caused
          // Elastic Agent to silently fail to schedule a component for this
          // input (confirmed empirically: `regexp:` stream-config +
          // `generateComponentModel` produced zero components for this input on
          // Elastic Agent 9.5.5, with no errors logged anywhere).
          // decode_json_string_numbers() requires no stream-config changes at
          // all, so it does not reintroduce that failure mode.
          resp.Body.decode_json_string_numbers().as(body,
            body.?results.orValue([]).map(e, {"message": e.encode_json()}).as(mapped,
              (
                // Primary signal: DRF-style `next` field, non-null means more pages.
                // Fallback (if the real envelope omits `next` entirely): a full page
                // suggests more data may follow; a short/empty page means stop.
                size(mapped) != 0 && (
                  body.?next.hasValue() ?
                    (body.?next.orValue(null) != null)
                  :
                    size(mapped) >= int(state.page_size)
                )
              ) ?
                // More pages remain for the current phase in this window.
                {
                  "events": (size(mapped) > 0) ? dyn(mapped) : dyn([{"retry": true}]),
                  "cursor": cur.with({"page": cur.page + 1}),
                  "want_more": true,
                }
              : (cur.phase == "alert") ?
                // alert phase exhausted for this window -- move to stamus phase
                // immediately (same window), page reset to 1.
                {
                  "events": (size(mapped) > 0) ? dyn(mapped) : dyn([{"retry": true}]),
                  "cursor": {"phase": "stamus", "from_date": cur.from_date, "to_date": cur.to_date, "page": 1},
                  "want_more": true,
                }
              :
                // stamus phase exhausted -- both phases done for this window. Advance
                // the window (next from_date is this window's to_date) and wait for
                // the next poll interval before starting the next window.
                {
                  "events": (size(mapped) > 0) ? dyn(mapped) : dyn([{"retry": true}]),
                  "cursor": {"phase": "alert", "from_date": cur.to_date},
                  "want_more": false,
                }
            )
          )
        :
          {
            "code": string(resp.StatusCode),
            "id": string(resp.Status),
            "message": "GET /rest/rules/es/events_tail/: " + (
              (size(resp.Body) != 0) ?
                string(resp.Body)
              :
                string(resp.Status) + " (" + string(resp.StatusCode) + ")"
            ),
          }.as(err,
            // [CONFIRMED -- x-pack/filebeat/input/cel/input.go, func (s
            // *runSession) execute(), the "case map[string]any:" branch of the
            // "events" type switch] A single-object "events" value is NOT just
            // "logged and not advanced": the runtime unconditionally deletes
            // the session's stored cursor for that evaluation
            // (`delete(s.state, "cursor")`) and skips the goodCursor sync at the
            // end of publish(), so the persisted cursor collapses to whatever
            // was last known-good *before* this failed request -- not to the
            // cursor this request actually used. Mid-pagination, after at least
            // one prior successful page this session, that rollback happens to
            // land on the same phase/page/window because goodCursor was already
            // advanced there -- so single-object form can look like it "retries
            // correctly", but that is an accident of session-local history, not
            // a guarantee the runtime makes. On the very first evaluation of a
            // freshly-installed input (no persisted cursor on disk yet,
            // goodCursor is nil) there is no prior known-good cursor to fall
            // back to, so the cursor is wiped outright and the next evaluation's
            // `state.?cursor.phase`/`.from_date` optional-chaining falls through
            // to the "no cursor" defaults above -- a fresh `now - initial_interval`
            // window -- instead of retrying the failed phase/page. This is the
            // exact failure mode documented and fixed in
            // packages/o365/data_stream/audit/agent/stream/cel.yml.hbs:432-438
            // ("the runtime treats a single object as an error condition and
            // discards the cursor returned with it"): it can replay
            // already-ingested alerts under new document IDs, or skip unread
            // alerts older than the lookback, on every transient hiccup.
            //
            // So every retryable (transient) error below is returned as a LIST
            // (`[{"error": err}]`), never a single-object `{"error": err}` map,
            // with an EXPLICIT, unmodified "cursor": cur -- the exact
            // phase/page/from_date/to_date this failed request used -- so the
            // next evaluation is guaranteed to retry the same window and page,
            // regardless of session history. List-form error events are not
            // flagged "degraded" by the runtime the way single-object form is
            // (that status transition, and the cursor deletion, are both
            // specific to the single-object branch); they are ordinary published
            // events, so the ingest pipeline's `terminate` processor (ES
            // 8.16.0+) is what keeps them from being indexed as alert data.
            //
            // The two phases are NOT treated the same way for *non-retryable*
            // (4xx) errors. A persistent non-retryable error on the "stamus"
            // (DoC/DoPV correlation) phase is advanced past -- same
            // window-advance transition used for a clean terminal/empty stamus
            // result -- because stamus correlation requires a higher Stamus
            // license tier and can be permanently unavailable (403/404) on Tier
            // 2/Community instances; retrying it forever would mean alert
            // collection for every later window never happens (see README
            // Troubleshooting). A persistent error on the "alert" phase is the
            // primary data this program collects, so it keeps the halt/retry
            // behavior -- explicitly retaining "cursor": cur (the unmodified
            // phase/page/window, same as the transient-error branch below)
            // rather than advancing -- so it keeps retrying the same window
            // instead of risking silently skipping alert data.
            //
            // [EMPIRICAL NOTE, confirmed via elastic-package test system]: a single
            // transient 5xx that resolves on the Elastic Agent's own HTTP
            // resource-level retry never actually reaches this branch in
            // practice -- the agent retries the failed request transparently
            // below the CEL script, so the script is only ever re-invoked with
            // the eventual 200 response, not the 503. This branch still exists,
            // is still correct, and is NOT dead code: it is what protects
            // against a 5xx that persists beyond the agent's retry budget (which
            // a short-lived mock scenario can't easily force), and its core
            // property -- no cursor reset across a transient failure -- was
            // independently confirmed by observing strictly-advancing,
            // non-repeating from_date/to_date values with zero duplicate
            // documents across a full system-test run. Don't expect to see this
            // branch's error document in system-test output for a single,
            // retry-budget-respecting transient failure -- see
            // `_dev/test/system/test-default-config.yml`'s hit_count comment.
            [400, 401, 403, 404, 422].exists(c, c == int(resp.StatusCode)) ?
              (
                (cur.phase == "stamus") ?
                  {
                    "events": [{"error": err}],
                    "cursor": {"phase": "alert", "from_date": cur.to_date},
                    "want_more": false,
                  }
                :
                  {"events": [{"error": err}], "cursor": cur, "want_more": false}
              )
            :
              // Transient (429, 5xx, connection-level, etc.) on either phase:
              // retry the exact same phase/page/window on the next evaluation.
              {"events": [{"error": err}], "cursor": cur, "want_more": false}
          )
      )
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
processors:
- drop_event.when.equals.retry: true
{{#if processors}}
{{processors}}
{{/if}}
